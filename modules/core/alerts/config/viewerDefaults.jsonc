    // create/edit z core.system.viewerDefaults — alerty se needitují ručně).

    "toolbarActions": {
        "runDue": {
            "name": "Run due checks",
            "name:cs": "Spustit naplánované kontroly",
            "name:en": "Run due checks",
            "variant": "primary"
        }
    },

    "rowActions": {
        "snooze": {
            "name": "Snooze",
            "name:cs": "Odložit",
            "name:en": "Snooze"
        },
        "dismiss": {
            "name": "Dismiss",
            "name:cs": "Zamítnout",
            "name:en": "Dismiss"
        },
        "recheck": {
            "name": "Re-check",
            "name:cs": "Zkontrolovat znovu",
            "name:en": "Re-check"
        },
        "unsnooze": {
            "name": "Unsnooze",
            "name:cs": "Vrátit do aktivních",
            "name:en": "Unsnooze"
        }
    }
}
