{
    // core.alerts.feedTexts
    //
    // Texty karet feedu dashboardu z modulu core.alerts (AlertsSource;
    // #101 D11–D15). Čte je Shipard\Core\Feed\FeedTexts: pole `text` je
    // vzor ICU MessageFormat ve stejné syntaxi jako frontend/src/i18n/cs.js.
    // Pravidla vzorů (`#` v plurálu, `''` pro apostrof, holé pole =
    // anglický fallback shodný se zdrojem) viz core/mail/config/feedTexts.jsonc.
    //
    // Titulky a zprávy samotných alertů sem nepatří — vyrábí je checky
    // při reconcile (#102).

    // Podtitulek skupinové karty checku nad prahem agregace; {n} = počet
    // alertů. Počet je vždy > 3, plurál by nic nezměnil; doslovné {n}
    // navíc neformátuje tisíce (výstup 1:1 s dřívějším kódem).
    "group.subtitle": {
        "text": "{n} alerts",
        "text:cs": "{n} upozornění",
        "text:en": "{n} alerts"
    },
    // Label jediné akce skupinové karty (otevře agendu Upozornění).
    "group.action": {
        "text": "Open alerts",
        "text:cs": "Otevřít upozornění",
        "text:en": "Open alerts"
    },
    // Karta setup checků (ds-setup.md §5.5).
    "setup.title": {
        "text": "Finish setup",
        "text:cs": "Dokončit nastavení",
        "text:en": "Finish setup"
    },
    // Podtitulek setup karty s více položkami; {n} = počet (jediná
    // položka ukazuje svůj titulek, ne počet).
    "setup.items": {
        "text": "{n, plural, one {# item} other {# items}}",
        "text:cs": "{n, plural, one {# položka} few {# položky} many {# položky} other {# položek}}",
        "text:en": "{n, plural, one {# item} other {# items}}"
    },
    "setup.action": {
        "text": "Open setup",
        "text:cs": "Otevřít nastavení",
        "text:en": "Open setup"
    }
}
