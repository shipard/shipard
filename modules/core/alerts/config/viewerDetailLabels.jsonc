{
    // core.alerts.viewerDetailLabels
    //
    // Detail-tab labely pro AlertsViewer. Alert má jednoduchý detail: overview
    // (text alertu + actions) a context (raw JSON pro debug).

    "tabs": {
        "overview": {
            "name": "Overview",
            "name:cs": "Přehled",
            "name:en": "Overview"
        },
        "context": {
            "name": "Context",
            "name:cs": "Kontext",
            "name:en": "Context"
        }
    },

    // Texty detailu (#137 D30) — čte `TableViewer::detailText()`.
    "texts": {
        // Nadpisy bloků tabu Kontext (výpis JSON).
        "actions": {
            "name": "Actions",
            "name:cs": "Akce",
            "name:en": "Actions"
        },
        "context": {
            "name": "Context",
            "name:cs": "Kontext",
            "name:en": "Context"
        }
    }
}
