{
    "id": "core.system",
    "name": "System",
    "name:cs": "Systém",
    "name:en": "System",
    "description": "Core system tables — users, sessions, settings",
    "description:cs": "Základní systémové tabulky — uživatelé, relace, nastavení",
    "description:en": "Core system tables — users, sessions, settings",
    "tables": [
        "core_system_users",
        "core_system_user_identities",
        "core_system_sessions",
        "core_system_auth_transactions",
        "core_system_auth_tokens",
        "core_system_settings",
        "core_system_user_settings",
        "core_system_api_keys",
        "core_system_rate_limits"
    ],
    // ds-reset nikdy nesmaže systémové tabulky — login, relace, OIDC identity
    // a transakce, pozvánkové/reset tokeny, nastavení (DS i per-user),
    // API klíče (vč. importního) a rate limity přežijí reset.
    "keepOnReset": [
        "core_system_users",
        "core_system_user_identities",
        "core_system_sessions",
        "core_system_auth_transactions",
        "core_system_auth_tokens",
        "core_system_settings",
        "core_system_user_settings",
        "core_system_api_keys",
        "core_system_rate_limits"
    ],
    "settingsPages": [
        {
            "id": "appSettings",
            "name": "Application",
            "name:cs": "Aplikace",
            "name:en": "Application",
            "icon": "settings",
            "fields": [
                {
                    "id": "app.name",
                    "type": "text",
                    "name": "Data source name",
                    "name:cs": "Název zdroje dat",
                    "name:en": "Data source name",
                    "hint": "Full name — the default comes from the installation.",
                    "hint:cs": "Plný název — výchozí hodnota pochází z instalace.",
                    "hint:en": "Full name — the default comes from the installation.",
                    "maxLength": 120
                },
                {
                    "id": "app.shortName",
                    "type": "text",
                    "name": "Short name",
                    "name:cs": "Zkrácený název",
                    "name:en": "Short name",
                    "hint": "Browser tab title and sidebar text.",
                    "hint:cs": "Titulek tabu prohlížeče a sidebaru.",
                    "hint:en": "Browser tab title and sidebar text.",
                    "maxLength": 30
                },
                {
                    "id": "app.icon",
                    "type": "image",
                    "slot": "icon",
                    "name": "Application icon",
                    "name:cs": "Ikona aplikace",
                    "name:en": "Application icon",
                    "hint": "Browser favicon and sidebar icon. Ideally square, PNG.",
                    "hint:cs": "Ikona v prohlížeči (favicon) a v sidebaru. Ideálně čtvercová, PNG.",
                    "hint:en": "Browser favicon and sidebar icon. Ideally square, PNG."
                },
                {
                    "id": "app.companyLogo",
                    "type": "image",
                    "slot": "companyLogo",
                    "name": "Company logo",
                    "name:cs": "Logo firmy",
                    "name:en": "Company logo",
                    "hint": "Used on output documents (invoices etc.).",
                    "hint:cs": "Použije se na výstupních sestavách (faktury apod.).",
                    "hint:en": "Used on output documents (invoices etc.)."
                },
                {
                    "id": "app.theme",
                    "type": "theme",
                    "name": "Default appearance",
                    "name:cs": "Výchozí vzhled",
                    "name:en": "Default appearance",
                    "hint": "Default sidebar appearance for all users who haven't set their own.",
                    "hint:cs": "Výchozí vzhled sidebaru pro všechny uživatele, kteří nemají vlastní.",
                    "hint:en": "Default sidebar appearance for all users who haven't set their own."
                },
                {
                    "id": "app.shell",
                    "type": "shell",
                    "name": "Default layout",
                    "name:cs": "Výchozí rozložení",
                    "name:en": "Default layout",
                    "hint": "Default app layout (shell) for all users who haven't set their own.",
                    "hint:cs": "Výchozí rozložení aplikace (shell) pro všechny uživatele, kteří nemají vlastní.",
                    "hint:en": "Default app layout (shell) for all users who haven't set their own."
                }
            ]
        },
        {
            "id": "accountBasic",
            "scope": "user",
            "name": "Basic",
            "name:cs": "Základní",
            "name:en": "Basic",
            "icon": "settings",
            "fields": [
                {
                    "id": "account.avatar",
                    "type": "avatar",
                    "name": "Photo",
                    "name:cs": "Fotka",
                    "name:en": "Photo",
                    "hint": "Shown next to your name in the sidebar. Ideally square, PNG; downscaled automatically.",
                    "hint:cs": "Zobrazí se v sidebaru vedle vašeho jména. Ideálně čtvercová, PNG; automaticky zmenšená.",
                    "hint:en": "Shown next to your name in the sidebar. Ideally square, PNG; downscaled automatically."
                },
                {
                    "id": "account.theme",
                    "type": "theme",
                    "name": "Appearance",
                    "name:cs": "Vzhled",
                    "name:en": "Appearance",
                    "hint": "Sidebar color and light/dark base. Synced across your devices.",
                    "hint:cs": "Barva sidebaru a světlý/tmavý základ. Synchronizováno mezi vašimi zařízeními.",
                    "hint:en": "Sidebar color and light/dark base. Synced across your devices."
                },
                {
                    "id": "account.shell",
                    "type": "shell",
                    "name": "Layout",
                    "name:cs": "Rozložení",
                    "name:en": "Layout",
                    "hint": "App layout (shell) on desktop. Synced across your devices.",
                    "hint:cs": "Rozložení aplikace (shell) na desktopu. Synchronizováno mezi vašimi zařízeními.",
                    "hint:en": "App layout (shell) on desktop. Synced across your devices."
                },
                {
                    "id": "account.language",
                    "type": "language",
                    "name": "Language",
                    "name:cs": "Jazyk",
                    "name:en": "Language",
                    "hint": "Interface language.",
                    "hint:cs": "Jazyk rozhraní.",
                    "hint:en": "Interface language."
                }
            ]
        }
    ],
    // panels — klientské komponenty v navigaci (mapa panelId → komponenta
    // v ContentArea.svelte). Pro obsah, který nejde poskládat z generických
    // settings fieldů.
    "panels": [
        {
            "id": "accountSecurity",
            "name": "Security",
            "name:cs": "Zabezpečení",
            "name:en": "Security",
            "icon": "lock"
        },
        {
            "id": "dsSetup",
            "name": "Data source setup",
            "name:cs": "Nastavení zdroje dat",
            "name:en": "Data source setup",
            "icon": "list-check"
        },
        {
            "id": "dsAbout",
            "name": "About data source",
            "name:cs": "O zdroji dat",
            "name:en": "About data source",
            "icon": "info"
        }
    ],
    "viewers": [
        {
            "id": "core.system.users",
            "name": "Users",
            "name:cs": "Uživatelé",
            "name:en": "Users",
            "icon": "users",
            "table": "core_system_users",
            "class": "Shipard\\Module\\Core\\System\\UsersViewer"
        }
    ],
    "settingsItems": [
        { "panel": "dsSetup", "section": "app", "order": 5 },
        { "page": "appSettings", "section": "app", "order": 10 },
        { "viewer": "core.system.users",   "section": "other", "subsection": "other.system", "order": 20 },
        { "table": "core_system_user_identities",   "section": "other", "subsection": "other.system", "order": 22 },
        { "table": "core_system_auth_transactions", "section": "other", "subsection": "other.system", "order": 24 },
        { "table": "core_system_settings", "section": "other", "subsection": "other.system", "order": 30 },
        // Sekce `about` existuje jen v profilu install.base — na hosting
        // profilu se položka v navigaci tiše zahodí (ds-about-panel D6).
        { "panel": "dsAbout", "section": "about", "order": 10 }
    ],
    "accountItems": [
        { "page": "accountBasic", "section": "basic", "order": 10 },
        { "panel": "accountSecurity", "section": "basic", "order": 20 }
    ],
    "config": [
        {
            "id": "core.system.docStatesArchive",
            "file": "config/docStatesArchive.jsonc"
        },
        {
            "id": "core.system.viewerDefaults",
            "file": "config/viewerDefaults.jsonc"
        },
        {
            "id": "core.system.formDefaults",
            "file": "config/formDefaults.jsonc"
        },
        {
            "id": "core.system.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        },
        {
            "id": "core.system.reportExportLabels",
            "file": "config/reportExportLabels.jsonc"
        }
    ]
}
