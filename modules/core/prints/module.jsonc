{
    "id": "core.prints",
    "name": "Prints",
    "name:cs": "Tisky",
    "name:en": "Prints",
    "description": "Settings shared by all prints — appearance and custom texts on prints",
    "description:cs": "Nastavení společné všem tiskům — vzhled a vlastní texty na tiscích",
    "description:en": "Settings shared by all prints — appearance and custom texts on prints",

    // core.devices: tiskové úlohy se směrují na periferii zařízení podle
    // role (#177 task 4b). Opačným směrem závislost není — katalog profilů
    // čte core.devices jen z konfigurace.
    "dependencies": [
        "core.system",
        "core.devices"
    ],

    "tables": [
        "core_prints_texts",
        "core_prints_jobs"
    ],

    // Texty na tiscích jsou konfigurace zdroje dat, ne data — ds-reset je
    // nechává (stejně jako pravidla pošty a nastavení vzhledu).
    "keepOnReset": [
        "core_prints_texts"
    ],

    "commands": [
        "Shipard\\Module\\Core\\Prints\\Command\\PrintJobsPruneCommand"
    ],

    // Úklid tiskových úloh starších než 30 dní (#177 U39). Jen ve stavu
    // `active`: v režimu jen pro čtení úlohy nevznikají, není co uklízet.
    "cronJobs": [
        { "command": "print-jobs-prune", "slot": "daily" }
    ],

    // Vzhled je branding — stránka Tisky stojí hned za stránkou Aplikace
    // a texty na tiscích hned za ní.
    "settingsItems": [
        { "page": "printsAppearance",   "section": "app", "order": 20 },
        { "viewer": "core.prints.texts", "section": "app", "order": 30 }
    ],

    "viewers": [
        {
            "id": "core.prints.texts",
            "name": "Texts on prints",
            "name:cs": "Texty na tiscích",
            "name:en": "Texts on prints",
            "icon": "document",
            "table": "core_prints_texts",
            "class": "Shipard\\Module\\Core\\Prints\\PrintTextsViewer"
        }
    ],

    "forms": [
        {
            "table": "core_prints_texts",
            "class": "Shipard\\Module\\Core\\Prints\\PrintTextsForm"
        }
    ],

    "documentClasses": [
        {
            "table": "core_prints_texts",
            "class": "Shipard\\Module\\Core\\Prints\\PrintTextDocument"
        }
    ],

    "config": [
        {
            "id": "core.prints.textSlots",
            "file": "config/textSlots.jsonc"
        },
        {
            "id": "core.prints.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        },
        // Tisk na účtenkovou tiskárnu (#177 task 4a): bajty příkazů ESC/POS.
        {
            "id": "core.prints.printerDrivers",
            "file": "config/printerDrivers.jsonc"
        },
        // Katalog profilů tiskáren; čte ho i GET /_devices/printer-profiles.
        {
            "id": "core.prints.printerProfiles",
            "file": "config/printerProfiles.jsonc"
        },
        // Popisky zkušební účtenky profilu.
        {
            "id": "core.prints.printerTestTexts",
            "file": "config/printerTestTexts.jsonc"
        }
    ],

    // Vzhled tisků (#90 D46, #162 D132). Klíče čte PrintRunner
    // (SETTING_ACCENT_COLOR, SETTING_LOGO_PLACEMENT, SETTING_FOOTER_CONTACTS)
    // a plní jimi `branding` v obálce tisku; chybějící klíč = výchozí vzhled
    // (logo vlevo, neutrální šedý akcent, všechny kontakty v zápatí).
    "settingsPages": [
        {
            "id": "printsAppearance",
            "name": "Prints",
            "name:cs": "Tisky",
            "name:en": "Prints",
            "icon": "print",
            "fields": [
                {
                    "id": "prints.accentColor",
                    "type": "color",
                    // Shodné s PrintData::DEFAULT_ACCENT_COLOR — výběr barvy
                    // ji ukazuje u prázdného pole.
                    "default": "#c8c8c8",
                    "name": "Header accent colour",
                    "name:cs": "Akcentová barva hlavičky",
                    "name:en": "Header accent colour",
                    "hint": "Colours the bar next to the document title and the line under the header. The text stays black. Empty = neutral grey.",
                    "hint:cs": "Barví pruh u titulku dokladu a linku pod hlavičkou. Text zůstává černý. Prázdné = neutrální šedá.",
                    "hint:en": "Colours the bar next to the document title and the line under the header. The text stays black. Empty = neutral grey."
                },
                {
                    "id": "prints.logoPlacement",
                    "type": "select",
                    "name": "Logo placement",
                    "name:cs": "Umístění loga",
                    "name:en": "Logo placement",
                    "hint": "Side of the header with the company logo; the document title and number are on the other side. Empty = left.",
                    "hint:cs": "Strana hlavičky s logem firmy; titulek a číslo dokladu jsou na druhé straně. Prázdné = vlevo.",
                    "hint:en": "Side of the header with the company logo; the document title and number are on the other side. Empty = left.",
                    "options": [
                        { "value": "left",  "label": "Left",  "label:cs": "Vlevo",  "label:en": "Left" },
                        { "value": "right", "label": "Right", "label:cs": "Vpravo", "label:en": "Right" }
                    ]
                },
                // Kontakty vlastní firmy v zápatí dokladu (#162 D130, D132)
                // pod mezinadpisem s úvodním textem (D138) — položka
                // `section` nemá hodnotu ani klíč nastavení.
                {
                    "id": "prints.footerContacts",
                    "type": "section",
                    "name": "Footer contacts",
                    "name:cs": "Kontakty v zápatí",
                    "name:en": "Footer contacts",
                    "hint": "Taken from your own company's card. An empty value is not printed.",
                    "hint:cs": "Údaje z karty vlastní firmy. Prázdný údaj se netiskne.",
                    "hint:en": "Taken from your own company's card. An empty value is not printed."
                },
                // `default: true` musí odpovídat čtení v PrintRunner:
                // nenastavený klíč = kontakt se tiskne.
                {
                    "id": "prints.footer.email",
                    "type": "checkbox",
                    "default": true,
                    "name": "E-mail",
                    "name:cs": "E-mail",
                    "name:en": "E-mail"
                },
                {
                    "id": "prints.footer.phone",
                    "type": "checkbox",
                    "default": true,
                    "name": "Phone",
                    "name:cs": "Telefon",
                    "name:en": "Phone"
                },
                {
                    "id": "prints.footer.web",
                    "type": "checkbox",
                    "default": true,
                    "name": "Website",
                    "name:cs": "Web",
                    "name:en": "Website"
                },
                {
                    "id": "prints.footer.dataBox",
                    "type": "checkbox",
                    "default": true,
                    "name": "Data box",
                    "name:cs": "Datová schránka",
                    "name:en": "Data box"
                }
            ]
        }
    ]
}
