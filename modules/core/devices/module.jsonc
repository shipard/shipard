{
    // Zařízení (#177, docs/native-bridge.md §7): registrovaná zařízení
    // nativní aplikace, jejich periferie a podepsaná volání bez session.
    // Záznam zařízení vzniká jen registrací a plní roli pracoviště ze starého
    // Shipardu (U23). Endpointy `/_devices/*` jsou v jádru
    // (`src/Api/Controller/DevicesController.php`), logika tady.
    "id": "core.devices",
    "name": "Devices",
    "name:cs": "Zařízení",
    "name:en": "Devices",
    "description": "Registered devices of the native app, their peripherals and signed device calls",
    "description:cs": "Registrovaná zařízení nativní aplikace, jejich periferie a podepsaná volání zařízení",
    "description:en": "Registered devices of the native app, their peripherals and signed device calls",

    "dependencies": [
        "core.system"
    ],

    "tables": [
        "core_devices_devices",
        "core_devices_peripherals",
        "core_devices_challenges"
    ],

    // Zařízení a jejich periferie jsou konfigurace zdroje dat — registraci
    // by po `ds-reset` musel administrátor opakovat na každém zařízení (U17).
    // Výzvy žijí 60 s, reset je zahazuje.
    "keepOnReset": [
        "core_devices_devices",
        "core_devices_peripherals"
    ],

    // Příkazy `shpd-ds` (#177 U22): přehled zařízení a zneplatnění bez UI
    // (ztracené zařízení, nedostupná aplikace); úklid výzev pro cron.
    "commands": [
        "Shipard\\Module\\Core\\Devices\\Command\\DeviceListCommand",
        "Shipard\\Module\\Core\\Devices\\Command\\DeviceRevokeCommand",
        "Shipard\\Module\\Core\\Devices\\Command\\DeviceChallengesPruneCommand"
    ],

    // Výzvy vznikají i v režimu jen pro čtení (zařízení se musí ověřit),
    // proto se uklízejí i tam (U20).
    "cronJobs": [
        { "command": "device-challenges-prune", "slot": "five-minutes", "states": ["active", "read_only"] }
    ],

    // Nastavení → Zařízení (#177 D13): panel Toto zařízení (registrace
    // z nativní aplikace nebo ze simulace mostu) a přehled zařízení. Viewer
    // nemá `navSection` — do hlavní navigace nepatří.
    "settingsItems": [
        { "panel": "thisDevice",           "section": "devices", "order": 10 },
        { "viewer": "core.devices.devices", "section": "devices", "order": 20 }
    ],

    "panels": [
        {
            "id": "thisDevice",
            "name": "This device",
            "name:cs": "Toto zařízení",
            "name:en": "This device",
            "icon": "device"
        }
    ],

    "viewers": [
        {
            "id": "core.devices.devices",
            "name": "Devices",
            "name:cs": "Zařízení",
            "name:en": "Devices",
            "icon": "device",
            "table": "core_devices_devices",
            "class": "Shipard\\Module\\Core\\Devices\\DevicesViewer"
        }
    ],

    "forms": [
        { "table": "core_devices_devices", "class": "Shipard\\Module\\Core\\Devices\\DevicesForm" },
        // Bez class → forms/core_devices_peripherals.jsonc (dialog řádku podtabulky).
        { "table": "core_devices_peripherals", "id": "core.devices.peripherals" }
    ],

    // Zneplatnit — jen administrátor, jen aktivní zařízení (U18).
    "recordActions": [
        {
            "id": "revoke",
            "table": "core_devices_devices",
            "class": "Shipard\\Module\\Core\\Devices\\Actions\\RevokeDeviceAction",
            "admin": true,
            "order": 100
        }
    ],

    "documentClasses": [
        { "table": "core_devices_devices",     "class": "Shipard\\Module\\Core\\Devices\\DeviceDocument" },
        { "table": "core_devices_peripherals", "class": "Shipard\\Module\\Core\\Devices\\PeripheralDocument" }
    ],

    "config": [
        { "id": "core.devices.docStates",       "file": "config/docStates.jsonc" },
        { "id": "core.devices.modes",           "file": "config/modes.jsonc" },
        { "id": "core.devices.peripheralRoles", "file": "config/peripheralRoles.jsonc" },
        { "id": "core.devices.viewerLabels",    "file": "config/viewerLabels.jsonc" },
        { "id": "core.devices.formTexts",       "file": "config/formTexts.jsonc" }
    ]
}
