{
    // core.ai.effortLevels
    //
    // Úsilí modelu (core_ai_backends.effort, tasks/ai-models-phase0.md
    // F0-D2). `auto` = parametr se neposílá a platí výchozí úsilí modelu
    // (řada 5: `high`). Jiná hodnota odchází jako
    // `output_config: {"effort": "<hodnota>"}`. Thinking se na řadě 5
    // počítá do `max_tokens` a účtuje jako výstup. Které úrovně model
    // přijímá, říká katalog modelů `core.ai.models` (`capabilities.
    // effortLevels`, `thinkingOffMaxEffort`, #85 D32): nepřijímaná úroveň
    // spadne na nejbližší nižší, s vypnutým thinkingem nejvýš na strop
    // modelu (`between_tools` + `xhigh` → `high`), model bez effortu ji
    // nedostane. Dočasné — fáze 1b (#85) přesune ladění do AI úloh.

    // `default` = převzít z deklarace AI funkce (core_ai_function_settings,
    // core_mail_ai_profiles; tasks/ai-functions.md D38, D46). Není to `auto`:
    // `auto` parametr výslovně neposílá, `default` nechá rozhodnout funkci.
    "default": {
        "name": "By function (default)",
        "name:cs": "Podle funkce (default)",
        "name:en": "By function (default)",
        "order": 5
    },
    "auto": {
        "name": "Model default (not sent)",
        "name:cs": "Výchozí modelu (neposílat)",
        "name:en": "Model default (not sent)",
        "order": 10
    },
    "low": {
        "name": "Low",
        "name:cs": "Nízké (low)",
        "name:en": "Low",
        "order": 20
    },
    "medium": {
        "name": "Medium",
        "name:cs": "Střední (medium)",
        "name:en": "Medium",
        "order": 30
    },
    "high": {
        "name": "High",
        "name:cs": "Vysoké (high)",
        "name:en": "High",
        "order": 40
    },
    "xhigh": {
        "name": "Extra high",
        "name:cs": "Velmi vysoké (xhigh)",
        "name:en": "Extra high",
        "order": 50
    },
    "max": {
