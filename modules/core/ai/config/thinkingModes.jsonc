{
    // core.ai.thinkingModes
    //
    // Režim přemýšlení modelu (core_ai_backends.thinking,
    // tasks/ai-models-phase0.md F0-D2). `auto` = parametr `thinking` se
    // neposílá a model běží ve svém výchozím režimu (řada 5 přemýšlí
    // adaptivně, Sonnet 4.6 nepřemýšlí). Jiná hodnota odchází jako
    // `thinking: {"type": "<hodnota>"}`. Které hodnoty konkrétní model
    // přijímá, říká katalog modelů `core.ai.models` (`capabilities.
    // thinkingModes`, #85 D32): nepřijímanou hodnotu klient před odesláním
    // nahradí (`disabled` ↔ `between_tools`) nebo vynechá a zaloguje.
    // Katalog nezná `enabled` (thinking s rozpočtem) — neposíláme ho.
    // Ladění žije u AI funkcí a profilů pošty (fáze 1b, #85).

    // `default` = převzít z deklarace AI funkce (core_ai_function_settings,
    // core_mail_ai_profiles; tasks/ai-functions.md D38, D46). Není to `auto`:
    // `auto` parametr výslovně neposílá, `default` nechá rozhodnout funkci.
    "default": {
        "name": "By function (default)",
        "name:cs": "Podle funkce (default)",
        "name:en": "By function (default)",
        "order": 5
    },
    "auto": {
        "name": "Model default (not sent)",
        "name:cs": "Výchozí modelu (neposílat)",
        "name:en": "Model default (not sent)",
        "order": 10
    },
    "adaptive": {
        "name": "Adaptive",
        "name:cs": "Adaptivní (adaptive)",
        "name:en": "Adaptive",
        "order": 20
    },
    "between_tools": {
        "name": "Only between tool calls",
        "name:cs": "Jen mezi voláními nástrojů (between_tools)",
        "name:en": "Only between tool calls",
        "order": 30
    },
    "disabled": {
        "name": "Disabled",
        "name:cs": "Vypnuto (disabled)",
        "name:en": "Disabled",
        "order": 40
    }
}
