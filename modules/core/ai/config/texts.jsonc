        "text:cs": "Server nemůže dešifrovat API klíč AI připojení {connectionCode}.",
        "text:en": "The server cannot decrypt the API key of AI connection {connectionCode}."
    },
    "hint.SECRETS_UNAVAILABLE": {
        "text": "Check the data source key file: shpd-ds ds-secrets-health",
        "text:cs": "Zkontroluj klíčový soubor zdroje dat: shpd-ds ds-secrets-health",
        "text:en": "Check the data source key file: shpd-ds ds-secrets-health"
    },
    "error.KEY_CORRUPTED": {
        "text": "The stored API key of AI connection {connectionCode} cannot be decrypted (corrupted, or a different secrets.key).",
        "text:cs": "Uložený API klíč AI připojení {connectionCode} nejde dešifrovat (poškozený, nebo jiný secrets.key).",
        "text:en": "The stored API key of AI connection {connectionCode} cannot be decrypted (corrupted, or a different secrets.key)."
    },
    "hint.KEY_CORRUPTED": {
        "text": "Enter the key again: shpd-ds ai-backend-set-key --backend {connectionCode}",
