        "text:en": "Settings → AI → Functions → {function}: pick a model available on the connection’s platform, or another connection."
    },

    // --- úpravy požadavku (RequestShaper → RequestChange) -------------------
    "change.temperatureOmitted": {
        "text": "Temperature {temperature} is not sent — the model rejects a non-default temperature.",
        "text:cs": "Teplota {temperature} se neposílá — model nepřijímá jinou než výchozí teplotu.",
        "text:en": "Temperature {temperature} is not sent — the model rejects a non-default temperature."
    },
    "change.thinkingReplaced": {
