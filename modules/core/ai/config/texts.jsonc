    "error.UNKNOWN_MODEL.like": {
        "text": "Model {modelLike}, after which requests of the AI function {function} are to be shaped, is not in the model catalog.",
        "text:cs": "Model {modelLike}, podle kterého se má tvarovat požadavek AI funkce {function}, není v katalogu modelů.",
        "text:en": "Model {modelLike}, after which requests of the AI function {function} are to be shaped, is not in the model catalog."
    },
    "hint.UNKNOWN_MODEL.like": {
