{
    // core.ai.texts — věty k AI volání pro uživatele (#85 D51, D52). Čte
    // Shipard\Core\Ai\AiTexts: detail AI funkce v Nastavení, `ai-test`
    // i chyba asistenta mají **jednu** větu, ne tři varianty.
    //
    //   error.<KÓD>[.varianta]  chyba resolveru (AiFunctionException), {param}
    //                           z `details` výjimky + {function} = název funkce
    //   hint.<KÓD>[.varianta]   rada, kde to opravit
    //   change.<kód>            úprava požadavku (RequestChange)
    //   origin.<původ>          původ hodnoty (ResolvedAiCall::ORIGIN_*)
    //   api.<druh>[.platforma]  druh chyby API (LlmApiException); varianta
    //                           pro platformu připojení má přednost (Bedrock:
    //                           klíč z jiného regionu, model bez povoleného
    //                           přístupu, politika účtu — tasks/ai-bedrock-eu.md)
    //
    // Pole `text` je anglický originál (fallback kompilace), `text:cs` /
    // `text:en` překlady. Bez katalogu vrací AiTexts zprávu výjimky.

    // --- chyby resolveru -------------------------------------------------
    "error.UNKNOWN_FUNCTION": {
        "text": "AI function {functionId} is not declared by any active module.",
        "text:cs": "AI funkci {functionId} nedeklaruje žádný aktivní modul.",
        "text:en": "AI function {functionId} is not declared by any active module."
    },
    "hint.UNKNOWN_FUNCTION": {
        "text": "Run shpd-ds ds-upgrade; if the module no longer declares the function, delete its row.",
        "text:cs": "Spusť shpd-ds ds-upgrade; pokud modul funkci už nemá, řádek smaž.",
        "text:en": "Run shpd-ds ds-upgrade; if the module no longer declares the function, delete its row."
    },
    "error.NO_CONNECTION": {
        "text": "No active default AI connection is configured.",
        "text:cs": "Není nastavené žádné výchozí aktivní AI připojení.",
        "text:en": "No active default AI connection is configured."
    },
    "hint.NO_CONNECTION": {
        "text": "Settings → AI → Connections: mark a connection as default and active.",
        "text:cs": "Nastavení → AI → Připojení: označ připojení jako výchozí a aktivní.",
        "text:en": "Settings → AI → Connections: mark a connection as default and active."
    },
    "error.NO_CONNECTION.selected": {
        "text": "AI connection #{connectionId} selected for the function {function} is missing or inactive.",
        "text:cs": "AI připojení č. {connectionId} nastavené u funkce {function} neexistuje nebo není aktivní.",
        "text:en": "AI connection #{connectionId} selected for the function {function} is missing or inactive."
    },
    "hint.NO_CONNECTION.selected": {
        "text": "Settings → AI → Functions → {function}: pick another connection, or clear the field (default connection).",
        "text:cs": "Nastavení → AI → Funkce → {function}: vyber jiné připojení, nebo pole vyprázdni (výchozí připojení).",
        "text:en": "Settings → AI → Functions → {function}: pick another connection, or clear the field (default connection)."
    },
    "error.UNKNOWN_PLATFORM": {
        "text": "AI connection {connectionCode} uses an unknown platform {platform}.",
        "text:cs": "AI připojení {connectionCode} používá neznámou platformu {platform}.",
        "text:en": "AI connection {connectionCode} uses an unknown platform {platform}."
    },
    "hint.UNKNOWN_PLATFORM": {
        "text": "Settings → AI → Connections → {connectionCode}: fix the platform.",
        "text:cs": "Nastavení → AI → Připojení → {connectionCode}: oprav platformu.",
        "text:en": "Settings → AI → Connections → {connectionCode}: fix the platform."
    },
    "error.KEY_MISSING": {
        "text": "AI connection {connectionCode} has no API key stored.",
        "text:cs": "AI připojení {connectionCode} nemá uložený API klíč.",
        "text:en": "AI connection {connectionCode} has no API key stored."
    },
    "hint.KEY_MISSING": {
        "text": "An administrator sets it from the console: shpd-ds ai-backend-set-key --backend {connectionCode}",
        "text:cs": "Správce ho zadá v konzoli: shpd-ds ai-backend-set-key --backend {connectionCode}",
        "text:en": "An administrator sets it from the console: shpd-ds ai-backend-set-key --backend {connectionCode}"
    },
    "error.SECRETS_UNAVAILABLE": {
