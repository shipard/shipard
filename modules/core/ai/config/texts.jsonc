        "text:en": "Model {model} of the AI function {function} is not in the model catalog and no catalog model to shape the request after is set."
    },
    "hint.UNKNOWN_MODEL": {
        "text": "Settings → AI → Functions → {function}: pick a catalog model, or fill in “Shape as model” for a custom ID.",
        "text:cs": "Nastavení → AI → Funkce → {function}: vyber model z katalogu, nebo u vlastního ID vyplň „Tvarovat jako model“.",
        "text:en": "Settings → AI → Functions → {function}: pick a catalog model, or fill in “Shape as model” for a custom ID."
