        "text:cs": "Pro úroveň {tier} AI funkce {function} není v mapě úrovní žádný model.",
        "text:en": "The tier map has no model for tier {tier} of the AI function {function}."
    },
    "hint.NO_MODEL": {
        "text": "Run shpd-ds ds-upgrade (the compiled configuration core.ai.tiers is missing).",
        "text:cs": "Spusť shpd-ds ds-upgrade (chybí zkompilovaná konfigurace core.ai.tiers).",
