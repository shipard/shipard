{
    // core.ai.models — katalog modelů (tasks/ai-model-catalog.md, #85 D30–D33)
    //
    // Jediné místo, kde Shipard ví, „jak s modelem mluvit“: schopnosti, ceny
    // a životní cyklus. Čte ho `Shipard\Core\Ai\ModelCatalog` (compiled
    // config, cfgItem `core.ai.models`); podle schopností tvaruje
    // `RequestShaper` tělo požadavku, z cen počítá `costUsd()`, podle
    // životního cyklu přepisuje `ds-upgrade` vyřazené modely backendů.
    //
    // Klíč položky = ID modelu na přímém API bez datové přípony
    // (`claude-sonnet-4-6`; `claude-sonnet-4-5` platí i pro
    // `claude-sonnet-4-5-20250929`). Pole:
    //
    //   name, vendor, dialect, order   — popis; `order` řadí výpisy.
    //   tier                           — `fast` | `balanced` | `strong` | null
    //                                    (null = model nenabízíme, jen ceník).
    //                                    Výchozí model úrovně určuje mapa
    //                                    `core.ai.tiers` (tiers.jsonc, D37).
    //   platformIds                    — ID modelu per platforma (`anthropic`,
    //                                    `bedrock`); chybějící platforma =
    //                                    model tam není.
    //   capabilities (D31)             — jen to, podle čeho se rozhodujeme:
    //     temperature          true/false — přijímá nevýchozí teplotu
    //     thinkingModes        přijímané hodnoty `thinking.type`
    //     thinkingDefault      `off` / `adaptive` — chování bez parametru
    //     effortLevels         přijímané úrovně; [] = parametr nezná
    //     thinkingOffMaxEffort nejvyšší effort přijímaný spolu s vypnutým
    //                          thinkingem (`disabled` / `between_tools`)
    //     maxOutputTokens      horní mez `max_tokens`
    //   prices (D33)                   — USD za milion tokenů: `input`,
    //                                    `output`, volitelně `longPrompt`
    //                                    {over, input, output}.
    //   lifecycle (D33)                — `status` active | deprecated |
    //                                    retired, `retiresAt`,
    //                                    `retiresNotBefore`, `replacedBy`
    //                                    (naše náhrada při `ds-upgrade`).
    //
    // PRAVIDLO: `null` (nebo chybějící pole) = nevíme → neomezovat, hodnota
    // se pošle beze změny. Co nejde doložit z dokumentace, zůstává null;
    // žádné odhady. Položka smí nést jen ceny (modely, které nenabízíme).
    //
    // Zdroje (poslední kontrola 2026-10-10):
    //   https://platform.claude.com/docs/en/about-claude/models/overview
    //   https://platform.claude.com/docs/en/build-with-claude/thinking  (tabulka hodnot `thinking`)
    //   https://platform.claude.com/docs/en/build-with-claude/effort    (úrovně per model)
    //   https://platform.claude.com/docs/en/about-claude/model-deprecations
    //   https://platform.claude.com/docs/en/about-claude/pricing
    //   https://platform.claude.com/docs/en/build-with-claude/claude-in-amazon-bedrock
    //   https://platform.claude.com/docs/en/models/<model>/overview

    // ---------------------------------------------------------------- strong

    "claude-opus-5-5": {
        "name": "Claude Opus 5.5",
        "vendor": "anthropic",
        "dialect": "anthropic-messages",
        "order": 10,
        "tier": "strong",
        "platformIds": { "anthropic": "claude-opus-5-5", "bedrock": "anthropic.claude-opus-5-5" },
        "capabilities": {
            "temperature": false,
            "thinkingModes": ["adaptive"],
            "thinkingDefault": "adaptive",
            "effortLevels": ["low", "medium", "high", "xhigh", "max"],
            "thinkingOffMaxEffort": null,
            "maxOutputTokens": 128000
        },
        "prices": { "input": 4, "output": 20 },
        "lifecycle": { "status": "active", "retiresNotBefore": "2027-09-22" }
    },
    "claude-opus-5": {
