{
    "id": "core.ai",
    "name": "AI",
    "name:cs": "AI",
    "name:en": "AI",
    "description": "Shared AI infrastructure: LLM provider backends (credentials, model, encrypted API key) reused by mail analysis, chat, and future AI features",
    "description:cs": "Sdílená AI infrastruktura: LLM backendy (přístupové údaje, model, zašifrovaný API klíč) sdílené analýzou pošty, chatem a dalšími AI funkcemi",
    "description:en": "Shared AI infrastructure: LLM provider backends (credentials, model, encrypted API key) reused by mail analysis, chat, and future AI features",

    "dependencies": [
        "core.system"
    ],

    "tables": [
        "core_ai_backends",
        "core_ai_dashboard_summary"
    ],

    // ds-reset chrání AI backend kvůli zašifrovanému API klíči
    // (ai-backend-set-key). Přesunuto z core.mail spolu s tabulkou.
    "keepOnReset": [
        "core_ai_backends"
    ],

    // Umístění v nastavení zachováno 1:1 z core.mail (subsekce other.mail).
    "settingsItems": [
        { "viewer": "core.ai.backends", "section": "other", "subsection": "other.mail", "order": 40 }
    ],

    "viewers": [
        {
            "id": "core.ai.backends",
            "name": "AI backends",
            "name:cs": "AI backendy",
            "name:en": "AI backends",
            "icon": "chip",
            "table": "core_ai_backends",
            "class": "Shipard\\Module\\Core\\Ai\\AIBackendsViewer"
        }
    ],

    "config": [
        {
            "id": "core.ai.thinkingModes",
            "file": "config/thinkingModes.jsonc"
        },
        {
            "id": "core.ai.effortLevels",
            "file": "config/effortLevels.jsonc"
        },
        {
            // Katalog modelů — schopnosti, ceny, životní cyklus (#85 D30).
            "id": "core.ai.models",
            "file": "config/models.jsonc"
        },
        {
            // Mapa úrovní modelu fast / balanced / strong → model (#85 D37).
            "id": "core.ai.tiers",
            "file": "config/tiers.jsonc"
        },
        {
            // Platformy připojení (`core_ai_backends.provider`, #85 D39).
            "id": "core.ai.platforms",
            "file": "config/platforms.jsonc"
        }
    ],

    // AI funkce jádra (#85 D36): shrnutí dashboardu a vnitřní chat. Funkce
    // ostatních modulů deklaruje každý modul sám (core.mail, core.exchange);
    // core.ai na nich nezávisí — registr je čte z compiled configu.
    "aiFunctions": [
        {
            "id": "dashboard.summary",
            "name": "Dashboard summary",
            "name:cs": "Shrnutí dashboardu",
            "name:en": "Dashboard summary",
            "description": "Short generated summary of the home feed (2–4 sentences, no tools).",
            "description:cs": "Krátké generované shrnutí domovského feedu (2–4 věty, bez nástrojů).",
            "description:en": "Short generated summary of the home feed (2–4 sentences, no tools).",
            "tier": "fast",
            "defaults": { "maxTokens": 2000 }
        },
        {
            "id": "chat.default",
            "name": "Assistant chat",
            "name:cs": "Chat asistenta",
            "name:en": "Assistant chat",
            "description": "Built-in assistant with the read-only tool loop over the data source.",
            "description:cs": "Vestavěný asistent s tool smyčkou nad čtecími nástroji zdroje dat.",
            "description:en": "Built-in assistant with the read-only tool loop over the data source.",
            "tier": "balanced",
            "defaults": { "maxTokens": 4096 },
            "requires": ["tools"]
        }
    ],

    "lookups": [
        {
            "table": "core_ai_backends",
            "class": "Shipard\\Module\\Core\\Ai\\AIBackendLookup"
        }
    ],

    "documentClasses": [
        {
            "table": "core_ai_backends",
            "class": "Shipard\\Module\\Core\\Ai\\AIBackendDocument"
        }
    ]
}
