{
    "id": "core.ai",
    "name": "AI",
    "name:cs": "AI",
    "name:en": "AI",
    "description": "Shared AI infrastructure: AI connections (platform, encrypted API key), model catalog, tier map and per-function settings reused by mail analysis, chat and other AI functions",
    "description:cs": "Sdílená AI infrastruktura: AI připojení (platforma, zašifrovaný API klíč), katalog modelů, mapa úrovní a nastavení AI funkcí sdílené analýzou pošty, chatem a dalšími AI funkcemi",
    "description:en": "Shared AI infrastructure: AI connections (platform, encrypted API key), model catalog, tier map and per-function settings reused by mail analysis, chat and other AI functions",

    "dependencies": [
        "core.system"
    ],

    "tables": [
        "core_ai_backends",
        "core_ai_function_settings",
        "core_ai_dashboard_summary"
    ],

    // ds-reset chrání AI připojení kvůli zašifrovanému API klíči
    // (ai-backend-set-key) a přepsání AI funkcí (#85 D38).
    "keepOnReset": [
        "core_ai_backends",
        "core_ai_function_settings"
    ],

    // Sekce AI v Nastavení (#85 D49): připojení, funkce, přehled modelů.
    // Sekci deklaruje install.base (settingsSections.jsonc); instalace bez
    // ní položky tiše vynechá. AI profily pošty zůstávají u Pošty (D8).
    "settingsItems": [
        { "viewer": "core.ai.backends", "section": "ai", "order": 10 },
        { "viewer": "core.ai.functions", "section": "ai", "order": 20 },
        { "viewer": "core.ai.modelCatalog", "section": "ai", "order": 30 }
    ],

    "viewers": [
        {
            // Názvy položek sekce AI (#85 D49): Připojení / Funkce / Modely.
            "id": "core.ai.backends",
            "name": "Connections",
            "name:cs": "Připojení",
            "name:en": "Connections",
            "icon": "chip",
            "table": "core_ai_backends",
            "class": "Shipard\\Module\\Core\\Ai\\AIBackendsViewer"
        },
        {
            // Nastavení AI funkcí per zdroj dat (#85 D38) — řádky zakládá ds-upgrade.
            "id": "core.ai.functions",
            "name": "Functions",
            "name:cs": "Funkce",
            "name:en": "Functions",
            "icon": "chip",
            "table": "core_ai_function_settings",
            "class": "Shipard\\Module\\Core\\Ai\\AiFunctionsViewer"
        },
        {
            // Přehled katalogu modelů jen pro čtení (#85 D50) — viewer bez
            // tabulky: řádky z cfgItemů core.ai.models + core.ai.tiers.
            "id": "core.ai.modelCatalog",
            "name": "Models",
            "name:cs": "Modely",
            "name:en": "Models",
            "icon": "chip",
            "class": "Shipard\\Module\\Core\\Ai\\ModelCatalogViewer"
        }
    ],

    "forms": [
        {
            "table": "core_ai_function_settings",
            "class": "Shipard\\Module\\Core\\Ai\\AiFunctionSettingsForm"
        }
    ],

    "config": [
        {
            "id": "core.ai.thinkingModes",
            "file": "config/thinkingModes.jsonc"
        },
        {
            "id": "core.ai.effortLevels",
            "file": "config/effortLevels.jsonc"
        },
        {
            // Katalog modelů — schopnosti, ceny, životní cyklus (#85 D30).
            "id": "core.ai.models",
            "file": "config/models.jsonc"
        },
        {
            // Mapa úrovní modelu fast / balanced / strong → model (#85 D37).
            "id": "core.ai.tiers",
            "file": "config/tiers.jsonc"
        },
        {
            // Platformy připojení (`core_ai_backends.provider`, #85 D39).
            "id": "core.ai.platforms",
            "file": "config/platforms.jsonc"
        },
        {
            // Popisky viewerů AI (skupiny a položky detailu, badge) — čte
            // AiViewerBase::text(); PHP nenese cs/en větvení (#85 D50).
            "id": "core.ai.viewerLabels",
            "file": "config/viewerLabels.jsonc"
        },
        {
            // Věty k AI volání (chyby resolveru s radou, úpravy požadavku,
            // původ hodnot, chyby API) — jeden zdroj pro detail funkce,
            // `ai-test` i chybu asistenta; čte Shipard\Core\Ai\AiTexts (#85 D51).
            "id": "core.ai.texts",
            "file": "config/texts.jsonc"
        }
    ],

    // AI funkce jádra (#85 D36): shrnutí dashboardu a vnitřní chat. Funkce
    // ostatních modulů deklaruje každý modul sám (core.mail, core.exchange);
    // core.ai na nich nezávisí — registr je čte z compiled configu.
    "aiFunctions": [
        {
            "id": "dashboard.summary",
            "name": "Dashboard summary",
            "name:cs": "Shrnutí dashboardu",
            "name:en": "Dashboard summary",
            "description": "Short generated summary of the home feed (2–4 sentences, no tools).",
            "description:cs": "Krátké generované shrnutí domovského feedu (2–4 věty, bez nástrojů).",
            "description:en": "Short generated summary of the home feed (2–4 sentences, no tools).",
            "tier": "fast",
            "defaults": { "maxTokens": 2000 }
        },
        {
            "id": "chat.default",
            "name": "Assistant chat",
            "name:cs": "Chat asistenta",
            "name:en": "Assistant chat",
            "description": "Built-in assistant with the read-only tool loop over the data source.",
            "description:cs": "Vestavěný asistent s tool smyčkou nad čtecími nástroji zdroje dat.",
            "description:en": "Built-in assistant with the read-only tool loop over the data source.",
            "tier": "balanced",
            // 16 000 (tasks/chat-thinking-blocks.md D55): na modelech
            // s thinkingem se úvahy počítají do stropu.
            "defaults": { "maxTokens": 16000 },
            "requires": ["tools"]
        }
    ],

    // „AI model brzy končí“ (#85 D42, D47): výslovně nastavený model u AI
    // funkce, který podle katalogu do 30 dnů končí nebo už skončil. Profily
    // pošty hlídá core.mail.profile_model_retiring nad stejným úsudkem.
    "alertChecks": [
        {
            "id": "core.ai.model_retiring",
            "name": "AI model retiring",
            "name:cs": "AI model brzy končí",
            "name:en": "AI model retiring",
            "description": "An AI function has an explicitly set model that the model catalog retires within 30 days or has already retired.",
            "description:cs": "AI funkce má výslovně nastavený model, který podle katalogu modelů do 30 dnů končí nebo už skončil.",
            "description:en": "An AI function has an explicitly set model that the model catalog retires within 30 days or has already retired.",
            "class": "Shipard\\Module\\Core\\Ai\\Alerts\\ModelRetiringAlertCheck",
            "severity": "warning",
            "interval": "1d",
            "tags": ["ai"]
        }
    ],

    "lookups": [
        {
            "table": "core_ai_backends",
            "class": "Shipard\\Module\\Core\\Ai\\AIBackendLookup"
        }
    ],

    "documentClasses": [
        {
            "table": "core_ai_backends",
            "class": "Shipard\\Module\\Core\\Ai\\AIBackendDocument"
        },
        {
            "table": "core_ai_function_settings",
            "class": "Shipard\\Module\\Core\\Ai\\AiFunctionSettingsDocument"
        }
    ]
}
