{
    "tableId": 307,
    "name": "AI connections",
    "name:cs": "AI připojení",
    "name:en": "AI connections",

    // AI připojení (tasks/ai-functions.md D39): jen přístup — platforma,
    // adresa, šifrovaný klíč. Model a ladění určuje AI funkce
    // (core_ai_function_settings) a profil pošty. Sloupce ladění
    // (max_tokens, temperature, thinking, effort) z definice zmizely
    // ve fázi 1b; v databázích je ds-upgrade nechává (nemaže).

    "displayPattern": "{name}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "provider",
            "name": "Platform",
            "name:cs": "Platforma",
            "name:en": "Platform"
        },
        {
            "id": "credentials",
            "name": "Credentials",
            "name:cs": "Přístup",
            "name:en": "Credentials"
        },
        {
            "id": "flags",
            "name": "Flags",
            "name:cs": "Příznaky",
            "name:en": "Flags"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "backend_id",
            "name": "Backend code",
            "name:cs": "Kód backendu",
            "name:en": "Backend code",
            "type": "varchar",
            "length": 50,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Název",
            "name:en": "Name",
            "type": "varchar",
            "length": 100,
            "nullable": false,
            "group": "identity"
        },

        // --- provider ---

        {
            // Platforma připojení (tasks/ai-functions.md D39, D45): klíč z cfgItemu
            // `core.ai.platforms` (dialekt API, výchozí adresa); hodnotu hlídá
            // AIBackendDocument, typ zůstává varchar (změna typu není bezpečný MODIFY).
            "id": "provider",
            "name": "Platform",
            "name:cs": "Platforma",
            "name:en": "Platform",
            "type": "varchar",
            "length": 30,
            "nullable": false,
            "default": "anthropic",
            "group": "provider"
        },
        {
            // Nepoužívá se od fáze 1b (#85 D39): model určuje AI funkce. Sloupec
            // zůstává v definici jako nullable — v databázích byl NOT NULL bez
            // výchozí hodnoty a ds-upgrade sloupce nemaže, takže by po vyjmutí
            // selhal INSERT nového připojení. Mimo formulář i viewer; odstraní
            // servisní výmaz. Dokud je vyplněný, je to značka nepřevedeného
            // připojení (D46 — ds-upgrade ho po převodu vynuluje).
            "id": "model",
            "name": "Model (unused since phase 1b)",
            "name:cs": "Model (nepoužívá se od fáze 1b)",
            "name:en": "Model (unused since phase 1b)",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "provider"
        },
        {
            "id": "base_url",
            "name": "Base URL",
            "name:cs": "Base URL",
            "name:en": "Base URL",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "provider"
        },

        // --- credentials ---

        {
            "id": "api_key",
            "name": "API key",
            "name:cs": "API klíč",
            "name:en": "API key",
            "type": "encrypted_text",
            "nullable": true,
            "sensitive": true,
            "group": "credentials"
        },

        // --- flags ---

        {
            "id": "is_default",
            "name": "Default backend",
            "name:cs": "Výchozí backend",
            "name:en": "Default backend",
            "type": "boolean",
            "nullable": false,
            "default": false,
            "group": "flags"
        },
        {
            "id": "is_active",
            "name": "Active",
            "name:cs": "Aktivní",
            "name:en": "Active",
            "type": "boolean",
            "nullable": false,
            "default": false,
            "group": "flags"
        },

        // --- audit ---

        {
            "id": "created",
            "name": "Created",
            "name:cs": "Vytvořeno",
            "name:en": "Created",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },
        {
            "id": "created_by",
            "name": "Created by",
            "name:cs": "Vytvořil",
            "name:en": "Created by",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "status"
        },
        {
            "id": "modified",
            "name": "Modified",
            "name:cs": "Změněno",
            "name:en": "Modified",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },

        // --- doc state (systémové) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 40,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 3,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_backend_id",
            "type": "unique",
            "columns": [
                {"column": "backend_id"}
            ]
        },
        {
            "id": "idx_is_default",
            "type": "index",
            "columns": [
                {"column": "is_default"}
            ]
        },
        {
            "id": "idx_is_active",
            "type": "index",
            "columns": [
                {"column": "is_active"}
            ]
        }
    ]
}
