{
    // core.exchange.contentTags — sémantická taxonomie obsahu dokladů.
    // FIXNÍ systémová sada (D6, tasks/content-tag-enrichment.md). Klíče
    // s prefixovou konvencí `group.tag`; mapování štítek → položka smí
    // fallbackovat na prefix (`vehicle.*`). Břitva D2: nový štítek jen
    // tehdy, když se obsah účtuje jinak než existující štítky.
    //
    // `crossBorderSupply` (nepovinný, tasks/exchange-received-supply-kind.md
    // D2/D4) — co štítek říká o plnění od dodavatele mimo tuzemsko:
    //   "services" | "goods"  druh plnění pro fallback, když AI u řádku
    //                         přijatého dokladu `vat.supplyKind` nevyplnila
    //                         (DocumentApplier, warning supply_kind_derived);
    //                         `goods` u třetí země kód DPH stejně nedá
    //                         (dovoz zboží se vyměřuje z celního dokladu,
    //                         D3) — slouží pro zboží z EU (cz-215);
    //   "special"             veto — místo plnění se řídí zvláštním
    //                         pravidlem (ubytování, doprava osob, stravování,
    //                         nemovitost, mýto, parkování), samovyměření
    //                         se mimo tuzemsko neodvozuje ani s druhem z AI;
    //   chybí                 žádný fallback ani veto.
    // Jen štítky, kde obecné pravidlo místa plnění (§ 9 odst. 1) platí
    // spolehlivě. Sémantika obsahu, ne účetní předvolba — `vatHint`
    // patří do economy.items.contentTagDefaults. Prompt klasifikátoru
    // čte jen `name`, atribut se do LLM nedostane.
    "vehicle.fuel":          { "name": "Fuel",                              "name:cs": "Pohonné hmoty",                                "name:en": "Fuel",                              "order": 10 },
    "vehicle.consumables":   { "name": "Vehicle consumables",              "name:cs": "Provozní kapaliny a drobný materiál k vozidlům", "name:en": "Vehicle consumables",             "order": 20, "crossBorderSupply": "goods" },
    "vehicle.service":       { "name": "Vehicle service and repairs",      "name:cs": "Servis a opravy vozidel",                      "name:en": "Vehicle service and repairs",       "order": 30 },
