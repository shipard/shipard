{
    // shpd.docs.document.v1 — canonical exchange format for documents.
    //
    // Full specification: docs/exchange-format.md.
    //
    // Important:
    //   - Polymorphism by `docType` is NOT enforced in the schema. All
    //     type-specific fields are optional and the PHP DocumentValidator
    //     enforces per-docType rules (povinná pole, místo plnění apod.).
    //   - `additionalProperties` is false on top-level and on most objects;
    //     `source.raw` is the one exception (opaque vendor payload).
    //   - `vatRecap` and `totals` amounts are never the authority — Applier
    //     recomputes them via DocDocument::beforeSave (#166 D4). In an
    //     instruction the numeric `totals` fields are a **checksum**: a
    //     declared value more than 0.01 away from the computed one fails
    //     the apply with `totals_check_failed` and nothing is saved. In a
    //     proposal (`applyOptions.interpret`) they stay a signal: Validator
    //     emits the `totals_mismatch` warning and Applier derives
    //     `total_rounding_mode` from the numbers when
    //     `totals.totalRoundingMode` is absent.
    //     `totals.totalRoundingAuto`, `totals.totalRoundingMode` and
    //     `vat.roundingMode` are intent (#73 D8, #166 D25): automatic
    //     rounding by payment method on sales documents, otherwise the
    //     named mode.

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.docs.document.v1.json",
    "title": "Shipard canonical document v1",
    "type": "object",
    "additionalProperties": false,

    "required": ["format", "formatVersion", "docType"],

    "properties": {
        "format":        { "const": "shpd.docs.document" },
        "formatVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },

        // ── Source / lineage ────────────────────────────────────────────
        "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kind":          { "type": "string" },
                // Identifikátor dokladu ve zdrojovém systému (#166 D46) — s `kind`
                // klíč idempotence: opakovaný pokyn se stejnou dvojicí vrátí
                // existující živý doklad beze změny (koš neblokuje). Bez `kind`
                // chyba `source_kind_missing`. Bez mezer na krajích, shoda je
                // přesná včetně velikosti písmen. Návrh z pošty ho nenese —
                // server ho ze zdroje zprávy zahazuje.
                "ref": {
                    "type": ["string", "null"],
                    "minLength": 1,
                    "maxLength": 60,
                    "pattern": "^\\S(.*\\S)?$",
                    "description": "Identifier of the document in the source system. Together with kind it is the idempotence key: a repeated instruction with the same pair returns the existing document unchanged. Written by scripts and imports — never fill this field from a paper document."
                },
                "extractedAt":   { "type": ["string", "null"], "format": "date-time" },
                "confidence":    { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                // Lineage: zdrojová zpráva došlé pošty (core_mail_incoming_messages).
                // Applier ji propíše do docs_core_heads.source_message; server ji
                // injektuje sám (nikdy nevěří klientovi).
                "message":       { "type": ["integer", "null"] },
                "promptVersion": { "type": ["string", "null"] },
                "raw": {
                    // Vendor-specific opaque payload (e.g. ISDOC <Header>,
                    // AI extraction raw response). Schema-less by design.
                    "type": ["object", "null"],
                    "additionalProperties": true
                }
            }
        },

        // ── Document identity ───────────────────────────────────────────
        "docType":   { "type": "string", "minLength": 1 },
        "docNumber": { "type": ["string", "null"] },
        "docText":   { "type": ["string", "null"] },
        "selfParty": { "enum": ["supplier", "customer", null] },
        // Pokladna (#59 D12) — reference na economy_codebooks_cash_desks
        // (přirozený klíč = kód: "@POK"). Povinná u cashDocument /
        // cashRegisterDocument (řada vázaná na pokladnu — applier ji dohledá
        // podle typu + pokladny; uvedená jiná `numberSeries` je chyba
        // number_series_conflict); u faktur volitelná a platí jen
        // s payment.method "cash" (faktura placená hotově →
        // docs_core_heads.cash_desk).
        "cashDesk": { "$ref": "#/$defs/Reference" },
        // Číselná řada dokladu (#166 D30) — reference na
        // docs_core_number_series (přirozený klíč = kód řady: "@invno").
        // Chybí → výchozí řada typu dokladu (první aktivní); u typu vázaného
        // na pokladnu řadu určuje pokladna. Řada musí být aktivní a typu
        // docType, jinak number_series_not_found.
        "numberSeries": { "$ref": "#/$defs/Reference" },
        // Směr pokladního dokladu: 1 příjem, 2 výdej. Jen cashDocument.
        "cashDirection": { "enum": [1, 2, null] },
        // Doklad otevíracího / uzávěrkového období (#69 D20): zařadí se do
        // měsíce Otevření / Uzavření roku účetního data. Jen import mód
        // (applyOptions.importNumber) — jinak applier pole ignoruje.
        "fiscalPeriodType": { "enum": ["opening", "closing", null] },

        // ── Parties ─────────────────────────────────────────────────────
        // Strana = reference na osobu (#166 D30, D35: 42, "@K00042",
        // "@company_id:12345678", "@vat_id:CZ12345678"), nebo objekt
        // s `ref` a daty. Pokyn hledá jen přes referenci a nic nezakládá —
        // objekt bez `ref` s názvem / IČO / DIČ je chyba reference_missing.
        // Návrh (pošta, ISDOC) hledá podle údajů jako dřív; uvedený `ref`
        // má přednost. Strana vlastní firmy (`selfParty`) referenci nenese.
        "supplier": { "$ref": "#/$defs/Party" },
        "customer": { "$ref": "#/$defs/Party" },
        // Osoba pro saldokonto (#72 D2) — ruční plátce dokladu: applier ji
        // dohledá jako stranu a zapíše partner_balance + partner_balance_manual = 1
        // (odvození z terminálu / dopravce ji nepřepíše). Null / vynecháno =
        // plátce se odvodí při uložení. Exportér ji vydává jen u ručního plátce.
        "balanceParty": { "$ref": "#/$defs/Party" },
        // Partner hlavičky účetního dokladu a dokladu vázaného na pokladnu
        // (#166 D30) — reference na osobu, stejný tvar jako strana. U faktur
        // je partnerem strana: `partner` je tam v pokynu chyba
        // partner_not_supported. U pokladních typů má přednost před stranou;
        // jiná osoba než strana je v pokynu chyba partner_conflict.
        "partner": {
            "$ref": "#/$defs/Party",
            "description": "Head partner of an accounting document or a cash-desk document, given as a reference (see Party). Written by scripts, datasets and Shipard itself. On invoices the partner is the supplier / customer party — never fill this field from a paper document."
        },

        // ── Dates ───────────────────────────────────────────────────────
        "dates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "issueDate":         { "type": ["string", "null"], "format": "date" },
                "dueDate":           { "type": ["string", "null"], "format": "date" },
                "accountingDate":    { "type": ["string", "null"], "format": "date" },
                "taxPointDate":      { "type": ["string", "null"], "format": "date" },
                "vatObligationDate": { "type": ["string", "null"], "format": "date" },
                // Vlastní datum sazby DPH dokladu (#159 D11) — platí jen při
                // `vat.rateSource: "document"`, jinak se ignoruje (info
                // `vat_rate_date_ignored`). Pravidla: VatRateDates (docs.core).
                "vatRateDate":       { "type": ["string", "null"], "format": "date" },
                "periodFrom":        { "type": ["string", "null"], "format": "date" },
                "periodTo":          { "type": ["string", "null"], "format": "date" }
            }
        },

        // ── Currency & VAT ─────────────────────────────────────────────
        "currency": {
            // ISO 4217 uppercase in canonical. Applier lowercases for cfgItem.
            "type": ["string", "null"],
            "pattern": "^[A-Z]{3}$"
        },
        "exchangeRate": { "type": ["number", "null"], "exclusiveMinimum": 0 },

        "vat": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                // Režim výpočtu (docs.core.vatModes). Neznámá hodnota →
                // warning `vat_mode_unknown`, fallback fromBase.
                "mode":                { "enum": ["fromBase", "fromTotal", "none", null] },
                // Místo plnění — canonical názvy (thirdCountry = číselník
                // world.vat `foreign`). Neznámá hodnota → warning
                // `vat_place_unknown`, fallback domestic.
                "place":               { "enum": ["domestic", "intracom", "thirdCountry", null] },
                // Naše registrace DPH (#166 D36) — reference na
                // economy_codebooks_vat_registrations (přirozený klíč = kód:
                // "@cz"). Nepovinná: bez ní pokyn doplní výchozí registraci
                // zdroje dat, dokladu Bez DPH žádnou.
                "registration":        { "$ref": "#/$defs/Reference" },
                // DOČASNÉ (#166 D39) — signál platný jen v návrhu: země naší
                // registrace DPH, jak ji přečetla AI. U přijatých dokladů
                // (selfParty customer) ji návrh odvodí z první aktivní
                // registrace na zdroji a hodnotu tu ignoruje (při rozporu
                // info `vat_registration_country_derived`). Pokyn pole
                // odmítá chybou signal_not_allowed — patří tam `registration`.
                "registrationCountry": { "type": ["string", "null"], "pattern": "^[A-Za-z]{2}$" },
                // Daň přiznává příjemce („reverse charge“, přenesení daňové
                // povinnosti, čl. 196 směrnice, § 92a) — signál pro odvození
                // kódu DPH řádků (VatCodeDerivation), i když je na dokladu
                // DPH 0.
                "reverseCharge":       { "type": ["boolean", "null"] },

                // Autorita rekapitulace (docs.core.vatRecapSources):
                //   "declared" = vatRecap je fakt z dokladu, applier ho uloží
                //                a DocDocument ho nepřepočítá (import, doklad
                //                dodavatele);
                //   "computed"  = rekapitulace se spočítá z řádků.
                // null → applier odvodí: u přijatých dokladů "declared", když
                // je vatRecap neprázdný, vnitřně konzistentní a kódy jsou
                // dohledatelné; jinak "computed" + info issue
                // `recap_source_computed_fallback`.
                "recapSource":         { "enum": ["computed", "declared", null] },

                // Metoda výpočtu přepočítané rekapitulace
                // (docs.core.vatCalcSources): "header" = daň jednou ze součtu
                // cen ve sazbě (norma), "rows" = součet řádkových daní
                // (historický režim). null → default 0 (z hlavičky).
                "calcSource":          { "enum": ["header", "rows", null] },

                // Ruční zařazení do kontrolního hlášení
                // (economy.vat.controlStatementModes, sloupec cs_mode, #77):
                // "auto" podle limitu 10 000 Kč, "detail" vždy A4/B2,
                // "aggregate" vždy A5/B3, "exclude" mimo hlášení. Hodnoty
                // 1:1 se starým vatCS 0–3; null → auto.
                "controlStatementMode": { "enum": ["auto", "detail", "aggregate", "exclude", null] },

                // Přepínač „Sazby DPH podle“ (docs.core.vatRateSources, sloupec
                // vat_rate_source, #159 D11): k jakému datu se hledá sazba kódu
                // DPH řádků a řádků rekapitulace. "auto" = opravný doklad
                // k datu původního plnění, jinak DPPD → DUZP → datum vystavení;
                // "document" = `dates.vatRateDate`; "rows" = `rows[].vat.rateDate`
                // a `vatRecap[].rateDate`, prázdné = automatika. null → auto.
                // Jediné místo pravidel je VatRateDates (docs.core).
                "rateSource":          { "enum": ["auto", "document", "rows", null] },

                // Zaokrouhlení DPH (docs.core.vatRoundingModes, sloupec
                // vat_rounding_mode, #166 D25): "cent" = na haléře, "unit" =
                // na celé jednotky měny. Záměr v obou režimech; null → "cent".
                // Názvy ↔ kódy: RoundingModeNames (core.exchange).
                "roundingMode":        { "enum": ["cent", "unit", null] }
            }
        },

        // ── Payment ─────────────────────────────────────────────────────
        "payment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "method":         { "type": ["string", "null"] },
                // Vlastní bankovní účet dokladu (#166 D30) — reference na
                // economy_codebooks_bank_accounts (přirozený klíč = kód:
                // "@BU1"). Vydaná faktura ho ve stavu V pořádku vyžaduje.
                "ownBankAccount": { "$ref": "#/$defs/Reference" },
                "paymentReference": { "type": ["string", "null"], "maxLength": 35 },
                "specificSymbol": { "type": ["string", "null"] },
                "constantSymbol": { "type": ["string", "null"] }
            }
        },

        // ── Notes ───────────────────────────────────────────────────────
        "notes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "internal":   { "type": ["string", "null"] },
                "onDocument": { "type": ["string", "null"] }
            }
        },

        // ── Dimenze deníku (#110 D20, T2) ───────────────────────────────
        // Klíč = id dimenze (`journalDimensions` v economy.accounting:
        // costCenter, workOrder, asset), hodnota = reference na záznam
        // cílové tabulky (#166 D30; přirozený klíč říká `exchangeKey` v její
        // definici: středisko kód "@STR1", zakázka číslo, majetek
        // inventární číslo).
        // Hlavička = výchozí hodnota pro řádky bez vlastní. Klíče hlídá PHP:
        // neznámé id nebo dimenze, jejíž tabulka klíč nemá → dimension_unknown,
        // hodnota bez záznamu → reference_not_found (obě blokují apply).
        // Chybějící objekt nebo klíč = sloupec zůstane prázdný.
        "dimensions": {
            "type": ["object", "null"],
            "additionalProperties": { "$ref": "#/$defs/Reference" }
        },

        // ── Opravný daňový doklad (#92 D10, task B U1) ─────────────────
        // Objekt = opravný doklad (docs_core_heads.corrective = 1), null nebo
        // chybějící klíč = běžný doklad. Applier ho bere jen u typu dokladu
        // s příznakem docTypes[].corrective (invno); jinde varování
        // correction_not_supported. Původní doklad: `originalDoc` (#166 D30)
        // — reference na docs_core_heads (přirozený klíč = číslo dokladu;
        // čísla různých typů se mohou shodovat, generátory proto posílají
        // id); v návrhu i volba _resolve.correction useExisting:<id>.
        // S odkazem applier číslo a datum plnění přepíše z původního
        // dokladu. `originalDocNumber` je jen text (souhrnný opravný doklad,
        // číslo na tisku) — podle něj se nic nedohledává. Objekt se samými
        // null je platný (import ze starého Shipardu nese jen příznak).
        "correction": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "originalDoc":          { "$ref": "#/$defs/Reference" },
                "originalDocNumber":    { "type": ["string", "null"], "maxLength": 40 },
                "originalTaxPointDate": { "type": ["string", "null"], "format": "date" },
                "reason":               { "type": ["string", "null"] }
            }
        },

        // ── Rows ────────────────────────────────────────────────────────
        "rows": {
            "type": "array",
            "items": { "$ref": "#/$defs/Row" }
        },

        // ── Computed (applier recomputes; `totals` = checksum, #166 D4) ─
        "vatRecap": {
            "type": "array",
            "items": { "$ref": "#/$defs/VatRecapEntry" }
        },
        "totals": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "totalBase":     { "type": ["number", "null"] },
                "totalVat":      { "type": ["number", "null"] },
                "totalAmount":   { "type": ["number", "null"] },
                "totalRounding": { "type": ["number", "null"] },
                // Automatické zaokrouhlení podle způsobu úhrady (#73 D8):
                // explicitní hodnota vyhrává. null / chybí: pokyn ji zapne
                // všude, kde automatika platí (prodejní typy; #166 D26),
                // návrh jen u prodejního dokladu bez totalAmount.
                "totalRoundingAuto": { "type": ["boolean", "null"] },
                // Mód zaokrouhlení celkové částky (docs.core.roundingModes,
                // sloupec total_rounding_mode, #166 D25): "cent" na haléře,
                // "unit" matematicky na 1, "unitUp" / "unitDown" na 1 nahoru /
                // dolů, "fiveCent" matematicky na 0,05. Platí při vypnuté
                // automatice; null → pokyn "cent", návrh odhad z částek. Při
                // zapnuté automatice mód určí způsob úhrady — liší-li se
                // uvedený, pokyn hlásí `total_rounding_mode_ignored`.
                "totalRoundingMode": { "enum": ["cent", "unit", "unitUp", "unitDown", "fiveCent", null] }
            }
        },

        // ── Attachments ─────────────────────────────────────────────────
        "attachments": {
            "type": "array",
            "items": { "$ref": "#/$defs/Attachment" }
        },

        // ── Resolve state ───────────────────────────────────────────────
        // Populated by /preview, consumed by /apply. Free-form here; the
        // PHP DocumentValidator does deeper semantic checks (userAction
        // values, presence of personId for matched, …).
        "_resolve": {
            "type": "object",
            "additionalProperties": true
        },

        // ── Apply options (only honored by /apply) ─────────────────────
        "applyOptions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                // 80 (V opravě) je parkovací cíl migrace — validátor ho povoluje
                // jen v kombinaci s applyOptions.importNumber.
                "targetDocState":        { "type": "integer", "enum": [10, 40, 30, 80] },
                // Zakládání chybějících osob, položek a účtů partnera — čte
                // jen návrh; pokyn nic nezakládá (#166 D31).
                "autoCreateMode":        { "enum": ["strict", "safe", "liberal"] },
                "createMissingEntities": { "type": "boolean" },
                "rejectOnIssues": {
                    "type": "array",
                    "items": { "enum": ["error", "warning"] }
                },

                "importNumber": {
                    "type": "object",
                    "description": "Import mode: force the document's own number + sequence instead of generating from the series counter. Used by legacy migration. When present, DocDocument skips assignDocumentNumber and syncs the counter to GREATEST(last_assigned, sequenceNumber).",
                    "properties": {
                        "docNumber": {
                            "type": "string",
                            "minLength": 1,
                            "description": "The document's own number to store verbatim in doc_number."
                        },
                        "sequenceNumber": {
                            "type": ["integer", "null"],
                            "minimum": 1,
                            "description": "Sequence-in-series, used for counter sync and payment_reference default. Explicit null = number outside the series formula (migrated duplicate-key documents, docNumber suffixed): stored with sequence_number = NULL, counter not synced."
                        }
                    },
                    "required": ["docNumber", "sequenceNumber"],
                    "additionalProperties": false
                },

                // Autor dokladu „Vystavil“ (#93 D9). Přítomný klíč = explicitní
                // volba (null = bez autora), chybějící = výchozí podle
                // DocAuthorResolver. Platí i mimo import mód; AI extrakce ho
                // neposílá.
                "author": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "Explicit author of the document (docs_core_heads.author → core_system_users.id, printed as “Issued by”). A present key is an explicit choice — null = document without an author; a missing key = default (the signed-in user, otherwise the author of automatically issued documents). Must be the id of an existing user (active or not), unknown id = author_not_found. Not limited to import mode."
                },

                // Přegenerovat v místě (#110 D24, Q2): cílový Koncept stejného
                // typu se nahradí z payloadu; id, přílohy a autor zůstávají.
                "replaceConcept": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Regenerate in place (#110 D24, Q2): id of an existing docs_core_heads record in state 10 (Koncept) with the same doc_type as docType. Head and rows are replaced from this payload in one transaction (same validation and derivations as a new document); id, attachments and author are kept, columns the payload does not carry are reset. targetDocState must be 10 or absent, importNumber must be absent. Rejections: replace_target_not_found (422), replace_target_not_concept (409), replace_target_type_mismatch (422)."
                },
                // Režim volání (#166 D2, D18): REST je pokyn; `true` si vyžádá
                // interpretaci (návrh) jako u pošty. S importNumber nejde
                // (import_requires_instruction). Pošta pole nečte.
                "interpret": {
                    "type": "boolean",
                    "description": "REST endpoints only (#166 D2, D18): true requests interpretation (proposal mode) — the applier derives the place of supply, VAT codes and mode, recap takeover and rounding from the paper form of the document, as it does for mail proposals. Absent or false = instruction: the document is stored as the payload says, nothing is derived. Cannot be combined with importNumber (import_requires_instruction). The mail flow ignores it, its mode is fixed in code."
                }
            }
        },

        // ── Saved id (server fills on /apply success) ──────────────────
        "savedDocId": { "type": ["integer", "null"] }
    },

    "$defs": {

        // ── Reference na záznam (#166 D9, D15) ──────────────────────────
        // Gramatiku hodnoty drží jediné místo — ReferenceValue (core.exchange);
        // schéma hlídá jen typ, špatný tvar (i číselný řetězec "42") je
        // chyba reference_invalid. Hledá ReferenceResolver: přesně jeden živý
        // záznam, nenalezeno i nejednoznačné je chyba.
        "Reference": {
            "type": ["integer", "string", "null"],
            "description": "Reference to an existing record: a positive integer = record id, or a string starting with \"@\" = natural key of the target table (\"@K00042\") or a named lookup column (\"@company_id:12345678\"). Exactly one live record must match; not found or ambiguous is an error. Written by scripts, datasets and Shipard itself — a document read from its paper form never carries a reference (omit the field)."
        },

        // ── Party ───────────────────────────────────────────────────────
        // Reference sama (číslo / "@…"), nebo objekt s `ref` a daty. Data
        // vedle `ref` jsou dobový snapshot v importním módu; mimo něj se
        // snapshot staví z adresáře.
        "Party": {
            "type": ["object", "integer", "string", "null"],
            "additionalProperties": false,
            "properties": {
                "ref":               { "$ref": "#/$defs/Reference" },
                "name":              { "type": ["string", "null"] },
                "country":           { "type": ["string", "null"] },
                "companyId":         { "type": ["string", "null"] },
                "taxId":             { "type": ["string", "null"] },
                "vatId":             { "type": ["string", "null"] },
                "courtRegistration": { "type": ["string", "null"] },
                "address":           { "$ref": "#/$defs/Address" },
                "contact":           { "$ref": "#/$defs/Contact" },
                "bankAccount":       { "$ref": "#/$defs/BankAccount" },
                "paymentTermDays":   { "type": ["integer", "null"], "minimum": 0 }
            }
        },

        "Address": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "street":       { "type": ["string", "null"] },
                "houseNumber":  { "type": ["string", "null"] },
                "city":         { "type": ["string", "null"] },
                "cityPart":     { "type": ["string", "null"] },
                "zip":          { "type": ["string", "null"] },
                "country":      { "type": ["string", "null"] },
                "registryCode": { "type": ["string", "null"] },
                "displayLine":  { "type": ["string", "null"] },
                "displayBlock": { "type": ["string", "null"] }
            }
        },

        // Contact *of the document*: the party's contact person (`name` —
        // "Vyřizuje" / "Attn" / name printed above the company, ISDOC
        // Contact/Name) plus their channels. `name` stays in the proposal
        // (preview only) — it is not written to the Person nor to the
        // document snapshots. Differs from shpd.persons.person.v1, where
        // `contact` is the company-level channel and people live in
        // `contacts[]`. See docs/exchange-format.md §6, tasks/exchange-contact-name.md.
        "Contact": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "name":  { "type": ["string", "null"] },
                "email": { "type": ["string", "null"] },
                "phone": { "type": ["string", "null"] },
                "web":   { "type": ["string", "null"] }
            }
        },

        "BankAccount": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                // Účet partnera referencí (#166 D61): id záznamu účtu osoby
                // (přirozený klíč účet nemá). S referencí pokyn použije ten
                // účet; chybí-li klíč, váže účet přesnou shodou čísla s účtem
                // osoby; výslovné null = účet se k záznamu neváže. Čte se
                // u dodavatele (`supplier.bankAccount`).
                "ref":           { "$ref": "#/$defs/Reference" },
                "accountNumber": { "type": ["string", "null"] },
                "iban":          { "type": ["string", "null"] },
                "bic":           { "type": ["string", "null"] },
                "currency":      {
                    "type": ["string", "null"],
                    "pattern": "^[A-Z]{3}$"
                }
            }
        },

        // ── Row ─────────────────────────────────────────────────────────
        // Kontační řádek účetního dokladu (docType accountingDocument):
        // operation `acc.record` (účet z `account`) / `acc.item` (účet z
        // položky), `accSide` + `totalPrice` nesou stranu a částku; item /
        // quantity / unitPrice / vat zůstávají prázdné. Partner řádku je pole
        // `partner` (reference na osobu, #166 D30).
        "Row": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "rowKind":        { "type": ["string", "null"] },
                "operation":      { "type": ["string", "null"] },
                "orderPos":       { "type": ["integer", "null"] },
                "item":           { "$ref": "#/$defs/RowItem" },
                // Jednotka (#166 D37, D60): text = systémový kód jednotky
                // ("pcs", "hr"); kladné celé číslo = id jednotky — tak se
                // zapíše jednotka založená uživatelem, která systémový kód
                // nemá. Papírová podoba ji nese zkratkou nebo názvem (návrh).
                "unit":           { "type": ["string", "integer", "null"], "minimum": 1 },
                "quantity":       { "type": ["number", "null"] },
                "unitPrice":      { "type": ["number", "null"] },
                "totalPrice":     { "type": ["number", "null"] },
                "priceCalcMode":  { "type": ["string", "null"] },
                "discountPct":    { "type": ["number", "null"] },
                "discountAmount": { "type": ["number", "null"] },
                "vat":            { "$ref": "#/$defs/RowVat" },
                "computed":       { "$ref": "#/$defs/RowComputed" },

                // Text řádku (docs_core_rows.description) na řádkové úrovni —
                // účetní doklad (acc.record) item fragment nemá, export ho píše
                // sem. Skladbu textu řádku dělá výhradně CanonicalRowText (#84 D1):
                // neprázdný top-level description první, jinak item.name + " — " +
                // item.description (není-li v názvu obsažený); ořez na 500 znaků.
                "description":      { "type": ["string", "null"] },

                // Kontace (účetní doklad) — viz komentář výše. Reference na
                // economy_accounting_accounts (#166 D30; přirozený klíč =
                // číslo účtu: "@518100"). DOČASNÉ (D39): holé číslo účtu
                // ("518100") je signál platný jen v návrhu — pokyn ho odmítá
                // chybou signal_not_allowed.
                "account":          { "$ref": "#/$defs/Reference" },
                "accSide":          { "enum": ["debit", "credit", null] },
                "paymentReference": { "type": ["string", "null"], "maxLength": 35 },
                "specificSymbol":   { "type": ["string", "null"], "maxLength": 20 },
                "constantSymbol":   { "type": ["string", "null"], "maxLength": 10 },
                "dueDate":          { "type": ["string", "null"], "format": "date" },

                // Partner řádku (#166 D30) — kontační řádek účetního dokladu,
                // úhrada a záloha na pokladním dokladu. Reference na osobu,
                // stejný tvar jako strana; data vedle `ref` se nepoužijí.
                "partner": {
                    "$ref": "#/$defs/Party",
                    "description": "Partner of the row (accounting entry, payment of an invoice in cash) as a reference (see Party). Written by scripts, datasets and Shipard itself — never fill this field from a paper document."
                },

                // Dimenze deníku řádku (#110 T2) — stejný tvar jako na
                // hlavičce; řádek bez hodnoty dědí hlavičku.
                "dimensions": {
                    "type": ["object", "null"],
                    "additionalProperties": { "$ref": "#/$defs/Reference" }
                }
            }
        },

        // Položka řádku: reference sama (číslo / "@KOD" / "@ean:…"), nebo
        // objekt s `ref` a texty (#166 D30). Pokyn hledá jen přes referenci;
        // objekt bez `ref` s názvem nebo kódem je chyba reference_missing
        // (řádek bez položky nese text v `description` řádku). Návrh hledá
        // podle kódů a názvu jako dřív; uvedený `ref` má přednost.
        "RowItem": {
            "type": ["object", "integer", "string", "null"],
            "additionalProperties": false,
            "properties": {
                "ref":          { "$ref": "#/$defs/Reference" },
                // DOČASNÉ (#166 D39) — signál platný jen v návrhu (uložené
                // návrhy z pošty); pokyn ho odmítá chybou signal_not_allowed
                // — patří tam `ref` ("@KOD").
                "ourCode":      { "type": ["string", "null"] },
                "supplierCode": { "type": ["string", "null"] },
                "sku":          { "type": ["string", "null"] },
                "ean":          { "type": ["string", "null"] },
                "name":         { "type": ["string", "null"] },
                "description":  { "type": ["string", "null"] }
            }
        },

        "RowVat": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                // Klíč z číselníku země registrace (cz-110). U přijatých
                // dokladů smí být null — kód odvodí applier ze signálů
                // (VatCodeDerivation, `matchedBy: "derived"`).
                "code": { "type": ["string", "null"] },
                "pct":  { "type": ["number", "null"] },
                // Druh plnění — rozhoduje jen mimo tuzemsko (EU zboží
                // cz-215 vs. služby cz-217).
                "supplyKind": { "enum": ["goods", "services", null] },
                // Kód předmětu plnění u tuzemského přenesení daňové
                // povinnosti ("4" stavební práce, "4a", "5" příloha 5, "14"
                // mobilní telefony … — číselník world.vat reverseChargeSubjects).
                // Ukládá se na řádek dokladu (#89 D10).
                "reverseChargeCode": { "type": ["string", "null"] },
                // Vlastní datum sazby DPH řádku (#159 D11) — platí jen při
                // `vat.rateSource: "rows"`; prázdné = automatické datum
                // dokladu (VatRateDates::lineDate).
                "rateDate": { "type": ["string", "null"], "format": "date" }
            }
        },

        "RowComputed": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "vatBase":   { "type": ["number", "null"] },
                "vatAmount": { "type": ["number", "null"] },
                "vatTotal":  { "type": ["number", "null"] }
            }
        },

        // ── VAT recapitulation ─────────────────────────────────────────
        "VatRecapEntry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "vatCode":       { "type": ["string", "null"] },
                "vatPct":        { "type": ["number", "null"] },
                "base":          { "type": ["number", "null"] },
                "tax":           { "type": ["number", "null"] },
                "total":         { "type": ["number", "null"] },
                "isReversePair": { "type": ["boolean", "null"] },
                // Předmět plnění skupiny u tuzemského přenesení daňové
                // povinnosti (#89 D10) — nepovinné; vyváží ho exporter,
                // AI extrakce ho nevyplňuje.
                "reverseChargeCode": { "type": ["string", "null"] },
                // Vlastní datum sazby DPH řádku rekapitulace (#159 D11) —
                // jen při `vat.rateSource: "rows"`, jako `rows[].vat.rateDate`.
                "rateDate": { "type": ["string", "null"], "format": "date" }
            }
        },

        // ── Attachment ─────────────────────────────────────────────────
        "Attachment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "filename": { "type": ["string", "null"] },
                "mimeType": { "type": ["string", "null"] },
                "size":     { "type": ["integer", "null"], "minimum": 0 },
                "sha256":   { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
                "kind":     { "enum": ["original", "scan", "supplement", "preview", "structured", null] },
                "ref":      { "type": ["string", "null"], "pattern": "^att:[0-9]+$" },
                "inline":   { "type": ["string", "null"] }
            }
        }
    }
}
