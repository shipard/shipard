{
    // shpd.docs.document.v1 — canonical exchange format for documents.
    //
    // Full specification: docs/exchange-format.md.
    //
    // Important:
    //   - Polymorphism by `docType` is NOT enforced in the schema. All
    //     type-specific fields are optional and the PHP DocumentValidator
    //     enforces per-docType rules (povinná pole, místo plnění apod.).
    //   - `additionalProperties` is false on top-level and on most objects;
    //     `source.raw` is the one exception (opaque vendor payload).
    //   - `vatRecap` and `totals` are *informative* — Applier recomputes them
    //     via DocDocument::beforeSave. Validator compares declared vs.
    //     computed and emits `totals_mismatch` warning; a whole-number
    //     `totalAmount` less than 1.00 away from a computed variant passes
    //     (rounded invoice total — Applier derives `total_rounding_mode`
    //     from the numbers, `totals.totalRounding` itself is informative).

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.docs.document.v1.json",
    "title": "Shipard canonical document v1",
    "type": "object",
    "additionalProperties": false,

    "required": ["format", "formatVersion", "docType"],

    "properties": {
        "format":        { "const": "shpd.docs.document" },
        "formatVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },

        // ── Source / lineage ────────────────────────────────────────────
        "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kind":          { "type": "string" },
                "extractedAt":   { "type": ["string", "null"], "format": "date-time" },
                "confidence":    { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                // Lineage: zdrojová zpráva došlé pošty (core_mail_incoming_messages).
                // Applier ji propíše do docs_core_heads.source_message; server ji
                // injektuje sám (nikdy nevěří klientovi).
                "message":       { "type": ["integer", "null"] },
                "promptVersion": { "type": ["string", "null"] },
                "raw": {
                    // Vendor-specific opaque payload (e.g. ISDOC <Header>,
                    // AI extraction raw response). Schema-less by design.
                    "type": ["object", "null"],
                    "additionalProperties": true
                }
            }
        },

        // ── Document identity ───────────────────────────────────────────
        "docType":   { "type": "string", "minLength": 1 },
        "docNumber": { "type": ["string", "null"] },
        "docText":   { "type": ["string", "null"] },
        "selfParty": { "enum": ["supplier", "customer", null] },
        // Pokladna (#59 D12): kód economy_codebooks_cash_desks.code. Povinný
        // u cashDocument / cashRegisterDocument (řada vázaná na pokladnu —
        // applier ji dohledá podle typu + pokladny, numberSeriesCode se
        // ignoruje); u faktur volitelný a platí jen s payment.method "cash"
        // (faktura placená hotově → docs_core_heads.cash_desk).
        "cashDesk": { "type": ["string", "null"], "maxLength": 10 },
        // Směr pokladního dokladu: 1 příjem, 2 výdej. Jen cashDocument.
        "cashDirection": { "enum": [1, 2, null] },
        // Doklad otevíracího / uzávěrkového období (#69 D20): zařadí se do
        // měsíce Otevření / Uzavření roku účetního data. Jen import mód
        // (applyOptions.importNumber) — jinak applier pole ignoruje.
        "fiscalPeriodType": { "enum": ["opening", "closing", null] },

        // ── Parties ─────────────────────────────────────────────────────
        "supplier": { "$ref": "#/$defs/Party" },
        "customer": { "$ref": "#/$defs/Party" },
        // Osoba pro saldokonto (#72 D2) — ruční plátce dokladu: applier ji
        // resolvuje jako stranu a zapíše partner_balance + partner_balance_manual = 1
        // (odvození z terminálu / dopravce ji nepřepíše). Null / vynecháno =
        // plátce se odvodí při uložení. Exportér ji vydává jen u ručního plátce.
        "balanceParty": { "$ref": "#/$defs/Party" },

        // ── Dates ───────────────────────────────────────────────────────
        "dates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "issueDate":         { "type": ["string", "null"], "format": "date" },
                "dueDate":           { "type": ["string", "null"], "format": "date" },
                "accountingDate":    { "type": ["string", "null"], "format": "date" },
                "taxPointDate":      { "type": ["string", "null"], "format": "date" },
                "vatObligationDate": { "type": ["string", "null"], "format": "date" },
                "periodFrom":        { "type": ["string", "null"], "format": "date" },
                "periodTo":          { "type": ["string", "null"], "format": "date" }
            }
        },

        // ── Currency & VAT ─────────────────────────────────────────────
        "currency": {
            // ISO 4217 uppercase in canonical. Applier lowercases for cfgItem.
            "type": ["string", "null"],
            "pattern": "^[A-Z]{3}$"
        },
        "exchangeRate": { "type": ["number", "null"], "exclusiveMinimum": 0 },

        "vat": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "mode":                { "type": ["string", "null"] },
                "place":               { "type": ["string", "null"] },
                "registrationCountry": { "type": ["string", "null"], "pattern": "^[A-Za-z]{2}$" },

                // Autorita rekapitulace (docs.core.vatRecapSources):
                //   "declared" = vatRecap je fakt z dokladu, applier ho uloží
                //                a DocDocument ho nepřepočítá (import, doklad
                //                dodavatele);
                //   "computed"  = rekapitulace se spočítá z řádků.
                // null → applier odvodí: u přijatých dokladů "declared", když
                // je vatRecap neprázdný, vnitřně konzistentní a kódy jsou
                // dohledatelné; jinak "computed" + info issue
                // `recap_source_computed_fallback`.
                "recapSource":         { "enum": ["computed", "declared", null] },

                // Metoda výpočtu přepočítané rekapitulace
                // (docs.core.vatCalcSources): "header" = daň jednou ze součtu
                // cen ve sazbě (norma), "rows" = součet řádkových daní
                // (historický režim). null → default 0 (z hlavičky).
                "calcSource":          { "enum": ["header", "rows", null] },

                // Ruční zařazení do kontrolního hlášení
                // (economy.vat.controlStatementModes, sloupec cs_mode, #77):
                // "auto" podle limitu 10 000 Kč, "detail" vždy A4/B2,
                // "aggregate" vždy A5/B3, "exclude" mimo hlášení. Hodnoty
                // 1:1 se starým vatCS 0–3; null → auto.
                "controlStatementMode": { "enum": ["auto", "detail", "aggregate", "exclude", null] }
            }
        },

        // ── Payment ─────────────────────────────────────────────────────
        "payment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "method":         { "type": ["string", "null"] },
                "paymentReference": { "type": ["string", "null"], "maxLength": 35 },
                "specificSymbol": { "type": ["string", "null"] },
                "constantSymbol": { "type": ["string", "null"] }
            }
        },

        // ── Notes ───────────────────────────────────────────────────────
        "notes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "internal":   { "type": ["string", "null"] },
                "onDocument": { "type": ["string", "null"] }
            }
        },

        // ── Rows ────────────────────────────────────────────────────────
        "rows": {
            "type": "array",
            "items": { "$ref": "#/$defs/Row" }
        },

        // ── Computed (informative; applier recomputes) ─────────────────
        "vatRecap": {
            "type": "array",
            "items": { "$ref": "#/$defs/VatRecapEntry" }
        },
        "totals": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "totalBase":     { "type": ["number", "null"] },
                "totalVat":      { "type": ["number", "null"] },
                "totalAmount":   { "type": ["number", "null"] },
                "totalRounding": { "type": ["number", "null"] }
            }
        },

        // ── Attachments ─────────────────────────────────────────────────
        "attachments": {
            "type": "array",
            "items": { "$ref": "#/$defs/Attachment" }
        },

        // ── Resolve state ───────────────────────────────────────────────
        // Populated by /preview, consumed by /apply. Free-form here; the
        // PHP DocumentValidator does deeper semantic checks (userAction
        // values, presence of personId for matched, …).
        "_resolve": {
            "type": "object",
            "additionalProperties": true
        },

        // ── Apply options (only honored by /apply) ─────────────────────
        "applyOptions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                // 80 (V opravě) je parkovací cíl migrace — validátor ho povoluje
                // jen v kombinaci s applyOptions.importNumber.
                "targetDocState":        { "type": "integer", "enum": [10, 40, 30, 80] },
                "autoCreateMode":        { "enum": ["strict", "safe", "liberal"] },
                "numberSeriesCode": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Výběr číselné řady v rámci doc_type (%C = docs_core_number_series.doc_number_code). Bez něj platí stávající chování (první aktivní řada). Neznámý kód = apply selže (number_series_not_found), žádný tichý fallback."
                },
                "createMissingEntities": { "type": "boolean" },
                "rejectOnIssues": {
                    "type": "array",
                    "items": { "enum": ["error", "warning"] }
                },

                "importNumber": {
                    "type": "object",
                    "description": "Import mode: force the document's own number + sequence instead of generating from the series counter. Used by legacy migration. When present, DocDocument skips assignDocumentNumber and syncs the counter to GREATEST(last_assigned, sequenceNumber).",
                    "properties": {
                        "docNumber": {
                            "type": "string",
                            "minLength": 1,
                            "description": "The document's own number to store verbatim in doc_number."
                        },
                        "sequenceNumber": {
                            "type": ["integer", "null"],
                            "minimum": 1,
                            "description": "Sequence-in-series, used for counter sync and payment_reference default. Explicit null = number outside the series formula (migrated duplicate-key documents, docNumber suffixed): stored with sequence_number = NULL, counter not synced."
                        }
                    },
                    "required": ["docNumber", "sequenceNumber"],
                    "additionalProperties": false
                },

                "importOwnBankAccount": {
                    "type": ["integer", "string", "null"],
                    "minimum": 1,
                    "minLength": 1,
                    "description": "Import mode: our own bank account (economy_codebooks_bank_accounts) to set on the document — integer id, or string = codebook `code` (datasets; resolved by the applier, unknown code = own_bank_account_not_found). For issued invoices confirmed at state 40+, bank_account is required and cannot be carried by the standard self-party flow; the importer resolves it and passes it here."
                }
            }
        },

        // ── Saved id (server fills on /apply success) ──────────────────
        "savedDocId": { "type": ["integer", "null"] }
    },

    "$defs": {

        // ── Party ───────────────────────────────────────────────────────
        "Party": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "name":              { "type": ["string", "null"] },
                "country":           { "type": ["string", "null"] },
                "companyId":         { "type": ["string", "null"] },
                "taxId":             { "type": ["string", "null"] },
                "vatId":             { "type": ["string", "null"] },
                "courtRegistration": { "type": ["string", "null"] },
                "address":           { "$ref": "#/$defs/Address" },
                "contact":           { "$ref": "#/$defs/Contact" },
                "bankAccount":       { "$ref": "#/$defs/BankAccount" },
                "paymentTermDays":   { "type": ["integer", "null"], "minimum": 0 }
            }
        },

        "Address": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "street":       { "type": ["string", "null"] },
                "houseNumber":  { "type": ["string", "null"] },
                "city":         { "type": ["string", "null"] },
                "cityPart":     { "type": ["string", "null"] },
                "zip":          { "type": ["string", "null"] },
                "country":      { "type": ["string", "null"] },
                "registryCode": { "type": ["string", "null"] },
                "displayLine":  { "type": ["string", "null"] },
                "displayBlock": { "type": ["string", "null"] }
            }
        },

        "Contact": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "email": { "type": ["string", "null"] },
                "phone": { "type": ["string", "null"] },
                "web":   { "type": ["string", "null"] }
            }
        },

        "BankAccount": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "accountNumber": { "type": ["string", "null"] },
                "iban":          { "type": ["string", "null"] },
                "bic":           { "type": ["string", "null"] },
                "currency":      {
                    "type": ["string", "null"],
                    "pattern": "^[A-Z]{3}$"
                }
            }
        },

        // ── Row ─────────────────────────────────────────────────────────
        // Kontační řádek účetního dokladu (docType accountingDocument):
        // operation `acc.record` (účet z `account`) / `acc.item` (účet z
        // položky), `accSide` + `totalPrice` nesou stranu a částku; item /
        // quantity / unitPrice / vat zůstávají prázdné. Per-řádkový partner se
        // pinuje přes `_resolve.rows[i].partner` (useExisting:<id>).
        "Row": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "rowKind":        { "type": ["string", "null"] },
                "operation":      { "type": ["string", "null"] },
                "orderPos":       { "type": ["integer", "null"] },
                "item":           { "$ref": "#/$defs/RowItem" },
                "unit":           { "type": ["string", "null"] },
                "quantity":       { "type": ["number", "null"] },
                "unitPrice":      { "type": ["number", "null"] },
                "totalPrice":     { "type": ["number", "null"] },
                "priceCalcMode":  { "type": ["string", "null"] },
                "discountPct":    { "type": ["number", "null"] },
                "discountAmount": { "type": ["number", "null"] },
                "vat":            { "$ref": "#/$defs/RowVat" },
                "computed":       { "$ref": "#/$defs/RowComputed" },

                // Text řádku (docs_core_rows.description). Faktury ho nesou přes
                // item.description; účetní doklad (acc.record) item fragment nemá,
                // proto je k dispozici i jako řádková úroveň. transformRows bere
                // top-level první, jinak fallback na item.description / item.name.
                "description":      { "type": ["string", "null"] },

                // Kontace (účetní doklad) — viz komentář výše.
                "account":          { "type": ["string", "null"], "pattern": "^[0-9]+$" },
                "accSide":          { "enum": ["debit", "credit", null] },
                "paymentReference": { "type": ["string", "null"], "maxLength": 35 },
                "specificSymbol":   { "type": ["string", "null"], "maxLength": 20 },
                "constantSymbol":   { "type": ["string", "null"], "maxLength": 10 },
                "dueDate":          { "type": ["string", "null"], "format": "date" }
            }
        },

        "RowItem": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "ourCode":      { "type": ["string", "null"] },
                "supplierCode": { "type": ["string", "null"] },
                "sku":          { "type": ["string", "null"] },
                "ean":          { "type": ["string", "null"] },
                "name":         { "type": ["string", "null"] },
                "description":  { "type": ["string", "null"] }
            }
        },

        "RowVat": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "code": { "type": ["string", "null"] },
                "pct":  { "type": ["number", "null"] }
            }
        },

        "RowComputed": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "vatBase":   { "type": ["number", "null"] },
                "vatAmount": { "type": ["number", "null"] },
                "vatTotal":  { "type": ["number", "null"] }
            }
        },

        // ── VAT recapitulation ─────────────────────────────────────────
        "VatRecapEntry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "vatCode":       { "type": ["string", "null"] },
                "vatPct":        { "type": ["number", "null"] },
                "base":          { "type": ["number", "null"] },
                "tax":           { "type": ["number", "null"] },
                "total":         { "type": ["number", "null"] },
                "isReversePair": { "type": ["boolean", "null"] }
            }
        },

        // ── Attachment ─────────────────────────────────────────────────
        "Attachment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "filename": { "type": ["string", "null"] },
                "mimeType": { "type": ["string", "null"] },
                "size":     { "type": ["integer", "null"], "minimum": 0 },
                "sha256":   { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
                "kind":     { "enum": ["original", "scan", "supplement", "preview", "structured", null] },
                "ref":      { "type": ["string", "null"], "pattern": "^att:[0-9]+$" },
                "inline":   { "type": ["string", "null"] }
            }
        }
    }
}
