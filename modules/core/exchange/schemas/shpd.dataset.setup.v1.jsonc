{
    // shpd.dataset.setup.v1 — sekce `setup/` datové sady (tasks/dataset-phase1.md R1).
    //
    // Číselníky, které `ds-reset` + provisionery neobnoví, ale sada na nich
    // stojí: rozhodovací parametry DS (settings), vlastní bankovní účty,
    // střediska (dimenze dokladů, #110), registrace DPH, šanony spisovny,
    // mailboxy. Jeden soubor per tabulka, řádky = sloupce tabulky bez
    // interních id a auditních sloupců; FK sloupce se nepřenáší (účet
    // z rozvrhu jako číslo účtu). Klíče řádků jsou sloupce tabulky, proto
    // `additionalProperties: true` — přesnou sadu určuje TableDefinition DS.

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.dataset.setup.v1.json",
    "title": "Shipard dataset setup section v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["format", "table", "rows"],
    "properties": {
        "format": { "const": "shpd.dataset.setup.v1" },
        // settings = klíč/hodnota z core_system_settings (rows: [{key, value}]), aplikuje se před resetem
        "table":  { "enum": ["settings", "bank_accounts", "cost_centers", "vat_registrations", "binders", "mailboxes"] },
        "rows": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
        }
    }
}
