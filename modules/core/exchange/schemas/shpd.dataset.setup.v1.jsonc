{
    // shpd.dataset.setup.v1 — sekce `setup/` datové sady (tasks/dataset-phase1.md R1).
    //
    // Číselníky, které `ds-reset` + provisionery neobnoví, ale sada na nich
    // stojí: rozhodovací parametry DS (settings), nesystémové účty osnovy
    // (accounts, #131 fáze 2a), vlastní bankovní účty, střediska (dimenze
    // dokladů, #110), registrace DPH, šanony spisovny, mailboxy, druhy
    // a číselné řady zakázek (work_order_kinds, work_order_series — #131
    // fáze 2b, D29). Jeden soubor per tabulka, řádky = sloupce tabulky bez
    // interních id a auditních sloupců; FK sloupce nesou přirozený klíč
    // cílové tabulky, pokud ho sada umí přeložit (SetupReferences: účet
    // z rozvrhu číslem, druh zakázky názvem, bankovní účet kódem, řada
    // dokladů objektem {docType, code} — D37), ostatní se nepřenáší. Klíče
    // řádků jsou sloupce tabulky, proto `additionalProperties: true` —
    // přesnou sadu určuje TableDefinition DS.

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.dataset.setup.v1.json",
    "title": "Shipard dataset setup section v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["format", "table", "rows"],
    "properties": {
        "format": { "const": "shpd.dataset.setup.v1" },
        // settings = klíč/hodnota z core_system_settings (rows: [{key, value}]), aplikuje se před resetem
        "table":  { "enum": ["settings", "accounts", "bank_accounts", "cash_desks", "cost_centers", "vat_registrations", "binders", "mailboxes", "work_order_kinds", "work_order_series"] },
        "rows": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
        }
    }
}
