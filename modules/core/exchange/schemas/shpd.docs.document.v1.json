{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.docs.document.v1.json",
    "title": "Shipard canonical document v1",
    "type": "object",
    "additionalProperties": false,
    "required": ["format", "formatVersion", "docType"],
    "properties": {
        "format":        { "const": "shpd.docs.document" },
        "formatVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kind":          { "type": "string" },
                "extractedAt":   { "type": ["string", "null"], "format": "date-time" },
                "confidence":    { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "message":       { "type": ["integer", "null"] },
                "promptVersion": { "type": ["string", "null"] },
                "raw": {
                    "type": ["object", "null"],
                    "additionalProperties": true
                }
            }
        },
        "docType":   { "type": "string", "minLength": 1 },
        "docNumber": { "type": ["string", "null"] },
        "docText":   { "type": ["string", "null"] },
        "selfParty": { "enum": ["supplier", "customer", null] },
        "cashDesk": { "type": ["string", "null"], "maxLength": 10 },
        "cashDirection": { "enum": [1, 2, null] },
        "fiscalPeriodType": { "enum": ["opening", "closing", null] },
        "supplier": { "$ref": "#/$defs/Party" },
        "customer": { "$ref": "#/$defs/Party" },
        "balanceParty": { "$ref": "#/$defs/Party" },
        "dates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "issueDate":         { "type": ["string", "null"], "format": "date" },
                "dueDate":           { "type": ["string", "null"], "format": "date" },
                "accountingDate":    { "type": ["string", "null"], "format": "date" },
                "taxPointDate":      { "type": ["string", "null"], "format": "date" },
                "vatObligationDate": { "type": ["string", "null"], "format": "date" },
                "periodFrom":        { "type": ["string", "null"], "format": "date" },
                "periodTo":          { "type": ["string", "null"], "format": "date" }
            }
        },
        "currency": {
            "type": ["string", "null"],
            "pattern": "^[A-Z]{3}$"
        },
        "exchangeRate": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "vat": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "mode":                { "enum": ["fromBase", "fromTotal", "none", null] },
                "place":               { "enum": ["domestic", "intracom", "thirdCountry", null] },
                "registrationCountry": { "type": ["string", "null"], "pattern": "^[A-Za-z]{2}$" },
                "reverseCharge":       { "type": ["boolean", "null"] },
                "recapSource":         { "enum": ["computed", "declared", null] },
                "calcSource":          { "enum": ["header", "rows", null] },
                "controlStatementMode": { "enum": ["auto", "detail", "aggregate", "exclude", null] }
            }
        },
        "payment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "method":         { "type": ["string", "null"] },
                "paymentReference": { "type": ["string", "null"], "maxLength": 35 },
                "specificSymbol": { "type": ["string", "null"] },
                "constantSymbol": { "type": ["string", "null"] }
            }
        },
        "notes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "internal":   { "type": ["string", "null"] },
                "onDocument": { "type": ["string", "null"] }
            }
        },
        "dimensions": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
        },
        "rows": {
            "type": "array",
            "items": { "$ref": "#/$defs/Row" }
        },
        "vatRecap": {
            "type": "array",
            "items": { "$ref": "#/$defs/VatRecapEntry" }
        },
        "totals": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "totalBase":     { "type": ["number", "null"] },
                "totalVat":      { "type": ["number", "null"] },
                "totalAmount":   { "type": ["number", "null"] },
                "totalRounding": { "type": ["number", "null"] }
            }
        },
        "attachments": {
            "type": "array",
            "items": { "$ref": "#/$defs/Attachment" }
        },
        "_resolve": {
            "type": "object",
            "additionalProperties": true
        },
        "applyOptions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "targetDocState":        { "type": "integer", "enum": [10, 40, 30, 80] },
                "autoCreateMode":        { "enum": ["strict", "safe", "liberal"] },
                "numberSeriesCode": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Výběr číselné řady v rámci doc_type (%C = docs_core_number_series.doc_number_code). Bez něj platí stávající chování (první aktivní řada). Neznámý kód = apply selže (number_series_not_found), žádný tichý fallback."
                },
                "numberSeriesId": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Výběr číselné řady podle id (docs_core_number_series.id) — pro doklady, které Shipard generuje sám z nastavení (periodická fakturace, #110); kód řady je nepovinný a neunikátní. Řada musí být aktivní a typu docType, jinak number_series_not_found; společně s numberSeriesCode = number_series_conflict."
                },
                "createMissingEntities": { "type": "boolean" },
                "rejectOnIssues": {
                    "type": "array",
                    "items": { "enum": ["error", "warning"] }
                },
                "importNumber": {
                    "type": "object",
                    "description": "Import mode: force the document's own number + sequence instead of generating from the series counter. Used by legacy migration. When present, DocDocument skips assignDocumentNumber and syncs the counter to GREATEST(last_assigned, sequenceNumber).",
                    "properties": {
                        "docNumber": {
                            "type": "string",
                            "minLength": 1,
                            "description": "The document's own number to store verbatim in doc_number."
                        },
                        "sequenceNumber": {
                            "type": ["integer", "null"],
                            "minimum": 1,
                            "description": "Sequence-in-series, used for counter sync and payment_reference default. Explicit null = number outside the series formula (migrated duplicate-key documents, docNumber suffixed): stored with sequence_number = NULL, counter not synced."
                        }
                    },
                    "required": ["docNumber", "sequenceNumber"],
                    "additionalProperties": false
                },
                "importOwnBankAccount": {
                    "type": ["integer", "string", "null"],
                    "minimum": 1,
                    "minLength": 1,
                    "description": "Import mode: our own bank account (economy_codebooks_bank_accounts) to set on the document — integer id, or string = codebook `code` (datasets; resolved by the applier, unknown code = own_bank_account_not_found). For issued invoices confirmed at state 40+, bank_account is required and cannot be carried by the standard self-party flow; the importer resolves it and passes it here."
                },
                "author": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "Explicit author of the document (docs_core_heads.author → core_system_users.id, printed as “Issued by”). A present key is an explicit choice — null = document without an author; a missing key = default (the signed-in user, otherwise the author of automatically issued documents). Must be the id of an existing user (active or not), unknown id = author_not_found. Not limited to import mode."
                },
                "replaceConcept": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Regenerate in place (#110 D24, Q2): id of an existing docs_core_heads record in state 10 (Koncept) with the same doc_type as docType. Head and rows are replaced from this payload in one transaction (same validation and derivations as a new document); id, attachments and author are kept, columns the payload does not carry are reset. targetDocState must be 10 or absent, importNumber must be absent. Rejections: replace_target_not_found (422), replace_target_not_concept (409), replace_target_type_mismatch (422)."
                }
            }
        },
        "savedDocId": { "type": ["integer", "null"] }
    },
    "$defs": {
        "Party": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "name":              { "type": ["string", "null"] },
                "country":           { "type": ["string", "null"] },
                "companyId":         { "type": ["string", "null"] },
                "taxId":             { "type": ["string", "null"] },
                "vatId":             { "type": ["string", "null"] },
                "courtRegistration": { "type": ["string", "null"] },
                "address":           { "$ref": "#/$defs/Address" },
                "contact":           { "$ref": "#/$defs/Contact" },
                "bankAccount":       { "$ref": "#/$defs/BankAccount" },
                "paymentTermDays":   { "type": ["integer", "null"], "minimum": 0 }
            }
        },
        "Address": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "street":       { "type": ["string", "null"] },
                "houseNumber":  { "type": ["string", "null"] },
                "city":         { "type": ["string", "null"] },
                "cityPart":     { "type": ["string", "null"] },
                "zip":          { "type": ["string", "null"] },
                "country":      { "type": ["string", "null"] },
                "registryCode": { "type": ["string", "null"] },
                "displayLine":  { "type": ["string", "null"] },
                "displayBlock": { "type": ["string", "null"] }
            }
        },
        "Contact": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "name":  { "type": ["string", "null"] },
                "email": { "type": ["string", "null"] },
                "phone": { "type": ["string", "null"] },
                "web":   { "type": ["string", "null"] }
            }
        },
        "BankAccount": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "accountNumber": { "type": ["string", "null"] },
                "iban":          { "type": ["string", "null"] },
                "bic":           { "type": ["string", "null"] },
                "currency":      {
                    "type": ["string", "null"],
                    "pattern": "^[A-Z]{3}$"
                }
            }
        },
        "Row": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "rowKind":        { "type": ["string", "null"] },
                "operation":      { "type": ["string", "null"] },
                "orderPos":       { "type": ["integer", "null"] },
                "item":           { "$ref": "#/$defs/RowItem" },
                "unit":           { "type": ["string", "null"] },
                "quantity":       { "type": ["number", "null"] },
                "unitPrice":      { "type": ["number", "null"] },
                "totalPrice":     { "type": ["number", "null"] },
                "priceCalcMode":  { "type": ["string", "null"] },
                "discountPct":    { "type": ["number", "null"] },
                "discountAmount": { "type": ["number", "null"] },
                "vat":            { "$ref": "#/$defs/RowVat" },
                "computed":       { "$ref": "#/$defs/RowComputed" },
                "description":      { "type": ["string", "null"] },
                "account":          { "type": ["string", "null"], "pattern": "^[0-9]+$" },
                "accSide":          { "enum": ["debit", "credit", null] },
                "paymentReference": { "type": ["string", "null"], "maxLength": 35 },
                "specificSymbol":   { "type": ["string", "null"], "maxLength": 20 },
                "constantSymbol":   { "type": ["string", "null"], "maxLength": 10 },
                "dueDate":          { "type": ["string", "null"], "format": "date" },
                "dimensions": {
                    "type": ["object", "null"],
                    "additionalProperties": { "type": "string" }
                }
            }
        },
        "RowItem": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "ourCode":      { "type": ["string", "null"] },
                "supplierCode": { "type": ["string", "null"] },
                "sku":          { "type": ["string", "null"] },
                "ean":          { "type": ["string", "null"] },
                "name":         { "type": ["string", "null"] },
                "description":  { "type": ["string", "null"] }
            }
        },
        "RowVat": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "code": { "type": ["string", "null"] },
                "pct":  { "type": ["number", "null"] },
                "supplyKind": { "enum": ["goods", "services", null] },
                "reverseChargeCode": { "type": ["string", "null"] }
            }
        },
        "RowComputed": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "vatBase":   { "type": ["number", "null"] },
                "vatAmount": { "type": ["number", "null"] },
                "vatTotal":  { "type": ["number", "null"] }
            }
        },
        "VatRecapEntry": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "vatCode":       { "type": ["string", "null"] },
                "vatPct":        { "type": ["number", "null"] },
                "base":          { "type": ["number", "null"] },
                "tax":           { "type": ["number", "null"] },
                "total":         { "type": ["number", "null"] },
                "isReversePair": { "type": ["boolean", "null"] }
            }
        },
        "Attachment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "filename": { "type": ["string", "null"] },
                "mimeType": { "type": ["string", "null"] },
                "size":     { "type": ["integer", "null"], "minimum": 0 },
                "sha256":   { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
                "kind":     { "enum": ["original", "scan", "supplement", "preview", "structured", null] },
                "ref":      { "type": ["string", "null"], "pattern": "^att:[0-9]+$" },
                "inline":   { "type": ["string", "null"] }
            }
        }
    }
}
