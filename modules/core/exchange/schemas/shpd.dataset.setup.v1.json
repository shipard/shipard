{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.dataset.setup.v1.json",
    "title": "Shipard dataset setup section v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "format",
        "table",
        "rows"
    ],
    "properties": {
        "format": {
            "const": "shpd.dataset.setup.v1"
        },
        "table": {
            "enum": [
                "settings",
                "accounts",
                "bank_accounts",
                "cash_desks",
                "cost_centers",
                "vat_registrations",
                "binders",
                "mailboxes",
                "work_order_kinds",
                "work_order_series",
                "asset_accounting_groups",
                "asset_type_groups",
                "asset_types"
            ]
        },
        "rows": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": true
            }
        }
    }
}
