{
    // shpd.system.user.v1 — import uživatele (#93 D7, D13).
    //
    // Malý formát pro migraci: importér zakládá uživatele pro Osoby, které
    // ve starém systému „něco udělaly“ (autor dokladu, autor záznamu
    // spisovny), a jejich id pak posílá jako `applyOptions.author` /
    // `createdBy`. Specifikace: docs/exchange-format.md → Uživatelé.
    //
    // Důležité:
    //   - Applier zakládá vždy NEAKTIVNÍHO uživatele bez hesla a bez práv
    //     admina — formát proto žádné takové pole nemá a
    //     `additionalProperties` je false.
    //   - `login` určuje importér (e-mail, při chybějícím či duplicitním
    //     e-mailu syntetický `import-<ref>`); applier jen páruje.
    //   - `person` je id Osoby v cílovém zdroji dat; na zdroji bez Osob se
    //     ignoruje.
    //   - Na rozdíl od ostatních formátů nese verzi přímo `format`
    //     (bez `formatVersion`).

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.system.user.v1.json",
    "title": "Shipard user import v1",
    "type": "object",
    "additionalProperties": false,

    "required": ["format", "login", "fullName"],

    "properties": {
        "format":   { "const": "shpd.system.user.v1" },
        "login":    { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
        "email":    { "type": ["string", "null"], "maxLength": 200 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "person":   { "type": ["integer", "null"], "minimum": 1 }
    }
}
