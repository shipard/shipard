{
    // shpd.dataset.workOrder.v1 — sekce `workOrders/` datové sady (#131 fáze 2b, D30).
    //
    // Obálka nad importním formátem shpd.workOrders.workOrder.v1: jeden soubor
    // = jedna zakázka včetně fakturačního předpisu, cílového stavu a evidence
    // vyfakturovaných období. Struktura je stejná jako u importu, liší se jen
    // reference — místo id přirozené klíče:
    //
    //   - `numberSeries` = kód řady zakázek (setup/work_order_series.jsonc);
    //   - `costCenter` = kód střediska; `parent` = číslo nadřazené zakázky;
    //   - `customer` = identifikace osoby (název, země, IČO, DIČ, VAT ID) —
    //     seed ji dohledá v adresáři jen podle identifikátorů, nenalezená
    //     strana je chyba (osoba musí být v persons/);
    //   - `invoicing.numberSeries` = řada dokladů objektem {docType, code}
    //     (D37: výchozí řady z provisioneru kód nemají), `invoicing.bankAccount`
    //     = kód vlastního účtu;
    //   - `rows[].item` = ourCode položky, `unit` = system_code / zkratka.
    //
    // `periods[]` nese jen vystavená období s dokladem (stav `issued`,
    // `docNumber` = číslo dokladu mezi vydanými doklady; koncept zástupným
    // číslem `!` + id). Období bez dokladu (naplánované, čekající, zastavené)
    // dump vynechá; `content_hash` spočítá seeder z uloženého dokladu.
    //
    // Seed deleguje na WorkOrderImportApplier (hlavička v Konceptu → řádky →
    // cílový stav), evidenci období zapíše WorkOrderPeriodsSeeder až za docs/.

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.dataset.workOrder.v1.json",
    "title": "Shipard dataset work order v1",
    "type": "object",
    "additionalProperties": false,

    "required": ["format", "workOrder"],

    "properties": {
        "format": { "const": "shpd.dataset.workOrder.v1" },

        "workOrder": {
            "type": "object",
            "additionalProperties": false,
            "required": ["numberSeries", "title", "state"],
            "properties": {
                "number":           { "type": ["string", "null"], "minLength": 1, "maxLength": 50, "pattern": "\\S" },
                "sequenceNumber":   { "type": ["integer", "null"], "minimum": 1 },
                // Kód řady zakázek (economy_work_orders_number_series.number_code).
                "numberSeries":     { "type": "string", "minLength": 1, "maxLength": 10 },
                "title":            { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
                "state":            { "enum": ["draft", "confirmed", "finished", "cancelled"] },
                "dateStart":        { "$ref": "#/$defs/dateOrNull" },
                "dateEnd":          { "$ref": "#/$defs/dateOrNull" },
                // Kód střediska (setup/cost_centers.jsonc).
                "costCenter":       { "type": ["string", "null"], "minLength": 1 },
                "internalNote":     { "type": ["string", "null"] },
                // Identifikace zákazníka — jen externí typy zakázek.
                "customer": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "properties": {
                        "name":      { "type": ["string", "null"] },
                        "country":   { "type": ["string", "null"], "pattern": "^[a-z]{2}$" },
                        "companyId": { "type": ["string", "null"] },
                        "taxId":     { "type": ["string", "null"] },
                        "vatId":     { "type": ["string", "null"] }
                    }
                },
                "currency":         { "type": ["string", "null"], "minLength": 3, "maxLength": 3 },
                "paymentReference": { "type": ["string", "null"], "maxLength": 35 },
                // Číslo nadřazené zakázky (jen jednorázové typy; nadřazená je v sadě dřív).
                "parent":           { "type": ["string", "null"], "minLength": 1, "maxLength": 50 },
                // Fakturační předpis — jen periodický typ; chybějící / null přepis = hodnota druhu.
                "invoicing": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "properties": {
                        "periodicity":   { "enum": ["month", "quarter", "halfyear", "year", null] },
                        "invoiceFrom":   { "$ref": "#/$defs/dateOrNull" },
                        "docText":       { "type": ["string", "null"], "maxLength": 200 },
                        "docType":       { "enum": ["invno", "invpo", null] },
                        // Řada dokladů složeným klíčem (D37): bez `code` = řada typu bez kódu.
                        "numberSeries": {
                            "type": ["object", "null"],
                            "additionalProperties": false,
                            "required": ["docType"],
                            "properties": {
                                "docType": { "type": "string", "minLength": 1 },
                                "code":    { "type": ["string", "null"], "maxLength": 10 }
                            }
                        },
                        "dueDays":       { "type": ["integer", "null"], "minimum": 0, "maximum": 999 },
                        "timing":        { "enum": ["start", "end", null] },
                        "vatMode":       { "enum": ["none", "fromBase", "fromTotal", null] },
                        "paymentMethod": { "enum": ["cash", "bankTransfer", "card", "cashOnDelivery", "setOff", "paymentGateway", null] },
                        // Kód vlastního bankovního účtu (setup/bank_accounts.jsonc).
                        "bankAccount":   { "type": ["string", "null"], "minLength": 1 }
                    }
                }
            }
        },

        // Řádky předpisu — jen periodický typ.
        "rows": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "item":        { "type": ["string", "null"], "minLength": 1 },
                    "description": { "type": ["string", "null"], "maxLength": 500 },
                    "quantity":    { "type": ["number", "null"] },
                    "unit":        { "type": ["string", "null"], "maxLength": 20 },
                    "unitPrice":   { "type": ["number", "null"] },
                    "vatCode":     { "type": ["string", "null"], "maxLength": 20 },
                    "operation":   { "type": ["string", "null"], "maxLength": 40 },
                    "validFrom":   { "$ref": "#/$defs/dateOrNull" },
                    "validTo":     { "$ref": "#/$defs/dateOrNull" }
                }
            }
        },

        // Evidence vyfakturovaných období — jen periodický typ, jen vystavená s dokladem.
        "periods": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "state", "docNumber"],
                "properties": {
                    "from":      { "$ref": "#/$defs/date" },
                    "to":        { "$ref": "#/$defs/date" },
                    "state":     { "const": "issued" },
                    "docNumber": { "type": "string", "minLength": 1, "maxLength": 50 }
                }
            }
        }
    },

    "$defs": {
        "date":       { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "dateOrNull": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
    }
}
