{
    // shpd.dataset.asset.v1 — sekce `assets/` datové sady (#131 fáze 2c, D38, D40).
    //
    // Obálka nad importním formátem shpd.assets.asset.v1: jeden soubor =
    // jedna karta majetku s potvrzenými hodnotovými událostmi. Struktura je
    // stejná jako u importu, liší se reference a původ:
    //
    //   - `type` = název typu majetku (setup/asset_types.jsonc),
    //     `accountingGroup` = kód účetní skupiny (setup/asset_accounting_groups.jsonc);
    //   - `owner` = identifikace osoby (název, země, IČO, DIČ, VAT ID) —
    //     seed ji dohledá v adresáři jen podle identifikátorů, nenalezený
    //     vlastník je chyba (osoba musí být v persons/);
    //   - `assetNumber` se převezme beze změny (AssetDocument číslo nepřepisuje);
    //   - dlouhodobý majetek datum pořízení, vyřazení ani cenu nenese —
    //     nesou je události (D13, D38); `acquiredDate`, `disposedDate`
    //     a `price` platí jen drobnému majetku;
    //   - události nesou `origin`: `manual` (seed je zakládá jako uživatel,
    //     bez importního módu) nebo `import` (zdroj dat po migraci — seed
    //     je uloží importním módem, původ zůstane). Systémové odpisy
    //     (původ `system`) sada nenese — jsou odvozené, po seedu je založí
    //     znovu Odpisy za období; nepotvrzené události dump vynechá.
    //   - vazba na účetní doklad (`doc_head`) se nepřenáší; doklady
    //     zaúčtování majetku (řádky asset.*) dump vynechá (D38).
    //
    // Seed zakládá kartu před doklady (dimenze `asset` na řádcích pořízení
    // odkazuje inventární číslo) a události až za doklady (AssetEventsSeeder).

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.dataset.asset.v1.json",
    "title": "Shipard dataset asset v1",
    "type": "object",
    "additionalProperties": false,

    "required": ["format", "asset"],

    "properties": {
        "format": { "const": "shpd.dataset.asset.v1" },

        "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetNumber", "name", "category", "tracking", "state"],
            "properties": {
                "assetNumber":     { "type": "string", "minLength": 1, "maxLength": 20, "pattern": "\\S" },
                "name":            { "type": "string", "minLength": 1, "maxLength": 150, "pattern": "\\S" },
                "shortName":       { "type": ["string", "null"], "maxLength": 60 },
                "note":            { "type": ["string", "null"] },
                // Název typu majetku (economy_assets_types.name).
                "type":            { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
                "category":        { "enum": ["small", "tangible", "intangible", "nondepreciable"] },
                "tracking":        { "enum": ["single", "set", "quantity"] },
                // Kód účetní skupiny majetku (economy_assets_accounting_groups.code).
                "accountingGroup": { "type": ["string", "null"], "minLength": 1, "maxLength": 10 },
                // Jen true; false se v souboru vynechává.
                "foreign":         { "type": "boolean" },
                // Identifikace vlastníka cizího majetku — osoba je v persons/.
                "owner": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "properties": {
                        "name":      { "type": ["string", "null"] },
                        "country":   { "type": ["string", "null"], "pattern": "^[a-z]{2}$" },
                        "companyId": { "type": ["string", "null"] },
                        "taxId":     { "type": ["string", "null"] },
                        "vatId":     { "type": ["string", "null"] }
                    }
                },
                "acquiredDate":    { "$ref": "#/$defs/dateOrNull" },
                "disposedDate":    { "$ref": "#/$defs/dateOrNull" },
                "price":           { "type": ["number", "null"], "minimum": 0 },
                "taxMethod":       { "type": ["string", "null"], "maxLength": 16 },
                "taxRule":         { "type": ["string", "null"], "maxLength": 24 },
                "accMethod":       { "enum": ["as_tax", "time", null] },
                "accMonths":       { "type": ["integer", "null"], "minimum": 1 },
                // draft = Koncept (jen s ručně zadaným číslem), confirmed = V pořádku
                // (i V opravě), archived = vyřazeno (dlouhodobou kartu tam přesune
                // až potvrzené vyřazení, D38).
                "state":           { "enum": ["draft", "confirmed", "archived"] }
            }
        },

        // Potvrzené hodnotové události chronologicky (datum, pořadí druhu v rámci dne).
        "events": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "scope", "date", "amount", "origin"],
                "properties": {
                    "kind":            { "enum": ["activation", "opening", "improvement", "reduction", "depreciation", "interruption", "disposal"] },
                    "scope":           { "enum": ["both", "tax", "acc"] },
                    "date":            { "$ref": "#/$defs/date" },
                    "periodBegin":     { "$ref": "#/$defs/dateOrNull" },
                    "periodEnd":       { "$ref": "#/$defs/dateOrNull" },
                    "amount":          { "type": "number", "minimum": 0 },
                    // Jen počáteční stav (D16).
                    "accumulated":     { "type": ["number", "null"], "minimum": 0 },
                    "unitsDone":       { "type": ["integer", "null"], "minimum": 0 },
                    "priceIncreased":  { "type": "boolean" },
                    "originalDate":    { "$ref": "#/$defs/dateOrNull" },
                    "claimUnrecorded": { "type": "boolean" },
                    "halfYear":        { "type": "boolean" },
                    "note":            { "type": ["string", "null"], "maxLength": 250 },
                    "origin":          { "enum": ["manual", "import"] }
                }
            }
        }
    },

    "$defs": {
        "date":       { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "dateOrNull": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
    }
}
