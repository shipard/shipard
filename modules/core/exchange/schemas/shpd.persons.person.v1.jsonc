{
    // shpd.persons.person.v1 — canonical exchange format for persons
    // (both companies and natural persons) including sub-collections
    // (addresses, bank accounts, contacts).
    //
    // Full specification: docs/exchange-format-persons.md.
    //
    // Important:
    //   - Polymorphism by `personType` is NOT enforced in the schema.
    //     Type-specific rules (fullName required for company, firstName +
    //     lastName required for person, personal block only for person)
    //     are enforced by PHP PersonValidator. Schema permits the broad
    //     structural shape.
    //   - `additionalProperties` is false on top-level and on most objects;
    //     `source.raw` and `_resolve` are the two exceptions (opaque
    //     vendor payload / resolver passthrough — validated by PHP).
    //   - Sub-schemas (Address, BankAccount, Contact) are inlined; we
    //     deliberately skip $ref/definitions in Phase 1 to keep the file
    //     readable. Refactor to shared definitions is a Phase 3 follow-up
    //     when the document spec adopts the same fragments.
    //   - `country` is lowercase ISO 3166-1 alpha-2 in canonical form
    //     ("cz", "sk", …) on both header and address sub-objects.
    //   - `currency` on bank accounts is uppercase ISO 4217 in canonical
    //     ("CZK", "EUR", …); applier lowercases at the DB boundary.

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.persons.person.v1.json",
    "title": "Shipard canonical person v1",
    "type": "object",
    "additionalProperties": false,

    "required": ["format", "formatVersion", "personType", "country"],

    "properties": {
        "format":        { "const": "shpd.persons.person" },
        "formatVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },

        // ── Source / lineage ────────────────────────────────────────────
        "source": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "kind":        { "type": "string" },
                "fetchedAt":   { "type": ["string", "null"], "format": "date-time" },
                "registryRef": { "type": ["string", "null"] },
                "raw": {
                    // Vendor-specific opaque payload (e.g. raw ARES JSON,
                    // raw RPO record). Schema-less by design.
                    "type": ["object", "null"],
                    "additionalProperties": true
                }
            }
        },

        // ── Identification ──────────────────────────────────────────────
        "personType": { "type": "string", "enum": ["company", "person"] },
        "country":    { "type": "string", "pattern": "^[a-z]{2}$" },
        "personId":   { "type": ["string", "null"] },

        "companyId":         { "type": ["string", "null"] },
        "taxId":             { "type": ["string", "null"] },
        "vatId":             { "type": ["string", "null"] },
        "courtRegistration": { "type": ["string", "null"] },
        "govEBoxId":         { "type": ["string", "null"] },

        // ── Name ────────────────────────────────────────────────────────
        // Per-personType validation lives in PHP PersonValidator. Schema
        // accepts the union of fields used by both types.
        "name": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "fullName":    { "type": ["string", "null"] },
                "titleBefore": { "type": ["string", "null"] },
                "firstName":   { "type": ["string", "null"] },
                "middleName":  { "type": ["string", "null"] },
                "lastName":    { "type": ["string", "null"] },
                "titleAfter":  { "type": ["string", "null"] }
            }
        },

        // ── Personal data (relevant only for personType=person) ─────────
        "personal": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "birthDate":    { "type": ["string", "null"], "format": "date" },
                "nationalId":   { "type": ["string", "null"] },
                "idCardNumber": { "type": ["string", "null"] }
            }
        },

        // ── Header contact (propagates to base_persons_persons columns) ─
        "contact": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "email": { "type": ["string", "null"] },
                "phone": { "type": ["string", "null"] },
                "web":   { "type": ["string", "null"] }
            }
        },

        // ── Status ──────────────────────────────────────────────────────
        "status": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "isClosed":   { "type": ["boolean", "null"] },
                "closedDate": { "type": ["string", "null"], "format": "date" },
                "isOwn":      { "type": ["boolean", "null"] },
                "docState":   { "type": ["integer", "null"], "enum": [null, 10, 40, 70, 80, 90] }
            }
        },

        // ── Documents (formatVersion 1.1, #94) ──────────────────────────
        // Volby osoby pro dokumenty. Blok CHYBÍ → applier sloupce nemění;
        // blok JE → zapíše obě hodnoty (`language: null` = automaticky
        // podle země). `language` proti jazykům dokumentů validuje PHP.
        "documents": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "language":              { "type": ["string", "null"], "pattern": "^[a-z]{2}$" },
                "sendAttachmentsMerged": { "type": ["boolean", "null"] }
            }
        },

        // ── Sub-collections ─────────────────────────────────────────────
        "addresses": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["addressType"],
                "properties": {
                    "addressType":    { "type": "integer", "enum": [1, 2, 3, 4] },
                    "name":           { "type": ["string", "null"] },
                    "placeRegType":   { "enum": [null, "ICP", "ICZ"] },
                    "placeRegId":     { "type": ["string", "null"] },

                    "isStandardized": { "type": ["boolean", "null"] },

                    "street":            { "type": ["string", "null"] },
                    "houseNumber":       { "type": ["string", "null"] },
                    "orientationNumber": { "type": ["string", "null"] },
                    "city":              { "type": ["string", "null"] },
                    "cityPart":          { "type": ["string", "null"] },
                    "district":          { "type": ["string", "null"] },
                    "zip":               { "type": ["string", "null"] },
                    "country":           { "type": ["string", "null"], "pattern": "^[a-z]{2}$" },
                    "registryCode":      { "type": ["string", "null"] },
                    "divisionCode":      { "type": ["string", "null"] },

                    "latitude":  { "type": ["number", "null"] },
                    "longitude": { "type": ["number", "null"] },
                    "manualGps": { "type": ["boolean", "null"] },

                    "displayLine":  { "type": ["string", "null"] },
                    "displayBlock": { "type": ["string", "null"] },

                    "orderPos":  { "type": ["integer", "null"] },
                    "validFrom": { "type": ["string", "null"], "format": "date" },
                    "validTo":   { "type": ["string", "null"], "format": "date" },
                    "note":      { "type": ["string", "null"] }
                }
            }
        },

        "bankAccounts": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name":          { "type": ["string", "null"] },
                    "accountNumber": { "type": ["string", "null"] },
                    "iban":          { "type": ["string", "null"] },
                    "bic":           { "type": ["string", "null"] },
                    "currency":      { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
                    "source":        { "type": ["integer", "null"] },
                    "orderPos":      { "type": ["integer", "null"] },
                    "validFrom":     { "type": ["string", "null"], "format": "date" },
                    "validTo":       { "type": ["string", "null"], "format": "date" }
                }
            }
        },

        "contacts": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                    "name":      { "type": "string", "minLength": 1 },
                    "role":      { "type": ["string", "null"] },
                    "email":     { "type": ["string", "null"] },
                    "phone":     { "type": ["string", "null"] },
                    "note":      { "type": ["string", "null"] },
                    "orderPos":  { "type": ["integer", "null"] },
                    "validFrom": { "type": ["string", "null"], "format": "date" },
                    "validTo":   { "type": ["string", "null"], "format": "date" }
                }
            }
        },

        // ── Apply options ───────────────────────────────────────────────
        "applyOptions": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
                "mergeStrategy":  { "enum": [null, "createOnly", "updateHeader", "mergeAdd", "fullSync"] },
                // identifiersOnly: skip name fuzzy match (legacy migration — don't merge same-name people).
                "matchStrategy":  { "enum": [null, "identifiersAndName", "identifiersOnly"] },
                "targetDocState": { "enum": [null, 10, 40] },
                "createPersonId": { "type": ["boolean", "null"] },
                "rejectOnIssues": {
                    "type": ["array", "null"],
                    "items": { "enum": ["error", "warning"] }
                }
            }
        },

        // ── Resolve state ───────────────────────────────────────────────
        // Populated by /preview and accepted by /apply. Structure is
        // validated by PHP (PersonResolver), schema lets it pass through.
        "_resolve": {
            "type": ["object", "null"],
            "additionalProperties": true
        }
    }
}
