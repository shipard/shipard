{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.exchangeRates.list.v1.json",
    "title": "Shipard exchange rate list v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "format",
        "listType",
        "homeCurrency",
        "validFrom",
        "rates"
    ],
    "properties": {
        "format": {
            "const": "shpd.exchangeRates.list.v1"
        },
        "listType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"
        },
        "homeCurrency": {
            "$ref": "#/$defs/currency"
        },
        "validFrom": {
            "$ref": "#/$defs/date"
        },
        "validTo": {
            "$ref": "#/$defs/dateOrNull"
        },
        "listNumber": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 20
        },
        "rates": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "currency",
                    "amount",
                    "rate"
                ],
                "properties": {
                    "currency": {
                        "$ref": "#/$defs/currency"
                    },
                    "amount": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "rate": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    }
                }
            }
        }
    },
    "$defs": {
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dateOrNull": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
    }
}
