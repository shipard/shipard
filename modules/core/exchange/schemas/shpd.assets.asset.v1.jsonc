{
    // shpd.assets.asset.v1 — import karty majetku s hodnotovou historií
    // (docs/assets.md D74, D75, D79; §5.7). Jeden request = jedna karta.
    //
    // Důležité:
    //   - `assetNumber` je klíč párování; převezme se beze změny (import
    //     číslo nepřiděluje). Existující karta: hlavička se přepíše a všechny
    //     její události původu `import` se nahradí. Karta s ručními nebo
    //     systémovými událostmi se přeskočí (`skipped`).
    //   - `type`, `accountingGroup` a `owner` jsou NOVÁ id číselníků a Osob
    //     v cílovém zdroji dat — mapu starých na nová drží runner.
    //   - Dlouhodobý majetek: datum pořízení a vyřazení i cena vznikají
    //     z událostí (D13, D38); `acquiredDate`, `disposedDate` a `price`
    //     platí jen pro drobný majetek.
    //   - Události se ukládají s původem `import`, potvrzené, chronologicky
    //     (podle data a pořadí druhů v rámci dne). Validace, které
    //     historická data splnit nemohou, platí pro import volněji
    //     (docs/assets.md §5.7).
    //   - `sourceRef` události se neukládá — slouží jen k identifikaci
    //     řádku ve výpisu chyb.
    //   - Verzi nese přímo `format` (jako shpd.system.user.v1).

    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shipard.cz/schemas/shpd.assets.asset.v1.json",
    "title": "Shipard asset import v1",
    "type": "object",
    "additionalProperties": false,

    "required": ["format", "asset", "events"],

    "properties": {
        "format": { "const": "shpd.assets.asset.v1" },

        "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assetNumber", "name", "category", "tracking", "state"],
            "properties": {
                "assetNumber":     { "type": "string", "minLength": 1, "maxLength": 20, "pattern": "\\S" },
                "name":            { "type": "string", "minLength": 1, "maxLength": 150, "pattern": "\\S" },
                "shortName":       { "type": ["string", "null"], "maxLength": 60 },
                "note":            { "type": ["string", "null"] },
                "type":            { "type": ["integer", "null"], "minimum": 1 },
                "category":        { "enum": ["small", "tangible", "intangible", "nondepreciable"] },
                "tracking":        { "enum": ["single", "set", "quantity"] },
                "accountingGroup": { "type": ["integer", "null"], "minimum": 1 },
                "foreign":         { "type": "boolean" },
                "owner":           { "type": ["integer", "null"], "minimum": 1 },
                "acquiredDate":    { "$ref": "#/$defs/dateOrNull" },
                "disposedDate":    { "$ref": "#/$defs/dateOrNull" },
                "price":           { "type": ["number", "null"], "minimum": 0 },
                "taxMethod":       { "type": ["string", "null"], "maxLength": 16 },
                "taxRule":         { "type": ["string", "null"], "maxLength": 24 },
                "accMethod":       { "enum": ["as_tax", "time", null] },
                "accMonths":       { "type": ["integer", "null"], "minimum": 1 },
                "state":           { "enum": ["confirmed", "archived"] }
            }
        },

        "events": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "scope", "date", "amount"],
                "properties": {
                    "kind":            { "enum": ["activation", "improvement", "reduction", "depreciation", "interruption", "disposal"] },
                    "scope":           { "enum": ["both", "tax", "acc"] },
                    "date":            { "$ref": "#/$defs/date" },
                    "periodBegin":     { "$ref": "#/$defs/dateOrNull" },
                    "periodEnd":       { "$ref": "#/$defs/dateOrNull" },
                    "amount":          { "type": "number", "minimum": 0 },
                    "claimUnrecorded": { "type": "boolean" },
                    "halfYear":        { "type": "boolean" },
                    "priceIncreased":  { "type": "boolean" },
                    "note":            { "type": ["string", "null"], "maxLength": 250 },
                    "sourceRef":       { "type": ["string", "null"], "maxLength": 100 }
                }
            }
        }
    },

    "$defs": {
        "date":       { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "dateOrNull": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
    }
}
