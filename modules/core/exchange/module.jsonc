{
    "id": "core.exchange",
    "name": "Exchange formats",
    "name:cs": "Výměnné formáty",
    "name:en": "Exchange formats",
    "description": "Canonical exchange formats for documents and other entities",
    "description:cs": "Kanonické výměnné formáty pro doklady a další entity",
    "description:en": "Canonical exchange formats for documents and other entities",

    "dependencies": [
        "docs.core",
        "base.persons",
        "economy.items",
        "economy.bank",
        "core.units",
        "world.vat",
        "world.trade",
        "core.mail",
        "core.attachments"
    ],

    "tables": [
        "core_exchange_tag_rules"
    ],

    "config": [
        { "id": "core.exchange.contentTags", "file": "config/contentTags.jsonc" },
        { "id": "core.exchange.tagRuleOrigins", "file": "config/tagRuleOrigins.jsonc" }
    ],

    "documentEventHandlers": [
        {
            // Učení pravidel IČO → obsahový štítek z apply dokladu s LLM
            // štítkem (D22, tasks/content-tag-enrichment.md).
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Core\\Exchange\\Enrich\\ContentTagRuleCaptureHandler",
            "events": ["stateChanged"]
        }
    ],

    "documentClasses": [
        {
            "table": "core_exchange_tag_rules",
            "class": "Shipard\\Module\\Core\\Exchange\\Enrich\\TagRuleDocument"
        }
    ],

    "viewers": [
        {
            // Správa pravidel IČO → štítek v Nastavení (content-tag-ui D28);
            // form JSONC konvencí (forms/core_exchange_tag_rules.jsonc).
            "id": "core.exchange.tagRules",
            "name": "Content tag rules",
            "name:cs": "Pravidla obsahových štítků",
            "name:en": "Content tag rules",
            "icon": "shuffle",
            "table": "core_exchange_tag_rules",
            "class": "Shipard\\Module\\Core\\Exchange\\Enrich\\TagRulesViewer"
        }
    ],

    "settingsItems": [
        { "viewer": "core.exchange.tagRules", "section": "items", "order": 30 }
    ]
}
