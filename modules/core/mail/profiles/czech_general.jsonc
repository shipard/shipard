                                        "applyOptions": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                // Kopie kanonického schematu (ProfileSchemaDriftTest) — 80 je
                                                // parkovací cíl migrace; v mail/AI flow ho odmítá exchange
                                                // validator (target_state_80_requires_import).
                                                "targetDocState": {
                                                    "type": "integer",
                                                    "enum": [
                                                        10,
                                                        40,
                                                        30,
                                                        80
                                                    ]
                                                },
                                                "autoCreateMode": {
                                                    "enum": [
                                                        "strict",
                                                        "safe",
                                                        "liberal"
                                                    ]
                                                },
                                                "numberSeriesCode": {
                                                    "type": "string",
                                                    "minLength": 1,
                                                    "description": "Výběr číselné řady v rámci doc_type (%C = docs_core_number_series.doc_number_code). Bez něj platí stávající chování (první aktivní řada). Neznámý kód = apply selže (number_series_not_found), žádný tichý fallback."
                                                },
                                                "createMissingEntities": {
                                                    "type": "boolean"
                                                },
                                                "rejectOnIssues": {
                                                    "type": "array",
                                                    "items": {
                                                        "enum": [
                                                            "error",
                                                            "warning"
                                                        ]
                                                    }
                                                },
                                                "importNumber": {
                                                    "type": "object",
                                                    "description": "Import mode: force the document's own number + sequence instead of generating from the series counter. Used by legacy migration. When present, DocDocument skips assignDocumentNumber and syncs the counter to GREATEST(last_assigned, sequenceNumber).",
                                                    "properties": {
                                                        "docNumber": {
                                                            "type": "string",
                                                            "minLength": 1,
                                                            "description": "The document's own number to store verbatim in doc_number."
                                                        },
                                                        "sequenceNumber": {
                                                            "type": [
                                                                "integer",
                                                                "null"
                                                            ],
                                                            "minimum": 1,
                                                            "description": "Sequence-in-series, used for counter sync and payment_reference default. Explicit null = number outside the series formula (migrated duplicate-key documents, docNumber suffixed): stored with sequence_number = NULL, counter not synced."
                                                        }
                                                    },
                                                    "required": [
                                                        "docNumber",
                                                        "sequenceNumber"
                                                    ],
                                                    "additionalProperties": false
                                                },
                                                "importOwnBankAccount": {
                                                    "type": [
                                                        "integer",
                                                        "string",
                                                        "null"
                                                    ],
                                                    "minimum": 1,
                                                    "minLength": 1,
                                                    "description": "Import mode: our own bank account (economy_codebooks_bank_accounts) to set on the document — integer id, or string = codebook `code` (datasets; resolved by the applier, unknown code = own_bank_account_not_found). For issued invoices confirmed at state 40+, bank_account is required and cannot be carried by the standard self-party flow; the importer resolves it and passes it here."
                                                }
                                            }
                                        },
