                                                    "kindFields": {
                                                        "type": "object",
                                                        "additionalProperties": false,
                                                        "properties": {
                                                            "counterparty": {
                                                                "type": [
                                                                    "string",
                                                                    "null"
                                                                ]
                                                            },
