                                        },
                                        "docType": {
                                            "enum": [
                                                "contract",
                                                "insurance",
                                                "quotation",
                                                "certificate",
                                                "official"
                                            ]
                                        },
                                        "title": {
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "summary": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
