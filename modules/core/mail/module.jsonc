{
    "id": "core.mail",
    "name": "Mail",
    "name:cs": "Pošta",
    "name:en": "Mail",
    "description": "Incoming and outgoing e-mail messages",
    "description:cs": "Došlá a odchozí pošta",
    "description:en": "Incoming and outgoing e-mail messages",

    "dependencies": [
        "core.system",
        "core.attachments",
        "core.ai",
        "base.persons"
    ],

    "tables": [
        "core_mail_mailboxes",
        "core_mail_incoming_messages",
        "core_mail_message_analyses",
        "core_mail_incoming_idempotency",
        "core_mail_ai_profiles",
        "core_mail_analysis_claims",
        "core_mail_senders",
        "core_mail_outbox",
        "core_mail_outbox_log",
        "core_mail_sender_rules",
        "core_mail_preprocess_rules",
        "core_mail_sent_messages"
    ],

    // ds-reset chrání AI profily — je to konfigurace (vč. admin úprav
    // name/is_default/is_active a lokálně laděného promptu), ne migrovaná
    // data. Backendy chrání analogicky core.ai.
    // Senders jsou konfigurace (transporty per from adresa); outbox a log
    // jsou data — při resetu se mažou. Sender rules (pravidla došlé pošty)
    // jsou rovněž konfigurace, stejně jako pravidla předzpracování.
    "keepOnReset": [
        "core_mail_ai_profiles",
        "core_mail_senders",
        "core_mail_sender_rules",
        "core_mail_preprocess_rules"
    ],

    // core_mail_incoming_messages má viewer core.mail.incoming (Došlá pošta)
    // a zůstává v hlavní navigaci — do settings nepatří.
    // AI backendy se přesunuly do core.ai (i jejich settingsItem + keepOnReset).
    "settingsItems": [
        { "viewer": "core.mail.mailboxes",          "section": "other", "subsection": "other.mail", "order": 10 },
        { "table": "core_mail_message_analyses",    "section": "other", "subsection": "other.mail", "order": 20 },
        { "table": "core_mail_incoming_idempotency","section": "other", "subsection": "other.mail", "order": 30 },
        { "viewer": "core.mail.aiProfiles",         "section": "other", "subsection": "other.mail", "order": 50 },
        { "table": "core_mail_analysis_claims",     "section": "other", "subsection": "other.mail", "order": 60 },
        { "viewer": "core.mail.senders",            "section": "other", "subsection": "other.mail", "order": 70 },
        { "table": "core_mail_outbox",              "section": "other", "subsection": "other.mail", "order": 75 },
        { "table": "core_mail_outbox_log",          "section": "other", "subsection": "other.mail", "order": 80 },
        { "page": "mailOutbound",                   "section": "other", "subsection": "other.mail", "order": 85 },
        { "viewer": "core.mail.senderRules",        "section": "other", "subsection": "other.mail", "order": 90 },
        { "viewer": "core.mail.preprocessRules",    "section": "other", "subsection": "other.mail", "order": 95 }
    ],

    "settingsPages": [
        {
            "id": "mailOutbound",
            "name": "Outbound mail",
            "name:cs": "Odchozí pošta",
            "name:en": "Outbound mail",
            "icon": "mail-out",
            "fields": [
                {
                    "id": "mail.defaultFrom",
                    "type": "text",
                    "name": "Default from address",
                    "name:cs": "Výchozí adresa odesílatele",
                    "name:en": "Default from address",
                    "hint": "Used when the caller does not specify a from address.",
                    "hint:cs": "Použije se, když volající neurčí adresu odesílatele.",
                    "hint:en": "Used when the caller does not specify a from address.",
                    "maxLength": 200
                }
            ]
        }
    ],

    "viewers": [
        {
            "id": "core.mail.incoming",
            "name": "Incoming messages",
            "name:cs": "Došlá pošta",
            "name:en": "Incoming messages",
            "icon": "mail",
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\IncomingMessagesViewer",
            "navSection": "_top",
            "navOrder": 30
        },
        // Odeslaná pošta (#90 D45) — hned za došlou; sekce „Pošta“ v hlavní
        // navigaci není, obě agendy jsou root-level položky.
        {
            "id": "core.mail.sent",
            "name": "Sent messages",
            "name:cs": "Odeslaná pošta",
            "name:en": "Sent messages",
            "icon": "mail-out",
            "table": "core_mail_sent_messages",
            "class": "Shipard\\Module\\Core\\Mail\\Sent\\SentMessagesViewer",
            "navSection": "_top",
            "navOrder": 35
        },
        {
            "id": "core.mail.mailboxes",
            "name": "Mailboxes",
            "name:cs": "Schránky",
            "name:en": "Mailboxes",
            "icon": "inbox",
            "table": "core_mail_mailboxes",
            "class": "Shipard\\Module\\Core\\Mail\\MailboxesViewer"
        },
        {
            "id": "core.mail.senders",
            "name": "Mail senders",
            "name:cs": "Odesílatelé pošty",
            "name:en": "Mail senders",
            "icon": "address-book",
            "table": "core_mail_senders",
            "class": "Shipard\\Module\\Core\\Mail\\SendersViewer"
        },
        {
            "id": "core.mail.aiProfiles",
            "name": "AI profiles",
            "name:cs": "AI profily",
            "name:en": "AI profiles",
            "icon": "robot",
            "table": "core_mail_ai_profiles",
            "class": "Shipard\\Module\\Core\\Mail\\AIProfilesViewer"
        },
        {
            "id": "core.mail.senderRules",
            "name": "Sender rules",
            "name:cs": "Pravidla odesílatelů",
            "name:en": "Sender rules",
            "icon": "filter",
            "table": "core_mail_sender_rules",
            "class": "Shipard\\Module\\Core\\Mail\\SenderRulesViewer"
        },
        {
            "id": "core.mail.preprocessRules",
            "name": "Preprocess rules",
            "name:cs": "Pravidla předzpracování",
            "name:en": "Preprocess rules",
            "icon": "magic",
            "table": "core_mail_preprocess_rules",
            "class": "Shipard\\Module\\Core\\Mail\\Preprocess\\PreprocessRulesViewer"
        }
    ],

    "forms": [
        {
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\IncomingMessagesForm"
        },
        {
            "table": "core_mail_sent_messages",
            "class": "Shipard\\Module\\Core\\Mail\\Sent\\SentMessagesForm"
        }
    ],
    // core_mail_preprocess_rules: JSONC form forms/core_mail_preprocess_rules.jsonc

    "documentClasses": [
        {
            "table": "core_mail_mailboxes",
            "class": "Shipard\\Module\\Core\\Mail\\MailboxDocument"
        },
        {
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\IncomingMessageDocument"
        },
        {
            "table": "core_mail_ai_profiles",
            "class": "Shipard\\Module\\Core\\Mail\\AIProfileDocument"
        },
        {
            "table": "core_mail_sender_rules",
            "class": "Shipard\\Module\\Core\\Mail\\SenderRuleDocument"
        },
        {
            "table": "core_mail_preprocess_rules",
            "class": "Shipard\\Module\\Core\\Mail\\Preprocess\\PreprocessRuleDocument"
        },
        {
            "table": "core_mail_sent_messages",
            "class": "Shipard\\Module\\Core\\Mail\\Sent\\SentMessageDocument"
        }
    ],

    // Přílohy odeslané zprávy jsou součást jejího pevného obsahu (#90 D41).
    "attachmentGuards": [
        {
            "table": "core_mail_sent_messages",
            "class": "Shipard\\Module\\Core\\Mail\\Sent\\SentMessageAttachmentGuard"
        }
    ],

    "alertChecks": [
        {
            "id": "core.mail.outbox_health",
            "name": "Outbound mail queue health",
            "name:cs": "Zdraví fronty odchozí pošty",
            "name:en": "Outbound mail queue health",
            "description": "Failed outbound messages in the last 24 h and stuck pending messages (worker or relay down).",
            "description:cs": "Selhané odchozí zprávy za posledních 24 h a zaseklé pending zprávy (worker nebo relay leží).",
            "description:en": "Failed outbound messages in the last 24 h and stuck pending messages (worker or relay down).",
            "class": "Shipard\\Core\\Mail\\MailOutboxAlertCheck",
            "severity": "warning",
            "interval": "15m",
            "navSection": "_top",
            "tags": ["mail"]
        }
    ],

    "documentEventHandlers": [
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Core\\Mail\\SupplierCodeCaptureHandler",
            "events": ["stateChanged"]
        },
        {
            "table": "core_mail_incoming_messages",
            "class": "Shipard\\Module\\Core\\Mail\\SenderRuleSuggestionHandler",
            "events": ["stateChanged"]
        }
    ],

    "config": [
        {
            "id": "core.mail.primaryTypes",
            "file": "config/primaryTypes.jsonc"
        },
        {
            "id": "core.mail.docStatesIncoming",
            "file": "config/docStatesIncoming.jsonc"
        },
        {
            "id": "core.mail.analysisStates",
            "file": "config/analysisStates.jsonc"
        },
        {
            "id": "core.mail.analysisErrorKinds",
            "file": "config/analysisErrorKinds.jsonc"
        },
        {
            "id": "core.mail.feedTexts",
            "file": "config/feedTexts.jsonc"
        },
        {
            "id": "core.mail.primaryTypeSources",
            "file": "config/primaryTypeSources.jsonc"
        },
        {
            "id": "core.mail.analysisResolutions",
            "file": "config/analysisResolutions.jsonc"
        },
        {
            "id": "core.mail.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        },
        {
            "id": "core.mail.viewerDefaults",
            "file": "config/viewerDefaults.jsonc"
        },
        {
            "id": "core.mail.senderRulePatternKinds",
            "file": "config/senderRulePatternKinds.jsonc"
        },
        {
            "id": "core.mail.senderRuleDispositions",
            "file": "config/senderRuleDispositions.jsonc"
        },
        {
            "id": "core.mail.senderRuleOrigins",
            "file": "config/senderRuleOrigins.jsonc"
        },
        {
            "id": "core.mail.preprocessStates",
            "file": "config/preprocessStates.jsonc"
        },
        {
            "id": "core.mail.preprocessActions",
            "file": "config/preprocessActions.jsonc"
        },
        {
            "id": "core.mail.preprocessRuleOrigins",
            "file": "config/preprocessRuleOrigins.jsonc"
        },
        {
            "id": "core.mail.preprocessErrorKinds",
            "file": "config/preprocessErrorKinds.jsonc"
        },
        {
            "id": "core.mail.genericSubjectPatterns",
            "file": "config/genericSubjectPatterns.jsonc"
        },
        {
            "id": "core.mail.sendLabels",
            "file": "config/sendLabels.jsonc"
        },
        {
            "id": "core.mail.docStatesSent",
            "file": "config/docStatesSent.jsonc"
        },
        {
            "id": "core.mail.transportStates",
            "file": "config/transportStates.jsonc"
        },
        {
            "id": "core.mail.sendTriggers",
            "file": "config/sendTriggers.jsonc"
        },
        {
            "id": "core.mail.sentChannels",
            "file": "config/sentChannels.jsonc"
        },
        {
            "id": "core.mail.safetyActions",
            "file": "config/safetyActions.jsonc"
        }
    ]
}
