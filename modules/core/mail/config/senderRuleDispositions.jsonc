{
    // core.mail.senderRuleDispositions
    //
    // Co pravidlo se zprávou udělá (core_mail_sender_rules.disposition).
    // Dispozice určuje fázi, ve které pravidlo zasahuje
    // (tasks/mail-sender-rules-after-analysis.md D3, D6):
    //
    //   - archiveIfOther — po analýze: archivuje, jen když AI ve zprávě
    //     nenašla doklad ani dokument Spisovny (primary_type `other`).
    //     Bezpečný výchozí stav pro smíšené odesílatele (D9).
    //   - archive — před analýzou: zpráva vznikne rovnou v Archivu,
    //     AI ji nečte. Po analýze a při potvrzení pravidla archivuje
    //     ostatní poštu také („všechno“ zahrnuje i ostatní).

    "archiveIfOther": {
        "name": "Archive when it contains no document",
        "name:cs": "Archivovat, když neobsahuje doklad ani dokument",
        "name:en": "Archive when it contains no document",
        "order": 10
    },
    "archive": {
        "name": "Archive immediately, without analysis",
        "name:cs": "Archivovat hned, bez analýzy",
        "name:en": "Archive immediately, without analysis",
        "order": 20
    }
}
