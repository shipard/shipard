{
    // core.mail.viewerDetailLabels
    //
    // Detail labels for IncomingMessagesViewer. No shared "overview" —
    // tabs are Content / Analyses / Proposal / Original. The `attachments`
    // key is not a tab anymore — it labels the attachments section heading
    // inside the Content tab.

    "tabs": {
        "content": {
            "name": "Content",
            "name:cs": "Obsah",
            "name:en": "Content"
        },
        "attachments": {
            "name": "Attachments",
            "name:cs": "Přílohy",
            "name:en": "Attachments"
        },
        "analyses": {
            "name": "Analyses",
            "name:cs": "Analýzy",
            "name:en": "Analyses"
        },
        "proposal": {
            "name": "Proposal",
            "name:cs": "Návrh",
            "name:en": "Proposal"
        },
        "original": {
            "name": "Original",
            "name:cs": "Originál",
            "name:en": "Original"
        }
    },

    // Drobné popisky řádku / hlavičky detailu.
    "labels": {
        // „od: odesílatel" v t3 a v subtitle detailu, když t2 nese partnera.
        "from": {
            "name": "from",
            "name:cs": "od",
            "name:en": "from"
        },
        // Původní předmět v Technických údajích, když hlavička ukazuje
        // titulek z AI (IncomingMessageTitle, D3).
        "subject": {
            "name": "Subject",
            "name:cs": "Předmět",
            "name:en": "Subject"
        }
    },

    // Texty detailu (#137 D30) — čte `TableViewer::detailText()`.
    "texts": {
        // Tab Obsah bez těla, příloh i technických údajů.
        "noContent": {
            "name": "The message has no content.",
            "name:cs": "Zpráva nemá žádný obsah.",
            "name:en": "The message has no content."
        },
        // Tab Analýzy bez záznamu.
        "noAnalyses": {
            "name": "No AI analysis for this message yet.",
            "name:cs": "Pro tuto zprávu zatím neexistuje žádná AI analýza.",
            "name:en": "No AI analysis for this message yet."
        },
        // Tab Originál u zprávy bez uloženého zdroje.
        "originalMissing": {
            "name": "The original .eml is not available (message entered manually).",
            "name:cs": "Originální .eml není k dispozici (zpráva pořízena ručně).",
            "name:en": "The original .eml is not available (message entered manually)."
        },
        // Tab Originál, když příloha se zdrojem chybí.
        "originalDeleted": {
            "name": "The original was deleted or is not available.",
            "name:cs": "Originál byl smazán nebo není dostupný.",
            "name:en": "The original was deleted or is not available."
        }
    }
}
