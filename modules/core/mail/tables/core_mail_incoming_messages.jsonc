{
    "tableId": 303,
    "name": "Incoming messages",
    "name:cs": "Došlé zprávy",
    "name:en": "Incoming messages",

    "displayPattern": "{message_id} — {subject}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.mail.docStatesIncoming"
    },

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "headers",
            "name": "Headers",
            "name:cs": "Hlavičky",
            "name:en": "Headers"
        },
        {
            "id": "partner",
            "name": "Partner",
            "name:cs": "Partner",
            "name:en": "Partner"
        },
        {
            "id": "body",
            "name": "Body",
            "name:cs": "Tělo zprávy",
            "name:en": "Body"
        },
        {
            "id": "routing",
            "name": "Routing",
            "name:cs": "Směrování",
            "name:en": "Routing"
        },
        {
            "id": "source",
            "name": "Source",
            "name:cs": "Zdroj",
            "name:en": "Source"
        },
        {
            "id": "ai",
            "name": "AI analysis",
            "name:cs": "AI analýza",
            "name:en": "AI analysis"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "message_id",
            "name": "Message code",
            "name:cs": "Kód zprávy",
            "name:en": "Message code",
            "type": "varchar",
            "length": 30,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "mailbox",
            "name": "Mailbox",
            "name:cs": "Schránka",
            "name:en": "Mailbox",
            "type": "int",
            "nullable": false,
            "reference": "core_mail_mailboxes",
            "group": "identity"
        },
        {
            "id": "primary_type",
            "name": "Primary type",
            "name:cs": "Primární typ",
            "name:en": "Primary type",
            "type": "enumString",
            "length": 30,
            "nullable": false,
            "cfgItem": "core.mail.primaryTypes",
            "default": "other",
            "group": "identity"
        },
        {
            // Kdo naposledy určil primary_type: mailbox (default schránky /
            // mail-router), user (ruční změna ve formuláři), ai (klasifikace
            // z analýzy). AI nikdy nepřepisuje hodnotu nastavenou uživatelem.
            "id": "primary_type_source",
            "name": "Primary type source",
            "name:cs": "Zdroj primárního typu",
            "name:en": "Primary type source",
            "type": "enumString",
            "length": 10,
            "nullable": false,
            "cfgItem": "core.mail.primaryTypeSources",
            "default": "mailbox",
            "group": "identity"
        },

        // --- headers (RFC822 hlavičky) ---

        {
            "id": "subject",
            "name": "Subject",
            "name:cs": "Předmět",
            "name:en": "Subject",
            "type": "text",
            "nullable": false,
            "group": "headers"
        },
        {
            "id": "sender_email",
            "name": "Sender e-mail",
            "name:cs": "E-mail odesílatele",
            "name:en": "Sender e-mail",
            "type": "varchar",
            "length": 200,
            "nullable": false,
            "group": "headers"
        },
        {
            "id": "sender_name",
            "name": "Sender name",
            "name:cs": "Jméno odesílatele",
            "name:en": "Sender name",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "headers"
        },
        {
            "id": "sender_person",
            "name": "Sender person",
            "name:cs": "Odesílatel (osoba)",
            "name:en": "Sender person",
            "type": "int",
            "nullable": true,
            "reference": "base_persons_persons",
            "group": "headers"
        },
        {
            "id": "received_at",
            "name": "Received at",
            "name:cs": "Datum doručení",
            "name:en": "Received at",
            "type": "datetime",
            "nullable": false,
            "group": "headers"
        },
        {
            "id": "external_message_id",
            "name": "External Message-ID",
            "name:cs": "RFC822 Message-ID",
            "name:en": "External Message-ID",
            "type": "varchar",
            "length": 255,
            "nullable": true,
            "group": "headers"
        },
        {
            "id": "in_reply_to",
            "name": "In-Reply-To",
            "name:cs": "In-Reply-To",
            "name:en": "In-Reply-To",
            "type": "varchar",
            "length": 255,
            "nullable": true,
            "group": "headers"
        },
        {
            "id": "reply_references",
            "name": "References header",
            "name:cs": "Hlavička References",
            "name:en": "References header",
            "type": "text",
            "nullable": true,
            "group": "headers"
        },
        {
            // Signál z hlaviček .eml (List-Unsubscribe, Precedence,
            // Auto-Submitted, List-Id) — sám o sobě nikdy nearchivuje (D7).
            "id": "is_bulk",
            "name": "Bulk mail",
            "name:cs": "Hromadná pošta",
            "name:en": "Bulk mail",
            "type": "tinyint",
            "default": 0,
            "nullable": false,
            "group": "headers"
        },

        // --- partner (protistrana dokumentu, ne odesílatel) ---
        // tasks/mail-message-title-partner.md D4/D5/D8

        {
            // Osoba, která doklad/dokument vystavila. Vrstva 1 (/result, ISDOC)
            // zapisuje jen do NULL a jen dokud target_row IS NULL; vrstva 2
            // (Použít) přepisuje partnerem založeného záznamu. Ručně editovatelné.
            "id": "partner_person",
            "name": "Partner (person)",
            "name:cs": "Partner (osoba)",
            "name:en": "Partner (person)",
            "type": "int",
            "nullable": true,
            "reference": "base_persons_persons",
            "group": "partner"
        },
        {
            // Jméno protistrany z canonicalu (supplier.name / party.name) —
            // denormalizace pro fulltext a pro partnery mimo Osoby. Historický
            // snapshot toho, co bylo na dokladu; po Použít se nepřepisuje.
            "id": "partner_name",
            "name": "Partner name",
            "name:cs": "Partner (název)",
            "name:en": "Partner name",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "partner"
        },

        // --- body ---

        {
            "id": "body_plain",
            "name": "Body (plain text)",
            "name:cs": "Tělo (prostý text)",
            "name:en": "Body (plain text)",
            "type": "longtext",
            "nullable": true,
            "group": "body"
        },
        {
            "id": "body_html",
            "name": "Body (HTML)",
            "name:cs": "Tělo (HTML)",
            "name:en": "Body (HTML)",
            "type": "longtext",
            "nullable": true,
            "group": "body"
        },
        {
            "id": "raw_source_attachment",
            "name": "Raw source (.eml)",
            "name:cs": "Originál (.eml)",
            "name:en": "Raw source (.eml)",
            "type": "int",
            "nullable": true,
            "reference": "core_attachments_files",
            "group": "body"
        },

        // --- routing / target ---

        {
            "id": "target_table_id",
            "name": "Target table",
            "name:cs": "Cílová tabulka",
            "name:en": "Target table",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "routing"
        },
        {
            "id": "target_row",
            "name": "Target record",
            "name:cs": "Cílový záznam",
            "name:en": "Target record",
            "type": "int",
            "nullable": true,
            "group": "routing"
        },

        // --- source ---

        {
            "id": "source_type",
            "name": "Source",
            "name:cs": "Zdroj",
            "name:en": "Source",
            "type": "tinyint",
            "default": 1,
            "nullable": false,
            "group": "source"
        },

        // --- AI analysis ---

        {
            // Pipeline status AI analýzy — ortogonální k docState (workflow).
            // Přežívá Koš i Archiv. Viz config/analysisStates.jsonc.
            "id": "analysis_state",
            "name": "Analysis state",
            "name:cs": "Stav analýzy",
            "name:en": "Analysis state",
            "type": "enumInt",
            "nullable": false,
            "cfgItem": "core.mail.analysisStates",
            "default": 0,
            "group": "ai"
        },
        {
            "id": "ai_analysis_enabled",
            "name": "AI analysis enabled",
            "name:cs": "AI analýza povolena",
            "name:en": "AI analysis enabled",
            "type": "boolean",
            "nullable": true,
            "group": "ai"
        },
        {
            "id": "needs_reanalysis",
            "name": "Needs re-analysis",
            "name:cs": "Vyžaduje znovu-analýzu",
            "name:en": "Needs re-analysis",
            "type": "boolean",
            "nullable": false,
            "default": false,
            "group": "ai"
        },
        {
            "id": "profile_override",
            "name": "Profile override",
            "name:cs": "Override profilu",
            "name:en": "Profile override",
            "type": "int",
            "nullable": true,
            "reference": "core_mail_ai_profiles",
            "group": "ai"
        },
        {
            // Titulek zprávy z AI (message_classification.title) nebo serverový
            // fallback z canonicalu (MessageTitleComposer). AI-vlastněný:
            // přepisuje každý úspěšný běh analýzy (i na NULL), uživatel ho
            // needituje. Zobrazuje se místo `subject` jen u generického nebo
            // prázdného předmětu a u ručních zpráv (IncomingMessageTitle, D3).
            "id": "ai_title",
            "name": "AI title",
            "name:cs": "Titulek (AI)",
            "name:en": "AI title",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "ai"
        },
        {
            // Pozornost u zprávy bez dokladu (tasks/mail-other-attention.md
            // D1, D3, #105): AI u primary_type `other` rozliší, zda zpráva
            // vyžaduje akci (`action`), jen informuje (`info`), nebo je to
            // obchodní sdělení (`promo`). Zapisuje /result jen u typu `other`;
            // u dokladu a dokumentu Spisovny NULL. NULL = neurčeno (starší
            // analýza). Uživatel pole needituje — reaguje archivací.
            "id": "attention",
            "name": "Attention",
            "name:cs": "Pozornost",
            "name:en": "Attention",
            "type": "enumString",
            "length": 10,
            "nullable": true,
            "cfgItem": "core.mail.attentionKinds",
            "group": "ai"
        },
        {
            // Co má člověk udělat — jedna věta od AI (jazyk AI profilu jako
            // ai_title), jen u attention = action; jinak NULL.
            "id": "action_note",
            "name": "Action note",
            "name:cs": "Co udělat",
            "name:en": "Action note",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "ai"
        },
        {
            // Lhůta z message_classification.due_date — jen když je ve zprávě
            // výslovně uvedená (model ji neodhaduje), jen u action; jinak NULL.
            "id": "action_due",
            "name": "Action due",
            "name:cs": "Lhůta",
            "name:en": "Action due",
            "type": "date",
            "nullable": true,
            "group": "ai"
        },

        // --- technické předzpracování (tasks/mail-preprocess.md) ---

        {
            // Stav předzpracování — ortogonální k docState i analysis_state.
            // 10/20 drží zprávu mimo AI frontu (gate v /queue).
            // Viz config/preprocessStates.jsonc.
            "id": "preprocess_state",
            "name": "Preprocess state",
            "name:cs": "Stav předzpracování",
            "name:en": "Preprocess state",
            "type": "enumInt",
            "nullable": false,
            "cfgItem": "core.mail.preprocessStates",
            "default": 0,
            "group": "ai"
        },
        {
            // JSON {plan: [{ruleId, actions}], results: [{action, ok, note,
            // attachmentId?}], attempts, createdAt, startedAt, finishedAt}.
            "id": "preprocess_log",
            "name": "Preprocess log",
            "name:cs": "Log předzpracování",
            "name:en": "Preprocess log",
            "type": "longtext",
            "nullable": true,
            "group": "ai"
        },

        // --- audit ---

        {
            "id": "created",
            "name": "Created",
            "name:cs": "Vytvořeno",
            "name:en": "Created",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },
        {
            "id": "created_by",
            "name": "Created by",
            "name:cs": "Vytvořil",
            "name:en": "Created by",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "status"
        },
        {
            "id": "modified",
            "name": "Modified",
            "name:cs": "Změněno",
            "name:en": "Modified",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },

        // --- auto-archiv (pre-triage dle pravidel odesílatelů) ---

        {
            "id": "auto_disposed_by",
            "name": "Auto-disposed by rule",
            "name:cs": "Auto-archivováno pravidlem",
            "name:en": "Auto-disposed by rule",
            "type": "int",
            "nullable": true,
            "reference": "core_mail_sender_rules",
            "group": "status"
        },
        {
            "id": "auto_disposed_at",
            "name": "Auto-disposed at",
            "name:cs": "Čas auto-archivace",
            "name:en": "Auto-disposed at",
            "type": "datetime",
            "nullable": true,
            "group": "status"
        },

        // --- doc state (systémové) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 1,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_message_id",
            "type": "unique",
            "columns": [
                {"column": "message_id"}
            ]
        },
        {
            "id": "idx_mailbox",
            "type": "index",
            "columns": [
                {"column": "mailbox"}
            ]
        },
        {
            "id": "idx_received_at",
            "type": "index",
            "columns": [
                {"column": "received_at", "order": "DESC"}
            ]
        },
        {
            "id": "idx_external_message_id",
            "type": "index",
            "columns": [
                {"column": "external_message_id"}
            ]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"},
                {"column": "received_at", "order": "DESC"}
            ]
        },
        {
            // Fronta analyzeru: analysis_state = 10 ORDER BY received_at ASC
            "id": "idx_analysis_state",
            "type": "index",
            "columns": [
                {"column": "analysis_state", "order": "ASC"},
                {"column": "received_at", "order": "ASC"}
            ]
        },
        {
            "id": "idx_target",
            "type": "index",
            "columns": [
                {"column": "target_table_id"},
                {"column": "target_row"}
            ]
        },
        {
            "id": "idx_sender_email",
            "type": "index",
            "columns": [
                {"column": "sender_email"}
            ]
        },
        {
            "id": "idx_sender_person",
            "type": "index",
            "columns": [
                {"column": "sender_person"}
            ]
        },
        {
            "id": "idx_partner_person",
            "type": "index",
            "columns": [
                {"column": "partner_person"}
            ]
        },
        {
            // Digest karta a "Vrátit vše": zprávy auto-archivované v daném dni
            "id": "idx_auto_disposed",
            "type": "index",
            "columns": [
                {"column": "auto_disposed_at"}
            ]
        },
        {
            // Rescue sweep runneru: state IN (10, 20) AND modified < threshold
            "id": "idx_preprocess_state",
            "type": "index",
            "columns": [
                {"column": "preprocess_state"},
                {"column": "modified"}
            ]
        }
    ]
}
