{
  "id": "services.locAddr.addrPlaces", "sql": "services_locAddr_addrPlaces", "name": "Adresní místa",
  "columns": [
    {"id": "ndx", "name": "id", "type": "int_ai"},
    {"id": "country", "name": "Země", "type": "int", "reference": "e10.world.countries"},
    {"id": "addrPlaceId", "name": "Kód", "type": "int"},

		{"id": "houseNr1Type", "name": "Typ čísla domu", "type": "enumInt",
			"enumValues": {"0": "Číslo popisné", "1": "Číslo evidenční"}},

    {"id": "houseNr1", "name": "Číslo domu", "type": "short"},
    {"id": "houseNr2", "name": "Číslo orientační", "type": "short"},
    {"id": "houseNrLetter", "name": "Číslo orientační - písmeno", "type": "string", "len": 3},
    {"id": "houseNr", "name": "Číslo domovní", "type": "string", "len": 20},

    {"id": "street", "name": "Ulice", "type": "int", "reference": "services.locAddr.streets"},
    {"id": "cityPart", "name": "Část obce", "type": "int", "reference": "services.locAddr.citiesParts"},
    {"id": "city", "name": "Obec", "type": "int", "reference": "services.locAddr.cities"},
    {"id": "zipCode", "name": "PSČ", "type": "int", "reference": "services.locAddr.zipCodes"},

    {"id": "natGeoCoordX", "name": "Národní geosouřadnice X", "type": "number", "dec": 2},
    {"id": "natGeoCoordY", "name": "Národní geosouřadnice Y", "type": "number", "dec": 2},
	  {"id": "wgs84lat", "name": "Zeměpisná šířka", "type": "number", "dec": 9},
	  {"id": "wgs84lng", "name": "Zeměpisná délka", "type": "number", "dec": 9},

		{"id": "validFrom", "name": "Platné od", "type": "date"},
		{"id": "validTo", "name": "Platné do", "type": "date"}
  ],
  "views": {
		"default": {
			"id": "default", "class": "services.locAddr.ViewAddrPlaces",
			"details": {
        "changes": {"title": "Detail", "icon": "system/detailDetail", "type": "detail", "order":  100, "class": "services.locAddr.ViewDetailAddrPlace"}
			}
		}
	},
	"forms": [
		{"id": "default", "class": "services.locAddr.FormAddrPlace"}
	],
	"indexes": [
		{"id": "s1", "columns": ["country", "addrPlaceId"]},
    {"id": "s2", "columns": ["houseNr1"]},
    {"id": "s2", "columns": ["street"]},
    {"id": "s3", "columns": ["cityPart"]},
    {"id": "s4", "columns": ["city"]}
	]
}
