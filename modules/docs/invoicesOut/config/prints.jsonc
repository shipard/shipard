// Tisky faktury vydané (#90). Builder, layout a dílčí bloky šablony jsou
// sdílené v docs.core; tady je deklarace a tenká stránková šablona.
[
    {
        "id": "docs.invoicesOut.invoice",
        "name": "Invoice",
        "name:cs": "Faktura",
        "name:en": "Invoice",
        "table": "docs_core_heads",
        "filter": { "doc_type": ["invno"] },
        // Stornovaný doklad se tiskne s vodoznakem přes každou stranu.
        "docStates": [40, 30],
        "watermarks": { "30": "watermark.cancelled" },
        "audience": "external",
        // Odeslání e-mailem (#90 D34): komu (kontakty partnera s tímto
        // účelem, jinak e-mail osoby) určuje účel a sloupec s osobou.
        "sendPurpose": "invoices",
        "recipientPerson": "partner",
        // Sloty textů na tiscích (#90 D48), které layout dokladu vykreslí;
        // e-mailové přepisují výchozí předmět a tělo.
        "textSlots": ["header", "beforeRows", "afterRows", "footer", "emailSubject", "emailBody"],
        "builder": "Shipard\\Module\\Docs\\Core\\Prints\\DocPrintBuilder",
        "template": "@docs.invoicesOut/invoice",
        "catalogs": ["@docs.core/_layout"],
        // Horní a dolní okraj nechávají místo záhlaví (logo, titulek) a zápatí.
        "paper": {
            "format": "A4",
            "orientation": "portrait",
            "margins": { "top": "3.2cm", "bottom": "2cm" }
        },
        "order": 10
    }
]
