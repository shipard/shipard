// Tisk prodejky (#90 D26) — A4, tisk ven. Builder, layout a dílčí bloky
// šablony jsou sdílené v docs.core; tady je deklarace a stránková šablona.
// Účtenka pro účtenkovou tiskárnu je druhý tisk nad stejnými daty (D3, #177).
[
    {
        "id": "docs.cashRegister.receipt",
        "name": "Sales receipt",
        "name:cs": "Prodejka",
        "name:en": "Sales receipt",
        "table": "docs_core_heads",
        "filter": { "doc_type": ["cashreg"] },
        // Stornovaný doklad se tiskne s vodoznakem přes každou stranu.
        "docStates": [40, 30],
        "watermarks": { "30": "watermark.cancelled" },
        "audience": "external",
        // Odeslání e-mailem (#90 D34): komu (kontakty partnera s tímto
        // účelem, jinak e-mail osoby) určuje účel a sloupec s osobou.
        "sendPurpose": "invoices",
        "recipientPerson": "partner",
        // Sloty textů na tiscích (#90 D48), které layout dokladu vykreslí;
        // e-mailové přepisují výchozí předmět a tělo.
        "textSlots": ["header", "beforeRows", "afterRows", "footer", "emailSubject", "emailBody"],
        // Proměnné, které formulář textu nabídne (D51) — sdílená sada dokladů.
        "textVariables": ["@docs.core/_layout"],
        "builder": "Shipard\\Module\\Docs\\Core\\Prints\\CashRegisterPrintBuilder",
        "template": "@docs.cashRegister/receipt",
        "catalogs": ["@docs.core/_layout"],
        // Horní a dolní okraj nechávají místo záhlaví (logo, titulek) a zápatí.
        "paper": {
            "format": "A4",
            "orientation": "portrait",
            "margins": { "top": "3.2cm", "bottom": "2cm" }
        },
        "order": 10
    },
    // Účtenka prodejky pro účtenkovou tiskárnu (#177 D26, U34): stejný
    // builder a stejná data jako A4 prodejka, jiná šablona — značky účtenky,
    // ze kterých EscPosRenderer složí bajty ESC/POS podle profilu tiskárny.
    // Na tiskárnu jde tiskovou úlohou; akce Tisk v detailu ji nenabízí.
    {
        "id": "docs.cashRegister.receiptPos",
        "name": "Receipt",
        "name:cs": "Účtenka",
        "name:en": "Receipt",
        "table": "docs_core_heads",
        "filter": { "doc_type": ["cashreg"] },
        // Stornovaná prodejka nese text vodoznaku jako výrazný řádek nahoře.
        "docStates": [40, 30],
        "watermarks": { "30": "watermark.cancelled" },
        "audience": "external",
        // Tisk `escpos` nemá papír, odesílání ani texty na tiscích.
        "output": "escpos",
        "builder": "Shipard\\Module\\Docs\\Core\\Prints\\CashRegisterPrintBuilder",
        "template": "@docs.cashRegister/receiptPos",
        // Titulky podle varianty překládá builder — jsou v katalogu A4 prodejky.
        "catalogs": ["@docs.core/_layout", "@docs.cashRegister/receipt"],
        "order": 20
    }
]
