    "message.qrSkipped.specificSymbol": {
        "cs": "QR platba neobsahuje specifický symbol — smí mít jen číslice, nejvýš 10.",
        "en": "The payment QR code carries no specific symbol — only digits are allowed, 10 at most."
    },
    "message.qrSkipped.constantSymbol": {
        "cs": "QR platba neobsahuje konstantní symbol — smí mít jen číslice, nejvýš 10.",
        "en": "The payment QR code carries no constant symbol — only digits are allowed, 10 at most."
