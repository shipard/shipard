{
    // docs.core.rowOperations
    //
    // Pohyby řádků dokladů. Klíč = stabilní stringový identifikátor.
    // docTypes: pro které typy dokladů je pohyb povolený; order určuje
    // pořadí v nabídce UI (vzestupně, první = default pro nový řádek).
    //   cashDir: 1 | 2  — jen u typu se směrem per doklad (cash): pohyb je
    //                     povolený jen při daném cash_dir hlavičky (1 příjem,
    //                     2 výdej). Chybí = povolený pro oba směry. Nabídka
    //                     ve formuláři i tvrdá validace (DocRowOperationRules)
    //                     filtrují podle něj; default nového řádku = nejnižší
    //                     order pro daný směr.
    //
    // Vlajky per-řádkové identity (čte je AccountingEngine ve Fázi 2):
    //   rowPartner: 1   — řádek nese vlastního partnera (engine ho razítkuje
    //                     z řádku místo z hlavičky; formulář ukáže input).
    //   rowPaymentId: 1 — řádek nese vlastní platební identitu
    //                     (payment_reference / specific_symbol /
    //                     constant_symbol / due_date), jinak z hlavičky.
    //   identityRequired: 1 — partner řádku a payment_reference jsou tvrdě
    //                     povinné (saldokontní úhrady: bez nich accbal nemá
    //                     co párovat). Vyžaduje rowPartner + rowPaymentId.
    //   partnerRequired: 1 — jen partner řádku je tvrdě povinný, VS ne
    //                     (zálohy v hotovosti). identityRequired ho implikuje.
    //
    // Forma-facing atributy (řídí vstupy formuláře — protějšky accountSrc /
    // sideSrc z účtovacího předpisu, musí souhlasit):
    //   rowAccount: "direct" — účet se zadává přímo na řádku (vstup account)
    //   rowAccount: "item"   — účet přijde z položky typu 2 (vstup item)
    //   rowSide: 1           — strana MD/DAL se zadává na řádku (vstup
    //                          acc_side; protějšek sideSrc: "row" předpisu).
    //                          Přepíná formulář do kontačního layoutu bez
    //                          položkového bloku (množství/cena/DPH).
    //   rowSide: 0           — kontační layout, ale BEZ volby strany: stranu
    //                          nesou fixní kroky předpisu (side na kroku),
    //                          částky řádků kladné — směr = volba operace
    //                          (kurzové rozdíly, saldokontní úhrady
    //                          payment.*). Řádek je bez DPH bloku (vat_code
    //                          prázdný → mimo rekapitulaci, do součtu
    //                          dokladu se přičte). Vlajka chybí = položkový
    //                          layout.
    //   selfBalancing: 1     — kroky předpisu pokrývají OBĚ strany (jeden
    //                          řádek → MD i DAL stejnou částkou, FX čtveřice).
    //                          Kontrola vyrovnanosti (AccountingDocument)
    //                          počítá řádek do MD i DAL a acc_side ignoruje;
    //                          součty ho počítají jednou do Σ MD. Parita
    //                          vlajky s kroky předpisu je hlídaná testem.
    //
    // Operace s rowAccount/rowPartner/rowPaymentId bez rowSide (zálohy,
    // majetek na fakturách) zůstávají v položkovém layoutu — jen dostanou
    // navíc vstup účtu a/nebo pole saldo identity; stranu určuje krok
    // předpisu. Saldokontní operace (zápočty) mají rowPartner/rowPaymentId,
    // ale žádný rowAccount — účet je implicitní z kategorie účtovacího
    // předpisu (resolveCategoryAccount, ekvivalent starého acc-default.json);
    // formulář proto vstup účtu/položky nezobrazí.

    "sale.services": {
        "name": "Sale of services",
        "name:cs": "Prodej služeb",
        "name:en": "Sale of services",
        "docTypes": {
            "invno": {"order": 100},
            "invpo": {"order": 100},
            "cash": {"order": 100, "cashDir": 1},
            "cashreg": {"order": 100}
        }
    },
    "sale.goods": {
        "name": "Sale of goods",
        "name:cs": "Prodej zboží",
        "name:en": "Sale of goods",
        "docTypes": {
            "invno": {"order": 200},
            "invpo": {"order": 200},
            "cash": {"order": 200, "cashDir": 1},
            "cashreg": {"order": 200}
        }
    },
    "purchase.goods": {
        "name": "Purchase of goods",
        "name:cs": "Nákup zboží a materiálu",
        "name:en": "Purchase of goods",
        "docTypes": {
            "invni": {"order": 100},
            "cash": {"order": 100, "cashDir": 2}
        }
    },
    "purchase.services": {
        "name": "Purchase of services",
        "name:cs": "Nákup služeb",
        "name:en": "Purchase of services",
        "docTypes": {
            "invni": {"order": 200},
            "cash": {"order": 200, "cashDir": 2}
        }
    },
    "purchase.other": {
        "name": "Other purchase",
        "name:cs": "Ostatní nákup",
        "name:en": "Other purchase",
        "docTypes": {
            "invni": {"order": 300},
            "cash": {"order": 300, "cashDir": 2}
        }
    },

    // Úhrady saldokonta hotově/kartou na pokladním dokladu (#59 D7) —
    // protějšek bankovních úhrad routovaných na 311/321 (OpenItemLookup,
    // #69 D3): partner řádku = dlužník/věřitel, payment_reference = VS /
    // číslo hrazené faktury; deník pak vypadá jako bankovní úhrada a v saldu
    // uzavírá týž klíč. rowSide: 0 = strana z kroku předpisu, částka kladná, bez DPH
    // bloku. identityRequired: bez partnera a VS nemá saldo co párovat.
    // Zálohy (*.advance*) na pokladní doklady zatím nedáváme (saldo záloh je
    // accbal fáze 4+).
    "payment.receivable": {
        "name": "Receivable payment",
        "name:cs": "Úhrada pohledávky",
        "name:en": "Receivable payment",
        "rowSide": 0,
        "rowPartner": 1,
        "rowPaymentId": 1,
        "identityRequired": 1,
        "docTypes": {
            "cash": {"order": 300, "cashDir": 1}
        }
    },
    "payment.payable": {
        "name": "Payable payment",
        "name:cs": "Úhrada závazku",
        "name:en": "Payable payment",
        "rowSide": 0,
        "rowPartner": 1,
        "rowPaymentId": 1,
        "identityRequired": 1,
        "docTypes": {
            "cash": {"order": 400, "cashDir": 2}
        }
    },

    // Převody peněz (#59 Task D): odvod hotovosti do banky, dotace pokladny
    // z banky, převod mezi pokladnami. Obě strany převodu jdou přes 261100
    // Peníze na cestě (kategorie cash.transit) — druhou stranu nese bankovní
    // transakce (economy.bank.txOperations transfer.*) nebo pokladní doklad
    // druhé pokladny; po zaúčtování obou má 261100 z převodů nulový zůstatek.
    // rowSide: 0 — strana z kroku předpisu, částka kladná, směr = operace +
    // cash_dir. Bez partnera (žádný rowPartner), bez DPH; payment_reference
    // nepovinný (identifikace protistrany převodu — číslo bankovní transakce,
    // doklad druhé pokladny — pro budoucí párování 261). Bez saldokontní
    // skupiny. Na cmnbkp úmyslně ne — ruční opravy pokryje acc.record na 261.
    "transfer.in": {
        "name": "Cash transfer in",
        "name:cs": "Příjem z převodu peněz",
        "name:en": "Cash transfer in",
        "rowSide": 0,
        "rowPaymentId": 1,
        "docTypes": {
            "cash": {"order": 350, "cashDir": 1}
        }
    },
    "transfer.out": {
        "name": "Cash transfer out",
        "name:cs": "Výdej pro převod peněz",
        "name:en": "Cash transfer out",
        "rowSide": 0,
        "rowPaymentId": 1,
        "docTypes": {
            "cash": {"order": 450, "cashDir": 2}
        }
    },

    // Zálohy a majetek (vlna C): zálohové operace NEMAJÍ rowAccount —
    // účet dohledávají kategorie advances.* účtovacího předpisu maskou
    // nad rozvrhem DS (D10, vzor saldokontních zápočtů), formulář vstup
    // účtu nezobrazí. Majetek má přímý účet na řádku (analytika per druh
    // majetku, D9). rowPaymentId na zálohových operacích —
    // payment_reference řádku nese číslo zálohového dokladu (staré symbol1),
    // na které naváže saldokontní párování záloh (Fáze 4+). Odpočty jsou na
    // dokladu záporné (věrný obraz), stranu otáčí reverseSign v předpisu.
    // Odpočet na pokladním dokladu (#59 Task E) se chová stejně jako na
    // faktuře — položkový řádek s DPH (odpočet zdaněné zálohy nese daň).
    "purchase.advanceDeduction": {
        "name": "Advance payment deduction",
        "name:cs": "Odpočet poskytnuté zálohy",
        "name:en": "Advance payment deduction",
        "rowPaymentId": 1,
        "docTypes": {
            "invni": {"order": 400},
            "cash": {"order": 460, "cashDir": 2}
        }
    },
    "purchase.advanceVat": {
        "name": "Advance payment taxation",
        "name:cs": "Zdanění poskytnuté zálohy",
        "name:en": "Advance payment taxation",
        "rowPaymentId": 1,
        "docTypes": {
            "invni": {"order": 500}
        }
    },
    "purchase.asset": {
        "name": "Asset acquisition",
        "name:cs": "Pořízení majetku",
        "name:en": "Asset acquisition",
        "rowAccount": "direct",
        "docTypes": {
            "invni": {"order": 600}
        }
    },
    "sale.advanceDeduction": {
        "name": "Advance payment deduction",
        "name:cs": "Odpočet přijaté zálohy",
        "name:en": "Advance payment deduction",
        "rowPaymentId": 1,
        "docTypes": {
            "invno": {"order": 300},
            "cash": {"order": 360, "cashDir": 1}
        }
    },

    // Zálohy přijaté / poskytnuté v hotovosti (#59 Task E): záloha zaplacená
    // na pokladně bez faktury (úhrada zálohové faktury hotově = totéž).
    // Bez DPH — zdanění zálohy je samostatný daňový doklad (mimo scope);
    // kontační layout (rowSide 0), strana z předpisu (příjem DAL 324 /
    // výdej MD 314), částka kladná; záporná částka = vrácení zálohy
    // (konvence záporných řádků D9). Partner povinný (partnerRequired —
    // saldo záloh bez dlužníka/věřitele nedává smysl), payment_reference
    // nepovinný (identita pro budoucí párování záloh, staré doklady ho
    // často nemají).
    "advance.received": {
        "name": "Advance received",
        "name:cs": "Přijatá záloha",
        "name:en": "Advance received",
        "rowSide": 0,
        "rowPartner": 1,
        "rowPaymentId": 1,
        "partnerRequired": 1,
        "docTypes": {
            "cash": {"order": 370, "cashDir": 1}
        }
    },
    "advance.given": {
        "name": "Advance given",
        "name:cs": "Poskytnutá záloha",
        "name:en": "Advance given",
        "rowSide": 0,
        "rowPartner": 1,
        "rowPaymentId": 1,
        "partnerRequired": 1,
        "docTypes": {
            "cash": {"order": 470, "cashDir": 2}
        }
    },
    "sale.advanceVat": {
        "name": "Advance payment taxation",
        "name:cs": "Zdanění přijaté zálohy",
        "name:en": "Advance payment taxation",
        "rowPaymentId": 1,
        "docTypes": {
            "invno": {"order": 400}
        }
    },
