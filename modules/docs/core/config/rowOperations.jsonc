    // Kurzové rozdíly saldokonta (vlna D, D12): jedna operace = dva zápisy
    // deníku (P&L strana kategorií fx.loss/fx.gain × saldo strana kategorií
    // receivables/payables) — proto rowSide: 0 (strany fixní z kroků
    // předpisu, částky kladné, směr nese volba operace). payment_reference
    // řádku = číslo párované faktury (staré symbol1) — saldo strana je
    // párovatelná accbal FX fází.
    "acc.fxLossReceivable": {
