{
    // docs.core.formTexts
    //
    // Texty prvků formulářů dokladů (#150 D87) — čte `TableForm::formText()`
    // ze sekce `texts`. Holé `name` je anglická varianta a shoduje se
    // s fallbackem v PHP znak po znaku. Názvy tabů, sekcí a oddělovačů
    // formulářů sem zatím nepatří (#154).
    "texts": {
        // Pokladní doklady — sekce Pokladna, když číselná řada pokladnu nemá.
        "cashDesk.missing": {
            "name": "The number series has no cash desk — check the number series of the document.",
            "name:cs": "Řada nemá pokladnu — zkontroluj číselnou řadu dokladu.",
            "name:en": "The number series has no cash desk — check the number series of the document."
        },

        // Tab Rekapitulace DPH — doklad zatím bez rekapitulace.
        "recap.empty": {
            "name": "The document has no VAT recap yet — add rows and save the document to recalculate.",
            "name:cs": "Doklad zatím nemá rekapitulaci — přidejte řádky a uložte doklad pro přepočet.",
            "name:en": "The document has no VAT recap yet — add rows and save the document to recalculate."
        },
        // Nabídka kódů DPH řádku: uložený kód, který k datu sazby řádku
        // sazbu nemá (#159 U9) — zůstává vidět, aby ho šlo vědomě vyměnit.
        "vatCode.noRate": {
            "name": "{label} — no rate at this date",
            "name:cs": "{label} — k datu bez sazby",
            "name:en": "{label} — no rate at this date"
        },
        // Název kódu DPH s předmětem plnění tuzemského přenesení (#89 D14) —
        // řádek rekapitulace i buňka kódu DPH v řádcích dokladu.
        "recap.reverseChargeSubject": {
            "name": "{label} · subject {code}",
            "name:cs": "{label} · předmět plnění {code}",
            "name:en": "{label} · subject {code}"
        }
    }
}
