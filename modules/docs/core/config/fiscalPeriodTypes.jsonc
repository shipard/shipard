    // (exchange `fiscalPeriodType` v import módu).

    "opening": {
        "name": "Opening",
        "name:cs": "Otevření",
        "name:en": "Opening"
    },
    "closing": {
        "name": "Closing",
        "name:cs": "Uzavření",
        "name:en": "Closing"
    }
}
