{
    // docs.core.docTypes
    //
    // Typy dokladů v systému: invno (faktura vydaná), invpo (zálohová
    // faktura vydaná — nedaňový doklad), invni (faktura přijatá), invpi
    // (zálohová faktura přijatá — nedaňový doklad), cmnbkp (účetní doklad),
    // cash (pokladní doklad, směr per doklad z cash_dir), cashreg
    // (prodejka). Postupně přibudou další (bank, stockin/stockout,
    // purchase, …).
    //
    // Atributy:
    //   doc_id_code: string vkládaný do %D placeholderu vzorce čísla dokladu
    //   trade_dir:   1 = výstup (my=dodavatel), 2 = vstup (my=odběratel),
    //                0 = typ bez pevného směru (cmnbkp; nebo směr per doklad
    //                přes trade_dir_column)
    //   tax_document: false = doklad není daňový (#79 D1): DPH se počítá jen
    //                informativně (sazby, rekapitulace, součty s DPH), ale
    //                doklad nemá DUZP ani DPPD (DocDocument je nuluje) a
    //                nevstupuje do tvrzení DPH (economy.vat nuluje
    //                vat_period/cs_period/rs_period i ruční hodnotu, selekce
    //                dokladů ho vyřadí). Chybí = true (daňový doklad, všechny
    //                dosavadní typy). Jediná autorita čtení:
    //                DocTypes::isTaxDocument() — kód nikdy neporovnává
    //                doc_type === 'invpo'.
    //   trade_dir_column: název sloupce hlavičky, ze kterého se čte směr
    //                obchodu, když je trade_dir 0. Hodnota sloupce se mapuje
    //                1→1, 2→2, jinak „bez stran". Jediná povolená hodnota je
    //                zatím "cash_dir" (cfgItem docs.core.cashDirections).
    //                Jediná autorita: DocDocument::resolveTradeDir().
    //   series_binding: "cash_desk" | "warehouse" — řada tohoto typu je vázaná
    //                na entitu a musí mít vyplněný odpovídající FK
    //                (docs_core_number_series.cash_desk / .warehouse).
    //                Řady zakládá BoundNumberSeriesProvisioner per aktivní
    //                entitu (doc_number_code = kód entity); běžný
    //                NumberSeriesProvisioner vázané typy přeskakuje. Hodnota
    //                FK se při uložení dokladu denormalizuje z řady do
    //                hlavičky (docs_core_heads.cash_desk). Chybí = nevázaný typ.
    //   doc_number_pattern_default: vzorec, který provisioner použije při
    //                               vytvoření default číselné řady
    //   subclass:    plný název Document třídy v navazujícím modulu
    //                (přijde s Fází 6 — zatím jen referenční hint)

    "invno": {
        "name": "Issued invoice",
        "name:cs": "Faktura vydaná",
        "name:en": "Issued invoice",
        "name:sk": "Faktúra vydaná",
        "name:de": "Ausgangsrechnung",
        "shortcut": "FVB",
        "shortcut:cs": "FVB",
        "shortcut:en": "IV",
        "doc_id_code": "1",
        "trade_dir": 1,
        "doc_number_pattern_default": "%D%y%C%4",
        "subclass": "Shipard\\Module\\Docs\\InvoicesOut\\IssuedInvoiceDocument"
    },

    // Zálohová faktura vydaná (#79 D1): pevně výstup, není daňový doklad
    // (tax_document: false) — DPH jen informativně, bez DUZP a bez zařazení
    // do tvrzení DPH. Účtuje se na podrozvahu (accountingRules, #79 D2).
    "invpo": {
        "name": "Issued proforma invoice",
        "name:cs": "Zálohová faktura vydaná",
        "name:en": "Issued proforma invoice",
        "name:sk": "Zálohová faktúra vydaná",
        "name:de": "Ausgangs-Proformarechnung",
        "shortcut": "FVZ",
        "shortcut:cs": "FVZ",
        "shortcut:en": "PI",
        "doc_id_code": "12",
        "trade_dir": 1,
        "tax_document": false,
        "doc_number_pattern_default": "%D%y%C%4",
        "subclass": "Shipard\\Module\\Docs\\ProformasOut\\ProformaOutDocument"
    },

    "invni": {
        "name": "Received invoice",
        "name:cs": "Faktura přijatá",
        "name:en": "Received invoice",
        "name:sk": "Faktúra prijatá",
        "name:de": "Eingangsrechnung",
        "shortcut": "FPB",
        "shortcut:cs": "FPB",
        "shortcut:en": "RI",
        "doc_id_code": "2",
        "trade_dir": 2,
        "doc_number_pattern_default": "%D%y%C%4",
        "subclass": "Shipard\\Module\\Docs\\InvoicesIn\\ReceivedInvoiceDocument"
    },

    // Zálohová faktura přijatá (#106 D1): pevně vstup, není daňový doklad
    // (tax_document: false) — DPH jen informativně, bez DUZP a bez zařazení
    // do tvrzení DPH. Účtuje se na podrozvahu (accountingRules, #106 D2).
    // Kód 22 a zkratka FPZ jako starý typ prfmin.
    "invpi": {
        "name": "Received proforma invoice",
        "name:cs": "Zálohová faktura přijatá",
        "name:en": "Received proforma invoice",
        "name:sk": "Zálohová faktúra prijatá",
        "name:de": "Eingangs-Proformarechnung",
        "shortcut": "FPZ",
        "shortcut:cs": "FPZ",
        "shortcut:en": "RPI",
        "doc_id_code": "22",
        "trade_dir": 2,
        "tax_document": false,
        "doc_number_pattern_default": "%D%y%C%4",
        "subclass": "Shipard\\Module\\Docs\\ProformasIn\\ProformaInDocument"
    },

    "cmnbkp": {
        "name": "Accounting document",
        "name:cs": "Účetní doklad",
        "name:en": "Accounting document",
        "name:sk": "Účtovný doklad",
        "name:de": "Buchungsbeleg",
        "shortcut": "ÚČD",
        "shortcut:cs": "ÚČD",
        "shortcut:en": "AD",
        "doc_id_code": "60",
        "trade_dir": 0,
        "doc_number_pattern_default": "%D%y%C%4",
        "subclass": "Shipard\\Module\\Docs\\AccountingDocs\\AccountingDocument"
    },

    // Pokladní doklad (#59 D5): směr obchodu per doklad — cash_dir 1 příjem
    // (my dodavatel, DPH výstup), 2 výdej (my odběratel, DPH vstup). Řada
    // vázaná na pokladnu; %C = kód pokladny → číslo např. 31HP12600001
    // (ekvivalent starého %D%B%y%5).
    "cash": {
        "name": "Cash document",
        "name:cs": "Pokladní doklad",
        "name:en": "Cash document",
        "name:sk": "Pokladničný doklad",
        "name:de": "Kassenbeleg",
        "shortcut": "PD",
        "shortcut:cs": "PD",
        "shortcut:en": "CD",
        "doc_id_code": "31",
        "trade_dir": 0,
        "trade_dir_column": "cash_dir",
        "series_binding": "cash_desk",
        "doc_number_pattern_default": "%D%C%y%5",
        "subclass": "Shipard\\Module\\Docs\\CashDocs\\CashDocument"
    },

    // Prodejka (#59 D1): pevně výstup, řada vázaná na pokladnu, vratka =
    // záporné řádky (D9), žádný zvláštní typ ani směr.
    "cashreg": {
        "name": "Retail sale",
        "name:cs": "Prodejka",
        "name:en": "Retail sale",
        "name:sk": "Predajka",
        "name:de": "Verkaufsbeleg",
        "shortcut": "PRO",
        "shortcut:cs": "PRO",
        "shortcut:en": "RS",
        "doc_id_code": "14",
        "trade_dir": 1,
        "series_binding": "cash_desk",
        "doc_number_pattern_default": "%D%C%y%5",
        "subclass": "Shipard\\Module\\Docs\\CashRegister\\CashRegisterDocument"
    }
}
