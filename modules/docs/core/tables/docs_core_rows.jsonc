{
    "tableId": 402,
    "name": "Document rows",
    "name:cs": "Řádky dokladů",
    "name:en": "Document rows",

    // Sub-table managed exclusively through the parent docs_core_heads
    // record. No standalone navigation entry.
    "hideFromNavigation": true,

    "displayPattern": "{description}",

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },
        {
            "id": "doc_head",
            "name": "Document",
            "name:cs": "Doklad",
            "name:en": "Document",
            "type": "int",
            "nullable": false,
            "reference": "docs_core_heads"
        },

        {
            "id": "row_kind",
            "name": "Row kind",
            "name:cs": "Typ řádku",
            "name:en": "Row kind",
            "type": "enumInt",
            "default": 1,
            "cfgItem": "docs.core.rowKinds"
        },

        {
            "id": "operation",
            "name": "Operation",
            "name:cs": "Pohyb",
            "name:en": "Operation",
            "type": "enumString",
            "length": 40,
            "cfgItem": "docs.core.rowOperations",
            "nullable": true
        },

        {
            "id": "order_pos",
            "name": "Sort order",
            "name:cs": "Pořadí",
            "name:en": "Sort order",
            "type": "smallint",
            "default": 0
        },

        // --- identification ---

        {
            "id": "item",
            "name": "Item",
            "name:cs": "Položka",
            "name:en": "Item",
            "type": "int",
            "nullable": true,
            "reference": "economy_items"
        },
        {
            "id": "description",
            "name": "Description",
            "name:cs": "Popis",
            "name:en": "Description",
            "type": "varchar",
            "length": 500,
            "nullable": true
        },

        // --- quantity & price ---

        {
            "id": "unit",
            "name": "Unit",
            "name:cs": "Jednotka",
            "name:en": "Unit",
            "type": "int",
            "nullable": true,
            "reference": "core_units"
        },
        {
            "id": "quantity",
            "name": "Quantity",
            "name:cs": "Množství",
            "name:en": "Quantity",
            "type": "numeric",
            "precision": 15,
            "scale": 4,
            "nullable": true
        },
        {
            "id": "unit_price",
            "name": "Unit price",
            "name:cs": "Cena/jednotka",
            "name:en": "Unit price",
            "type": "numeric",
            "precision": 15,
            "scale": 4,
            "nullable": true
        },
        {
            "id": "total_price",
            "name": "Total price",
            "name:cs": "Cena celkem",
            "name:en": "Total price",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "nullable": true
        },
        {
            "id": "price_calc_mode",
            "name": "Price calculation mode",
            "name:cs": "Způsob výpočtu",
            "name:en": "Price calculation mode",
            "type": "enumInt",
            "default": 0,
            "cfgItem": "docs.core.priceCalcModes"
        },

        // --- discount ---

        {
            "id": "discount_pct",
            "name": "Discount (%)",
            "name:cs": "Sleva (%)",
            "name:en": "Discount (%)",
            "type": "numeric",
            "precision": 5,
            "scale": 2,
            "nullable": true
        },
        {
            "id": "discount_amount",
            "name": "Discount (amount)",
            "name:cs": "Sleva (částka)",
            "name:en": "Discount (amount)",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "nullable": true
        },

        // --- VAT ---
        // vat_code is a free string in Phase 1; the cfgItem (vatCodes) is
        // resolved per-country dynamically at runtime, not at column level.
        // Will become enumString in Phase 5 once the framework supports
        // runtime-resolved cfgItem.

        {
            "id": "vat_code",
            "name": "VAT code",
            "name:cs": "Kód DPH",
            "name:en": "VAT code",
            "type": "varchar",
            "length": 20,
            "nullable": true
        },
        {
            "id": "vat_pct",
            "name": "VAT %",
            "name:cs": "DPH %",
            "name:en": "VAT %",
            "type": "numeric",
            "precision": 5,
            "scale": 2,
            "nullable": true
        },

        // --- calculated (system) ---

        {
            "id": "vat_base",
            "name": "VAT base",
            "name:cs": "Základ DPH",
            "name:en": "VAT base",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "nullable": true,
            "system": true
        },
        {
            "id": "vat_amount",
            "name": "VAT amount",
            "name:cs": "DPH",
            "name:en": "VAT amount",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "nullable": true,
            "system": true
        },
        {
            "id": "vat_total",
            "name": "VAT total",
            "name:cs": "Celkem s DPH",
            "name:en": "VAT total",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "nullable": true,
            "system": true
        },
        {
            "id": "vat_base_dom",
            "name": "VAT base (home)",
            "name:cs": "Základ DPH (domácí)",
            "name:en": "VAT base (home)",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "nullable": true,
            "system": true
        },
        {
            "id": "vat_amount_dom",
            "name": "VAT amount (home)",
            "name:cs": "DPH (domácí)",
            "name:en": "VAT amount (home)",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "nullable": true,
            "system": true
        },
        {
            "id": "vat_total_dom",
            "name": "VAT total (home)",
            "name:cs": "Celkem s DPH (domácí)",
            "name:en": "VAT total (home)",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "nullable": true,
            "system": true
        },

        // --- saldo identity (per-row override pro saldokontní doklady) ---
        // Razítkuje se do deníku per řádek až ve Fázi 2 (engine); operace řádku
        // rozhodne přes vlajky rowPartner / rowPaymentId, zda se bere z řádku
        // nebo z hlavičky. Zde jen schéma — zatím nečtené, faktur se to netýká.

        {
            "id": "partner",
            "name": "Partner",
            "name:cs": "Partner",
            "name:en": "Partner",
            "type": "int",
            "nullable": true,
            "reference": "base_persons_persons"
        },
        {
            "id": "payment_reference",
            "name": "Payment reference",
            "name:cs": "Variabilní symbol",
            "name:en": "Payment reference",
            "type": "varchar",
            "length": 35,
            "nullable": true
        },
        {
            "id": "specific_symbol",
            "name": "Specific symbol",
            "name:cs": "Specifický symbol",
            "name:en": "Specific symbol",
            "type": "varchar",
            "length": 20,
            "nullable": true
        },
        {
            "id": "constant_symbol",
            "name": "Constant symbol",
            "name:cs": "Konstantní symbol",
            "name:en": "Constant symbol",
            "type": "varchar",
            "length": 10,
            "nullable": true
        },
        {
            "id": "due_date",
            "name": "Due date",
            "name:cs": "Datum splatnosti",
            "name:en": "Due date",
            "type": "date",
            "nullable": true
        },

        // --- accounting contation (per-row účet + strana) ---
        // Účetní doklad (cmnbkp) nese kontaci na řádku: účet přímo na řádku
        // (operace acc.record) nebo z položky typu 2 (acc.item), strana MD/DAL
        // per řádek. Engine je čte ve Fázi 2; faktur se to netýká (nullable).

        {
            "id": "account",
            "name": "Account",
            "name:cs": "Účet",
            "name:en": "Account",
            "type": "int",
            "nullable": true,
            "reference": "economy_accounting_accounts"
        },
        {
            "id": "acc_side",
            "name": "Accounting side",
            "name:cs": "Strana",
            "name:en": "Accounting side",
            "type": "enumInt",
            "nullable": true,
            "cfgItem": "docs.core.accSides"
        },

        // --- dimenze deníku (#110 D20) ---
        // Standardní dimenze jádra: hodnota řádku jde do řádku deníku
        // (`rowColumn` v journalDimensions modulu economy.accounting,
        // docs/accounting.md § Dimenze deníku); prázdnou doplní engine
        // z hlavičky. Pole nabízí formulář jen se zapnutým nastavením
        // Dimenze na dokladech (D21); uložená hodnota se propisuje vždy.
        //
        // cost_center — středisko, kterého se řádek týká (#110 D23); prázdné
        //   = středisko hlavičky, i u řádku pořízení majetku.
        {
            "id": "cost_center",
            "name": "Cost center",
            "name:cs": "Středisko",
            "name:en": "Cost center",
            "type": "int",
            "nullable": true,
            "reference": "economy_codebooks_cost_centers"
        },

        // work_order — zakázka, které se řádek týká (#110 D23); prázdné
        //   = zakázka hlavičky.
        {
            "id": "work_order",
            "name": "Work order",
            "name:cs": "Zakázka",
            "name:en": "Work order",
            "type": "int",
            "nullable": true,
            "reference": "economy_work_orders_heads"
        },

        // asset — karta majetku, které se řádek týká (docs/assets.md D15,
        //   D47). Povinná u operací s vlajkou `rowAsset: 1` (asset.*, D48),
        //   nepovinná u pořízení (`purchase.asset`, D61) — tyhle řádky kartu
        //   z hlavičky nedědí. Index kvůli sekci Pořízení na kartě
        //   a alertům (D63).

        {
            "id": "asset",
            "name": "Asset",
            "name:cs": "Majetek",
            "name:en": "Asset",
            "type": "int",
            "nullable": true,
            "reference": "economy_assets_assets"
        }
    ],

    "indexes": [
        {
            "id": "idx_doc_head",
            "type": "index",
            "columns": [
                {"column": "doc_head"},
                {"column": "order_pos"}
            ]
        },
        {
            "id": "idx_item",
            "type": "index",
            "columns": [{"column": "item"}]
        },
        {
            "id": "idx_vat_code",
            "type": "index",
            "columns": [{"column": "vat_code"}]
        },
        // dimenze deníku (#110 D20)
        {
            "id": "idx_cost_center",
            "type": "index",
            "columns": [{"column": "cost_center"}]
        },
        {
            "id": "idx_work_order",
            "type": "index",
            "columns": [{"column": "work_order"}]
        },
        {
            "id": "idx_asset",
            "type": "index",
            "columns": [{"column": "asset"}]
        }
    ]
}
