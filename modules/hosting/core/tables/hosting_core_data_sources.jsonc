{
    "tableId": 431,
    "name": "Hosting data sources",
    "name:cs": "Hosting — zdroje dat",
    "name:en": "Hosting data sources",

    "adminOnly": true,

    "displayPattern": "{name}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "placement",
            "name": "Placement",
            "name:cs": "Umístění",
            "name:en": "Placement"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        },
        {
            "id": "oidc",
            "name": "OIDC",
            "name:cs": "OIDC",
            "name:en": "OIDC"
        },
        {
            "id": "mail",
            "name": "Mail",
            "name:cs": "Pošta",
            "name:en": "Mail"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "ds_id",
            "name": "Data source ID",
            "name:cs": "ID zdroje dat",
            "name:en": "Data source ID",
            "type": "varchar",
            "length": 19,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Název",
            "name:en": "Name",
            "type": "varchar",
            "length": 200,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "web_id",
            "name": "Web ID",
            "name:cs": "Web ID",
            "name:en": "Web ID",
            "type": "varchar",
            "length": 50,
            "nullable": true,
            "group": "identity"
        },

        // --- vrstva A (ds-setup D1/D7) — defaulty jen kvůli ALTER TABLE na
        // existujících řádcích, povinnost hlídá HostingDataSourceDocument ---

        {
            "id": "language",
            "name": "Language",
            "name:cs": "Jazyk",
            "name:en": "Language",
            "type": "enumString",
            "length": 2,
            "nullable": false,
            "default": "cs",
            "cfgItem": "world.base.languages",
            "group": "identity"
        },
        {
            "id": "country",
            "name": "Country",
            "name:cs": "Země",
            "name:en": "Country",
            "type": "enumString",
            "length": 2,
            "nullable": false,
            "default": "cz",
            "cfgItem": "world.base.countries",
            "group": "identity"
        },

        // --- placement ---

        {
            "id": "server",
            "name": "Server",
            "name:cs": "Server",
            "name:en": "Server",
            "type": "int",
            "nullable": true,
            "reference": "hosting_core_servers",
            "group": "placement"
        },
        {
            "id": "url_app",
            "name": "Application URL",
            "name:cs": "URL aplikace",
            "name:en": "Application URL",
            "type": "varchar",
            "length": 200,
            "nullable": false,
            "group": "placement"
        },
        {
            "id": "install_module",
            "name": "Install module",
            "name:cs": "Install modul",
            "name:en": "Install module",
            "type": "varchar",
            "length": 50,
            "nullable": true,
            "group": "placement"
        },
        {
            "id": "lifecycle",
            "name": "Lifecycle",
            "name:cs": "Lifecycle",
            "name:en": "Lifecycle",
            "type": "enumString",
            "length": 10,
            "cfgItem": "hosting.core.dsLifecycle",
            "nullable": false,
            "default": "active",
            "group": "placement"
        },

        // --- provisioning (D3, U1) ---

        {
            "id": "owner",
            "name": "Owner",
            "name:cs": "Vlastník",
            "name:en": "Owner",
            "type": "int",
            "nullable": true,
            "reference": "core_system_users",
            "group": "placement"
        },
        {
            "id": "provision_error",
            "name": "Provisioning error",
            "name:cs": "Chyba provisioningu",
            "name:en": "Provisioning error",
            "type": "text",
            "nullable": true,
            "group": "status"
        },
        {
            "id": "claimed_at",
            "name": "Claimed at",
            "name:cs": "Převzato agentem",
            "name:en": "Claimed at",
            "type": "datetime",
            "nullable": true,
            "group": "status"
        },

        // --- audit ---

        {
            "id": "created",
            "name": "Created",
            "name:cs": "Vytvořeno",
            "name:en": "Created",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },
        {
            "id": "modified",
            "name": "Modified",
            "name:cs": "Změněno",
            "name:en": "Modified",
            "type": "datetime",
            "nullable": false,
            "group": "status"
        },

        // --- OIDC klient (D2) — klient OP je aktivní jen s vyplněným
        // secretem i redirect URI; secret šifruje HostingDataSourceDocument ---

        {
            "id": "oidc_client_secret",
            "name": "OIDC client secret",
            "name:cs": "OIDC client secret",
            "name:en": "OIDC client secret",
            "type": "encrypted_text",
            "nullable": true,
            "sensitive": true,
            "group": "oidc"
        },
        {
            "id": "oidc_redirect_uri",
            "name": "OIDC redirect URI",
            "name:cs": "OIDC redirect URI",
            "name:en": "OIDC redirect URI",
            "type": "varchar",
            "length": 250,
            "nullable": true,
            "group": "oidc"
        },

        // --- mail-router (D4) — token pro /_mail/incoming DS, mintuje agent
        // (mail-router-setup) a hlásí confirmem; šifruje HostingDataSourceDocument;
        // servíruje ho jen lookup endpoint pro mail-routery ---

        {
            "id": "mail_token",
            "name": "Mail token",
            "name:cs": "Mail token",
            "name:en": "Mail token",
            "type": "encrypted_text",
            "nullable": true,
            "sensitive": true,
            "group": "mail"
        },

        // --- doc state (systémové) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 40,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 3,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_ds_id",
            "type": "unique",
            "columns": [
                {"column": "ds_id"}
            ]
        },
        // MariaDB unikátní index povoluje víc NULL hodnot — nullable unique
        // na web_id tedy funguje bez partial indexu.
        {
            "id": "unq_web_id",
            "type": "unique",
            "columns": [
                {"column": "web_id"}
            ]
        },
        {
            "id": "idx_lifecycle",
            "type": "index",
            "columns": [
                {"column": "lifecycle"}
            ]
        }
    ]
}
