            "name:cs": "Prázdné = převodem.",
            "name:en": "Empty = bank transfer."
        },
        "kind.invBankAccountHint": {
            "name": "Empty = the default account of the document.",
            "name:cs": "Prázdné = výchozí účet dokladu.",
            "name:en": "Empty = the default account of the document."
