        // --- smlouva: fakturace a přepisy hodnot druhu (#174 D29, D37) ---
        "contract.periodicityHint": {
            "name": "Calendar period; empty = the contract is not invoiced.",
            "name:cs": "Kalendářní období; prázdné = smlouva se nefakturuje.",
            "name:en": "Calendar period; empty = the contract is not invoiced."
