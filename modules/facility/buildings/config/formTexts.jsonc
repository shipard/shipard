        "contract.docTextHint": {
            "name": "The {období} variable is replaced with the period in the language of the tenant, e.g. October 2026.",
            "name:cs": "Proměnná {období} se nahradí obdobím v jazyce nájemce, např. říjen 2026.",
            "name:en": "The {období} variable is replaced with the period in the language of the tenant, e.g. October 2026."
