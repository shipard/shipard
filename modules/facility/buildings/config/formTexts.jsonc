            "name:en": "Issue date and tax point date of the document; empty = at the start of the period."
        },
        "kind.invVatModeHint": {
            "name": "Prices on prescription rows without VAT (from the base) or with VAT (from the total); empty = from the base.",
            "name:cs": "Ceny na řádcích předpisu bez DPH (ze základu), nebo s DPH (z ceny celkem); prázdné = ze základu.",
            "name:en": "Prices on prescription rows without VAT (from the base) or with VAT (from the total); empty = from the base."
