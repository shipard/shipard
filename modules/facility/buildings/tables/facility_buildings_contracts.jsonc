{
    // Smlouva (#174 D6, D20–D22) — hlavička nájemní smlouvy. Druh je povinný
    // a měnit jde jen v Konceptu; typ se z něj denormalizuje při uložení.
    // Číslo přidělí potvrzení přes společný engine čísel — čítač per druh
    // a kalendářní rok zahájení (`number_year`, u průběžného čítače NULL);
    // importované číslo zůstává. Místa smlouvy jsou v child tabulce
    // facility_buildings_contract_places (dataKey `places`, prvek
    // `multilookup` ve formuláři).
    //
    // Fáze 2 (#174 D29, D30, D36): fakturační předpis — periodicita,
    // fakturovat od, text dokladu, měna, pevný VS, středisko a přepisy
    // výchozích hodnot druhu (`inv_*`, prázdné = z druhu). Řádky předpisu
    // jsou sub-tabulka facility_buildings_contract_rows, ne child tabulka:
    // uložení hlavičky na ně nesahá.
    //
    // Vlastní sada stavů s Ukončená a Zrušená; přechody stavu jdou přes
    // Document lifecycle (číslo při potvrzení, datum ukončení).
    "tableId": 474,
    "name": "Contracts",
    "name:cs": "Smlouvy",
    "name:en": "Contracts",

    "displayPattern": "{number} — {title}",
    "exchangeKey": "number",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "facility.buildings.docStates"
    },

    "stateTransitionsRunDocumentHooks": true,

    "childTables": [
        { "table": "facility_buildings_contract_places", "foreignKey": "contract", "dataKey": "places" }
    ],

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "validity",
            "name": "Validity",
            "name:cs": "Platnost",
            "name:en": "Validity"
        },
        {
            "id": "invoicing",
            "name": "Invoicing",
            "name:cs": "Fakturace",
            "name:en": "Invoicing"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },
        {
            // Po opuštění Konceptu neměnný — číslo, rok čítače a typ jsou
            // od druhu odvozené.
            "id": "kind",
            "name": "Kind",
            "name:cs": "Druh",
            "name:en": "Kind",
            "type": "int",
            "nullable": false,
            "reference": "facility_buildings_contract_kinds",
            "group": "identity"
        },
        {
            // Denormalizováno z druhu při uložení (ContractDocument).
            "id": "type",
            "name": "Contract type",
            "name:cs": "Typ smlouvy",
            "name:en": "Contract type",
            "type": "enumString",
            "length": 16,
            "cfgItem": "facility.buildings.contractTypes",
            "nullable": true,
            "group": "identity"
        },
        {
            // Prázdné u konceptu; UNIQUE v celém zdroji.
            "id": "number",
            "name": "Number",
            "name:cs": "Číslo",
            "name:en": "Number",
            "type": "varchar",
            "length": 50,
            "nullable": true,
            "group": "identity"
        },
        {
            "id": "sequence_number",
            "name": "Sequence number",
            "name:cs": "Pořadové číslo",
            "name:en": "Sequence number",
            "type": "int",
            "nullable": true,
            "group": "identity"
        },
        {
            // Rozsah čítače, ze kterého je pořadí: kalendářní rok zahájení
            // u druhu s ročním restartem, jinak NULL.
            "id": "number_year",
            "name": "Counter year",
            "name:cs": "Rok čítače",
            "name:en": "Counter year",
            "type": "int",
            "nullable": true,
            "group": "identity"
        },
        {
            "id": "title",
            "name": "Title",
            "name:cs": "Název",
            "name:en": "Title",
            "type": "varchar",
            "length": 200,
            "nullable": false,
            "group": "identity"
        },
        {
            // Povinný při potvrzení.
            "id": "customer",
            "name": "Tenant",
            "name:cs": "Nájemce",
            "name:en": "Tenant",
            "type": "int",
            "nullable": true,
            "reference": "base_persons_persons",
            "group": "identity"
        },
        {
            // Povinné při potvrzení; jeho kalendářní rok určuje čítač čísla.
            "id": "date_start",
            "name": "Start date",
            "name:cs": "Zahájení",
            "name:en": "Start date",
            "type": "date",
            "nullable": true,
            "group": "validity"
        },
        {
            // Prázdné = doba neurčitá. Přechod do Ukončená / Zrušená doplní
            // prázdné datum dneškem.
            "id": "date_end",
            "name": "End date",
            "name:cs": "Ukončení",
            "name:en": "End date",
            "type": "date",
            "nullable": true,
            "group": "validity"
        },
        {
            "id": "internal_note",
            "name": "Internal note",
            "name:cs": "Interní poznámka",
            "name:en": "Internal note",
            "type": "text",
            "nullable": true,
            "group": "identity"
        },

        // --- fakturace (#174 D29, D36) ---

        {
            // Nepovinná (D36) — smlouva bez periodicity se nefakturuje.
            "id": "inv_periodicity",
            "name": "Periodicity",
            "name:cs": "Periodicita",
            "name:en": "Periodicity",
            "type": "enumString",
            "length": 10,
            "cfgItem": "economy.periodicInvoicing.periodicities",
            "nullable": true,
            "group": "invoicing"
        },
        {
            // První fakturované období = období obsahující toto datum; prázdné
            // doplní ContractDocument zahájením, dřív než zahájení být nesmí.
            "id": "inv_from",
            "name": "Invoice from",
            "name:cs": "Fakturovat od",
            "name:en": "Invoice from",
            "type": "date",
            "nullable": true,
            "group": "invoicing"
        },
        {
            // Text dokladu s proměnnou {období}; prázdný = název smlouvy a období.
            "id": "inv_doc_text",
            "name": "Document text",
            "name:cs": "Text dokladu",
            "name:en": "Document text",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "invoicing"
        },
        {
            // Prázdná = domácí měna zdroje dat (doplní ContractDocument).
            "id": "currency",
            "name": "Currency",
            "name:cs": "Měna",
            "name:en": "Currency",
            "type": "enumString",
            "length": 3,
            "cfgItem": "world.base.currencies",
            "nullable": true,
            "group": "invoicing"
        },
        {
            // Pevný variabilní symbol — ponesou ho všechny faktury smlouvy.
            "id": "payment_reference",
            "name": "Payment reference",
            "name:cs": "Variabilní symbol",
            "name:en": "Payment reference",
            "type": "varchar",
            "length": 35,
            "nullable": true,
            "group": "invoicing"
        },
        {
            // Středisko dokladů smlouvy (dimenze costCenter).
            "id": "cost_center",
            "name": "Cost center",
            "name:cs": "Středisko",
            "name:en": "Cost center",
            "type": "int",
            "reference": "economy_codebooks_cost_centers",
            "nullable": true,
            "group": "invoicing"
        },

        // Přepisy výchozích hodnot druhu (stejné názvy sloupců jako na
        // facility_buildings_contract_kinds); NULL = z druhu.
        {
            "id": "inv_doc_type",
            "name": "Invoice document type",
            "name:cs": "Typ dokladu",
            "name:en": "Invoice document type",
            "type": "enumString",
            "length": 20,
            "cfgItem": "docs.core.docTypes",
            "nullable": true,
            "group": "invoicing"
        },
        {
            "id": "inv_number_series",
            "name": "Document number series",
            "name:cs": "Řada dokladů",
            "name:en": "Document number series",
            "type": "int",
            "reference": "docs_core_number_series",
            "nullable": true,
            "group": "invoicing"
        },
        {
            "id": "inv_due_days",
            "name": "Due days",
            "name:cs": "Splatnost (dny)",
            "name:en": "Due days",
            "type": "smallint",
            "nullable": true,
            "group": "invoicing"
        },
        {
            "id": "inv_timing",
            "name": "Invoicing timing",
            "name:cs": "Fakturace",
            "name:en": "Invoicing timing",
            "type": "enumString",
            "length": 5,
            "cfgItem": "economy.periodicInvoicing.invoiceTimings",
            "nullable": true,
            "group": "invoicing"
        },
        {
            "id": "inv_vat_mode",
            "name": "VAT mode",
            "name:cs": "Režim DPH",
            "name:en": "VAT mode",
            "type": "enumInt",
            "cfgItem": "docs.core.vatModes",
            "nullable": true,
            "group": "invoicing"
        },
        {
            "id": "inv_payment_method",
            "name": "Payment method",
            "name:cs": "Způsob platby",
            "name:en": "Payment method",
            "type": "enumInt",
            "cfgItem": "docs.core.paymentMethods",
            "nullable": true,
            "group": "invoicing"
        },
        {
            "id": "inv_bank_account",
            "name": "Our bank account",
            "name:cs": "Bankovní účet",
            "name:en": "Our bank account",
            "type": "int",
            "reference": "economy_codebooks_bank_accounts",
            "nullable": true,
            "group": "invoicing"
        },

        // --- doc state (systémové) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 1,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_number",
            "type": "unique",
            "columns": [{"column": "number"}]
        },
        {
            // SequenceCounter::maxSequence + výpis druhu.
            "id": "idx_kind_year",
            "type": "index",
            "columns": [
                {"column": "kind"},
                {"column": "number_year"},
                {"column": "sequence_number"}
            ]
        },
        {
            "id": "idx_customer",
            "type": "index",
            "columns": [{"column": "customer"}]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"},
                {"column": "number", "order": "DESC"}
            ]
        }
    ]
}
