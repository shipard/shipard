{
    // Druh smlouvy (#174 D4, D15, D18): uživatelský číselník v Nastavení →
    // Budovy. Nese typ smlouvy (cfgItem facility.buildings.contractTypes —
    // po opuštění Konceptu jen ke čtení, hlídá ContractKindDocument)
    // a číslování: kód (%C), vzorec čísla a restart čítače. Čítač je per
    // druh a kalendářní rok zahájení smlouvy
    // (facility_buildings_number_counters). `system_code` nese jen seed
    // (= klíč typu, ContractKindsProvisioner).
    //
    // Fáze 2 (#174 D29, D32): výchozí hodnoty fakturace smluv druhu
    // (sloupce `inv_*` jako u druhu zakázky) a šablona řádků předpisu
    // v sub-tabulce facility_buildings_contract_kind_rows.
    "tableId": 472,
    "name": "Contract kinds",
    "name:cs": "Druhy smluv",
    "name:en": "Contract kinds",

    "displayPattern": "{name}",

    // Přechody stavu jdou přes ContractKindDocument — jinak by tlačítko
    // Smazat minulo kontrolu, že druh nepoužívá žádná smlouva (D18).
    "stateTransitionsRunDocumentHooks": true,

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {
            "id": "numbering",
            "name": "Numbering",
            "name:cs": "Číslování",
            "name:en": "Numbering"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Název",
            "name:en": "Name",
            "type": "varchar",
            "length": 100,
            "nullable": false
        },
        {
            "id": "type",
            "name": "Contract type",
            "name:cs": "Typ smlouvy",
            "name:en": "Contract type",
            "type": "enumString",
            "length": 16,
            "cfgItem": "facility.buildings.contractTypes",
            "nullable": false
        },
        {
            "id": "notice",
            "name": "Note",
            "name:cs": "Poznámka",
            "name:en": "Note",
            "type": "text",
            "nullable": true
        },
        {
            "id": "number_code",
            "name": "Kind code (%C)",
            "name:cs": "Kód druhu (%C)",
            "name:en": "Kind code (%C)",
            "type": "varchar",
            "length": 10,
            "nullable": true,
            "group": "numbering"
        },
        {
            "id": "number_pattern",
            "name": "Contract number pattern",
            "name:cs": "Vzorec čísla smlouvy",
            "name:en": "Contract number pattern",
            "type": "varchar",
            "length": 50,
            "nullable": false,
            "group": "numbering"
        },
        {
            // continuous = průběžně, yearly = restart každý kalendářní rok
            // zahájení smlouvy.
            "id": "reset_scope",
            "name": "Counter reset",
            "name:cs": "Restart počítadla",
            "name:en": "Counter reset",
            "type": "enumString",
            "length": 15,
            "cfgItem": "facility.buildings.resetScopes",
            "default": "yearly",
            "nullable": false,
            "group": "numbering"
        },
        {
            // Jen seed: klíč typu, podle kterého provisioner pozná, že druh
            // už jednou založil (i když ho uživatel přejmenoval nebo vyřadil).
            "id": "system_code",
            "name": "System code",
            "name:cs": "Systémový kód",
            "name:en": "System code",
            "type": "varchar",
            "length": 16,
            "nullable": true
        },

        // --- výchozí hodnoty fakturace (#174 D29) ---
        // Smlouva je smí přepsat stejnojmenným sloupcem; prázdné na obou =
        // výchozí hodnota enginu (InvoicingSettingsResolver).

        {
            // invno (faktura vydaná) nebo invpo (zálohová faktura vydaná);
            // povolené hodnoty hlídá InvoicingSettings::DOC_TYPES.
            "id": "inv_doc_type",
            "name": "Invoice document type",
            "name:cs": "Typ dokladu",
            "name:en": "Invoice document type",
            "type": "enumString",
            "length": 20,
            "cfgItem": "docs.core.docTypes",
            "nullable": true
        },
        {
            // Řada dokladů; její doc_type musí odpovídat typu dokladu.
            "id": "inv_number_series",
            "name": "Document number series",
            "name:cs": "Řada dokladů",
            "name:en": "Document number series",
            "type": "int",
            "reference": "docs_core_number_series",
            "nullable": true
        },
        {
            "id": "inv_due_days",
            "name": "Due days",
            "name:cs": "Splatnost (dny)",
            "name:en": "Due days",
            "type": "smallint",
            "nullable": true
        },
        {
            // start = fakturace na počátku období, end = na konci.
            "id": "inv_timing",
            "name": "Invoicing timing",
            "name:cs": "Fakturace",
            "name:en": "Invoicing timing",
            "type": "enumString",
            "length": 5,
            "cfgItem": "economy.periodicInvoicing.invoiceTimings",
            "nullable": true
        },
        {
            "id": "inv_vat_mode",
            "name": "VAT mode",
            "name:cs": "Režim DPH",
            "name:en": "VAT mode",
            "type": "enumInt",
            "cfgItem": "docs.core.vatModes",
            "nullable": true
        },
        {
            "id": "inv_payment_method",
            "name": "Payment method",
            "name:cs": "Způsob platby",
            "name:en": "Payment method",
            "type": "enumInt",
            "cfgItem": "docs.core.paymentMethods",
            "nullable": true
        },
        {
            // Prázdné = výchozí účet dokladu.
            "id": "inv_bank_account",
            "name": "Our bank account",
            "name:cs": "Bankovní účet",
            "name:en": "Our bank account",
            "type": "int",
            "reference": "economy_codebooks_bank_accounts",
            "nullable": true
        },

        // --- doc state (systémové) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 1,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_system_code",
            "type": "unique",
            "columns": [
                {"column": "system_code"}
            ]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"},
                {"column": "name", "order": "ASC"}
            ]
        }
    ]
}
