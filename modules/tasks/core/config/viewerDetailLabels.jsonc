{
    // tasks.core.viewerDetailLabels
    //
    // Texty `TasksViewer` (Úkoly) — řádek seznamu, hlavička a Přehled
    // detailu. Jen sekce `texts` (čte `TableViewer::detailText()`); tab
    // Přehled a zástupný titulek „(bez názvu)“ jsou sdílené
    // v core.system.viewerDetailLabels. Holé `name` je anglická varianta
    // a shoduje se s fallbackem v PHP.

    "texts": {
        // Řádek seznamu: kdo úkol vytvořil.
        "rowCreatedBy": { "name": "Created by: {name}", "name:cs": "Vytvořil: {name}", "name:en": "Created by: {name}" },
        // Podtitul hlavičky detailu: termín úkolu.
        "headerDueDate": { "name": "Due date {date}", "name:cs": "Termín {date}", "name:en": "Due date {date}" },
        // Štítek hlavičky: nedokončený úkol po termínu.
        "overdue": { "name": "Overdue", "name:cs": "Po termínu", "name:en": "Overdue" },
        // Skupina Přehledu s údaji o vzniku úkolu.
        "groupTask": { "name": "Task", "name:cs": "Úkol", "name:en": "Task" }
    }
}
