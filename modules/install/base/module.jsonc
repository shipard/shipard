{
    "id": "install.base",
    "name": "Base installation",
    "name:cs": "Základní instalace",
    "name:en": "Base installation",
    "description": "Base set of modules for system operation",
    "description:cs": "Základní sada modulů pro provoz systému",
    "description:en": "Base set of modules for system operation",

    // Nabízí se v self-service zakládání DS z portálu (hosting-08 D2).
    "selfService": true,

    "dependencies": [
        "core.system",
        "core.alerts",
        "core.attachments",
        "core.mail",
        "core.units",
        "core.exchange",
        "base.persons",
        "base.registry",
        "economy.codebooks",
        "economy.items",
        "economy.accounting",
        "economy.vat",
        "economy.bank",
        "economy.accbal",
        "world.vat",
        "docs.core",
        "docs.invoicesOut",
        "docs.proformasOut",
        "docs.invoicesIn",
        "docs.accountingDocs",
        "docs.cashDocs",
        "docs.cashRegister",
        "tasks.core",
        "core.chat",
    ],

    "config": [
        { "id": "global.settingsSections", "file": "config/settingsSections.jsonc" },
        { "id": "global.accountSections", "file": "config/accountSections.jsonc" },
        { "id": "global.navSections", "file": "config/navSections.jsonc" }
    ]
}
