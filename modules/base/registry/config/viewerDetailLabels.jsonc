        },
        "allDocuments": {
            "name": "All",
            "name:cs": "Vše",
            "name:en": "All"
        },
        "unfiled": {
            "name": "Unfiled",
            "name:cs": "Nezařazené",
            "name:en": "Unfiled"
        }
    }
