{
    "id": "base.registry",
    "name": "Registry",
    "name:cs": "Spisovna",
    "name:en": "Registry",
    "description": "Registry of permanent company documents (contracts, insurance, certificates...)",
    "description:cs": "Evidence trvalých dokumentů firmy (smlouvy, pojistky, revize...)",
    "description:en": "Registry of permanent company documents (contracts, insurance, certificates...)",

    "dependencies": [
        "core.system",
        "core.attachments",
        "base.persons",
        "core.mail"
    ],

    "tables": [
        "base_registry_binders",
        "base_registry_documents"
    ],

    // Žádný keepOnReset — šanony i dokumenty jsou migrovaná data ze starého
    // wkf.docs; re-import po ds-reset je čistý (dedupe metadata.legacyId).

    "settingsItems": [
        { "viewer": "base.registry.binders", "section": "other", "subsection": "other.registry", "order": 10 }
    ],

    "viewers": [
        {
            "id": "base.registry.documents",
            "name": "Registry",
            "name:cs": "Spisovna",
            "name:en": "Registry",
            "icon": "folder",
            "table": "base_registry_documents",
            "class": "Shipard\\Module\\Base\\Registry\\RegistryDocumentsViewer",
            "navSection": "_top",
            "navOrder": 35,
            // Tab Přílohy staví viewer sám — builder přílohy nepřidává (#136 D21).
            "detailAttachments": "content"
        },
        {
            "id": "base.registry.binders",
            "name": "Binders",
            "name:cs": "Šanony",
            "name:en": "Binders",
            "icon": "folder",
            "table": "base_registry_binders",
            "class": "Shipard\\Module\\Base\\Registry\\BindersViewer"
        }
    ],

    "forms": [
        {
            "table": "base_registry_documents",
            "class": "Shipard\\Module\\Base\\Registry\\RegistryDocumentsForm"
        }
    ],

    "alertChecks": [
        {
            "id": "base.registry.expirations",
            "name": "Registry document expirations",
            "name:cs": "Expirace dokumentů Spisovny",
            "name:en": "Registry document expirations",
            "description": "Filed documents whose valid_to is approaching or past, per docKinds expiration.warnDaysBefore.",
            "description:cs": "Zařazené dokumenty s blížícím se nebo prošlým valid_to dle expiration.warnDaysBefore druhu.",
            "description:en": "Filed documents whose valid_to is approaching or past, per docKinds expiration.warnDaysBefore.",
            "class": "Shipard\\Module\\Base\\Registry\\RegistryExpirationAlertCheck",
            "severity": "warning",
            "interval": "6h",
            "navSection": "_top",
            "tags": ["registry"]
        }
    ],

    "documentClasses": [
        {
            "table": "base_registry_binders",
            "class": "Shipard\\Module\\Base\\Registry\\BinderDocument"
        },
        {
            "table": "base_registry_documents",
            "class": "Shipard\\Module\\Base\\Registry\\RegistryDocumentDocument"
        }
    ],

    "config": [
        {
            "id": "base.registry.docKinds",
            "file": "config/docKinds.jsonc"
        },
        {
            "id": "base.registry.sourceKinds",
            "file": "config/sourceKinds.jsonc"
        },
        {
            "id": "base.registry.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        }
    ]
}
