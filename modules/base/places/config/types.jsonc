{
    // base.places.types — typ místa (#169 D2, D3, docs/places.md).
    // Hodnoty = enumString `type` na druhu místa (base_places_kinds); místo
    // typ dědí z druhu. Typ je po prvním potvrzení druhu jen ke čtení (D15).
    //
    // Kód se NIKDY neptá na klíč typu, jen na vlastnosti (PlaceTypes):
    //   level      — úroveň v hierarchii; nadřazené místo musí mít nižší
    //                úroveň, přeskakování je povolené. null = bez pravidla
    //                (smí být nad čímkoli i pod čímkoli)
    //   icon       — ikona typu (frontend/src/icons.js); platí, když druh
    //                nemá vlastní
    //   hasAddress — místo typu nese adresu (D13); u ostatních typů se
    //                adresa při uložení maže
    //   order      — pořadí v nabídce
    "site": {
        "name": "Site",
        "name:cs": "Areál",
        "name:en": "Site",
        "level": 10,
        "icon": "place-site",
        "hasAddress": true,
        "order": 10
    },
    "building": {
        "name": "Building",
