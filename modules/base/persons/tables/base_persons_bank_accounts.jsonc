{
    "tableId": 203,
    "name": "Bank accounts",
    "name:cs": "Bankovní účty",
    "name:en": "Bank accounts",
    "displayPattern": "{account_number|iban}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },
        {
            "id": "person",
            "name": "Person",
            "name:cs": "Osoba",
            "name:en": "Person",
            "type": "int",
            "nullable": false,
            "reference": "base_persons_persons"
        },
        {
            "id": "name",
            "name": "Account name",
            "name:cs": "Název účtu",
            "name:en": "Account name",
            "type": "varchar",
            "length": 100,
            "nullable": true
        },
        {
            "id": "account_number",
            "name": "Account number",
            "name:cs": "Číslo účtu",
            "name:en": "Account number",
            "type": "varchar",
            "length": 50,
            "nullable": false
        },
        {
            "id": "iban",
            "name": "IBAN",
            "name:cs": "IBAN",
            "name:en": "IBAN",
            "type": "varchar",
            "length": 34,
            "nullable": true
        },
        {
            "id": "bic",
            "name": "BIC/SWIFT",
            "name:cs": "BIC/SWIFT",
            "name:en": "BIC/SWIFT",
            "type": "varchar",
            "length": 11,
            "nullable": true
        },
        {
            "id": "currency",
            "name": "Currency",
            "name:cs": "Měna",
            "name:en": "Currency",
            "type": "varchar",
            "length": 3,
            "nullable": true
        },
        {
            "id": "source",
            "name": "Source",
            "name:cs": "Zdroj",
            "name:en": "Source",
            "type": "enumInt",
            "default": 0,
            "cfgItem": "base.persons.bankAccountSources"
        },
        {
            "id": "order_pos",
            "name": "Order",
            "name:cs": "Pořadí",
            "name:en": "Order",
            "type": "smallint",
            "default": 0
        },
        {
            "id": "valid_from",
            "name": "Valid from",
            "name:cs": "Platnost od",
            "name:en": "Valid from",
            "type": "date",
            "nullable": true
        },
        {
            "id": "valid_to",
            "name": "Valid to",
            "name:cs": "Platnost do",
            "name:en": "Valid to",
            "type": "date",
            "nullable": true
        },
        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 1,
            "system": true
        }
    ],
    "indexes": [
        {
            "id": "idx_person",
            "type": "index",
            "columns": [
                {
                    "column": "person"
                },
                {
                    "column": "order_pos",
                    "order": "ASC"
                }
            ]
        },
        {
            "id": "idx_account_number",
            "type": "index",
            "columns": [
                {
                    "column": "account_number"
                }
            ]
        },
        {
            "id": "idx_iban",
            "type": "index",
            "columns": [
                {
                    "column": "iban"
                }
            ]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"}
            ]
        }
    ]
}