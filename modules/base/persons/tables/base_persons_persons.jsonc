{
    "tableId": 201,
    "name": "Persons",
    "name:cs": "Osoby",
    "name:en": "Persons",

    "displayPattern": "{person_id} — {full_name}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {
            "id": "identity",
            "name": "Identity",
            "name:cs": "Identifikace",
            "name:en": "Identity"
        },
        {
            "id": "name",
            "name": "Name",
            "name:cs": "Jméno",
            "name:en": "Name"
        },
        {
            "id": "personal",
            "name": "Personal details",
            "name:cs": "Osobní údaje",
            "name:en": "Personal details"
        },
        {
            "id": "contact",
            "name": "Contact details",
            "name:cs": "Kontaktní údaje",
            "name:en": "Contact details"
        },
        {
            "id": "documents",
            "name": "Documents",
            "name:cs": "Dokumenty",
            "name:en": "Documents"
        },
        {
            "id": "status",
            "name": "Status",
            "name:cs": "Stav",
            "name:en": "Status"
        },
        {
            "id": "lineage",
            "name": "Lineage",
            "name:cs": "Původ záznamu",
            "name:en": "Lineage"
        }
    ],

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },

        // --- identity ---

        {
            "id": "person_id",
            "name": "Person code",
            "name:cs": "Kód osoby",
            "name:en": "Person code",
            "type": "varchar",
            "length": 10,
            "nullable": false,
            "group": "identity"
        },
        {
            "id": "person_type",
            "name": "Person type",
            "name:cs": "Typ osoby",
            "name:en": "Person type",
            "type": "enumInt",
            "default": 1,
            "cfgItem": "base.persons.personTypes",
            "group": "identity"
        },
        {
            "id": "company_id",
            "name": "Company ID",
            "name:cs": "IČO",
            "name:en": "Company ID",
            "type": "varchar",
            "length": 30,
            "nullable": true,
            "group": "identity"
        },
        {
            "id": "tax_id",
            "name": "Tax ID",
            "name:cs": "DIČ",
            "name:en": "Tax ID",
            "type": "varchar",
            "length": 30,
            "nullable": true,
            "group": "identity"
        },
        {
            "id": "vat_id",
            "name": "VAT ID",
            "name:cs": "DIČ pro DPH",
            "name:en": "VAT ID",
            "type": "varchar",
            "length": 30,
            "nullable": true,
            "group": "identity"
        },
        {
            "id": "court_registration",
            "name": "Court registration",
            "name:cs": "Zápis v obchodním rejstříku",
            "name:en": "Court registration",
            "type": "varchar",
            "length": 250,
            "nullable": true,
            "group": "identity"
        },
        {
            "id": "gov_e_box_id",
            "name": "Government e-box ID",
            "name:cs": "ID datové schránky",
            "name:en": "Government e-box ID",
            "type": "varchar",
            "length": 10,
            "nullable": true,
            "group": "identity"
        },

        // --- name ---

        {
            "id": "full_name",
            "name": "Full name",
            "name:cs": "Celý název",
            "name:en": "Full name",
            "type": "varchar",
            "length": 200,
            "nullable": false,
            "group": "name"
        },
        {
            "id": "complex_name",
            "name": "Complex name",
            "name:cs": "Komplikované jméno",
            "name:en": "Complex name",
            "type": "boolean",
            "default": 0,
            "group": "name"
        },
        {
            "id": "title_before",
            "name": "Title before name",
            "name:cs": "Tituly před jménem",
            "name:en": "Title before name",
            "type": "varchar",
            "length": 50,
            "nullable": true,
            "group": "name"
        },
        {
            "id": "first_name",
            "name": "First name",
            "name:cs": "Jméno",
            "name:en": "First name",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "name"
        },
        {
            "id": "middle_name",
            "name": "Middle name",
            "name:cs": "Prostřední jméno",
            "name:en": "Middle name",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "name"
        },
        {
            "id": "last_name",
            "name": "Last name",
            "name:cs": "Příjmení",
            "name:en": "Last name",
            "type": "varchar",
            "length": 100,
            "nullable": true,
            "group": "name"
        },
        {
            "id": "title_after",
            "name": "Title after name",
            "name:cs": "Tituly za jménem",
            "name:en": "Title after name",
            "type": "varchar",
            "length": 50,
            "nullable": true,
            "group": "name"
        },

        // --- personal ---

        {
            "id": "birth_date",
            "name": "Date of birth",
            "name:cs": "Datum narození",
            "name:en": "Date of birth",
            "type": "date",
            "nullable": true,
            "group": "personal"
        },
        {
            "id": "national_id",
            "name": "National ID number",
            "name:cs": "Rodné číslo",
            "name:en": "National ID number",
            "type": "varchar",
            "length": 30,
            "nullable": true,
            "group": "personal"
        },
        {
            "id": "id_card_number",
            "name": "ID card number",
            "name:cs": "Číslo osobního dokladu",
            "name:en": "ID card number",
            "type": "varchar",
            "length": 30,
            "nullable": true,
            "group": "personal"
        },

        // --- contact ---

        {
            "id": "email",
            "name": "E-mail",
            "name:cs": "E-mail",
            "name:en": "E-mail",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "contact"
        },
        {
            "id": "phone",
            "name": "Phone",
            "name:cs": "Telefon",
            "name:en": "Phone",
            "type": "varchar",
            "length": 30,
            "nullable": true,
            "group": "contact"
        },
        {
            "id": "web",
            "name": "Website",
            "name:cs": "Webová stránka",
            "name:en": "Website",
            "type": "varchar",
            "length": 200,
            "nullable": true,
            "group": "contact"
        },

        // --- documents ---

        // Výslovné přepsání jazyka dokumentů (#94 D1). NULL = automaticky
        // podle země (DocumentLanguageResolver). Čte se živě při tisku
        // i odeslání — do snapshotu strany nepatří.
        {
            "id": "language",
            "name": "Document language",
            "name:cs": "Jazyk dokumentů",
            "name:en": "Document language",
            "type": "enumString",
            "length": 2,
            "cfgItem": "world.base.documentLanguages",
            "nullable": true,
            "group": "documents"
        },

        // --- status ---

        {
            "id": "is_closed",
            "name": "Closed",
            "name:cs": "Uzavřeno",
            "name:en": "Closed",
            "type": "boolean",
            "default": 0,
            "group": "status"
        },
        {
            "id": "closed_date",
            "name": "Closed date",
            "name:cs": "Datum uzavření",
            "name:en": "Closed date",
            "type": "date",
            "nullable": true,
            "group": "status"
        },
        {
            "id": "is_own",
            "name": "Own company",
            "name:cs": "Vlastní firma",
            "name:en": "Own company",
            "type": "boolean",
            "default": 0,
            "group": "status"
        },

        // --- lineage ---

        {
            "id": "source_kind",
            "name": "Source kind",
            "name:cs": "Zdroj záznamu",
            "name:en": "Source kind",
            "type": "varchar",
            "length": 40,
            "nullable": true,
            "cfgItem": "base.persons.sourceKinds",
            "group": "lineage"
        },
        {
            "id": "source_ref",
            "name": "Source reference",
            "name:cs": "Identifikátor ve zdroji",
            "name:en": "Source reference",
            "type": "varchar",
            "length": 60,
            "nullable": true,
            "group": "lineage"
        },
        {
            "id": "source_imported_at",
            "name": "Imported at",
            "name:cs": "Importováno",
            "name:en": "Imported at",
            "type": "datetime",
            "nullable": true,
            "group": "lineage"
        },

        // --- doc state (systémové, bez skupiny) ---

        {
            "id": "docState",
            "name": "Document state",
            "name:cs": "Stav dokumentu",
            "name:en": "Document state",
            "type": "tinyint",
            "default": 10,
            "system": true
        },
        {
            "id": "docStateMain",
            "name": "Document state (sort)",
            "name:cs": "Stav dokumentu (řazení)",
            "name:en": "Document state (sort)",
            "type": "tinyint",
            "default": 1,
            "system": true
        }
    ],

    "indexes": [
        {
            "id": "unq_person_id",
            "type": "unique",
            "columns": [
                {"column": "person_id"}
            ]
        },
        {
            "id": "idx_full_name",
            "type": "index",
            "columns": [
                {"column": "full_name"}
            ]
        },
        {
            "id": "idx_last_name",
            "type": "index",
            "columns": [
                {"column": "last_name", "order": "ASC"},
                {"column": "first_name", "order": "ASC"}
            ]
        },
        {
            "id": "idx_company_id",
            "type": "index",
            "columns": [
                {"column": "company_id"}
            ]
        },
        {
            "id": "idx_email",
            "type": "index",
            "columns": [
                {"column": "email"}
            ]
        },
        {
            "id": "idx_doc_state",
            "type": "index",
            "columns": [
                {"column": "docStateMain", "order": "ASC"},
                {"column": "full_name", "order": "ASC"}
            ]
        },
        {
            "id": "ft_full_name",
            "type": "fulltext",
            "columns": [
                {"column": "full_name"}
            ]
        }
    ]
}
