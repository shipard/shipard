{
    "id": "base.persons",
    "name": "Persons",
    "name:cs": "Osoby",
    "name:en": "Persons",
    "description": "Suppliers, customers, employees and other persons",
    "description:cs": "Dodavatelé, odběratelé, zaměstnanci a další osoby",
    "description:en": "Suppliers, customers, employees and other persons",

    "dependencies": [
        "core.system",
        "core.alerts",
        "world.divisions",
        "world.trade",
    ],

    "tables": [
        "base_persons_persons",
        "base_persons_contacts",
        "base_persons_bank_accounts",
        "base_persons_addresses"
    ],

    // base_persons_persons má viewer base.persons (Osoby) a zůstává
    // v hlavní navigaci — do settings nepatří.
    "settingsItems": [
        { "table": "base_persons_contacts",      "section": "other", "subsection": "other.persons", "order": 10 },
        { "table": "base_persons_bank_accounts", "section": "other", "subsection": "other.persons", "order": 20 },
        { "table": "base_persons_addresses",     "section": "other", "subsection": "other.persons", "order": 30 }
    ],

    "viewers": [
        {
            "id": "base.persons",
            "name": "Persons",
            "name:cs": "Osoby",
            "name:en": "Persons",
            "icon": "user",
            "table": "base_persons_persons",
            "class": "Shipard\\Module\\Base\\Persons\\PersonsViewer",
            "navSection": "basic",
            "navOrder": 10
        }
    ],

    "forms": [
        {
            "table": "base_persons_persons",
            "class": "Shipard\\Module\\Base\\Persons\\PersonsForm"
        },
        {
            "table": "base_persons_contacts",
            "id": "base.persons.contacts"
        },
        {
            "table": "base_persons_addresses",
            "id": "base.persons.addresses"
        },
        {
            "table": "base_persons_bank_accounts",
            "id": "base.persons.bank_accounts"
        },
    ],

    "documentClasses": [
        {
            "table": "base_persons_persons",
            "class": "Shipard\\Module\\Base\\Persons\\PersonDocument"
        }
    ],

    "lookups": [
        {
            "table": "base_persons_persons",
            "class": "Shipard\\Module\\Base\\Persons\\PersonsLookup"
        },
        {
            "table": "base_persons_addresses",
            "class": "Shipard\\Module\\Base\\Persons\\AddressesLookup"
        },
        {
            "table": "base_persons_bank_accounts",
            "class": "Shipard\\Module\\Base\\Persons\\BankAccountsLookup"
        }
    ],

    "config": [
        {
            "id": "base.persons.personTypes",
            "file": "config/personTypes.jsonc"
        },
        {
            "id": "base.persons.bankAccountSources",
            "file": "config/bankAccountSources.jsonc"
        },
        {
            "id": "base.persons.addressTypes",
            "file": "config/addressTypes.jsonc"
        },
        {
            "id": "base.persons.placeRegTypes",
            "file": "config/placeRegTypes.jsonc"
        },
        {
            "id": "base.persons.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        },
        {
            "id": "base.persons.sourceKinds",
            "file": "config/sourceKinds.jsonc"
        },
        {
            "id": "base.persons.viewerDefaults",
            "file": "config/viewerDefaults.jsonc"
        },
        {
            "id": "base.persons.formLabels",
            "file": "config/formLabels.jsonc"
        },
    ],

    "alertChecks": [
        {
            "id": "base.persons.missing_own_person",
            "name": "Own Person is missing",
            "name:cs": "Chybí vlastní Osoba",
            "name:en": "Own Person is missing",
            "description": "Detects missing own legal entity (set up after creating a new data source).",
            "description:cs": "Detekuje chybějící vlastní právní subjekt (nastavuje se po vytvoření nového zdroje dat).",
            "description:en": "Detects missing own legal entity (set up after creating a new data source).",
            "class": "Shipard\\Module\\Base\\Persons\\Checks\\MissingOwnPersonCheck",
            "severity": "warning",
            "interval": "5m",
            "tags": ["setup"]
        },
        {
            "id": "base.persons.missing_own_headquarters",
            "name": "Own Person has no registered office",
            "name:cs": "Vlastní Osoba nemá sídlo",
            "name:en": "Own Person has no registered office",
            "description": "The own Person needs a Registered office address; it is printed on documents.",
            "description:cs": "Vlastní Osoba potřebuje adresu typu Sídlo — tiskne se na doklady.",
            "description:en": "The own Person needs a Registered office address; it is printed on documents.",
            "class": "Shipard\\Module\\Base\\Persons\\Checks\\MissingOwnHeadquartersCheck",
            "severity": "warning",
            "interval": "5m",
            "tags": ["setup"]
        }
    ]
}
