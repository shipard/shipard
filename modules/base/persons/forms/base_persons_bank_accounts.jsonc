{
    "title": "Bankovní účet",
    "title:cs": "Bankovní účet",
    "title:en": "Bank account",
    "titleNew": "Nový bankovní účet",
    "titleNew:cs": "Nový bankovní účet",
    "titleNew:en": "New bank account",
    "tabs": [
        {
            "id": "basic",
            "label": "Bankovní účet",
            "label:cs": "Bankovní účet",
            "label:en": "Bank account",
            "sections": [
                {
                    "title": "Účet",
                    "title:cs": "Účet",
                    "title:en": "Account",
                    "columns": [
                        {
                            "elements": [
                                {
                                    "type": "input",
                                    "column": "name"
                                },
                                // Číslo účtu nebo IBAN — aspoň jeden (#118 D28);
                                // sloupec je NOT NULL, takže `required` musí být
                                // vypnuté výslovně.
                                {
                                    "type": "input",
                                    "column": "account_number",
                                    "required": false
                                },
                                {
                                    "type": "input",
                                    "column": "iban"
                                },
                                {
                                    "type": "input",
                                    "column": "bic"
                                },
                                {
                                    "type": "input",
                                    "column": "currency"
                                },
                                {
                                    "type": "select",
                                    "column": "source"
                                }
                            ]
                        }
                    ]
                },
                {
                    "title": "Platnost",
                    "title:cs": "Platnost",
                    "title:en": "Validity",
                    "columns": [
                        {
                            "elements": [
                                {
                                    "type": "inline",
                                    "elements": [
                                        {
                                            "type": "input",
                                            "column": "valid_from"
                                        },
                                        {
                                            "type": "input",
                                            "column": "valid_to"
                                        }
                                    ]
                                },
                                {
                                    "type": "input",
                                    "column": "order_pos"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}