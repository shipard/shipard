{
    // Zakázky (docs/work-orders.md, #110): druhy zakázek s typem (D14),
    // číselné řady zakázek nad společným enginem čísel (D17), evidence
    // zakázek všech čtyř typů s nadřazenou zakázkou (D15, D18) a zakázka
    // jako standardní dimenze jádra (D20, D23 — sloupce v tabulkách jádra,
    // deklarace v economy.accounting). Fáze 1 = tasks/work-orders-phase1.md;
    // fáze 2 = tasks/work-orders-phase2.md: fakturační předpis periodické
    // zakázky (druh → zakázka → řádky), evidence období, denní běh přes
    // výměnný formát (src/Invoicing/).
    "id": "economy.workOrders",
    "name": "Work orders",
    "name:cs": "Zakázky",
    "name:en": "Work orders",
    "description": "Work orders: kinds with a type, number series, work order register and the work order journal dimension",
    "description:cs": "Zakázky: druhy s typem, číselné řady, evidence zakázek a dimenze deníku zakázka",
    "description:en": "Work orders: kinds with a type, number series, work order register and the work order journal dimension",

    "dependencies": ["core.system", "core.attachments", "base.persons", "economy.codebooks", "docs.core", "economy.accounting"],

    "tables": [
        "economy_work_orders_kinds",
        "economy_work_orders_number_series",
        "economy_work_orders_number_counters",
        "economy_work_orders_heads",
        "economy_work_orders_rows",
        "economy_work_orders_periods"
    ],

    // Nastavení → Zakázky (P1): druhy a číselné řady. Bez seedu — druhy
    // a řady zakládá uživatel nebo import.
    "settingsItems": [
        { "viewer": "economy.workOrders.kinds",        "section": "workOrders", "order": 10 },
        { "viewer": "economy.workOrders.numberSeries", "section": "workOrders", "order": 20 },
        { "page":   "workOrdersInvoicing",             "section": "workOrders", "order": 30 }
    ],

    // Nastavení → Zakázky → Periodická fakturace (fáze 2, D10): lhůta
    // čekání na podklady přispěvatele, po které se hlásí upozornění.
    "settingsPages": [
        {
            "id": "workOrdersInvoicing",
            "name": "Periodic invoicing",
            "name:cs": "Periodická fakturace",
            "name:en": "Periodic invoicing",
            "icon": "briefcase",
            "fields": [
                {
                    "id": "economy.workOrders.contributorWaitDays",
                    "type": "text",
                    "name": "Waiting for input (days)",
                    "name:cs": "Čekání na podklady (dny)",
                    "name:en": "Waiting for input (days)",
                    "hint": "Empty = 10. A period waiting for contributor input longer than this raises an alert.",
                    "hint:cs": "Prázdné = 10. Období, které čeká na podklady přispěvatele déle, ohlásí upozornění.",
                    "hint:en": "Empty = 10. A period waiting for contributor input longer than this raises an alert.",
                    "maxLength": 3
                }
            ]
        }
    ],

    // Upozornění periodické fakturace (fáze 2, §6): jeden souhrnný nález
    // konceptů ke kontrole, per zakázka selhání období, pojistka dohánění
    // a čekání na podklady. Id checku musí být malými písmeny
    // (AlertCheckDefinition), proto `workorders`, ne id modulu.
    "alertChecks": [
        {
            "id": "economy.workorders.invoices_to_review",
            "name": "Periodic invoicing drafts to review",
            "name:cs": "Koncepty z periodické fakturace ke kontrole",
            "name:en": "Periodic invoicing drafts to review",
            "description": "One summary finding: drafts issued by periodic invoicing waiting for review.",
            "description:cs": "Jeden souhrnný nález: koncepty vystavené periodickou fakturací čekají na kontrolu.",
            "description:en": "One summary finding: drafts issued by periodic invoicing waiting for review.",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\Checks\\InvoicesToReviewCheck",
            "severity": "info",
            "interval": "1h",
            "navSection": "workOrders",
            "tags": ["workOrders", "documents"]
        },
        {
            "id": "economy.workorders.period_failed",
            "name": "Periodic invoicing period failed",
            "name:cs": "Období periodické fakturace se nepodařilo vystavit",
            "name:en": "Periodic invoicing period failed",
            "description": "Per work order: periods the run could not issue (error, no valid row, missing series).",
            "description:cs": "Per zakázka: období, která běh nevystavil (chyba, žádný platný řádek, chybějící řada).",
            "description:en": "Per work order: periods the run could not issue (error, no valid row, missing series).",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\Checks\\PeriodFailedCheck",
            "severity": "warning",
            "interval": "1h",
            "navSection": "workOrders",
            "tags": ["workOrders"]
        },
        {
            "id": "economy.workorders.catchup_blocked",
            "name": "Periodic invoicing catch-up blocked",
            "name:cs": "Periodická fakturace čeká na vystavení dlužných období",
            "name:en": "Periodic invoicing catch-up blocked",
            "description": "Per work order: more than three due periods — the run stops, use Issue due periods.",
            "description:cs": "Per zakázka: víc než tři dlužná období — běh je nevystaví, použij Vystavit dlužná období.",
            "description:en": "Per work order: more than three due periods — the run stops, use Issue due periods.",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\Checks\\CatchupBlockedCheck",
            "severity": "warning",
            "interval": "1d",
            "navSection": "workOrders",
            "tags": ["workOrders"]
        },
        {
            "id": "economy.workorders.period_waiting",
            "name": "Periodic invoicing period waiting for input",
            "name:cs": "Období periodické fakturace čeká na podklady",
            "name:en": "Periodic invoicing period waiting for input",
            "description": "Per work order: periods waiting for contributor input longer than the limit, or with input ready but a manually edited draft.",
            "description:cs": "Per zakázka: období čekající na podklady déle než lhůta, nebo s podklady a ručně upraveným konceptem.",
            "description:en": "Per work order: periods waiting for contributor input longer than the limit, or with input ready but a manually edited draft.",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\Checks\\PeriodWaitingCheck",
            "severity": "warning",
            "interval": "1d",
            "navSection": "workOrders",
            "tags": ["workOrders"]
        }
    ],

    "viewers": [
        {
            // Sekce sidebaru Zakázky (P1, navSections.jsonc v install.base).
            // Spodní taby = číselné řady (P6), detail s Přehledem a Deníkem.
            "id": "economy.workOrders.heads",
            "name": "Work orders",
            "name:cs": "Zakázky",
            "name:en": "Work orders",
            "icon": "briefcase",
            "table": "economy_work_orders_heads",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\WorkOrdersViewer",
            "navSection": "workOrders",
            "navOrder": 10
        },
        {
            "id": "economy.workOrders.kinds",
            "name": "Work order kinds",
            "name:cs": "Druhy zakázek",
            "name:en": "Work order kinds",
            "icon": "kinds",
            "table": "economy_work_orders_kinds",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\KindsViewer"
        },
        {
            "id": "economy.workOrders.numberSeries",
            "name": "Work order number series",
            "name:cs": "Číselné řady zakázek",
            "name:en": "Work order number series",
            "icon": "hash",
            "table": "economy_work_orders_number_series",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\WorkOrderSeriesViewer"
        }
    ],

    "forms": [
        {
            "table": "economy_work_orders_heads",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\WorkOrdersForm"
        },
        {
            "table": "economy_work_orders_kinds",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\KindsForm"
        },
        {
            "table": "economy_work_orders_number_series",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\WorkOrderSeriesForm"
        },
        {
            // Řádek předpisu — sub-formulář tabu Řádky zakázky (fáze 2).
            "table": "economy_work_orders_rows",
            "id": "economy.workOrders.rows",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\WorkOrderRowsForm"
        }
    ],

    "documentClasses": [
        {
            "table": "economy_work_orders_heads",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\WorkOrderDocument"
        },
        {
            "table": "economy_work_orders_rows",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\WorkOrderRowDocument"
        },
        {
            "table": "economy_work_orders_kinds",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\KindDocument"
        },
        {
            "table": "economy_work_orders_number_series",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\WorkOrderSeriesDocument"
        }
    ],

    // Lookup zakázky: pole Nadřazená zakázka (filtr role=parent) a od
    // fáze dimenzí pole Zakázka na hlavičce a řádcích dokladů.
    "lookups": [
        {
            "table": "economy_work_orders_heads",
            "class": "Shipard\\Module\\Economy\\WorkOrders\\WorkOrdersLookup"
        }
    ],

    "config": [
        {
            // Stavy zakázky (D18, P2) — vlastní sada s Ukončeno a Zrušeno.
            "id": "economy.workOrders.docStates",
            "file": "config/docStates.jsonc"
        },
        {
            // Typy zakázek s příznaky (D14) — jediné čtení WorkOrderTypes.
            "id": "economy.workOrders.types",
            "file": "config/types.jsonc"
        },
        {
            "id": "economy.workOrders.viewerLabels",
            "file": "config/viewerLabels.jsonc"
        },
        {
            // Periodicita periodické zakázky (D2, Q3) — PeriodCalendar.
            "id": "economy.workOrders.periodicities",
            "file": "config/periodicities.jsonc"
        },
        {
            // Fakturace na počátku / konci období (D6).
            "id": "economy.workOrders.invoiceTimings",
            "file": "config/invoiceTimings.jsonc"
        },
        {
            // Stavy období fakturace (D5, D10) — PeriodRepository, záložka Fakturace.
            "id": "economy.workOrders.periodStates",
            "file": "config/periodStates.jsonc"
        },
        {
            // Tvar {období} v jazycích dokumentů (D12, Q6) — PeriodLabel.
            "id": "economy.workOrders.periodTexts",
            "file": "config/periodTexts.jsonc"
        }
    ]
}
