{
    "id": "economy.items",
    "name": "Items",
    "name:cs": "Položky",
    "name:en": "Items",
    "description": "Catalog of items (goods, services, accounting items, …) and their kinds",
    "description:cs": "Katalog položek (zboží, služby, účetní položky, …) a jejich druhů",
    "description:en": "Catalog of items (goods, services, accounting items, …) and their kinds",

    "dependencies": [
        "core.system",
        "core.units"
    ],

    "tables": [
        "economy_items",
        "economy_items_kinds",
        "economy_items_supplier_codes"
    ],

    "settingsItems": [
        { "viewer": "economy.items.kinds", "section": "items", "order": 10 },
        { "panel": "contentTags", "section": "items", "order": 20 }
    ],

    "panels": [
        {
            // Nastavení → Položky → Obsahové štítky (tasks/content-tag-ui.md
            // D27): přehled mapování taxonomie + reverzní otagování položek.
            // Ručně psaný panel — server-driven settings page tabulku
            // s akcemi neunese (vzor dsSetup).
            "id": "contentTags",
            "name": "Content tags",
            "name:cs": "Obsahové štítky",
            "name:en": "Content tags",
            "icon": "tags"
        }
    ],

    "viewers": [
        {
            "id": "economy.items",
            "name": "Items",
            "name:cs": "Položky",
            "name:en": "Items",
            "icon": "items",
            "table": "economy_items",
            "class": "Shipard\\Module\\Economy\\Items\\ItemsViewer",
            "detailHeader": {"title": "{name}", "subtitle": "{code}"},
            "navSection": "basic",
            "navOrder": 20
        },
        {
            "id": "economy.items.kinds",
            "name": "Item kinds",
            "name:cs": "Druhy položek",
            "name:en": "Item kinds",
            "icon": "kinds",
            "table": "economy_items_kinds",
            "class": "Shipard\\Module\\Economy\\Items\\ItemKindsViewer"
        }
    ],

    "forms": [
        {
            "table": "economy_items",
            "class": "Shipard\\Module\\Economy\\Items\\ItemsForm"
        },
        {
            "table": "economy_items_kinds",
            "class": "Shipard\\Module\\Economy\\Items\\ItemKindsForm"
        }
    ],

    "lookups": [
        {
            "table": "economy_items",
            "class": "Shipard\\Module\\Economy\\Items\\ItemsLookup"
        }
    ],

    "documentClasses": [
        {
            "table": "economy_items",
            "class": "Shipard\\Module\\Economy\\Items\\ItemDocument"
        },
        {
            "table": "economy_items_kinds",
            "class": "Shipard\\Module\\Economy\\Items\\ItemKindDocument"
        }
    ],

    "config": [
        {
            "id": "economy.items.itemTypes",
            "file": "config/itemTypes.jsonc"
        },
        {
            "id": "economy.items.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        },
        {
            "id": "economy.items.sourceKinds",
            "file": "config/sourceKinds.jsonc"
        },
        {
            "id": "economy.items.contentTagDefaults",
            "file": "config/contentTagDefaults.jsonc"
        }
    ]
}
