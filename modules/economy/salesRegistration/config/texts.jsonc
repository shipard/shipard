{
    // economy.salesRegistration.texts
    //
    // Texty doplňku mimo viewer a formulář — akce záznamu a jejich hlášky.
    // Čte `Texts::t()` ze sekce `texts`. Holé `name` je anglická varianta
    // a shoduje se s fallbackem v PHP znak po znaku (hlídá
    // SalesRegistrationTextsTest). Parametry `{param}` se nahrazují prostě,
    // bez skloňování.
    "texts": {
        // --- Akce Nahrát certifikát (#171 D11) ---
        "upload.label": { "name": "Upload certificate", "name:cs": "Nahrát certifikát", "name:en": "Upload certificate" },
        "upload.title": { "name": "Upload certificate", "name:cs": "Nahrát certifikát", "name:en": "Upload certificate" },
        "upload.notice": {
            "name": "The private key is stored encrypted, the password is not stored. The taxpayer identifier and validity are read from the certificate.",
            "name:cs": "Soukromý klíč se uloží šifrovaně, heslo se neukládá. Identifikátor poplatníka a platnost se převezmou z certifikátu.",
            "name:en": "The private key is stored encrypted, the password is not stored. The taxpayer identifier and validity are read from the certificate."
        },
        "upload.noticeReplace": {
            "name": "The new certificate replaces the current one. The private key is stored encrypted, the password is not stored.",
            "name:cs": "Nový certifikát nahradí dosavadní. Soukromý klíč se uloží šifrovaně, heslo se neukládá.",
            "name:en": "The new certificate replaces the current one. The private key is stored encrypted, the password is not stored."
        },
        "upload.file": { "name": "Certificate file (.p12)", "name:cs": "Soubor certifikátu (.p12)", "name:en": "Certificate file (.p12)" },
        "upload.password": { "name": "Certificate password", "name:cs": "Heslo k certifikátu", "name:en": "Certificate password" },
        "upload.submit": { "name": "Upload", "name:cs": "Nahrát", "name:en": "Upload" },
        "upload.done": {
            "name": "Certificate uploaded — {label} {taxpayerId}, valid until {validTo}.",
            "name:cs": "Certifikát nahrán — {label} {taxpayerId}, platnost do {validTo}.",
            "name:en": "Certificate uploaded — {label} {taxpayerId}, valid until {validTo}."
        },
        "upload.errorType": {
            "name": "The registration type is not available in this data source.",
            "name:cs": "Typ evidence této registrace není ve zdroji dat dostupný.",
            "name:en": "The registration type is not available in this data source."
        },
        "upload.errorNoFile": { "name": "Choose the certificate file.", "name:cs": "Vyberte soubor certifikátu.", "name:en": "Choose the certificate file." },
        "upload.errorStore": { "name": "The certificate cannot be stored.", "name:cs": "Certifikát se nepodařilo uložit.", "name:en": "The certificate cannot be stored." },
        "upload.errorPassword": {
            "name": "The password does not open the certificate file.",
            "name:cs": "Heslo k souboru certifikátu nesouhlasí.",
            "name:en": "The password does not open the certificate file."
        },
        "upload.errorNotCertificate": {
            "name": "The file is not a certificate with a private key (.p12).",
            "name:cs": "Soubor není certifikát se soukromým klíčem (.p12).",
            "name:en": "The file is not a certificate with a private key (.p12)."
        },
        "upload.errorExpired": {
            "name": "The certificate has expired ({validTo}). Issue a new one and upload it.",
            "name:cs": "Certifikát už vypršel ({validTo}). Vystavte nový a nahrajte ho.",
            "name:en": "The certificate has expired ({validTo}). Issue a new one and upload it."
        },
        "upload.errorNotYetValid": {
            "name": "The certificate is not valid yet (from {validFrom}).",
            "name:cs": "Certifikát ještě neplatí (až od {validFrom}).",
            "name:en": "The certificate is not valid yet (from {validFrom})."
        },
        "upload.errorNotForType": {
            "name": "This is not a certificate for {type}: its name “{commonName}” is not a valid {label}.",
            "name:cs": "Nejde o certifikát pro {type}: jeho jméno „{commonName}“ není platné {label}.",
            "name:en": "This is not a certificate for {type}: its name “{commonName}” is not a valid {label}."
        },
        "upload.errorKeyMismatch": {
            "name": "The private key in the file does not belong to the certificate.",
            "name:cs": "Soukromý klíč v souboru nepatří k certifikátu.",
            "name:en": "The private key in the file does not belong to the certificate."
        },
        "upload.errorLegacy": {
            "name": "The file uses an outdated cipher that this server cannot convert — the openssl program is missing. Contact the administrator.",
            "name:cs": "Soubor používá zastaralou šifru, kterou tento server neumí převést — chybí program openssl. Obraťte se na správce.",
            "name:en": "The file uses an outdated cipher that this server cannot convert — the openssl program is missing. Contact the administrator."
        },
        "upload.errorOtherTaxpayer": {
            "name": "The certificate belongs to another taxpayer ({certificate}) than this registration ({registration}).",
            "name:cs": "Certifikát patří jinému poplatníkovi ({certificate}) než tato registrace ({registration}).",
            "name:en": "The certificate belongs to another taxpayer ({certificate}) than this registration ({registration})."
                },

        // --- Kam zprávy jdou (pojistka serveru × režim registrace, #171 D9) ---
        "route.droppedTitle": { "name": "Messages are not sent", "name:cs": "Zprávy se neodesílají", "name:en": "Messages are not sent" },
        "route.dropDefault": {
            "name": "Server safety switch: this server is not marked as production and has no salesRegistration section in server.json — nothing is sent.",
            "name:cs": "Pojistka serveru: server není označený jako produkční a v server.json nemá sekci salesRegistration — nic se neodešle.",
            "name:en": "Server safety switch: this server is not marked as production and has no salesRegistration section in server.json — nothing is sent."
        },
        "route.dropInvalid": {
            "name": "Server safety switch: the salesRegistration section in server.json is invalid ({problem}) — nothing is sent.",
            "name:cs": "Pojistka serveru: sekce salesRegistration v server.json je chybná ({problem}) — nic se neodešle.",
            "name:en": "Server safety switch: the salesRegistration section in server.json is invalid ({problem}) — nothing is sent."
        },
        "route.dropConfigured": {
            "name": "Server safety switch is set to drop — nothing is sent.",
            "name:cs": "Pojistka serveru je v režimu drop — nic se neodešle.",
            "name:en": "Server safety switch is set to drop — nothing is sent."
        },
        "route.dropUnknownMode": {
            "name": "The registration has an unknown mode — nothing is sent.",
            "name:cs": "Registrace má neznámý režim — nic se neodešle.",
            "name:en": "The registration has an unknown mode — nothing is sent."
        },
        "route.playgroundTitle": { "name": "Messages go to the playground", "name:cs": "Zprávy jdou na playground", "name:en": "Messages go to the playground" },
        "route.playground": {
            "name": "Messages go to the non-production environment under the shared test identity {taxpayerId}, never under the certificate of this registration. Nothing is registered.",
            "name:cs": "Zprávy jdou do neprodukčního prostředí pod sdílenou testovací identitou {taxpayerId}, nikdy s certifikátem této registrace. Nic se neeviduje.",
            "name:en": "Messages go to the non-production environment under the shared test identity {taxpayerId}, never under the certificate of this registration. Nothing is registered."
        },
        "route.playgroundNoIdentity": {
            "name": "Messages should go to the non-production environment, but this registration type has no test identity — nothing can be sent.",
            "name:cs": "Zprávy by měly jít do neprodukčního prostředí, ale typ evidence nemá testovací identitu — nic odeslat nejde.",
            "name:en": "Messages should go to the non-production environment, but this registration type has no test identity — nothing can be sent."
        },
        "route.verificationTitle": { "name": "Messages go to production in verification mode", "name:cs": "Zprávy jdou do produkce v ověřovacím módu", "name:en": "Messages go to production in verification mode" },
        "route.verification": {
            "name": "Messages are signed with the certificate of this registration and sent to the production service in verification mode. Nothing is registered and the obligation is not fulfilled.",
            "name:cs": "Zprávy se podepisují certifikátem této registrace a jdou do produkce v ověřovacím módu. Nic se neeviduje a evidenční povinnost se tím neplní.",
            "name:en": "Messages are signed with the certificate of this registration and sent to the production service in verification mode. Nothing is registered and the obligation is not fulfilled."
        },
        "route.productionTitle": { "name": "Messages go to production", "name:cs": "Zprávy jdou do produkce", "name:en": "Messages go to production" },
        "route.production": {
            "name": "Messages are signed with the certificate of this registration and registered with the tax authority.",
            "name:cs": "Zprávy se podepisují certifikátem této registrace a evidují se u správce daně.",
            "name:en": "Messages are signed with the certificate of this registration and registered with the tax authority."
        },

        // --- Akce Ověřit spojení (#171 U4) ---
        "verify.label": { "name": "Verify connection", "name:cs": "Ověřit spojení", "name:en": "Verify connection" },
        "verify.confirm": { "name": "A test message of 0.00 is sent in verification mode — nothing is registered. Continue?", "name:cs": "Odešle se zkušební zpráva na 0,00 v ověřovacím módu — nic se neeviduje. Pokračovat?", "name:en": "A test message of 0.00 is sent in verification mode — nothing is registered. Continue?" },
        "verify.errorType": { "name": "The registration type is not available in this data source.", "name:cs": "Typ evidence této registrace není ve zdroji dat dostupný.", "name:en": "The registration type is not available in this data source." },
        "verify.errorNoUnit": { "name": "The registration has no default registration unit.", "name:cs": "Registrace nemá výchozí evidenční jednotku.", "name:en": "The registration has no default registration unit." },
        "verify.errorNoDataSource": { "name": "The connection cannot be verified outside a data source.", "name:cs": "Spojení nejde ověřit mimo zdroj dat.", "name:en": "The connection cannot be verified outside a data source." },
        "verify.ok": { "name": "Connection verified — {where}.", "name:cs": "Spojení ověřeno — {where}.", "name:en": "Connection verified — {where}." },
        "verify.warnings": { "name": "Warnings of the service: {warnings}", "name:cs": "Varování služby: {warnings}", "name:en": "Warnings of the service: {warnings}" },
        "verify.envProduction": { "name": "production", "name:cs": "produkce", "name:en": "production" },
        "verify.envPlayground": { "name": "playground", "name:cs": "playground", "name:en": "playground" },
        "verify.identityTest": { "name": "shared test identity {taxpayerId}", "name:cs": "sdílená testovací identita {taxpayerId}", "name:en": "shared test identity {taxpayerId}" },
        "verify.identityRegistration": { "name": "certificate of the registration {taxpayerId}", "name:cs": "certifikát registrace {taxpayerId}", "name:en": "certificate of the registration {taxpayerId}" },
        "verify.noCertificate": { "name": "The registration has no certificate — upload it first.", "name:cs": "Registrace nemá certifikát — nejdřív ho nahrajte.", "name:en": "The registration has no certificate — upload it first." },
        "verify.keyUnusable": { "name": "The certificate of the registration cannot be used — upload it again.", "name:cs": "Certifikát registrace nejde použít — nahrajte ho znovu.", "name:en": "The certificate of the registration cannot be used — upload it again." },
        "verify.noTestIdentity": { "name": "This registration type has no test identity for the non-production environment.", "name:cs": "Typ evidence nemá testovací identitu pro neprodukční prostředí.", "name:en": "This registration type has no test identity for the non-production environment." },
        "verify.noEnvironment": { "name": "This registration type has no address of the target environment.", "name:cs": "Typ evidence nemá adresu cílového prostředí.", "name:en": "This registration type has no address of the target environment." },
        "verify.messageInvalid": { "name": "The test message could not be built: {text}", "name:cs": "Zkušební zprávu se nepodařilo sestavit: {text}", "name:en": "The test message could not be built: {text}" },
        "verify.internal": { "name": "The test message could not be sent because of an internal error — see the server log.", "name:cs": "Zkušební zprávu se nepodařilo odeslat kvůli vnitřní chybě — podrobnosti jsou v logu serveru.", "name:en": "The test message could not be sent because of an internal error — see the server log." },
        "verify.retryLater": { "name": "The service is temporarily unavailable ({where}) — code {code}: {text} Try again later.", "name:cs": "Služba je dočasně nedostupná ({where}) — kód {code}: {text} Zkuste to později.", "name:en": "The service is temporarily unavailable ({where}) — code {code}: {text} Try again later." },
        "verify.rejected": { "name": "The service refused the message ({where}) — code {code}: {text}", "name:cs": "Služba zprávu odmítla ({where}) — kód {code}: {text}", "name:en": "The service refused the message ({where}) — code {code}: {text}" },
        "verify.untrusted": { "name": "The response of the service cannot be trusted ({where}): {text}", "name:cs": "Odpovědi služby nelze věřit ({where}): {text}", "name:en": "The response of the service cannot be trusted ({where}): {text}" },
        "verify.noResponse": { "name": "No valid response from the service ({where}): {text}", "name:cs": "Služba neodpověděla platnou odpovědí ({where}): {text}", "name:en": "No valid response from the service ({where}): {text}" },

        // --- Evidenční jednotka na číselné řadě (#171 D21) ---
        "series.tab": { "name": "Sales registration", "name:cs": "Evidence tržeb", "name:en": "Sales registration" },
        "series.unitHint": {
            "name": "Sales of documents in this series are registered under this unit. Left empty, the default unit of the registration applies. The series code is sent as the cash register identifier.",
            "name:cs": "Tržby dokladů této řady se evidují pod touto jednotkou. Bez výběru platí výchozí jednotka registrace. Kód řady se posílá jako označení pokladního zařízení.",
            "name:en": "Sales of documents in this series are registered under this unit. Left empty, the default unit of the registration applies. The series code is sent as the cash register identifier."
        },
        "series.unitUnknown": { "name": "The selected registration unit does not exist.", "name:cs": "Vybraná evidenční jednotka neexistuje.", "name:en": "The selected registration unit does not exist." },
        "series.codeRequired": {
            "name": "A series with a registration unit needs a code — it is sent as the cash register identifier.",
            "name:cs": "Řada s evidenční jednotkou musí mít kód — posílá se jako označení pokladního zařízení.",
            "name:en": "A series with a registration unit needs a code — it is sent as the cash register identifier."
        },
        "series.codeInvalid": {
            "name": "The series code \"{code}\" cannot be used as a cash register identifier of {type}{hint}. Change the code or remove the registration unit.",
            "name:cs": "Kód řady „{code}“ nejde použít jako označení pokladního zařízení evidence {type}{hint}. Změňte kód, nebo odeberte evidenční jednotku.",
            "name:en": "The series code \"{code}\" cannot be used as a cash register identifier of {type}{hint}. Change the code or remove the registration unit."
        },

        // --- Doklad s tržbou (#171 U12) ---
        "doc.trashWithSale": {
            "name": "The document has a sale registered with the tax authority and cannot be deleted. Cancel it instead — the cancellation registers a negative sale.",
            "name:cs": "Doklad má tržbu v evidenci tržeb a nejde smazat. Stornujte ho — storno zaeviduje zápornou tržbu.",
            "name:en": "The document has a sale registered with the tax authority and cannot be deleted. Cancel it instead — the cancellation registers a negative sale."
        },
        "doc.deleteWithSale": {
            "name": "The document has a sale registered with the tax authority and cannot be deleted.",
            "name:cs": "Doklad má tržbu v evidenci tržeb a nejde smazat.",
            "name:en": "The document has a sale registered with the tax authority and cannot be deleted."
        },

        // --- Akce Odeslat znovu nad tržbou (#171 U12) ---
        "resend.label": { "name": "Send again", "name:cs": "Odeslat znovu", "name:en": "Send again" },
        "resend.confirm": { "name": "The sale is sent to the sales registration service again with the same data. Continue?", "name:cs": "Tržba se pošle do evidence tržeb znovu se stejnými daty. Pokračovat?", "name:en": "The sale is sent to the sales registration service again with the same data. Continue?" },
        "resend.errorNoDataSource": { "name": "The sale cannot be sent outside a data source.", "name:cs": "Tržbu nejde odeslat mimo zdroj dat.", "name:en": "The sale cannot be sent outside a data source." },
        "resend.errorState": { "name": "The sale is not waiting to be sent — it has been settled in the meantime.", "name:cs": "Tržba nečeká na odeslání — mezitím byla vyřízena.", "name:en": "The sale is not waiting to be sent — it has been settled in the meantime." },
        "resend.queued": { "name": "The sale was returned to the queue; another process is sending it right now.", "name:cs": "Tržba se vrátila do fronty; právě ji posílá jiný proces.", "name:en": "The sale was returned to the queue; another process is sending it right now." },
        "resend.confirmed": { "name": "The sale was confirmed.", "name:cs": "Tržba byla potvrzena.", "name:en": "The sale was confirmed." },
        "resend.verified": { "name": "The sale was verified — the registration is in verification mode, nothing was registered.", "name:cs": "Tržba byla ověřena — registrace je v ověřovacím režimu, nic se nezaevidovalo.", "name:en": "The sale was verified — the registration is in verification mode, nothing was registered." },
        "resend.dropped": { "name": "The message was stopped by the safety switch of this server — nothing was sent.", "name:cs": "Zprávu zastavila pojistka tohoto serveru — nic se neodeslalo.", "name:en": "The message was stopped by the safety switch of this server — nothing was sent." },
        "resend.failed": { "name": "The service rejected the sale: {error}", "name:cs": "Služba tržbu odmítla: {error}", "name:en": "The service rejected the sale: {error}" },
        "resend.retry": { "name": "The sale could not be sent now; the next attempt is scheduled for {next}. See the Attempts tab for the reason.", "name:cs": "Tržbu teď odeslat nešlo; další pokus je naplánovaný na {next}. Důvod je v záložce Pokusy.", "name:en": "The sale could not be sent now; the next attempt is scheduled for {next}. See the Attempts tab for the reason." },

        // --- Kontaktní platba (#171 D8b, U14, U16, U17, U22) ---
        "contactPayment.errorTime": { "name": "The payment time is not a valid date and time.", "name:cs": "Čas platby není platné datum a čas.", "name:en": "The payment time is not a valid date and time." },
        "contactPayment.errorNoRegistration": {
            "name": "Contact payment cannot be set — there is no confirmed sales registration.",
            "name:cs": "Kontaktní platbu nejde nastavit — žádná registrace k evidenci tržeb není V pořádku.",
            "name:en": "Contact payment cannot be set — there is no confirmed sales registration."
        },
        "contactPayment.errorNotAllowed": {
            "name": "Contact payment cannot be set for this document and payment method. It is meant for an invoice paid by bank transfer that the customer paid on the spot; a document paid in cash or by card is registered automatically, and payment gateway, set-off and cash on delivery are not contact payments.",
            "name:cs": "Kontaktní platbu u tohoto dokladu a způsobu platby nastavit nejde. Je určená pro fakturu se způsobem platby Převodem, kterou zákazník zaplatil na místě; doklad placený hotově nebo kartou se eviduje sám a platební brána, zápočet ani dobírka kontaktní platbou nejsou.",
            "name:en": "Contact payment cannot be set for this document and payment method. It is meant for an invoice paid by bank transfer that the customer paid on the spot; a document paid in cash or by card is registered automatically, and payment gateway, set-off and cash on delivery are not contact payments."
        },
        "contactPayment.errorFuture": { "name": "The payment time must not be in the future.", "name:cs": "Čas platby nesmí být v budoucnu.", "name:en": "The payment time must not be in the future." },
        "contactPayment.tab": { "name": "Sales registration", "name:cs": "Evidence tržeb", "name:en": "Sales registration" },
        "contactPayment.section": { "name": "Contact payment", "name:cs": "Kontaktní platba", "name:en": "Contact payment" },
        "contactPayment.formHint": { "name": "Tick when the customer paid an invoice issued for bank transfer on the spot — by QR code or by card on a terminal. The whole amount of the document is then registered as a sale once the document is confirmed. Do not use it for payments over the internet (payment method Payment gateway). The flag does not change the payment method or the accounting of the document.", "name:cs": "Zaškrtněte, když zákazník fakturu se způsobem platby Převodem zaplatil na místě — QR kódem nebo kartou na terminálu. Celá částka dokladu se pak po přechodu dokladu do stavu V pořádku zaeviduje jako tržba. Nepoužívejte pro platby přes internet (způsob platby Platební bránou). Na způsob platby ani na zaúčtování dokladu příznak nemá vliv.", "name:en": "Tick when the customer paid an invoice issued for bank transfer on the spot — by QR code or by card on a terminal. The whole amount of the document is then registered as a sale once the document is confirmed. Do not use it for payments over the internet (payment method Payment gateway). The flag does not change the payment method or the accounting of the document." },
        "contactPayment.formTimeHint": { "name": "When the customer paid. Left empty, the time the document is confirmed applies.", "name:cs": "Kdy zákazník zaplatil. Prázdné = čas přechodu dokladu do stavu V pořádku.", "name:en": "When the customer paid. Left empty, the time the document is confirmed applies." },
        "contactPayment.label": { "name": "Contact payment", "name:cs": "Kontaktní platba", "name:en": "Contact payment" },
        "contactPayment.title": { "name": "Contact payment", "name:cs": "Kontaktní platba", "name:en": "Contact payment" },
        "contactPayment.intro": { "name": "The customer paid the document on the spot — by QR code or by card on a terminal. The whole amount of the document is registered as a sale and sent right away. The payment method and the accounting of the document do not change.", "name:cs": "Zákazník doklad zaplatil na místě — QR kódem nebo kartou na terminálu. Celá částka dokladu se zaeviduje jako tržba a hned se odešle. Způsob platby ani zaúčtování dokladu se nemění.", "name:en": "The customer paid the document on the spot — by QR code or by card on a terminal. The whole amount of the document is registered as a sale and sent right away. The payment method and the accounting of the document do not change." },
        "contactPayment.submit": { "name": "Register the sale", "name:cs": "Zaevidovat tržbu", "name:en": "Register the sale" },
        "contactPayment.paidAt": { "name": "Payment time", "name:cs": "Čas platby", "name:en": "Payment time" },
        "contactPayment.paidAtHint": { "name": "When the customer paid. It must not be in the future.", "name:cs": "Kdy zákazník zaplatil. Nesmí být v budoucnu.", "name:en": "When the customer paid. It must not be in the future." },
        "contactPayment.paidByCashDocument": { "name": "Warning: the document is already paid by cash document {numbers}, which is registered as a sale. A contact payment would register the same sale twice.", "name:cs": "Pozor: doklad už hradí pokladní doklad {numbers}, který se eviduje jako tržba. Kontaktní platbou by se tatáž tržba zaevidovala dvakrát.", "name:en": "Warning: the document is already paid by cash document {numbers}, which is registered as a sale. A contact payment would register the same sale twice." },
        "contactPayment.errorNoDataSource": { "name": "Contact payment cannot be set outside a data source.", "name:cs": "Kontaktní platbu nejde nastavit mimo zdroj dat.", "name:en": "Contact payment cannot be set outside a data source." },
        "contactPayment.errorTimeRequired": { "name": "Enter the payment time.", "name:cs": "Zadejte čas platby.", "name:en": "Enter the payment time." },
        "contactPayment.errorNotApplicable": { "name": "The document would not fall under sales registration: {reason}", "name:cs": "Doklad by do evidence tržeb nespadl: {reason}", "name:en": "The document would not fall under sales registration: {reason}" },
        "contactPayment.errorConflict": { "name": "The document has changed in the meantime — reload it and try again.", "name:cs": "Doklad se mezitím změnil — načtěte ho znovu a akci zopakujte.", "name:en": "The document has changed in the meantime — reload it and try again." },
        "contactPayment.resultLater": { "name": "The change was saved; the sale is created and sent automatically within a few minutes.", "name:cs": "Změna je uložena; tržba vznikne a odešle se sama během několika minut.", "name:en": "The change was saved; the sale is created and sent automatically within a few minutes." },
        "contactPayment.resultNone": { "name": "The change was saved; there is no sale to register.", "name:cs": "Změna je uložena; k evidenci není žádná tržba.", "name:en": "The change was saved; there is no sale to register." },
        "contactPayment.resultUnregistrable": { "name": "The change was saved, but the sale cannot be created: {reason} Once the settings are fixed, the sale is created automatically with the original time.", "name:cs": "Změna je uložena, ale tržbu nejde založit: {reason} Po opravě nastavení tržba vznikne sama s původním časem.", "name:en": "The change was saved, but the sale cannot be created: {reason} Once the settings are fixed, the sale is created automatically with the original time." },
        "contactPayment.resultQueued": { "name": "Sale {number} for {amount} was created and waits in the queue; it is sent automatically.", "name:cs": "Tržba {number} na {amount} vznikla a čeká ve frontě; odešle se sama.", "name:en": "Sale {number} for {amount} was created and waits in the queue; it is sent automatically." },
        "contactPayment.resultConfirmed": { "name": "Sale {number} for {amount} was registered and confirmed.", "name:cs": "Tržba {number} na {amount} byla zaevidována a potvrzena.", "name:en": "Sale {number} for {amount} was registered and confirmed." },
        "contactPayment.resultVerified": { "name": "Sale {number} for {amount} was verified — the registration is in verification mode, nothing was registered.", "name:cs": "Tržba {number} na {amount} byla ověřena — registrace je v ověřovacím režimu, nic se nezaevidovalo.", "name:en": "Sale {number} for {amount} was verified — the registration is in verification mode, nothing was registered." },
        "contactPayment.resultDropped": { "name": "Sale {number} for {amount} was created, but the message was stopped by the safety switch of this server — nothing was sent.", "name:cs": "Tržba {number} na {amount} vznikla, ale zprávu zastavila pojistka tohoto serveru — nic se neodeslalo.", "name:en": "Sale {number} for {amount} was created, but the message was stopped by the safety switch of this server — nothing was sent." },
        "contactPayment.resultFailed": { "name": "Sale {number} for {amount} was created, but the service rejected it: {error}", "name:cs": "Tržba {number} na {amount} vznikla, ale služba ji odmítla: {error}", "name:en": "Sale {number} for {amount} was created, but the service rejected it: {error}" },
        "contactPayment.resultRetry": { "name": "Sale {number} for {amount} was created, but it could not be sent now; the next attempt is scheduled for {next}.", "name:cs": "Tržba {number} na {amount} vznikla, ale teď ji odeslat nešlo; další pokus je naplánovaný na {next}.", "name:en": "Sale {number} for {amount} was created, but it could not be sent now; the next attempt is scheduled for {next}." },
        "contactPaymentCancel.label": { "name": "Cancel contact payment", "name:cs": "Zrušit kontaktní platbu", "name:en": "Cancel contact payment" },
        "contactPaymentCancel.confirm": { "name": "The contact payment of the document is cancelled and a negative sale is sent to the sales registration service to settle the registered one. Continue?", "name:cs": "Kontaktní platba dokladu se zruší a do evidence tržeb se pošle záporná tržba, která vyrovná tu zaevidovanou. Pokračovat?", "name:en": "The contact payment of the document is cancelled and a negative sale is sent to the sales registration service to settle the registered one. Continue?" },
        "contactPaymentCancel.errorNoDataSource": { "name": "Contact payment cannot be cancelled outside a data source.", "name:cs": "Kontaktní platbu nejde zrušit mimo zdroj dat.", "name:en": "Contact payment cannot be cancelled outside a data source." },

        // --- Upozornění na tržby ve frontě a na doklady, které nejde zaevidovat (#171 D13, D25, U9) ---
        "alert.openSales": { "name": "Open sales registration", "name:cs": "Otevřít evidenci tržeb", "name:en": "Open sales registration" },
        "alert.unconfirmedTitle": { "name": "Sales waiting for confirmation: {count} ({name})", "name:cs": "Tržby čekají na potvrzení: {count} ({name})", "name:en": "Sales waiting for confirmation: {count} ({name})" },
        "alert.unconfirmedMessage": { "name": "Sales of registration {name} have been waiting for confirmation for more than an hour — the oldest since {oldest}. They are sent again automatically; the reason is in the Attempts tab of the sale. Sales must be registered within 48 hours.", "name:cs": "Tržby registrace {name} čekají na potvrzení déle než hodinu — nejstarší od {oldest}. Odesílají se znovu automaticky; důvod je v záložce Pokusy u tržby. Tržby se musí zaevidovat do 48 hodin.", "name:en": "Sales of registration {name} have been waiting for confirmation for more than an hour — the oldest since {oldest}. They are sent again automatically; the reason is in the Attempts tab of the sale. Sales must be registered within 48 hours." },
        "alert.overdueTitle": { "name": "Sales not registered within 48 hours: {count} ({name})", "name:cs": "Tržby nezaevidované do 48 hodin: {count} ({name})", "name:en": "Sales not registered within 48 hours: {count} ({name})" },
        "alert.overdueMessage": { "name": "Sales of registration {name} are still not confirmed 48 hours after the sale — the oldest since {oldest}. Sending continues, the obligation lasts. Check the Attempts tab of the sales and the certificate of the registration.", "name:cs": "Tržby registrace {name} nejsou potvrzené ani 48 hodin po tržbě — nejstarší od {oldest}. Odesílání pokračuje, povinnost trvá. Zkontrolujte záložku Pokusy u tržeb a certifikát registrace.", "name:en": "Sales of registration {name} are still not confirmed 48 hours after the sale — the oldest since {oldest}. Sending continues, the obligation lasts. Check the Attempts tab of the sales and the certificate of the registration." },
        "alert.failedTitle": { "name": "Sales rejected by the service: {count} ({name})", "name:cs": "Tržby odmítnuté službou: {count} ({name})", "name:en": "Sales rejected by the service: {count} ({name})" },
        "alert.failedMessage": { "name": "The sales registration service rejected sales of registration {name} — the oldest from {oldest}. They are not sent again automatically: find the reason in the Attempts tab and use Send again.", "name:cs": "Služba evidence tržeb odmítla tržby registrace {name} — nejstarší z {oldest}. Samy se už neposílají: najděte důvod v záložce Pokusy a použijte Odeslat znovu.", "name:en": "The sales registration service rejected sales of registration {name} — the oldest from {oldest}. They are not sent again automatically: find the reason in the Attempts tab and use Send again." },
        "alert.unregistrableTitle": { "name": "Document {number} cannot be registered as a sale", "name:cs": "Doklad {number} nejde zaevidovat jako tržbu", "name:en": "Document {number} cannot be registered as a sale" },
        "alert.unregistrableFix": { "name": "Once the settings are fixed, the sale is created automatically with the original time.", "name:cs": "Po opravě nastavení se tržba založí sama s původním časem.", "name:en": "Once the settings are fixed, the sale is created automatically with the original time." },
        "alert.openDocument": { "name": "Open document", "name:cs": "Otevřít doklad", "name:en": "Open document" },
        // --- Evidence tržeb na dokladu: záložka detailu, štítek hlavičky a seznamu (#171 D13, U18, U19) ---
        "doc.tab": { "name": "Sales registration", "name:cs": "Evidence tržeb", "name:en": "Sales registration" },
        "doc.tag": { "name": "EET", "name:cs": "EET", "name:en": "EET" },
        "doc.tagTest": { "name": "EET test", "name:cs": "EET test", "name:en": "EET test" },
        "doc.tagWithState": { "name": "{tag}: {state}", "name:cs": "{tag}: {state}", "name:en": "{tag}: {state}" },
        "doc.groupEvaluation": { "name": "Evaluation", "name:cs": "Vyhodnocení", "name:en": "Evaluation" },
        "doc.verdict": { "name": "Sales registration", "name:cs": "Evidence tržeb", "name:en": "Sales registration" },
        "doc.verdictFalls": { "name": "Falls — {amount}", "name:cs": "Spadá — {amount}", "name:en": "Falls — {amount}" },
        "doc.verdictUnregistrable": { "name": "Falls, but the sale cannot be created", "name:cs": "Spadá, ale tržbu nejde založit", "name:en": "Falls, but the sale cannot be created" },
        "doc.verdictNot": { "name": "Does not fall", "name:cs": "Nespadá", "name:en": "Does not fall" },
        "doc.reason": { "name": "Reason", "name:cs": "Důvod", "name:en": "Reason" },
        "doc.source": { "name": "Falls by", "name:cs": "Čím spadá", "name:en": "Falls by" },
        "doc.sourceContactPayment": { "name": "contact payment", "name:cs": "kontaktní platbou", "name:en": "contact payment" },
        "doc.sourceRule": { "name": "document type and payment method", "name:cs": "typem dokladu a způsobem platby", "name:en": "document type and payment method" },
        "doc.unit": { "name": "Registration unit", "name:cs": "Evidenční jednotka", "name:en": "Registration unit" },
        "doc.cashRegister": { "name": "Cash register", "name:cs": "Pokladní zařízení", "name:en": "Cash register" },
        "doc.groupContactPayment": { "name": "Contact payment", "name:cs": "Kontaktní platba", "name:en": "Contact payment" },
        "doc.contactPayment": { "name": "Contact payment", "name:cs": "Kontaktní platba", "name:en": "Contact payment" },
        "doc.yes": { "name": "Yes", "name:cs": "Ano", "name:en": "Yes" },
        "doc.no": { "name": "No", "name:cs": "Ne", "name:en": "No" },
        "doc.paidAt": { "name": "Payment time", "name:cs": "Čas platby", "name:en": "Payment time" },
        "doc.paidAtTransition": { "name": "the time the document is confirmed", "name:cs": "čas přechodu dokladu do stavu V pořádku", "name:en": "the time the document is confirmed" },
        "doc.offerNotice": { "name": "If the customer paid the document on the spot — by QR code or by card on a terminal — mark it with the Contact payment action.", "name:cs": "Zaplatil-li zákazník doklad na místě — QR kódem nebo kartou na terminálu — označte ho akcí Kontaktní platba.", "name:en": "If the customer paid the document on the spot — by QR code or by card on a terminal — mark it with the Contact payment action." },
        "doc.noSales": { "name": "The document has no sale yet.", "name:cs": "Doklad zatím nemá žádnou tržbu.", "name:en": "The document has no sale yet." },
        "doc.saleTest": { "name": "test", "name:cs": "test", "name:en": "test" },
        "doc.salesTotal": { "name": "Total", "name:cs": "Celkem", "name:en": "Total" },
        "doc.colSerialNumber": { "name": "Serial number", "name:cs": "Pořadové číslo", "name:en": "Serial number" },
        "doc.colSoldAt": { "name": "Sale time", "name:cs": "Čas tržby", "name:en": "Sale time" },
        "doc.colAmount": { "name": "Amount", "name:cs": "Částka", "name:en": "Amount" },
        "doc.colState": { "name": "State", "name:cs": "Stav", "name:en": "State" },
        "doc.colCode": { "name": "Confirmation code", "name:cs": "Kód potvrzení", "name:en": "Confirmation code" },
        "doc.colAttempts": { "name": "Attempts", "name:cs": "Pokusy", "name:en": "Attempts" },

        // --- Proč doklad do evidence nespadá (#171 U18) — záložka detailu a akce ---
        "reason.imported": { "name": "The document was taken over by import — it does not enter sales registration.", "name:cs": "Doklad byl převzat importem — do evidence tržeb nevstupuje.", "name:en": "The document was taken over by import — it does not enter sales registration." },
        "reason.state": { "name": "The document is not confirmed.", "name:cs": "Doklad není ve stavu V pořádku.", "name:en": "The document is not confirmed." },
        "reason.cancelled": { "name": "The document is cancelled — nothing of it falls under sales registration.", "name:cs": "Doklad je stornovaný — do evidence tržeb z něj nespadá nic.", "name:en": "The document is cancelled — nothing of it falls under sales registration." },
        "reason.noRegistration": { "name": "No sales registration was valid for the country of the document at the time of the sale.", "name:cs": "V čase tržby neplatila pro zemi dokladu žádná registrace k evidenci tržeb.", "name:en": "No sales registration was valid for the country of the document at the time of the sale." },
        "reason.noRule": { "name": "The document type and payment method do not fall under sales registration.", "name:cs": "Typ dokladu a způsob platby do evidence tržeb nespadají.", "name:en": "The document type and payment method do not fall under sales registration." },
        "reason.beforeRegistration": { "name": "The document was issued before the sales registration became valid.", "name:cs": "Doklad byl vystaven před začátkem platnosti registrace k evidenci tržeb.", "name:en": "The document was issued before the sales registration became valid." },
        "reason.noMatchingRows": { "name": "No row of the document is a sale.", "name:cs": "Žádný řádek dokladu není tržbou.", "name:en": "No row of the document is a sale." },
        "reason.zeroAmount": { "name": "The amount that falls under sales registration is zero.", "name:cs": "Částka, která do evidence tržeb spadá, je nulová.", "name:en": "The amount that falls under sales registration is zero." },
        "reason.paymentOutsideRegistration": { "name": "No sales registration was valid at the time of the payment.", "name:cs": "V čase platby neplatila žádná registrace k evidenci tržeb.", "name:en": "No sales registration was valid at the time of the payment." },

        // --- Proč tržbu nejde založit (#171 U9) — upozornění, záložka detailu a akce ---
        "alert.reasonMultipleRegistrations": { "name": "More than one sales registration is valid for the document — only one may be valid at a time for a country.", "name:cs": "Dokladu odpovídá víc platných registrací k evidenci tržeb — pro jednu zemi smí v jednu chvíli platit jen jedna.", "name:en": "More than one sales registration is valid for the document — only one may be valid at a time for a country." },
        "alert.reasonRegistrationGone": { "name": "The registration under which the document was registered is no longer confirmed.", "name:cs": "Registrace, pod kterou byl doklad zaevidován, už není V pořádku.", "name:en": "The registration under which the document was registered is no longer confirmed." },
        "alert.reasonNoUnit": { "name": "Neither the number series of the document nor the registration has a registration unit — set the default unit of the registration or a unit on the number series.", "name:cs": "Evidenční jednotku nemá číselná řada dokladu ani registrace — nastavte výchozí jednotku registrace, nebo jednotku na číselné řadě.", "name:en": "Neither the number series of the document nor the registration has a registration unit — set the default unit of the registration or a unit on the number series." },
        "alert.reasonForeignUnit": { "name": "The registration unit set on the number series belongs to a different registration.", "name:cs": "Evidenční jednotka nastavená na číselné řadě patří jiné registraci.", "name:en": "The registration unit set on the number series belongs to a different registration." },
        "alert.reasonUnitId": { "name": "The number of the registration unit does not have the form the registration type prescribes.", "name:cs": "Číslo evidenční jednotky nemá tvar, který typ evidence předepisuje.", "name:en": "The number of the registration unit does not have the form the registration type prescribes." },
        "alert.reasonCashRegisterId": { "name": "The code of the number series cannot be used as a cash register identifier — change the code of the series.", "name:cs": "Kód číselné řady nejde použít jako označení pokladního zařízení — změňte kód řady.", "name:en": "The code of the number series cannot be used as a cash register identifier — change the code of the series." },
        "alert.reasonSerialNumber": { "name": "The document number is too long or contains characters that the serial number of a sale does not allow.", "name:cs": "Číslo dokladu je příliš dlouhé nebo obsahuje znaky, které pořadové číslo tržby nepovoluje.", "name:en": "The document number is too long or contains characters that the serial number of a sale does not allow." },
        "alert.reasonAmount": { "name": "The amount is outside the range the sales registration service accepts.", "name:cs": "Částka je mimo rozsah, který služba evidence tržeb přijímá.", "name:en": "The amount is outside the range the sales registration service accepts." },
        "alert.reasonCurrency": { "name": "The home currency of the document differs from the currency of the registration type.", "name:cs": "Domácí měna dokladu se liší od měny typu evidence.", "name:en": "The home currency of the document differs from the currency of the registration type." },
        "alert.reasonOther": { "name": "The sale cannot be created ({reason}).", "name:cs": "Tržbu nejde založit ({reason}).", "name:en": "The sale cannot be created ({reason})." },

        // --- Upozornění na certifikát (#171 D13) ---
        "alert.open": { "name": "Open registrations", "name:cs": "Otevřít registrace", "name:en": "Open registrations" },
        "alert.missingTitle": { "name": "Sales registration {name} has no certificate", "name:cs": "Registrace k evidenci tržeb {name} nemá certifikát", "name:en": "Sales registration {name} has no certificate" },
        "alert.missingMessage": { "name": "The registration is confirmed and valid, but no cash register certificate is uploaded — sales cannot be registered. Upload the certificate in the registration detail.", "name:cs": "Registrace je V pořádku a platná, ale nemá nahraný pokladní certifikát — tržby z ní evidovat nejde. Nahrajte certifikát v detailu registrace.", "name:en": "The registration is confirmed and valid, but no cash register certificate is uploaded — sales cannot be registered. Upload the certificate in the registration detail." },
        "alert.expiringTitle": { "name": "Certificate of sales registration {name} expires on {date}", "name:cs": "Certifikát registrace k evidenci tržeb {name} vyprší {date}", "name:en": "Certificate of sales registration {name} expires on {date}" },
        "alert.expiringMessage": { "name": "The cash register certificate ({label} {taxpayerId}) is valid until {date} — days left: {days}. Issue a new one and upload it in the registration detail; after it expires, sales cannot be registered.", "name:cs": "Pokladní certifikát ({label} {taxpayerId}) platí do {date} — zbývá dní: {days}. Vystavte nový a nahrajte ho v detailu registrace; po vypršení tržby evidovat nepůjde.", "name:en": "The cash register certificate ({label} {taxpayerId}) is valid until {date} — days left: {days}. Issue a new one and upload it in the registration detail; after it expires, sales cannot be registered." },
        "alert.expiredTitle": { "name": "Certificate of sales registration {name} has expired", "name:cs": "Certifikát registrace k evidenci tržeb {name} vypršel", "name:en": "Certificate of sales registration {name} has expired" },
        "alert.expiredMessage": { "name": "The cash register certificate ({label} {taxpayerId}) expired on {date} — sales cannot be registered. Issue a new one and upload it in the registration detail.", "name:cs": "Pokladní certifikát ({label} {taxpayerId}) vypršel {date} — tržby evidovat nejde. Vystavte nový a nahrajte ho v detailu registrace.", "name:en": "The cash register certificate ({label} {taxpayerId}) expired on {date} — sales cannot be registered. Issue a new one and upload it in the registration detail." }
    }
}
