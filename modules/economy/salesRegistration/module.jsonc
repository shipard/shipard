{
    // Evidence tržeb (#171) — doplněk: registrace k evidenci tržeb, evidenční
    // jednotky, pokladní certifikát, pojistka serveru a odesílání zpráv.
    // Data typu evidence deklaruje modul země (world.cz.salesRegistrationTypes,
    // typ cz.eet2 = EET 2.0); třídu, která protokol země umí, přiřazuje tento
    // doplněk (economy.salesRegistration.engines) — #171 D2, D17.
    // Specifikace: docs/sales-registration.md u modulu.
    "id": "economy.salesRegistration",
    "name": "Sales registration",
    "name:cs": "Evidence tržeb",
    "name:en": "Sales registration",
    "description": "Registration of sales with the tax authority (Czech EET 2.0): registrations, registration units, cash register certificate, server safety switch and message sending",
    "description:cs": "Evidence tržeb u správce daně (česká EET 2.0): registrace, evidenční jednotky, pokladní certifikát, pojistka serveru a odesílání zpráv",
    "description:en": "Registration of sales with the tax authority (Czech EET 2.0): registrations, registration units, cash register certificate, server safety switch and message sending",

    // Doplněk (#170): mimo install.base, zapíná se ve zdroji dat přes
    // `shpd-ds ds-module enable economy.salesRegistration`.
    "kind": "addon",

    // Záměrně bez závislosti na world.cz: typ se nabízí jen tam, kde je modul
    // jeho země aktivní (SalesRegistrationTypes). docs.core od fáze 2 —
    // tržby vznikají z dokladů a evidenční jednotka žije na číselné řadě.
    "dependencies": ["core.system", "docs.core"],

    "tables": [
        "economy_sales_registration_registrations",
        "economy_sales_registration_units",
        "economy_sales_registration_sales",
        "economy_sales_registration_attempts"
    ],

    // Příkazy a úlohy cronu doplňku (#172 D1–D6, #171 D7): fronta tržeb
    // každou minutu, záchranná síť každých pět minut (před upozorněními —
    // chybějící tržbu nejdřív založí, pak teprve hlásí).
    "commands": [
        "Shipard\\Module\\Economy\\SalesRegistration\\Command\\SalesRegistrationRunCommand",
        "Shipard\\Module\\Economy\\SalesRegistration\\Command\\SalesRegistrationReconcileCommand"
    ],
    "cronJobs": [
        {"command": "sales-registration-run", "slot": "minute"},
        {"command": "sales-registration-reconcile", "slot": "five-minutes"}
    ],

    // Evidenční jednotka na číselné řadě (#171 D4, D21) — pokladní zařízení
    // = řada. Sloupec přidává extension, edituje ho záložka formuláře řady
    // a kód řady proti masce typu hlídá handler při uložení řady.
    //
    // Kontaktní platba na hlavičce dokladu (#171 D8b, U13, U21) — příznak,
    // čas platby a čas změny; na řádcích jen index pro varování D8c (U25).
    "extensions": ["docs_core_number_series", "docs_core_heads", "docs_core_rows"],

    "formTabs": [
        {
            "table": "docs_core_number_series",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Series\\SeriesUnitFormTab"
        },
        {
            // Zaškrtávátko Kontaktní platba a čas platby ve formuláři faktury
            // vydané a zálohové faktury vydané (#171 U16) — u kterých typů,
            // říkají data typu evidence.
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\ContactPayment\\ContactPaymentFormTab"
        }
    ],

    // Evidence tržeb na dokladu (#171 D13, U18, U19): záložka s vyhodnocením
    // a tržbami a štítek stavu v detailu dokladu, štítek „EET“ v seznamu.
    "detailExtensions": [
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Docs\\DocSalesDetailExtension"
        }
    ],
    "rowDecorators": [
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Docs\\DocSalesRowDecorator"
        }
    ],

    // Tržby z dokladů (#171 D6, D7, U12): přechod do V pořádku nebo Storno
    // spustí rozdílový výpočet; doklad s tržbou nejde přesunout do koše.
    "documentEventHandlers": [
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Sales\\DocsHeadsSalesHandler",
            "events": ["beforeSave", "stateChanged", "beforeDelete"]
        },
        {
            // Kontaktní platba při uložení dokladu (#171 U22): příznak jen
            // tam, kde ho data typu dovolují, čas platby ne v budoucnu,
            // změna nastaví čas změny.
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\ContactPayment\\ContactPaymentSaveHandler",
            "events": ["beforeSave"]
        },
        {
            "table": "docs_core_number_series",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Series\\SeriesUnitHandler",
            "events": ["beforeSave"]
        }
    ],

    "documentClasses": [
        {
            "table": "economy_sales_registration_registrations",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\RegistrationDocument"
        },
        {
            "table": "economy_sales_registration_units",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\UnitDocument"
        }
    ],

    "forms": [
        {
            "table": "economy_sales_registration_registrations",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\RegistrationsForm"
        },
        {
            // Evidenční jednotka — dialog sub-tabulky ve formuláři registrace.
            "table": "economy_sales_registration_units",
            "id": "economy.salesRegistration.units"
        }
    ],

    // Vlastní sekce Nastavení (#170 D13) — ConfigCompiler ji připojí
    // k sekcím instalačního modulu.
    "settingsSections": [
        {
            "id": "salesRegistration",
            "name": "Sales registration",
            "name:cs": "Evidence tržeb",
            "name:en": "Sales registration",
            "icon": "cash-register",
            "order": 18
        }
    ],

    "settingsItems": [
        { "viewer": "economy.salesRegistration.registrations", "section": "salesRegistration", "order": 10 }
    ],

    "viewers": [
        {
            "id": "economy.salesRegistration.registrations",
            "name": "EET registrations",
            "name:cs": "Registrace EET",
            "name:en": "EET registrations",
            "icon": "cash-register",
            "table": "economy_sales_registration_registrations",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\RegistrationsViewer"
        },
        {
            // Agenda Evidence tržeb (#171 D25, U12) — tržby z dokladů a stav
            // jejich odeslání, v sekci Prodej za prodejkami.
            "id": "economy.salesRegistration.sales",
            "name": "Sales registration",
            "name:cs": "Evidence tržeb",
            "name:en": "Sales registration",
            "icon": "filing",
            "table": "economy_sales_registration_sales",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\SalesViewer",
            "navSection": "sales",
            "navOrder": 25
        }
    ],

    // Sekce server.json, kterou čte jen tento doplněk (#172 D7, #171 D9):
    // pojistka `salesRegistration.safety.mode` — off / playground / drop.
    "serverConfig": [
        {"key": "salesRegistration", "class": "Shipard\\Module\\Economy\\SalesRegistration\\Safety\\SalesRegistrationServerConfig"}
    ],

    // Akce záznamu s obsluhou v doplňku (#172 D12–D15). Nahrání certifikátu
    // jen pro správce — mění identitu, pod kterou se zprávy podepisují.
    "recordActions": [
        {
            "id": "uploadCertificate",
            "table": "economy_sales_registration_registrations",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Actions\\UploadCertificateAction",
            "admin": true,
            "order": 100
        },
        {
            // Zkušební zpráva v ověřovacím módu — nic se neeviduje (#171 U4).
            "id": "verifyConnection",
            "table": "economy_sales_registration_registrations",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Actions\\VerifyConnectionAction",
            "admin": true,
            "order": 110
        },
        {
            // Odeslat znovu nad tržbou (#171 U12) — není jen pro správce:
            // smí ji každý, kdo pracuje s doklady.
            "id": "resend",
            "table": "economy_sales_registration_sales",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Actions\\ResendSaleAction",
            "order": 100
        },
        {
            // Kontaktní platba na dokladu V pořádku (#171 D8b, U17): dialog
            // s časem platby, příznak bez přechodu stavu, hned tržba. Jako
            // Odeslat znovu není jen pro správce.
            "id": "contactPayment",
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Actions\\ContactPaymentAction",
            "order": 200
        },
        {
            // Zrušení jen s potvrzením — tržbu vyrovná záporná tržba.
            "id": "cancelContactPayment",
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Actions\\CancelContactPaymentAction",
            "order": 210
        }
    ],

    "config": [
        {
            // Typ evidence → třída engine (#171 D17). Klíč = id typu z modulu
            // země; země je první část id (`cz.eet2` → world.cz).
            "id": "economy.salesRegistration.engines",
            "file": "config/engines.jsonc"
        },
        {
            // Režim registrace (sloupec `mode`, #171 D10).
            "id": "economy.salesRegistration.modes",
            "file": "config/modes.jsonc"
        },
        {
            // Stav tržby ve frontě (sloupec `state`, #171 U5).
            "id": "economy.salesRegistration.saleStates",
            "file": "config/saleStates.jsonc"
        },
        {
            // Výsledek pokusu o odeslání (sloupec `status`, #171 D5).
            "id": "economy.salesRegistration.attemptStatuses",
            "file": "config/attemptStatuses.jsonc"
        },
        {
            "id": "economy.salesRegistration.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        },
        {
            "id": "economy.salesRegistration.formTexts",
            "file": "config/formTexts.jsonc"
        },
        {
            // Texty akcí záznamu a jejich hlášek.
            "id": "economy.salesRegistration.texts",
            "file": "config/texts.jsonc"
        }
        ],

    // Upozornění na pokladní certifikát (#171 D13) — jen u registrací
    // V pořádku v době jejich platnosti. Id malými písmeny (pravidlo
    // AlertCheckDefinition), jako economy.exchangerates.*.
    "alertChecks": [
        {
            // Tržba čeká na potvrzení déle než hodinu (#171 D13) — jeden
            // nález na registraci; po 48 hodinách ji přebírá sale_overdue.
            "id": "economy.salesregistration.sale_unconfirmed",
            "name": "Sales waiting for confirmation",
            "name:cs": "Tržby čekají na potvrzení",
            "name:en": "Sales waiting for confirmation",
            "description": "Sales that have been waiting to be confirmed by the sales registration service for more than an hour.",
            "description:cs": "Tržby, které čekají na potvrzení službou evidence tržeb déle než hodinu.",
            "description:en": "Sales that have been waiting to be confirmed by the sales registration service for more than an hour.",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Checks\\SaleUnconfirmedCheck",
            "severity": "warning",
            "interval": "15m",
            "navSection": "sales",
            "tags": ["salesRegistration"]
        },
        {
            "id": "economy.salesregistration.sale_overdue",
            "name": "Sales not registered within 48 hours",
            "name:cs": "Tržby nezaevidované do 48 hodin",
            "name:en": "Sales not registered within 48 hours",
            "description": "Sales still not confirmed 48 hours after the sale; sending continues.",
            "description:cs": "Tržby, které nejsou potvrzené ani 48 hodin po tržbě; odesílání pokračuje.",
            "description:en": "Sales still not confirmed 48 hours after the sale; sending continues.",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Checks\\SaleOverdueCheck",
            "severity": "error",
            "interval": "5m",
            "navSection": "sales",
            "tags": ["salesRegistration"]
        },
        {
            "id": "economy.salesregistration.sale_failed",
            "name": "Sales rejected by the service",
            "name:cs": "Tržby odmítnuté službou",
            "name:en": "Sales rejected by the service",
            "description": "Sales rejected by the sales registration service; they wait for Send again.",
            "description:cs": "Tržby, které služba evidence tržeb odmítla; čekají na Odeslat znovu.",
            "description:en": "Sales rejected by the sales registration service; they wait for Send again.",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Checks\\SaleFailedCheck",
            "severity": "error",
            "interval": "5m",
            "navSection": "sales",
            "tags": ["salesRegistration"]
        },
        {
            // Doklad spadá do evidence, ale tržbu založit nejde (#171 U9) —
            // stejné vyhodnocení jako záchranná síť, okno 7 dní.
            "id": "economy.salesregistration.doc_unregistrable",
            "name": "Documents that cannot be registered as sales",
            "name:cs": "Doklady, které nejde zaevidovat jako tržbu",
            "name:en": "Documents that cannot be registered as sales",
            "description": "Documents that fall under sales registration but the sale cannot be created because of missing settings.",
            "description:cs": "Doklady, které do evidence tržeb spadají, ale tržbu nejde založit kvůli chybějícímu nastavení.",
            "description:en": "Documents that fall under sales registration but the sale cannot be created because of missing settings.",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Checks\\DocUnregistrableCheck",
            "severity": "error",
            "interval": "1h",
            "navSection": "sales",
            "tags": ["salesRegistration"]
        },
        {
            "id": "economy.salesregistration.cert_expiring",
            "name": "Sales registration certificate expires soon",
            "name:cs": "Certifikát evidence tržeb brzy vyprší",
            "name:en": "Sales registration certificate expires soon",
            "description": "The cash register certificate of a confirmed, valid registration expires within 30 days — issue a new one and upload it.",
            "description:cs": "Pokladní certifikát platné registrace V pořádku vyprší do 30 dnů — vystavte nový a nahrajte ho.",
            "description:en": "The cash register certificate of a confirmed, valid registration expires within 30 days — issue a new one and upload it.",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Checks\\CertificateExpiringCheck",
            "severity": "warning",
            "interval": "6h",
            "tags": ["salesRegistration"]
        },
        {
            "id": "economy.salesregistration.cert_expired",
            "name": "Sales registration certificate has expired",
            "name:cs": "Certifikát evidence tržeb vypršel",
            "name:en": "Sales registration certificate has expired",
            "description": "The cash register certificate of a confirmed, valid registration has expired — sales cannot be registered until a new one is uploaded.",
            "description:cs": "Pokladní certifikát platné registrace V pořádku vypršel — do nahrání nového tržby evidovat nejde.",
            "description:en": "The cash register certificate of a confirmed, valid registration has expired — sales cannot be registered until a new one is uploaded.",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Checks\\CertificateExpiredCheck",
            "severity": "error",
            "interval": "6h",
            "tags": ["salesRegistration"]
        },
        {
            "id": "economy.salesregistration.cert_missing",
            "name": "Sales registration without a certificate",
            "name:cs": "Registrace k evidenci tržeb bez certifikátu",
            "name:en": "Sales registration without a certificate",
            "description": "A confirmed, valid registration has no cash register certificate uploaded.",
            "description:cs": "Platná registrace V pořádku nemá nahraný pokladní certifikát.",
            "description:en": "A confirmed, valid registration has no cash register certificate uploaded.",
            "class": "Shipard\\Module\\Economy\\SalesRegistration\\Checks\\CertificateMissingCheck",
            "severity": "warning",
            "interval": "6h",
            "tags": ["salesRegistration"]
        }
    ]
}
