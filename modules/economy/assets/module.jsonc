{
    // Majetek — evidence karet majetku, typů, skupin typů a účetních skupin
    // (docs/assets.md, #83). Fáze 1 = evidence, fáze 2 = hodnotové události
    // a odpisy (bez účtování — to přidá fáze 3).
    "id": "economy.assets",
    "name": "Assets",
    "name:cs": "Majetek",
    "name:en": "Assets",
    "description": "Asset register: asset cards, types, type groups and accounting groups",
    "description:cs": "Evidence majetku: karty majetku, typy, skupiny typů a účetní skupiny",
    "description:en": "Asset register: asset cards, types, type groups and accounting groups",

    // world.assets = pravidla daňových odpisů per stát (D31).
    "dependencies": ["core.system", "core.attachments", "base.persons", "docs.core", "economy.accounting", "world.assets"],

    "tables": [
        "economy_assets_assets",
        "economy_assets_types",
        "economy_assets_type_groups",
        "economy_assets_accounting_groups",
        "economy_assets_events"
    ],

    // Sloupec `asset` na hlavičkách a řádcích dokladů a v deníku (D15,
    // D47, D59).
    "extensions": [
        "docs_core_heads",
        "docs_core_rows",
        "economy_accounting_journal"
    ],

    // Dimenze deníku (D47): karta majetku z řádku dokladu → řádek deníku;
    // řádek bez karty zdědí kartu hlavičky (D60). `forms` = pole Majetek
    // na hlavičce a řádcích běžných dokladů, jen se zapnutým nastavením
    // „Sledovat náklady na majetek“ (D59). Řádek pořízení a systémové
    // operace majetku mají pole vždy (vlajka `rowAsset` operace).
    "journalDimensions": [
        {
            "id": "asset",
            "rowColumn": "asset",
            "headColumn": "asset",
            "journalColumn": "asset",
            "table": "economy_assets_assets",
            "name": "Asset",
            "name:cs": "Majetek",
            "name:en": "Asset",
            "forms": {
                "docTypes": ["invni", "invno", "cash", "cmnbkp"],
                "head": true,
                "rows": true,
                "enabledBySetting": "economy.assets.trackExpenses"
            }
        }
    ],

    "settingsItems": [
        { "viewer": "economy.assets.types",            "section": "assets", "order": 10 },
        { "viewer": "economy.assets.typeGroups",       "section": "assets", "order": 20 },
        { "viewer": "economy.assets.accountingGroups", "section": "assets", "order": 30 },
        { "page":   "assetsNumbering",                 "section": "assets", "order": 40 },
        { "page":   "assetsDepreciation",              "section": "assets", "order": 50 },
        { "page":   "assetsDocuments",                 "section": "assets", "order": 60 }
    ],

    // Prefixy inventárních čísel per druh (D22). Klíče musí sedět na klíče
    // cfgItem economy.assets.categories; čte je AssetDocument přes
    // AssetCategories::PREFIX_SETTING, fallback numberPrefix v cfgItem.
    // Četnost účetních odpisů (D12): AssetPlanService::SETTING_PERIODICITY,
    // fallback `year`. Řada účetních dokladů majetku (D54):
    // AssetPostingSeries::SETTING, bez fallbacku. Sledování nákladů (D59):
    // čte JournalDimensionSet::forForm přes `forms.enabledBySetting` dimenze.
    "settingsPages": [
        {
            "id": "assetsDocuments",
            "name": "Assets on documents",
            "name:cs": "Majetek na dokladech",
            "name:en": "Assets on documents",
            "icon": "document",
            "fields": [
                {
                    "id": "economy.assets.trackExpenses",
                    "type": "select",
                    "name": "Track expenses on assets",
                    "name:cs": "Sledovat náklady na majetek",
                    "name:en": "Track expenses on assets",
                    "hint": "Adds the Asset field to the header and rows of received and issued invoices, cash and accounting documents. Empty = no. Asset acquisition rows always have the field.",
                    "hint:cs": "Přidá pole Majetek na hlavičku a řádky přijatých a vydaných faktur, pokladních a účetních dokladů. Prázdné = ne. Řádek pořízení majetku má pole vždy.",
                    "hint:en": "Adds the Asset field to the header and rows of received and issued invoices, cash and accounting documents. Empty = no. Asset acquisition rows always have the field.",
                    "options": [
                        { "value": "yes", "label": "Yes", "label:cs": "Ano", "label:en": "Yes" },
                        { "value": "no",  "label": "No",  "label:cs": "Ne",  "label:en": "No" }
                    ]
                }
            ]
        },
        {
            "id": "assetsDepreciation",
            "name": "Depreciation",
            "name:cs": "Odpisy",
            "name:en": "Depreciation",
            "icon": "calculator",
            "fields": [
                {
                    "id": "economy.assets.accPeriodicity",
                    "type": "select",
                    "name": "Accounting depreciation frequency",
                    "name:cs": "Četnost účetních odpisů",
                    "name:en": "Accounting depreciation frequency",
                    "hint": "Tax depreciation is always yearly. Empty = yearly.",
                    "hint:cs": "Daňové odpisy jsou vždy roční. Prázdné = ročně.",
                    "hint:en": "Tax depreciation is always yearly. Empty = yearly.",
                    "options": [
                        { "value": "year",  "label": "Yearly",  "label:cs": "Ročně",   "label:en": "Yearly" },
                        { "value": "month", "label": "Monthly", "label:cs": "Měsíčně", "label:en": "Monthly" }
                    ]
                },
                {
                    // D54: řada účetních dokladů, kterými se majetek účtuje.
                    // Nabídka = aktivní řady cmnbkp (AssetPostingSeries);
                    // prázdné = zaúčtování se odmítne (žádný tichý výběr).
                    "id": "economy.assets.accountingSeries",
                    "type": "select",
                    "name": "Number series of asset accounting documents",
                    "name:cs": "Řada účetních dokladů majetku",
                    "name:en": "Number series of asset accounting documents",
                    "hint": "Accounting documents created by “Depreciation and posting for a period”. Without a series nothing can be posted.",
                    "hint:cs": "Účetní doklady, které zakládá „Odpisy a zaúčtování za období“. Bez řady nejde zaúčtovat.",
                    "hint:en": "Accounting documents created by “Depreciation and posting for a period”. Without a series nothing can be posted.",
                    "optionsProvider": "Shipard\\Module\\Economy\\Assets\\Posting\\AssetPostingSeries"
                }
            ]
        },
        {
            "id": "assetsNumbering",
            "name": "Inventory numbers",
            "name:cs": "Inventární čísla",
            "name:en": "Inventory numbers",
            "icon": "hash",
            "fields": [
                {
                    "id": "economy.assets.numberPrefix.small",
                    "type": "text",
                    "name": "Prefix — small assets",
                    "name:cs": "Prefix — drobný majetek",
                    "name:en": "Prefix — small assets",
                    "hint": "Empty = MA. The number is the prefix plus a sequence padded to 4 digits (MA0001).",
                    "hint:cs": "Prázdné = MA. Číslo je prefix a pořadové číslo doplněné na 4 místa (MA0001).",
                    "hint:en": "Empty = MA. The number is the prefix plus a sequence padded to 4 digits (MA0001).",
                    "maxLength": 16
                },
                {
                    "id": "economy.assets.numberPrefix.tangible",
                    "type": "text",
                    "name": "Prefix — tangible fixed assets",
                    "name:cs": "Prefix — dlouhodobý hmotný",
                    "name:en": "Prefix — tangible fixed assets",
                    "hint": "Empty = MA.",
                    "hint:cs": "Prázdné = MA.",
                    "hint:en": "Empty = MA.",
                    "maxLength": 16
                },
                {
                    "id": "economy.assets.numberPrefix.intangible",
                    "type": "text",
                    "name": "Prefix — intangible fixed assets",
                    "name:cs": "Prefix — dlouhodobý nehmotný",
                    "name:en": "Prefix — intangible fixed assets",
                    "hint": "Empty = MA.",
                    "hint:cs": "Prázdné = MA.",
                    "hint:en": "Empty = MA.",
                    "maxLength": 16
                },
                {
                    "id": "economy.assets.numberPrefix.nondepreciable",
                    "type": "text",
                    "name": "Prefix — non-depreciable fixed assets",
                    "name:cs": "Prefix — neodepisovaný dlouhodobý",
                    "name:en": "Prefix — non-depreciable fixed assets",
                    "hint": "Empty = MA.",
                    "hint:cs": "Prázdné = MA.",
                    "hint:en": "Empty = MA.",
                    "maxLength": 16
                }
            ]
        }
    ],

    "viewers": [
        {
            "id": "economy.assets.assets",
            "name": "Assets",
            "name:cs": "Majetek",
            "name:en": "Assets",
            "icon": "box",
            "table": "economy_assets_assets",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetsViewer",
            "navSection": "assets",
            "navOrder": 10
        },
        {
            "id": "economy.assets.types",
            "name": "Asset types",
            "name:cs": "Typy majetku",
            "name:en": "Asset types",
            "icon": "tags",
            "table": "economy_assets_types",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetTypesViewer"
        },
        {
            "id": "economy.assets.typeGroups",
            "name": "Asset type groups",
            "name:cs": "Skupiny typů majetku",
            "name:en": "Asset type groups",
            "icon": "folder",
            "table": "economy_assets_type_groups",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetTypeGroupsViewer"
        },
        {
            "id": "economy.assets.accountingGroups",
            "name": "Asset accounting groups",
            "name:cs": "Účetní skupiny majetku",
            "name:en": "Asset accounting groups",
            "icon": "calculator",
            "table": "economy_assets_accounting_groups",
            "class": "Shipard\\Module\\Economy\\Assets\\AccountingGroupsViewer"
        }
    ],

    "forms": [
        {
            "table": "economy_assets_assets",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetsForm"
        },
        {
            "table": "economy_assets_events",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetEventsForm"
        },
        { "table": "economy_assets_types",             "id": "economy.assets.types" },
        { "table": "economy_assets_type_groups",       "id": "economy.assets.type_groups" },
        { "table": "economy_assets_accounting_groups", "id": "economy.assets.accounting_groups" }
    ],

    "lookups": [
        {
            "table": "economy_assets_assets",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetsLookup"
        },
        {
            "table": "economy_assets_types",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetTypesLookup"
        },
        {
            "table": "economy_assets_accounting_groups",
            "class": "Shipard\\Module\\Economy\\Assets\\AccountingGroupsLookup"
        }
    ],

    "documentClasses": [
        {
            "table": "economy_assets_assets",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetDocument"
        },
        {
            "table": "economy_assets_types",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetTypeDocument"
        },
        {
            "table": "economy_assets_type_groups",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetTypeGroupDocument"
        },
        {
            "table": "economy_assets_accounting_groups",
            "class": "Shipard\\Module\\Economy\\Assets\\AccountingGroupDocument"
        },
        {
            "table": "economy_assets_events",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetEventDocument"
        }
    ],

    // Potvrzená událost je zamčená, dokud po ní v okruhu existuje potvrzený
    // odpis, v zamčeném účetním měsíci (D29) a po zaúčtování (D52).
    // Účetní doklad s řádky asset.* spravuje Majetek (D53) — ruční oprava
    // ani storno nejdou, zaúčtování se ruší z majetku.
    "documentLockProviders": [
        {
            "table": "economy_assets_events",
            "class": "Shipard\\Module\\Economy\\Assets\\AssetEventLockProvider"
        },
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\Assets\\Posting\\AssetPostingDocLockProvider"
        }
    ],

    "config": [
        {
            "id": "economy.assets.categories",
            "file": "config/categories.jsonc"
        },
        {
            "id": "economy.assets.trackingKinds",
            "file": "config/trackingKinds.jsonc"
        },
        {
            "id": "economy.assets.planMessages",
            "file": "config/planMessages.jsonc"
        },
        {
            "id": "economy.assets.eventKinds",
            "file": "config/eventKinds.jsonc"
        },
        {
            "id": "economy.assets.eventScopes",
            "file": "config/eventScopes.jsonc"
        },
        {
            "id": "economy.assets.eventOrigins",
            "file": "config/eventOrigins.jsonc"
        },
        {
            "id": "economy.assets.eventStates",
            "file": "config/eventStates.jsonc"
        },
        {
            "id": "economy.assets.accMethods",
            "file": "config/accMethods.jsonc"
        },
        {
            "id": "economy.assets.viewerLabels",
            "file": "config/viewerLabels.jsonc"
        }
    ]
}
