// Přehledy majetku (docs/assets.md D65–D67, §5.6; docs/reports.md §16).
// Zdrojem je evidence — karty, události a plány odpisů —, ne deník; deník
// slouží jen kontrole (economy.assets.journalCheck). Registrace:
// module.jsonc → klíč "reports". Stav „k datu“ = poslední den zvoleného
// období.
[
    {
        "id": "economy.assets.depreciationSchedule",
        "navSection": "assets",
        "navOrder": 50,
        "name": "Depreciation schedule",
        "name:cs": "Sestava odpisů",
        "name:en": "Depreciation schedule",
        "builder": "Shipard\\Module\\Economy\\Assets\\Reports\\DepreciationScheduleBuilder",
        "periodGranularities": ["year"],
        "params": [
            {
                "id": "groupBy", "type": "enum",
                "name": "Group by", "name:cs": "Seskupit podle", "name:en": "Group by",
                "options": ["accountingGroup", "taxRule", "type", "none"],
                "optionNames": {
                    "accountingGroup": "Accounting group", "accountingGroup:cs": "Účetní skupina", "accountingGroup:en": "Accounting group",
                    "taxRule": "Tax group and method", "taxRule:cs": "Daňová skupina a metoda", "taxRule:en": "Tax group and method",
                    "type": "Asset type", "type:cs": "Typ majetku", "type:en": "Asset type",
                    "none": "No grouping", "none:cs": "Neseskupovat", "none:en": "No grouping"
                },
                "default": "accountingGroup"
            },
            {
                "id": "category", "type": "enum",
                "name": "Assets", "name:cs": "Majetek", "name:en": "Assets",
                "options": ["all", "longTerm", "nondepreciable"],
                "optionNames": {
                    "all": "All fixed assets", "all:cs": "Všechen dlouhodobý", "all:en": "All fixed assets",
                    "longTerm": "Depreciated", "longTerm:cs": "Odepisovaný", "longTerm:en": "Depreciated",
                    "nondepreciable": "Non-depreciable", "nondepreciable:cs": "Neodepisovaný", "nondepreciable:en": "Non-depreciable"
                },
                "default": "all"
            }
        ]
    },
    {
        "id": "economy.assets.movements",
        "navSection": "assets",
        "navOrder": 51,
        "name": "Additions and disposals",
        "name:cs": "Přírůstky a úbytky",
        "name:en": "Additions and disposals",
        "builder": "Shipard\\Module\\Economy\\Assets\\Reports\\MovementsBuilder",
        "periodGranularities": ["month", "quarter", "halfYear", "year"],
        "params": [
            {
                "id": "kind", "type": "enum",
                "name": "Movements", "name:cs": "Pohyby", "name:en": "Movements",
                "options": ["all", "additions", "disposals"],
                "optionNames": {
                    "all": "Additions and disposals", "all:cs": "Přírůstky i úbytky", "all:en": "Additions and disposals",
                    "additions": "Additions only", "additions:cs": "Jen přírůstky", "additions:en": "Additions only",
                    "disposals": "Disposals only", "disposals:cs": "Jen úbytky", "disposals:en": "Disposals only"
                },
                "default": "all"
            }
        ]
    },
    {
        "id": "economy.assets.taxDepreciationReturn",
        "navSection": "assets",
        "navOrder": 52,
        "name": "Tax depreciation for the income tax return",
        "name:cs": "Daňové odpisy pro DPPO",
        "name:en": "Tax depreciation for the income tax return",
        "builder": "Shipard\\Module\\Economy\\Assets\\Reports\\TaxDepreciationReturnBuilder",
        "periodGranularities": ["year"],
        "params": []
    },
    {
        "id": "economy.assets.journalCheck",
        "navSection": "assets",
        "navOrder": 53,
        "name": "Register × journal check",
        "name:cs": "Kontrola evidence × deník",
        "name:en": "Register × journal check",
        "builder": "Shipard\\Module\\Economy\\Assets\\Reports\\JournalCheckBuilder",
        "periodGranularities": ["year"],
        "params": []
    },
    {
        "id": "economy.assets.register",
        "navSection": "assets",
        "navOrder": 54,
        "name": "Asset register",
        "name:cs": "Soupis majetku",
        "name:en": "Asset register",
        "builder": "Shipard\\Module\\Economy\\Assets\\Reports\\RegisterBuilder",
        "periodGranularities": ["month", "year"],
        "params": [
            {
                "id": "groupBy", "type": "enum",
                "name": "Group by", "name:cs": "Seskupit podle", "name:en": "Group by",
                "options": ["type", "category", "accountingGroup"],
                "optionNames": {
                    "type": "Asset type", "type:cs": "Typ majetku", "type:en": "Asset type",
                    "category": "Category", "category:cs": "Druh majetku", "category:en": "Category",
                    "accountingGroup": "Accounting group", "accountingGroup:cs": "Účetní skupina", "accountingGroup:en": "Accounting group"
                },
                "default": "type"
            },
            {
                "id": "foreign", "type": "enum",
                "name": "Foreign assets", "name:cs": "Cizí majetek", "name:en": "Foreign assets",
                "options": ["include", "exclude", "only"],
                "optionNames": {
                    "include": "Including foreign", "include:cs": "Včetně cizího", "include:en": "Including foreign",
                    "exclude": "Own assets only", "exclude:cs": "Jen vlastní", "exclude:en": "Own assets only",
                    "only": "Foreign assets only", "only:cs": "Jen cizí", "only:en": "Foreign assets only"
                },
                "default": "include"
            }
        ]
    }
]
