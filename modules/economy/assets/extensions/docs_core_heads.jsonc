    // asset — karta majetku, které se doklad týká. Výchozí hodnota dimenze
    //   deníku `asset` (`headColumn` v journalDimensions): řádek bez vlastní
    //   karty a hlavičkové kroky předpisu ji zdědí. Pole nabízí formulář jen
    //   se zapnutým nastavením „Sledovat náklady na majetek“; uložená hodnota
    //   se do deníku propisuje vždy.

    "table": "docs_core_heads",
    "columns": [
        {
            "id": "asset",
            "name": "Asset",
            "name:cs": "Majetek",
            "name:en": "Asset",
            "type": "int",
            "nullable": true,
            "reference": "economy_assets_assets"
        }
    ],
    "indexes": [
        {
            "id": "idx_asset",
            "type": "index",
            "columns": [{"column": "asset"}]
        }
    ]
}
