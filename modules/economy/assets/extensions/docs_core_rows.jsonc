{
    // Extension z economy.assets na řádky dokladů (docs/assets.md D15, D47).
    //
    // asset — karta majetku, které se řádek týká. Zdroj dimenze deníku
    //   `asset` (journalDimensions v module.jsonc): účtovací engine hodnotu
    //   zkopíruje do řádku deníku. Povinná u operací s vlajkou `rowAsset: 1`
    //   (asset.*, D48), nepovinná u pořízení (`purchase.asset`, D61); na
    //   ostatních řádcích ji nabízí nastavení „Sledovat náklady na majetek“
    //   (D59). Index kvůli sekci Pořízení na kartě a alertům (D63).

    "table": "docs_core_rows",
    "columns": [
        {
            "id": "asset",
            "name": "Asset",
            "name:cs": "Majetek",
            "name:en": "Asset",
            "type": "int",
            "nullable": true,
            "reference": "economy_assets_assets"
        }
    ],
    "indexes": [
        {
            "id": "idx_asset",
            "type": "index",
            "columns": [{"column": "asset"}]
        }
    ]
}
