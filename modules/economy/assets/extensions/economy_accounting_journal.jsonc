{
    // Extension z economy.assets na účetní deník (docs/assets.md D15, D47).
    //
    // asset — dimenze deníku: karta majetku, které se zápis týká. Plní ji
    //   AccountingEngine z řádku dokladu (journalDimensions v module.jsonc);
    //   bankovní zápisy a příspěvky contributorů ji nemají (NULL). Na ní
    //   stojí invariant „evidence = deník“ (docs/assets.md §1).

    "table": "economy_accounting_journal",
    "columns": [
        {
            "id": "asset",
            "name": "Asset",
            "name:cs": "Majetek",
            "name:en": "Asset",
            "type": "int",
            "nullable": true,
            "reference": "economy_assets_assets"
        }
    ],
    "indexes": [
        {
            "id": "idx_asset",
            "type": "index",
            "columns": [{"column": "asset"}]
        }
    ]
}
