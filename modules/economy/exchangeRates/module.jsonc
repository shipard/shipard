{
    // Kurzy cizích měn (docs/exchange-rates.md, #121 D1): kurzovní lístky
    // a jejich hodnoty v tabulkách zdroje dat — převzatá data, v UI jen ke
    // čtení. Typy lístků deklaruje modul země (world.cz.exchangeRateLists);
    // jediná cesta zápisu je ExchangeRateListImporter (CLI
    // exchange-rates-import, seeder datové sady, v tasku B služba).
    // Kurz k datu dává ExchangeRateResolver (D4, D5, U1, U2) — volají ho
    // formuláře dokladů, applier a import bankovního výpisu.
    "id": "economy.exchangeRates",
    "name": "Exchange rates",
    "name:cs": "Kurzy cizích měn",
    "name:en": "Exchange rates",
    "description": "Exchange rate lists of the data source's country and the rate-for-date lookup used by documents, the applier and bank statement import",
    "description:cs": "Kurzovní lístky země zdroje dat a dohledání kurzu k datu pro doklady, applier a import bankovního výpisu",
    "description:en": "Exchange rate lists of the data source's country and the rate-for-date lookup used by documents, the applier and bank statement import",

    "dependencies": ["core.system", "world.base"],

    "tables": [
        "economy_exchange_rates_lists",
        "economy_exchange_rates_values"
    ],

    // Nastavení → Účetnictví → Kurzovní lístky: jen ke čtení (§9).
    "settingsItems": [
        { "viewer": "economy.exchangeRates.lists", "section": "accounting", "order": 60 }
    ],

    "viewers": [
        {
            "id": "economy.exchangeRates.lists",
            "name": "Exchange rate lists",
            "name:cs": "Kurzovní lístky",
            "name:en": "Exchange rate lists",
            "icon": "exchange-rates",
            "table": "economy_exchange_rates_lists",
            "class": "Shipard\\Module\\Economy\\ExchangeRates\\ExchangeRateListsViewer"
        }
    ],

    "config": [
        {
            // Zdroj lístku (sloupec `source`): soubor / datová sada / služba.
            "id": "economy.exchangeRates.listSources",
            "file": "config/listSources.jsonc"
        },
        {
            "id": "economy.exchangeRates.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        }
    ],

    // Upozornění na chybějící lístek (task B U6, D9): denní typ bez lístku za
    // pracovní den v posledních 30 dnech (dnešek se nehlídá), měsíční typ bez
    // lístku běžného měsíce od 2. dne. Jen u typu, který už nějaký lístek má.
    "alertChecks": [
        {
            "id": "economy.exchangerates.list_missing",
            "name": "Exchange rate list missing",
            "name:cs": "Chybí kurzovní lístek",
            "name:en": "Exchange rate list missing",
            "description": "Working days of the last 30 days without a daily list, or the monthly list missing from the 2nd day of the month — no rate is filled in for those dates.",
            "description:cs": "Pracovní dny posledních 30 dnů bez denního lístku, nebo měsíční lístek chybějící od 2. dne měsíce — k těmto datům se kurz nedoplní.",
            "description:en": "Working days of the last 30 days without a daily list, or the monthly list missing from the 2nd day of the month — no rate is filled in for those dates.",
            "class": "Shipard\\Module\\Economy\\ExchangeRates\\Checks\\ListMissingCheck",
            "severity": "warning",
            "interval": "1h",
            "navSection": "accounting",
            "tags": ["exchangeRates"]
        }
    ]
}
