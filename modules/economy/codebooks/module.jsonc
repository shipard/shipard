{
    "id": "economy.codebooks",
    "name": "Codebooks",
    "name:cs": "Číselníky",
    "name:en": "Codebooks",
    "description": "Warehouses, cost centers, fiscal periods, VAT registrations, cash desks, bank accounts and other codebooks",
    "description:cs": "Sklady, střediska, fiskální období, registrace DPH, pokladny, bankovní spojení a další číselníky",
    "description:en": "Warehouses, cost centers, fiscal periods, VAT registrations, cash desks, bank accounts and other codebooks",

    "dependencies": ["core.system", "world.base", "world.trade", "base.persons"],

    "tables": [
        "economy_codebooks_warehouses",
        "economy_codebooks_cost_centers",
        "economy_codebooks_fiscal_years",
        "economy_codebooks_fiscal_months",
        "economy_codebooks_vat_registrations",
        "economy_codebooks_cash_desks",
        "economy_codebooks_bank_accounts",
        "economy_codebooks_payment_terminals",
        "economy_codebooks_transports"
    ],

    "settingsItems": [
        { "viewer": "economy.codebooks.fiscalYears",      "section": "accounting" },
        // Agenda DPH se skrývá u neplátce bez jediné registrace (D11) —
        // runtime gate, viz VatAgendaNavGate.
        { "viewer": "economy.codebooks.vatRegistrations", "section": "accounting",
          "visibilityClass": "Shipard\\Module\\Economy\\Codebooks\\VatAgendaNavGate" },
        { "viewer": "economy.codebooks.cashDesks",        "section": "accounting" },
        { "viewer": "economy.codebooks.paymentTerminals", "section": "accounting" },
        { "viewer": "economy.codebooks.transports",       "section": "accounting" },
        { "viewer": "economy.codebooks.bankAccounts",     "section": "accounting" },
        { "viewer": "economy.codebooks.warehouses",       "section": "warehouses" },
        { "viewer": "economy.codebooks.costCenters",      "section": "warehouses" }
    ],

    "viewers": [
        {
            "id": "economy.codebooks.fiscalYears",
            "name": "Fiscal periods",
            "name:cs": "Fiskální období",
            "name:en": "Fiscal periods",
            "icon": "calendar",
            "table": "economy_codebooks_fiscal_years",
            "class": "Shipard\\Module\\Economy\\Codebooks\\FiscalYearsViewer"
        },
        {
            "id": "economy.codebooks.vatRegistrations",
            "name": "VAT registrations",
            "name:cs": "Registrace DPH",
            "name:en": "VAT registrations",
            "icon": "vat",
            "table": "economy_codebooks_vat_registrations",
            "class": "Shipard\\Module\\Economy\\Codebooks\\VatRegistrationsViewer"
        },
        {
            "id": "economy.codebooks.cashDesks",
            "name": "Cash desks",
            "name:cs": "Pokladny",
            "name:en": "Cash desks",
            "icon": "cash-register",
            "table": "economy_codebooks_cash_desks",
            "class": "Shipard\\Module\\Economy\\Codebooks\\CashDesksViewer"
        },
        {
            "id": "economy.codebooks.paymentTerminals",
            "name": "Payment terminals and gateways",
            "name:cs": "Platební terminály a brány",
            "name:en": "Payment terminals and gateways",
            "icon": "credit-card",
            "table": "economy_codebooks_payment_terminals",
            "class": "Shipard\\Module\\Economy\\Codebooks\\PaymentTerminalsViewer"
        },
        {
            "id": "economy.codebooks.transports",
            "name": "Transports",
            "name:cs": "Způsoby dopravy",
            "name:en": "Transports",
            "icon": "truck",
            "table": "economy_codebooks_transports",
            "class": "Shipard\\Module\\Economy\\Codebooks\\TransportsViewer"
        },
        {
            "id": "economy.codebooks.bankAccounts",
            "name": "Bank accounts",
            "name:cs": "Bankovní spojení",
            "name:en": "Bank accounts",
            "icon": "bank",
            "table": "economy_codebooks_bank_accounts",
            "class": "Shipard\\Module\\Economy\\Codebooks\\BankAccountsViewer"
        },
        {
            "id": "economy.codebooks.warehouses",
            "name": "Warehouses",
            "name:cs": "Sklady",
            "name:en": "Warehouses",
            "icon": "warehouse",
            "table": "economy_codebooks_warehouses",
            "class": "Shipard\\Module\\Economy\\Codebooks\\WarehousesViewer"
        },
        {
            "id": "economy.codebooks.costCenters",
            "name": "Cost centers",
            "name:cs": "Střediska",
            "name:en": "Cost centers",
            "icon": "chart-pie",
            "table": "economy_codebooks_cost_centers",
            "class": "Shipard\\Module\\Economy\\Codebooks\\CostCentersViewer"
        }
    ],

    "forms": [
        {
            "table": "economy_codebooks_fiscal_years",
            "class": "Shipard\\Module\\Economy\\Codebooks\\FiscalYearsForm"
        },
        {
            "table": "economy_codebooks_fiscal_months",
            "id": "economy.codebooks.fiscal_months"
        },
        {
            "table": "economy_codebooks_vat_registrations",
            "class": "Shipard\\Module\\Economy\\Codebooks\\VatRegistrationsForm"
        },
        {
            "table": "economy_codebooks_cash_desks",
            "id": "economy.codebooks.cash_desks"
        },
        {
            "table": "economy_codebooks_bank_accounts",
            "id": "economy.codebooks.bank_accounts"
        },
        {
            "table": "economy_codebooks_payment_terminals",
            "id": "economy.codebooks.payment_terminals"
        },
        {
            "table": "economy_codebooks_transports",
            "id": "economy.codebooks.transports"
        },
        { "table": "economy_codebooks_warehouses",   "id": "economy.codebooks.warehouses" },
        { "table": "economy_codebooks_cost_centers", "id": "economy.codebooks.cost_centers" }
    ],

    // Zámek fiskálního měsíce nad doklady (#55 D27): zamčený měsíc blokuje
    // každý doklad s účetním datem v něm (koncepty i bezdaňové včetně).
    // Ptá se TableGateway, generické CRUD i nabídka přechodů.
    "documentLockProviders": [
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\Codebooks\\FiscalMonthLockProvider"
        }
    ],

    "documentClasses": [
        {
            "table": "economy_codebooks_fiscal_years",
            "class": "Shipard\\Module\\Economy\\Codebooks\\FiscalYearDocument"
        },
        {
            "table": "economy_codebooks_fiscal_months",
            "class": "Shipard\\Module\\Economy\\Codebooks\\FiscalMonthDocument"
        },
        {
            "table": "economy_codebooks_vat_registrations",
            "class": "Shipard\\Module\\Economy\\Codebooks\\VatRegistrationDocument"
        },
        {
            "table": "economy_codebooks_cash_desks",
            "class": "Shipard\\Module\\Economy\\Codebooks\\CashDeskDocument"
        },
        {
            "table": "economy_codebooks_bank_accounts",
            "class": "Shipard\\Module\\Economy\\Codebooks\\BankAccountDocument"
        },
        {
            "table": "economy_codebooks_payment_terminals",
            "class": "Shipard\\Module\\Economy\\Codebooks\\PaymentTerminalDocument"
        },
        {
            "table": "economy_codebooks_transports",
            "class": "Shipard\\Module\\Economy\\Codebooks\\TransportDocument"
        },
        { "table": "economy_codebooks_warehouses",   "class": "Shipard\\Module\\Economy\\Codebooks\\WarehouseDocument" },
        { "table": "economy_codebooks_cost_centers", "class": "Shipard\\Module\\Economy\\Codebooks\\CostCenterDocument" }
    ],

    "lookups": [
        {
            "table": "economy_codebooks_bank_accounts",
            "class": "Shipard\\Module\\Economy\\Codebooks\\BankAccountsLookup"
        },
        {
            "table": "economy_codebooks_cash_desks",
            "class": "Shipard\\Module\\Economy\\Codebooks\\CashDesksLookup"
        },
        {
            "table": "economy_codebooks_payment_terminals",
            "class": "Shipard\\Module\\Economy\\Codebooks\\PaymentTerminalsLookup"
        },
        {
            "table": "economy_codebooks_transports",
            "class": "Shipard\\Module\\Economy\\Codebooks\\TransportsLookup"
        },
        {
            "table": "economy_codebooks_warehouses",
            "class": "Shipard\\Module\\Economy\\Codebooks\\WarehousesLookup"
        }
    ],

    "alertChecks": [
        {
            "id": "economy.codebooks.undecided_vat_agenda",
            "name": "VAT agenda not decided",
            "name:cs": "Nerozhodnutá agenda DPH",
            "name:en": "VAT agenda not decided",
            "description": "Decide whether the company keeps a VAT agenda; it drives the default VAT mode of new documents.",
            "description:cs": "Urči, jestli firma vede agendu DPH — řídí výchozí režim DPH nových dokladů.",
            "description:en": "Decide whether the company keeps a VAT agenda; it drives the default VAT mode of new documents.",
            "class": "Shipard\\Module\\Economy\\Codebooks\\Checks\\UndecidedVatAgendaCheck",
            "severity": "warning",
            "interval": "5m",
            "tags": ["setup"]
        },
        {
            "id": "economy.codebooks.missing_vat_registration",
            "name": "VAT registration is missing",
            "name:cs": "Chybí Registrace DPH",
            "name:en": "VAT registration is missing",
            "description": "The company keeps a VAT agenda but has no VAT registration; documents with VAT cannot be confirmed.",
            "description:cs": "Firma vede agendu DPH, ale nemá Registraci DPH — doklad s DPH nejde potvrdit.",
            "description:en": "The company keeps a VAT agenda but has no VAT registration; documents with VAT cannot be confirmed.",
            "class": "Shipard\\Module\\Economy\\Codebooks\\Checks\\MissingVatRegistrationCheck",
            "severity": "warning",
            "interval": "5m",
            "tags": ["setup"]
        },
        {
            "id": "economy.codebooks.missing_own_bank_account",
            "name": "Own bank account is missing",
            "name:cs": "Chybí vlastní bankovní účet",
            "name:en": "Own bank account is missing",
            "description": "Add the company bank account to the codebook; issued invoices cannot be confirmed without it.",
            "description:cs": "Založ bankovní spojení firmy do číselníku — bez něj nejde potvrdit vydaná faktura.",
            "description:en": "Add the company bank account to the codebook; issued invoices cannot be confirmed without it.",
            "class": "Shipard\\Module\\Economy\\Codebooks\\Checks\\MissingOwnBankAccountCheck",
            "severity": "warning",
            "interval": "5m",
            "tags": ["setup"]
        },
        {
            "id": "economy.codebooks.undecided_fiscal_year_start",
            "name": "Fiscal year start month not chosen",
            "name:cs": "Nezvolen první měsíc fiskálního roku",
            "name:en": "Fiscal year start month not chosen",
            "description": "Choose the fiscal year start month; until decided, fiscal years are not created.",
            "description:cs": "Zvol první měsíc fiskálního roku — do rozhodnutí se fiskální roky nezakládají.",
            "description:en": "Choose the fiscal year start month; until decided, fiscal years are not created.",
            "class": "Shipard\\Module\\Economy\\Codebooks\\Checks\\UndecidedFiscalYearStartCheck",
            "severity": "warning",
            "interval": "5m",
            "tags": ["setup"]
        },
        {
            "id": "economy.codebooks.undecided_home_currency",
            "name": "Home currency not chosen",
            "name:cs": "Nezvolena domácí měna",
            "name:en": "Home currency not chosen",
            "description": "Choose the home currency of the books; new documents and fiscal years use it.",
            "description:cs": "Zvol domácí měnu účetnictví — používají ji nové doklady a fiskální roky.",
            "description:en": "Choose the home currency of the books; new documents and fiscal years use it.",
            "class": "Shipard\\Module\\Economy\\Codebooks\\Checks\\UndecidedHomeCurrencyCheck",
            "severity": "warning",
            "interval": "5m",
            "tags": ["setup"]
        }
    ],

    "config": [
        {
            "id": "economy.codebooks.fiscalPeriodTypes",
            "file": "config/fiscalPeriodTypes.jsonc"
        },
        {
            "id": "economy.codebooks.paymentTerminalKinds",
            "file": "config/paymentTerminalKinds.jsonc"
        },
        {
            "id": "economy.codebooks.fiscalConfig",
            "file": "config/fiscalConfig.jsonc"
        },
        {
            "id": "economy.codebooks.vatTaxpayerKinds",
            "file": "config/vatTaxpayerKinds.jsonc"
        },
        {
            "id": "economy.codebooks.vatPeriodKinds",
            "file": "config/vatPeriodKinds.jsonc"
        },
        {
            "id": "economy.codebooks.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        }
    ]
}
