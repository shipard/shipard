{
    "id": "economy.bank",
    "name": "Bank",
    "name:cs": "Banka",
    "name:en": "Bank",
    "description": "Bank transactions and statements",
    "description:cs": "Bankovní transakce a výpisy",
    "description:en": "Bank transactions and statements",

    "dependencies": ["core.system", "economy.accounting", "economy.codebooks", "docs.core", "core.attachments"],

    "tables": [
        "economy_bank_transactions",
        "economy_bank_statements"
    ],

    "extensions": [
        "economy_codebooks_bank_accounts",
        "economy_accounting_journal"
    ],

    "viewers": [
        {
            "id": "economy.bank.transactions",
            "name": "Bank transactions",
            "name:cs": "Bankovní transakce",
            "name:en": "Bank transactions",
            "icon": "money-transfer",
            "table": "economy_bank_transactions",
            "class": "Shipard\\Module\\Economy\\Bank\\BankTransactionsViewer",
            "navSection": "accounting",
            "navOrder": 30
        },
        {
            "id": "economy.bank.statements",
            "name": "Bank statements",
            "name:cs": "Bankovní výpisy",
            "name:en": "Bank statements",
            "icon": "bank",
            "table": "economy_bank_statements",
            "class": "Shipard\\Module\\Economy\\Bank\\BankStatementsViewer",
            "navSection": "accounting",
            "navOrder": 40
        }
    ],

    "forms": [
        {"table": "economy_bank_transactions", "id": "economy.bank.transactions"},
        {"table": "economy_bank_statements",   "id": "economy.bank.statements"}
    ],

    "documentClasses": [
        {"table": "economy_bank_transactions", "class": "Shipard\\Module\\Economy\\Bank\\BankTransactionDocument"},
        {"table": "economy_bank_statements",   "class": "Shipard\\Module\\Economy\\Bank\\BankStatementDocument"}
    ],

    "documentEventHandlers": [
        {
            "table": "economy_bank_transactions",
            "class": "Shipard\\Module\\Economy\\Bank\\BankTransactionEventHandler",
            "events": ["stateChanged", "beforeDelete"]
        }
    ],

    "alertChecks": [
        {
            "id": "economy.bank.reconciliation_errors",
            "name": "Bank statement reconciliation",
            "name:cs": "Rekonciliace bankovních výpisů",
            "name:en": "Bank statement reconciliation",
            "description": "Bank statements whose opening balance plus movements does not match the closing balance.",
            "description:cs": "Bankovní výpisy, u nichž počáteční zůstatek a obraty nesedí s koncovým zůstatkem.",
            "description:en": "Bank statements whose opening balance plus movements does not match the closing balance.",
            "class": "Shipard\\Module\\Economy\\Bank\\Checks\\StatementReconciliationCheck",
            "severity": "warning",
            "interval": "1h",
            "navSection": "accounting",
            "tags": ["bank"]
        },
        {
            "id": "economy.bank.accounting_errors",
            "name": "Bank transaction accounting errors",
            "name:cs": "Chyby účtování bankovních transakcí",
            "name:en": "Bank transaction accounting errors",
            "description": "Bank transactions in the Accounted state that failed to post to the journal.",
            "description:cs": "Bankovní transakce ve stavu Zaúčtováno, které se nepodařilo zaúčtovat do deníku.",
            "description:en": "Bank transactions in the Accounted state that failed to post to the journal.",
            "class": "Shipard\\Module\\Economy\\Bank\\Checks\\BankAccountingErrorsCheck",
            "severity": "warning",
            "interval": "15m",
            "navSection": "accounting",
            "tags": ["bank"]
        }
    ],

    "config": [
        {"id": "economy.bank.txStates",             "file": "config/txStates.jsonc"},
        {"id": "economy.bank.txOperations",         "file": "config/txOperations.jsonc"},
        {"id": "economy.bank.txDirections",         "file": "config/txDirections.jsonc"},
        {"id": "economy.bank.reconciliationStates", "file": "config/reconciliationStates.jsonc"},
        {"id": "economy.bank.statementFormats",     "file": "config/statementFormats.jsonc"},
        {"id": "economy.bank.overviewTexts",        "file": "config/overviewTexts.jsonc"}
    ],

    // Přehled firmy (#120): Peníze → banka = koncový zůstatek posledního výpisu per účet.
    "overviewBlocks": [
        {"id": "economy.bank.balances", "section": "money", "order": 10, "class": "Shipard\\Module\\Economy\\Bank\\Overview\\BankBalancesBlock"}
    ]
}
