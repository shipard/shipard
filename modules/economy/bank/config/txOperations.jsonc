{
    // economy.bank.txOperations
    //
    // Pohyby bankovní transakce (economy_bank_transactions.operation).
    // Klíč = stabilní stringový identifikátor. `direction` (1 příjem / 2 výdaj)
    // říká, na jakou stranu transakce patří; `cat` je účetní kategorie, kterou
    // konzumuje bankovní mikroengine (Fáze 3) přes sekci `accounts` účtovacího
    // předpisu (accountingRules.cz.jsonc).
    //
    // Default operace dle směru (payment.in / payment.out) doplní ingestion /
    // UI ve Fázi 2/3; tento config jen definuje povolenou sadu.
    //
    // Úhrady (payment.*): spárovanost `operation` nenese (#69 D3). Engine
    // dohledá otevřený předpis pro klíč partner+VS+SS+měna (OpenItemLookup)
    // a položí úhradu na jeho účet 311/321; kategorie bank.unmatched.* →
    // clearing 261200/261300 je jen výstup při miss.

    "payment.in": {
        "name": "Incoming payment",
        "name:cs": "Příjem",
        "name:en": "Incoming payment",
        "direction": 1,
        "cat": "bank.unmatched.in"
    },
    "payment.out": {
        "name": "Outgoing payment",
        "name:cs": "Výdaj",
        "name:en": "Outgoing payment",
        "direction": 2,
        "cat": "bank.unmatched.out"
    },
    "fee.out": {
        "name": "Bank fee",
        "name:cs": "Bankovní poplatek",
        "name:en": "Bank fee",
        "direction": 2,
        "cat": "bank.fee"
    },
    "interest.in": {
        "name": "Interest received",
        "name:cs": "Připsaný úrok",
        "name:en": "Interest received",
        "direction": 1,
        "cat": "bank.interest.in"
    },
    "interest.out": {
        "name": "Interest paid",
        "name:cs": "Zaplacený úrok",
        "name:en": "Interest paid",
        "direction": 2,
        "cat": "bank.interest.out"
    },
    // Převody peněz (#59 Task D): protistrana je vlastní pokladna (nebo
    // vlastní jiný bankovní účet). Obě strany přes 261100 (cash.transit) —
    // po zaúčtování obou nulový zůstatek. Matcher accbal transakce nevidí:
    // kandidáty bere z clearingu 261200/261300, 261100 v žádné saldo skupině
    // není. Automatická detekce převodu z výpisu je refinement (bank.md §11).
    "transfer.in": {
        "name": "Transfer in (own cash / account)",
        "name:cs": "Příjem z převodu peněz",
        "name:en": "Transfer in (own cash / account)",
        "direction": 1,
        "cat": "cash.transit"
    },
    "transfer.out": {
        "name": "Transfer out (own cash / account)",
        "name:cs": "Výdej pro převod peněz",
        "name:en": "Transfer out (own cash / account)",
        "direction": 2,
        "cat": "cash.transit"
    }
}
