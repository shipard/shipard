// Seed standardních saldokont (skupin + jejich účtů) pro BalancesProvisioner.
//
// Idempotence dle `code` skupiny: existující skupinu provisioner nepřepisuje
// (uživatel si ji mohl upravit), jen do ní doplní účty seedu, které v ní
// chybí — klíč (account_number, acc_side, bal_side, modify_sign). Prefixy
// účtů ověřeny proti nasazené osnově (accountChartDefault.jsonc).
//
// enum hodnoty:
//   acc_side:     0 = MD,       1 = DAL
//   amounts_sign: 0 = Všechny,  1 = Kladné,  2 = Záporné
//   bal_side:     0 = Předpis,  1 = Úhrada
//   modify_sign:  obrátit znaménko částky (dobropisy)
//
// creditNoteRule (#69 D18): sign-pravidlo dobropisu — záporná částka na
// účtu jedné skupiny je předpis / úhrada druhé skupiny ×−1 (311 záporně →
// Závazky, 321 záporně → Pohledávky). Výchozí chování nového Shipardu.
// Importovaný DS (skipProvisioning) dostane seed ve variantě legacy:
// tyto řádky se nezaloží a zbylé řádky mají částky Všechny (0), takže
// dobropis zůstává záporně ve své skupině jako ve starém systému. Skupina
// nese provisioning_variant; do legacy skupiny provisioner creditNoteRule
// řádky nikdy nedoplní (přepnutí je ruční, docs/accbal.md §3.2).
//
// Skupiny Poskytnuté/Přijaté půjčky (loans) zatím vynechány — přesné mapování
// účtů není potvrzené (old_shipard seed neobsahuje datové záznamy). Doplnit
// jako follow-up. Viz tasks/accbal-phase1-settings.md Otevřené body.
[
    {
        "code": "receivables",
        "name": "Pohledávky",
        "short_name": "Pohledávky",
        "sort_order": 10,
        "show_in_navigation": 1,
        "accounts": [
            {"account_number": "311", "acc_side": 0, "amounts_sign": 1, "bal_side": 0, "modify_sign": false, "note": "Pohledávka vzniká"},
            {"account_number": "311", "acc_side": 1, "amounts_sign": 1, "bal_side": 1, "modify_sign": false, "note": "Pohledávka se hradí"},
            // 315 Ostatní pohledávky (#72 D6): vyúčtování úhrad od brány /
            // terminálu / dopravce (311 DAL per doklad → 315 MD per dávka) a
            // bankovní úhrada 315 se párují jako běžný dlužník.
            {"account_number": "315", "acc_side": 0, "amounts_sign": 1, "bal_side": 0, "modify_sign": false, "note": "Ostatní pohledávka vzniká (vyúčtování brány / terminálu)"},
            {"account_number": "315", "acc_side": 1, "amounts_sign": 1, "bal_side": 1, "modify_sign": false, "note": "Ostatní pohledávka se hradí"},
            // Zrcadlo sign-pravidla dobropisu (D18): přijatý dobropis = pohledávka za dodavatelem.
            {"account_number": "321", "acc_side": 1, "amounts_sign": 2, "bal_side": 0, "modify_sign": true, "creditNoteRule": true, "note": "Dobropis závazku = pohledávka"},
            {"account_number": "321", "acc_side": 0, "amounts_sign": 2, "bal_side": 1, "modify_sign": true, "creditNoteRule": true, "note": "Úhrada dobropisu závazku"}
        ]
    },
    {
