{
    "id": "economy.accbal",
    "name": "Open items",
    "name:cs": "Saldokonto",
    "name:en": "Open items",
    "description": "Open items / balances configuration — groups and their accounts",
    "description:cs": "Nastavení saldokont — skupiny a jejich účty",
    "description:en": "Open items / balances configuration — groups and their accounts",

    "dependencies": ["core.system", "economy.accounting", "economy.bank", "docs.core", "economy.codebooks"],

    "tables": [
        "economy_accbal_balances",
        "economy_accbal_balance_accounts",
        "economy_accbal_ledger",
        "economy_accbal_allocations"
    ],

    "settingsItems": [
        { "viewer": "economy.accbal.balances",        "section": "accounting" },
        { "viewer": "economy.accbal.balanceAccounts",  "section": "accounting" },
        { "table": "economy_accbal_allocations", "section": "other", "subsection": "other.system", "order": 40 }
    ],

    "viewers": [
        {
            "id": "economy.accbal.balances",
            "name": "Balances",
            "name:cs": "Saldokonta",
            "name:en": "Balances",
            "icon": "balance",
            "table": "economy_accbal_balances",
            "class": "Shipard\\Module\\Economy\\Accbal\\BalancesViewer"
        },
        {
            "id": "economy.accbal.balanceAccounts",
            "name": "Balance accounts",
            "name:cs": "Účty saldokont",
            "name:en": "Balance accounts",
            "icon": "table",
            "table": "economy_accbal_balance_accounts",
            "class": "Shipard\\Module\\Economy\\Accbal\\BalanceAccountsViewer"
        },
        {
            "id": "economy.accbal.ledger",
            "name": "Balance ledger",
            "name:cs": "Saldo pohyby",
            "name:en": "Balance ledger",
            "icon": "movements",
            "table": "economy_accbal_ledger",
            "class": "Shipard\\Module\\Economy\\Accbal\\LedgerViewer",
            "navSection": "accounting",
            "navOrder": 30
        }
    ],

    "forms": [
        { "table": "economy_accbal_balances",         "id": "economy.accbal.balances" },
        { "table": "economy_accbal_balance_accounts", "id": "economy.accbal.balanceAccounts" }
    ],

    "lookups": [
        {
            "table": "economy_accbal_balances",
            "class": "Shipard\\Module\\Economy\\Accbal\\BalancesLookup"
        }
    ],

    "navigationProviders": [
        { "class": "Shipard\\Module\\Economy\\Accbal\\BalancesNavigationProvider" }
    ],

    // Pořadí je významové: dispatcher volá handlery v pořadí registrace —
    // reroute (přeúčtování clearingu po vzniku předpisu, #69 D4) potřebuje
    // ledger dokladu už re-derivovaný.
    "journalEventHandlers": [
        {
            "class": "Shipard\\Module\\Economy\\Accbal\\JournalLedgerHandler",
            "events": ["journalWritten"]
        },
        {
            "class": "Shipard\\Module\\Economy\\Accbal\\ClearingRerouteHandler",
            "events": ["journalWritten"]
        }
    ],

    // Dohledání otevřeného předpisu pro bankovní účtovací engine (#69 D3/D8):
    // účet úhrady = účet předpisu při zásahu klíče, jinak clearing.
    "openItemLookup": "Shipard\\Module\\Economy\\Accbal\\LedgerOpenItemLookup",

    "documentEventHandlers": [
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\Accbal\\AccbalSourceCleanupHandler",
            "events": ["beforeDelete"]
        },
        {
            "table": "economy_bank_transactions",
            "class": "Shipard\\Module\\Economy\\Accbal\\AccbalSourceCleanupHandler",
            "events": ["beforeDelete"]
        }
    ],

    "config": [
        { "id": "economy.accbal.accSides",          "file": "config/accSides.jsonc" },
        { "id": "economy.accbal.amountsSigns",      "file": "config/amountsSigns.jsonc" },
        { "id": "economy.accbal.balSides",          "file": "config/balSides.jsonc" },
        { "id": "economy.accbal.allocationOrigins", "file": "config/allocationOrigins.jsonc" }
    ]
}
