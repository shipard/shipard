{
    "tableId": 416,
    "name": "Balances",
    "name:cs": "Saldokonta",
    "name:en": "Balances",

    "displayPattern": "{name}",

    "docStates": {
        "stateColumn": "docState",
        "mainColumn": "docStateMain",
        "cfgItem": "core.system.docStatesArchive"
    },

    "columnGroups": [
        {"id": "identity", "name": "Identity", "name:cs": "Identifikace", "name:en": "Identity"},
        {"id": "settings", "name": "Settings", "name:cs": "Nastavení",    "name:en": "Settings"}
    ],

    "columns": [
        {"id": "id", "name": "ID", "type": "int", "autoIncrement": true, "primaryKey": true},

        // --- identity ---

        {"id": "code", "name": "Code", "name:cs": "Kód", "name:en": "Code",
            "type": "varchar", "length": 25, "nullable": false, "group": "identity"},
        {"id": "name", "name": "Name", "name:cs": "Název", "name:en": "Name",
            "type": "varchar", "length": 140, "nullable": false, "group": "identity"},
        {"id": "short_name", "name": "Short name", "name:cs": "Zkrácený název", "name:en": "Short name",
            "type": "varchar", "length": 80, "nullable": true, "group": "identity"},

        // --- settings ---

        {"id": "sort_order", "name": "Order", "name:cs": "Pořadí", "name:en": "Order",
            "type": "smallint", "default": 0, "nullable": false, "group": "settings"},
        {"id": "show_in_navigation", "name": "Show in navigation", "name:cs": "Zobrazit v navigaci", "name:en": "Show in navigation",
            "type": "boolean", "default": 0, "nullable": false, "group": "settings"},
        {"id": "valid_from", "name": "Valid from", "name:cs": "Platnost od", "name:en": "Valid from",
            "type": "date", "nullable": true, "group": "settings"},
        {"id": "valid_to", "name": "Valid to", "name:cs": "Platnost do", "name:en": "Valid to",
            "type": "date", "nullable": true, "group": "settings"},
        // Varianta seedu, kterou skupinu založil provisioner (#69 D18): NULL =
        // výchozí (sign-pravidla dobropisů), 'legacy' = importovaný DS bez nich
        // (částky Všechny). Řídí jen doplňování řádků seedu (creditNoteRule
        // se do legacy skupiny nedoplní); uživatelské řádky nemění.
        {"id": "provisioning_variant", "name": "Provisioning variant", "name:cs": "Varianta seedu", "name:en": "Provisioning variant",
            "type": "varchar", "length": 10, "nullable": true, "system": true},

        // --- doc state (systémové, bez skupiny) ---

        {"id": "docState", "name": "Document state", "name:cs": "Stav dokumentu", "name:en": "Document state",
            "type": "tinyint", "default": 10, "system": true},
        {"id": "docStateMain", "name": "Document state (sort)", "name:cs": "Stav dokumentu (řazení)", "name:en": "Document state (sort)",
            "type": "tinyint", "default": 1, "system": true}
    ],

    "indexes": [
        {"id": "unq_code", "type": "unique", "columns": [{"column": "code"}]},
        {"id": "idx_sort_order", "type": "index", "columns": [
            {"column": "sort_order", "order": "ASC"}, {"column": "name", "order": "ASC"}]},
        {"id": "idx_doc_state", "type": "index", "columns": [
            {"column": "docStateMain", "order": "ASC"}, {"column": "sort_order", "order": "ASC"}]}
    ]
}
