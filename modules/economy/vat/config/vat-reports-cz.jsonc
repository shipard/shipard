    // Popisky řádků DPHDP3 pro živý report (zkrácené názvy dle formuláře).
    // Řádek 52 se dopočítává (krácený × koeficient); 53/60/61 vstupují jen
    // do dopočtu 63/62 a zatím jsou nulové.
    "dp3Rows": {
        "1":  { "label": "Domestic supplies — standard rate", "label:cs": "Dodání zboží a poskytnutí služeb v tuzemsku — základní sazba" },
        "2":  { "label": "Domestic supplies — reduced rate", "label:cs": "Dodání zboží a poskytnutí služeb v tuzemsku — snížená sazba" },
        "3":  { "label": "Intra-EU acquisition of goods — standard rate", "label:cs": "Pořízení zboží z jiného členského státu — základní sazba" },
        "4":  { "label": "Intra-EU acquisition of goods — reduced rate", "label:cs": "Pořízení zboží z jiného členského státu — snížená sazba" },
        "5":  { "label": "Services received from the EU — standard rate", "label:cs": "Přijetí služby z jiného členského státu — základní sazba" },
        "6":  { "label": "Services received from the EU — reduced rate", "label:cs": "Přijetí služby z jiného členského státu — snížená sazba" },
        "7":  { "label": "Import of goods — standard rate", "label:cs": "Dovoz zboží — základní sazba" },
        "8":  { "label": "Import of goods — reduced rate", "label:cs": "Dovoz zboží — snížená sazba" },
        "10": { "label": "Domestic reverse charge — customer — standard rate", "label:cs": "Režim přenesení daňové povinnosti — odběratel — základní sazba" },
        "11": { "label": "Domestic reverse charge — customer — reduced rate", "label:cs": "Režim přenesení daňové povinnosti — odběratel — snížená sazba" },
        "12": { "label": "Other taxable supplies — standard rate", "label:cs": "Ostatní zdanitelná plnění s povinností přiznat daň — základní sazba" },
        "13": { "label": "Other taxable supplies — reduced rate", "label:cs": "Ostatní zdanitelná plnění s povinností přiznat daň — snížená sazba" },
        "20": { "label": "Supply of goods to another EU member state", "label:cs": "Dodání zboží do jiného členského státu" },
        "21": { "label": "Supply of services to another EU member state", "label:cs": "Poskytnutí služeb s místem plnění v jiném členském státě" },
        "22": { "label": "Export of goods", "label:cs": "Vývoz zboží" },
        "25": { "label": "Domestic reverse charge — supplier", "label:cs": "Režim přenesení daňové povinnosti — dodavatel" },
        "40": { "label": "Input tax deduction from domestic supplies — standard rate", "label:cs": "Nárok na odpočet z přijatých zdanitelných plnění — základní sazba" },
        "41": { "label": "Input tax deduction from domestic supplies — reduced rate", "label:cs": "Nárok na odpočet z přijatých zdanitelných plnění — snížená sazba" },
        "43": { "label": "Deduction from supplies reported on rows 3–13 — standard rate", "label:cs": "Odpočet ze zdanitelných plnění vykázaných na ř. 3–13 — základní sazba" },
        "44": { "label": "Deduction from supplies reported on rows 3–13 — reduced rate", "label:cs": "Odpočet ze zdanitelných plnění vykázaných na ř. 3–13 — snížená sazba" },
        "46": { "label": "Total deduction", "label:cs": "Odpočet daně celkem" },
        "50": { "label": "Exempt supplies without deduction entitlement", "label:cs": "Plnění osvobozená od daně bez nároku na odpočet" },
        "52": { "label": "Reduced deduction (rows 40–45 × coefficient)", "label:cs": "Krácený odpočet (ř. 40–45 × koeficient)" },
        "62": { "label": "Total output tax", "label:cs": "Daň na výstupu celkem" },
        "63": { "label": "Total deduction (46 + 52 + 53 + 60)", "label:cs": "Odpočet daně (46 + 52 + 53 + 60)" },
        "64": { "label": "Tax liability", "label:cs": "Vlastní daň" },
        "65": { "label": "Excess deduction", "label:cs": "Nadměrný odpočet" }
    },

    // Národní pravidla výkaznictví per typ výstupu — ne vlastnost typu
    // instance (config/reportTypes.jsonc je jen názvosloví).
    //
    // `validFrom` (#58) — zákonný počátek typu: doklad s efektivním datem
    //   před ním do výstupu nespadá (ukazatel NULL, koncept instance se
    //   nezaloží, generátor instanci před tímto datem nikdy nezačne).
    //   Přiznání a souhrnné hlášení omezení nemají — stará data jsou
    //   legitimní. Konec platnosti (`validTo`) záměrně neexistuje.
    //
    // Druhy podání a zaokrouhlení (#55 D16, D17) — čte VatOutputsMapping,
    // uplatňuje FilingDocument (které druhy lze podat) a FilingRounding
    // (jak se z přesných hodnot stanou podané):
    //
    // `filingKinds`          povolené druhy podání; názvosloví je
    //                        v config/filingKinds.jsonc. DP3 zná dodatečné
    //                        (§ 141 DŘ), hlášení místo něj následné
    //                        (§ 101f ZDPH); SH opravné nezná.
    // `supplementaryMode`    `diff` = dodatečné vykazuje rozdíly proti
    //                        předchozímu podání a změnu povinnosti na
    //                        ř. 66; `full` (default) = plný obsah znovu.
    // `dateFoundRequiredFor` druhy, u kterých je povinné datum zjištění
    //                        důvodů pro podání (KH následné: `d_zjist`).
    // `roundingUnit`         jednotka podaných hodnot: 1 = celé Kč
    //                        (DP3 řádek po řádku, SH nahoru), 0.01 = beze
    //                        změny (KH se podává na haléře).
    //
    // Zaúčtování přiznání (#55 D28–D31) — čte VatOutputsMapping::accounting(),
    // uplatňuje VatReturnAccountingBuilder; jen typ, který se účtuje (return):
    //
    // `accounting.payableDueDays`       splatnost odvodu od konce období
    //                                   (saldo řádek 343801)
    // `accounting.refundDueDays`        splatnost nadměrného odpočtu od konce
    //                                   období (saldo řádek 343802)
    // `accounting.specificSymbolPrefix` SS saldo řádku = prefix + RRRRMM konce
    //                                   období (starý vzor `705` + období)
    // `accounting.constantSymbol`       KS saldo řádku
    // `accounting.excludeAccounts`      saldo analytiky, které vypořádání
    //                                   nevynulovává (kontrola zůstatků 343)
    "reportTypes": {
        "return": {
            "filingKinds": ["regular", "corrective", "supplementary"],
            "supplementaryMode": "diff",
            "roundingUnit": 1,
            "accounting": {
                "payableDueDays": 25,
                "refundDueDays": 60,
                "specificSymbolPrefix": "705",
                "constantSymbol": "1148",
                "excludeAccounts": ["343801", "343802"]
            }
        },
        "cs": {
            "validFrom": "2016-01-01",   // zavedení kontrolního hlášení (§ 101c ZDPH)
            "filingKinds": ["regular", "corrective", "subsequent"],
            "dateFoundRequiredFor": ["subsequent"],
            "roundingUnit": 0.01
        },
        "rs": {
            "filingKinds": ["regular", "subsequent"],
            "roundingUnit": 1
        }
    }
}
