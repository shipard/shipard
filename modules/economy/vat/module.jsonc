{
    "id": "economy.vat",
    "name": "VAT",
    "name:cs": "DPH",
    "name:en": "VAT",
    "description": "VAT outputs: live VAT return, control statement and recapitulative statement computed on demand from confirmed documents (issue #55, M1)",
    "description:cs": "Výstupy DPH: živé přiznání, kontrolní hlášení a souhrnné hlášení počítané on-demand z potvrzených dokladů (issue #55, M1)",
    "description:en": "VAT outputs: live VAT return, control statement and recapitulative statement computed on demand from confirmed documents (issue #55, M1)",

    // world.vat = kódy DPH (legislativní vrstva bez výkaznických konvencí, D3),
    // economy.codebooks = registrace + období DPH, docs.core = doklady
    // a vat_recap, economy.accounting = deník pro křížovou kontrolu 343.
    // world.cz = statické české číselníky (finanční úřady a jejich územní
    // pracoviště v profilu podatele, #74).
    "dependencies": ["world.vat", "world.cz", "economy.codebooks", "docs.core", "economy.accounting"],

    "tables": [
        "economy_vat_report_periods",
        "economy_vat_deduction_coefficients",
        "economy_vat_filings",
        "economy_vat_filing_items",
        "economy_vat_filing_return_rows",
        "economy_vat_filing_cs_rows",
        "economy_vat_filing_rs_rows"
    ],

    // Zařazení dokladu do instancí tvrzení (vat_period / cs_period /
    // rs_period, D13) — docs.core na economy.vat nezávisí. Profil podatele
    // na registraci k DPH (#74, D19) — dtto economy.codebooks.
    "extensions": [
        "docs_core_heads",
        "economy_codebooks_vat_registrations"
    ],

    "documentEventHandlers": [
        {
            // Save-time přiřazení instancí (D8) + on-demand koncept (D9).
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\Vat\\DocsHeadsVatPeriodHandler",
            "events": ["beforeSave"]
        },
        {
            // Seed instancí běžného období po uložení registrace DPH
            // (dřív afterSave hook registrace v economy.codebooks).
            "table": "economy_codebooks_vat_registrations",
            "class": "Shipard\\Module\\Economy\\Vat\\VatRegistrationSeedHandler",
            "events": ["afterSave"]
        }
    ],

    // Zámek instance tvrzení nad doklady (#55 D23/D24): doklad s rekapitulací
    // DPH, jehož ukazatel míří na zamčenou instanci, nejde uložit, změnit
    // stav ani smazat. Ptá se TableGateway, CRUD i nabídka přechodů.
    "documentLockProviders": [
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\Vat\\VatPeriodLockProvider"
        }
    ],

    // Soubory podaného tvrzení jsou nevratný doklad — guard je chrání
    // před smazáním a přejmenováním (#55 X16).
    "attachmentGuards": [
        {
            "table": "economy_vat_filings",
            "class": "Shipard\\Module\\Economy\\Vat\\FilingAttachmentGuard"
        }
    ],

    "alertChecks": [
        {
            "id": "economy.vat.draft_report_periods",
            "name": "Draft VAT report periods",
            "name:cs": "Koncepty daňových tvrzení",
            "name:en": "Draft VAT report periods",
            "description": "Report period instances created on demand while saving a document — review the range and confirm them.",
            "description:cs": "Instance tvrzení založené automaticky při uložení dokladu — zkontrolujte rozsah a potvrďte je.",
            "description:en": "Report period instances created on demand while saving a document — review the range and confirm them.",
            "class": "Shipard\\Module\\Economy\\Vat\\Checks\\DraftReportPeriodsCheck",
            "severity": "warning",
            "interval": "15m",
            "navSection": "accounting",
            "tags": ["vat", "periods"]
        },
        {
            // Podané řádné přiznání starší než 3 dny bez zámku instance (#55 D25).
            "id": "economy.vat.filed_unlocked_periods",
            "name": "Filed VAT returns without lock",
            "name:cs": "Podaná přiznání bez zámku",
            "name:en": "Filed VAT returns without lock",
            "description": "A regular VAT return was filed more than 3 days ago but its report period is not locked — lock it so the filed content can no longer change.",
            "description:cs": "Řádné přiznání bylo podáno před více než 3 dny, ale tvrzení není uzamčené — uzamkněte ho, aby se podaný obsah už neměnil.",
            "description:en": "A regular VAT return was filed more than 3 days ago but its report period is not locked — lock it so the filed content can no longer change.",
            "class": "Shipard\\Module\\Economy\\Vat\\Checks\\FiledUnlockedPeriodsCheck",
            "severity": "warning",
            "interval": "1d",
            "navSection": "accounting",
            "tags": ["vat", "periods"]
        },
        {
            // Nenulový zůstatek 343 analytiky za podané přiznání (#55 D31) —
            // chybí zaúčtování přiznání (F4b), nebo se DPH po podání změnila.
            "id": "economy.vat.closed_period_balance",
            "name": "Unsettled VAT balances of filed returns",
            "name:cs": "Nevypořádaná DPH za podaná přiznání",
            "name:en": "Unsettled VAT balances of filed returns",
            "description": "Journal balance on a 343 analytical account across the documents of a filed VAT return is not zero — the return is not posted, or VAT changed after filing.",
            "description:cs": "Součet deníku na analytice 343 přes doklady podaného přiznání není nula — chybí zaúčtování přiznání, nebo se DPH po podání změnila.",
            "description:en": "Journal balance on a 343 analytical account across the documents of a filed VAT return is not zero — the return is not posted, or VAT changed after filing.",
            "class": "Shipard\\Module\\Economy\\Vat\\Checks\\ClosedPeriodBalanceCheck",
            "severity": "warning",
            "interval": "1d",
            "navSection": "accounting",
            "tags": ["vat", "periods", "accounting"]
        }
    ],

    "config": [
        { "id": "economy.vat.reports.cz", "file": "config/vat-reports-cz.jsonc" },

        // Mapování obsahu podání na atributy XML pro EPO (#55 Fáze 3, X4);
        // schémata v modules/economy/vat/xsd/.
        { "id": "economy.vat.xml.cz", "file": "config/vat-xml-cz.jsonc" },
        { "id": "economy.vat.reportTypes", "file": "config/reportTypes.jsonc" },
        { "id": "economy.vat.filingKinds", "file": "config/filingKinds.jsonc" },
        // Původ podání — sestaveno vs. importováno ze starého systému (#55 D34).
        { "id": "economy.vat.filingOrigins", "file": "config/filingOrigins.jsonc" },
        { "id": "economy.vat.docStatesFilings", "file": "config/docStatesFilings.jsonc" },

        // Profil podatele — schéma strukturovaného pole a jeho číselníky (#74).
        { "id": "economy.vat.filingProfileCz", "file": "config/filingProfileCz.jsonc" },
        { "id": "economy.vat.filingSubjectTypes", "file": "config/filingSubjectTypes.jsonc" },
        { "id": "economy.vat.filingSignatoryTypes", "file": "config/filingSignatoryTypes.jsonc" },
        { "id": "economy.vat.filingSignatoryCodes", "file": "config/filingSignatoryCodes.jsonc" },

        // Hlavička podání — schéma strukturovaného pole per typ tvrzení
        // (#55 Fáze 3, X2) a číselníky věty D přiznání.
        { "id": "economy.vat.filingHeaderCzDp3", "file": "config/filingHeaderCzDp3.jsonc" },
        { "id": "economy.vat.filingHeaderCzKh1", "file": "config/filingHeaderCzKh1.jsonc" },
        { "id": "economy.vat.filingHeaderCzShv", "file": "config/filingHeaderCzShv.jsonc" },
        { "id": "economy.vat.filingPayerTypes", "file": "config/filingPayerTypes.jsonc" },
        { "id": "economy.vat.filingNextPeriodCodes", "file": "config/filingNextPeriodCodes.jsonc" },
        // Ruční zařazení dokladu do KH (`docs_core_heads.cs_mode`, #77).
        { "id": "economy.vat.controlStatementModes", "file": "config/controlStatementModes.jsonc" }
    ],

    // Koeficienty odpočtu patří do Nastavení vedle Registrací DPH; stejný
    // gate agendy DPH (economy.codebooks je závislost modulu).
    "settingsItems": [
        { "viewer": "economy.vat.deductionCoefficients", "section": "accounting",
          "visibilityClass": "Shipard\\Module\\Economy\\Codebooks\\VatAgendaNavGate" }
    ],

    "viewers": [
        {
            // Instance daňových tvrzení (D7) — vedle živých reportů v sekci
            // účetnictví; registrace zůstávají v Nastavení.
            "id": "economy.vat.reportPeriods",
            "name": "VAT report periods",
            "name:cs": "Daňová tvrzení",
            "name:en": "VAT report periods",
            "icon": "calendar",
            "table": "economy_vat_report_periods",
            "class": "Shipard\\Module\\Economy\\Vat\\ReportPeriodsViewer",
            "navSection": "accounting",
            "navOrder": 50
        },
        {
            // Podání DPH (#55 D20) — za Daňovými tvrzeními: trvalý záznam
            // „co jsme za období podali".
            "id": "economy.vat.filings",
            "name": "VAT filings",
            "name:cs": "Podání DPH",
            "name:en": "VAT filings",
            "icon": "filing",
            "table": "economy_vat_filings",
            "class": "Shipard\\Module\\Economy\\Vat\\FilingsViewer",
            "navSection": "accounting",
            "navOrder": 55
        },
        {
            // Koeficient odpočtu per registrace × rok (#59 D13) — Nastavení.
            "id": "economy.vat.deductionCoefficients",
            "name": "VAT deduction coefficients",
            "name:cs": "Koeficienty odpočtu DPH",
            "name:en": "VAT deduction coefficients",
            "icon": "calculator",
            "table": "economy_vat_deduction_coefficients",
            "class": "Shipard\\Module\\Economy\\Vat\\DeductionCoefficientsViewer"
        }
    ],

    "forms": [
        {
            "table": "economy_vat_report_periods",
            "class": "Shipard\\Module\\Economy\\Vat\\ReportPeriodsForm"
        },
        {
            "table": "economy_vat_deduction_coefficients",
            "class": "Shipard\\Module\\Economy\\Vat\\DeductionCoefficientsForm"
        },
        {
            "table": "economy_vat_filings",
            "class": "Shipard\\Module\\Economy\\Vat\\FilingsForm"
        }
    ],

    "documentClasses": [
        {
            "table": "economy_vat_report_periods",
            "class": "Shipard\\Module\\Economy\\Vat\\ReportPeriodDocument"
        },
        {
            // Koeficient odpočtu per registrace × rok (#59 D13).
            "table": "economy_vat_deduction_coefficients",
            "class": "Shipard\\Module\\Economy\\Vat\\DeductionCoefficientDocument"
        },
        {
            // Podání DPH (#55 D14–D18): druhy, pořadí, lifecycle, guardy.
            "table": "economy_vat_filings",
            "class": "Shipard\\Module\\Economy\\Vat\\FilingDocument"
        }
    ],

    "reports": [
        { "file": "config/reports.jsonc" }
    ]
}
