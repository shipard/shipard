{
    // Podání DPH — dokladová úroveň snapshotu (issue #55, D15/1). Jedna
    // řada per (podání, doklad, řádek rekapitulace DPH) s **úplným**
    // obsahem instance v okamžiku sestavení, společná pro všechny tři
    // typy tvrzení. Nese materializovaný výsledek mapování, takže obsah
    // podání jde vyložit i po pozdější změně konfigurace, a umožňuje
    // rozdíly mezi podáními po dokladech.
    //
    // Systémová tabulka — vlastníkem je podání, zapisuje výhradně
    // FilingComposer (DELETE + INSERT celého podání). Žádné docStates.
    "tableId": 444,
    "name": "VAT filing items",
    "name:cs": "Řádky podání DPH — doklady",
    "name:en": "VAT filing items",

    "hideFromNavigation": true,

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },
        {
            "id": "filing",
            "name": "Filing",
            "name:cs": "Podání",
            "name:en": "Filing",
            "type": "int",
            "nullable": false,
            "reference": "economy_vat_filings"
        },
        {
            // Id hlavičky dokladu **bez reference** — snapshot musí přežít
            // zrušení i smazání dokladu; je to historický údaj, ne živá vazba.
            "id": "doc_head",
            "name": "Document head id",
            "name:cs": "Doklad (id)",
            "name:en": "Document head id",
            "type": "int",
            "nullable": false
        },
        {
            "id": "doc_type",
            "name": "Document type",
            "name:cs": "Typ dokladu",
            "name:en": "Document type",
            "type": "enumString",
            "length": 20,
            "nullable": false,
            "cfgItem": "docs.core.docTypes"
        },
        {
            "id": "doc_number",
            "name": "Document number",
            "name:cs": "Číslo dokladu",
            "name:en": "Document number",
            "type": "varchar",
            "length": 40,
            "nullable": false,
            "default": ""
        },
        {
            "id": "partner_doc_number",
            "name": "Partner's document number",
            "name:cs": "Ev. číslo dokladu",
            "name:en": "Partner's document number",
            "type": "varchar",
            "length": 40,
            "nullable": false,
            "default": ""
        },
        {
            // Celková částka dokladu vč. daně v domácí měně — rozhoduje
            // o limitu 10 000 Kč pro rozpad A4/A5 a B2/B3.
            "id": "total_amount_dom",
            "name": "Total incl. tax (home)",
            "name:cs": "Celkem vč. daně (domácí)",
            "name:en": "Total incl. tax (home)",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "default": 0
        },
        {
            "id": "vat_duzp",
            "name": "Date of supply",
            "name:cs": "DUZP",
            "name:en": "Date of supply",
            "type": "date",
            "nullable": true
        },
        {
            "id": "vat_dppd",
            "name": "Date of tax obligation",
            "name:cs": "DPPD",
            "name:en": "Date of tax obligation",
            "type": "date",
            "nullable": true
        },
        {
            // DIČ protistrany dobově, ze snapshotu partnera na dokladu:
            // u přijatých plnění (A2/B1/B2) dodavatel, u našich odběratel.
            "id": "partner_vat_id",
            "name": "Partner VAT id",
            "name:cs": "DIČ protistrany",
            "name:en": "Partner VAT id",
            "type": "varchar",
            "length": 20,
            "nullable": false,
            "default": ""
        },
        {
            "id": "vat_code",
            "name": "VAT code",
            "name:cs": "Kód DPH",
            "name:en": "VAT code",
            "type": "varchar",
            "length": 20,
            "nullable": false
        },
        {
            "id": "vat_pct",
            "name": "VAT %",
            "name:cs": "DPH %",
            "name:en": "VAT %",
            "type": "numeric",
            "precision": 5,
            "scale": 2,
            "nullable": false,
            "default": 0
        },
        {
            "id": "base_dom",
            "name": "Base (home)",
            "name:cs": "Základ (domácí)",
            "name:en": "Base (home)",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "default": 0
        },
        {
            "id": "tax_dom",
            "name": "Tax (home)",
            "name:cs": "Daň (domácí)",
            "name:en": "Tax (home)",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "default": 0
        },
        {
            // Oddaňovací pár samovyměření — nese opačnou stranu téhož
            // plnění (docs_core_vat_recap.is_reverse_pair).
            "id": "is_reverse_pair",
            "name": "Reverse charge pair",
            "name:cs": "Párový řádek samovyměření",
            "name:en": "Reverse charge pair",
            "type": "boolean",
            "nullable": false,
            "default": 0
        },

        // --- materializované mapování (VatOutputsMapping + engine KH) ---

        {
            "id": "dp3_row",
            "name": "VAT return row",
            "name:cs": "Řádek přiznání",
            "name:en": "VAT return row",
            "type": "smallint",
            "nullable": true
        },
        {
            // "full" | "reduced" — sloupec odpočtu u ř. 40/41/43/44.
            "id": "dp3_col",
            "name": "VAT return column",
            "name:cs": "Sloupec přiznání",
            "name:en": "VAT return column",
            "type": "varchar",
            "length": 10,
            "nullable": true
        },
        {
            // Skupina z configu (A1/A2/A4A5/B1/B2B3) — před rozpadem.
            "id": "kh_group",
            "name": "Control statement group",
            "name:cs": "Skupina KH",
            "name:en": "Control statement group",
            "type": "varchar",
            "length": 10,
            "nullable": true
        },
        {
            // Sekce po rozpadu enginem (A1/A2/A4/A5/B1/B2/B3) — to, co
            // reálně šlo do hlášení.
            "id": "kh_section",
            "name": "Control statement section",
            "name:cs": "Sekce KH",
            "name:en": "Control statement section",
            "type": "varchar",
            "length": 5,
            "nullable": true
        },
        {
            // Kód předmětu plnění z rekapitulace dokladu — řetězec ("4a").
            // Nahradil tinyint `kh_kod_pred_pl` (#89 D13): ds-upgrade typ
            // tinyint → varchar nemění, proto nový sloupec; starý v databázi
            // zůstává nepoužitý.
            "id": "kh_reverse_charge_code",
            "name": "Reverse charge subject",
            "name:cs": "Předmět plnění",
            "name:en": "Reverse charge subject",
            "type": "varchar",
            "length": 3,
            "nullable": true
        },
        {
            "id": "sh_kod",
            "name": "Recapitulative statement code",
            "name:cs": "Kód plnění SH",
            "name:en": "Recapitulative statement code",
            "type": "tinyint",
            "nullable": true
        }
    ],

    "indexes": [
        {
            "id": "idx_filing_doc",
            "type": "index",
            "columns": [
                {"column": "filing"},
                {"column": "doc_head"}
            ]
        }
    ]
}
