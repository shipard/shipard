// Deklarace reportů modulu economy.accounting (docs/reports.md, D7 + D16).
// Registrace: module.jsonc → klíč "reports"; načítá ReportDefinitionLoader.
// Parametr nese vlastní popisky (`name`, `optionNames`) — z nich je toolbar
// v UI i úvodní blok exportu.
[
    {
        "id": "economy.accounting.generalLedger",
        "navSection": "accounting",
        "navOrder": 60,
        "name": "General ledger",
        "name:cs": "Hlavní kniha",
        "name:en": "General ledger",
        "builder": "Shipard\\Module\\Economy\\Accounting\\Reports\\GeneralLedgerBuilder",
        "periodGranularities": ["month", "quarter", "halfYear", "year"],
        "params": [
            {
                "id": "detail", "type": "enum",
                "name": "Detail level", "name:cs": "Úroveň detailu", "name:en": "Detail level",
                "options": ["analytic", "synthetic"],
                "optionNames": {
                    "analytic": "Analytic", "analytic:cs": "Analyticky", "analytic:en": "Analytic",
                    "synthetic": "Synthetic", "synthetic:cs": "Synteticky", "synthetic:en": "Synthetic"
                },
                "default": "analytic"
            }
        ]
    },
    {
        "id": "economy.accounting.profitLoss",
        "navSection": "accounting",
        "navOrder": 61,
        "name": "Profit and loss",
        "name:cs": "Výsledovka",
        "name:en": "Profit and loss",
        "builder": "Shipard\\Module\\Economy\\Accounting\\Reports\\ProfitLossBuilder",
        "periodGranularities": ["month", "quarter", "halfYear", "year"],
        "params": [
            {
                "id": "detail", "type": "enum",
                "name": "Detail level", "name:cs": "Úroveň detailu", "name:en": "Detail level",
                "options": ["analytic", "synthetic"],
                "optionNames": {
                    "analytic": "Analytic", "analytic:cs": "Analyticky", "analytic:en": "Analytic",
                    "synthetic": "Synthetic", "synthetic:cs": "Synteticky", "synthetic:en": "Synthetic"
                },
                "default": "analytic"
            }
        ]
    },
    {
        "id": "economy.accounting.balanceSheet",
        "navSection": "accounting",
        "navOrder": 62,
        "name": "Balance sheet",
        "name:cs": "Rozvaha",
        "name:en": "Balance sheet",
        "builder": "Shipard\\Module\\Economy\\Accounting\\Reports\\BalanceSheetBuilder",
        "periodGranularities": ["month", "quarter", "halfYear", "year"],
        "params": [
            {
                "id": "detail", "type": "enum",
                "name": "Detail level", "name:cs": "Úroveň detailu", "name:en": "Detail level",
                "options": ["analytic", "synthetic"],
                "optionNames": {
                    "analytic": "Analytic", "analytic:cs": "Analyticky", "analytic:en": "Analytic",
                    "synthetic": "Synthetic", "synthetic:cs": "Synteticky", "synthetic:en": "Synthetic"
                },
                "default": "analytic"
