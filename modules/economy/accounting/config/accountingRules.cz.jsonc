{
    // economy.accounting.rules.cz
    //
    // Účtovací předpis — Česká republika, podvojné účetnictví.
    //
    // documents:  per docType seznam kroků — odkud vzít částku (src/col),
    //             na kterou stranu (side: 0 = MD, 1 = DAL), jaká kategorie.
    // accounts:   kategorie → maska účtu; první záznam se shodnou cat a
    //             vyhovující query vyhrává. Maska se dohledává v rozvrhu
    //             (number LIKE mask%, jen analytické účty, dle čísla).
    // categories: názvy kategorií pro dokumentaci/UI.
    //
    // Účet pokladny (211xxx) není kategorie: kroky s accountSrc: "cashDesk"
    // ho berou přímo z pokladny hlavičky (economy_codebooks_cash_desks
    // .accounting_account, #59 D8) — hotovostní protistrana pokladních
    // dokladů, prodejek i faktur placených hotově.
    //
    // Detaily sémantiky kroků: docs/accounting.md sekce 4 a 5.

    "categories": {
        "receivables":      {"name:cs": "Pohledávky"},
        "payables":         {"name:cs": "Závazky"},
        "advances.given":    {"name:cs": "Zálohy poskytnuté"},
        "advances.received": {"name:cs": "Zálohy přijaté"},
        "vat":              {"name:cs": "DPH"},
        "revenue":          {"name:cs": "Výnosy"},
        "costs":            {"name:cs": "Náklady"},
        "rounding.cost":    {"name:cs": "Zaokrouhlení — náklad"},
        "rounding.revenue": {"name:cs": "Zaokrouhlení — výnos"},
        "vat.payable":       {"name:cs": "DPH — odvod (závazek vůči FÚ)"},
        "vat.receivable":    {"name:cs": "DPH — nadměrný odpočet (pohledávka za FÚ)"},
        "vat.nondeductible": {"name:cs": "DPH bez nároku na odpočet (krácení)"},
        "fx.loss":          {"name:cs": "Kurzové ztráty"},
        "fx.gain":          {"name:cs": "Kurzové zisky"},
        "card.transit":     {"name:cs": "Karta — platební karty na cestě"},
        "cash.transit":     {"name:cs": "Převod peněz — peníze na cestě"},

        "bank.unmatched.in":  {"name:cs": "Banka — nespárovaný příjem"},
        "bank.unmatched.out": {"name:cs": "Banka — nespárovaný výdaj"},
        "bank.fee":           {"name:cs": "Banka — poplatek"},
        "bank.interest.in":   {"name:cs": "Banka — připsaný úrok"},
        "bank.interest.out":  {"name:cs": "Banka — zaplacený úrok"}
    },

    "accounts": [
        {"cat": "revenue", "accountMask": "602", "query": {"operation": "sale.services"}},
        {"cat": "revenue", "accountMask": "604", "query": {"operation": "sale.goods"}},

        {"cat": "costs", "accountMask": "504", "query": {"operation": "purchase.goods"}},
        {"cat": "costs", "accountMask": "518", "query": {"operation": "purchase.services"}},
        {"cat": "costs", "accountMask": "548", "query": {"operation": "purchase.other"}},

        {"cat": "receivables",      "accountMask": "311"},
        {"cat": "payables",         "accountMask": "321"},

        // Zálohy (D10): analytiky se liší per DS (např. x14001/x14901
        // vs. x14100/x14900) — dohledává je maska nad rozvrhem DS.
        // Pořadí záznamů je významové: brutto s query první (loose
        // porovnání, vat_amount 0.00/NULL → brutto), jinak zdaněná.
        // Pole = řetěz masek po řadě; některé rozvrhy nemají 3249xx → fallback 324.
        {"cat": "advances.given",    "accountMask": "314",  "query": {"vat_amount": 0}},
        {"cat": "advances.given",    "accountMask": "3149"},
        {"cat": "advances.received", "accountMask": "324",  "query": {"vat_amount": 0}},
        {"cat": "advances.received", "accountMask": ["3249", "324"]},

        // Bankovní kategorie (bankovní mikroengine). 261200/261300 = clearing
        // účty nespárovaných plateb — úhrada tam padá jen při miss dohledání
        // otevřeného předpisu (OpenItemLookup, #69 D3, docs/bank.md §6.3);
        // při zásahu jde přesně na účet předpisu (311xxx/321xxx), bez masky.
        // Poplatky/úroky jdou na finanční náklady/výnosy.
        {"cat": "bank.unmatched.in",  "accountMask": "261200"},
        {"cat": "bank.unmatched.out", "accountMask": "261300"},
        {"cat": "bank.fee",           "accountMask": "568"},
        {"cat": "bank.interest.in",   "accountMask": "662"},
        {"cat": "bank.interest.out",  "accountMask": "562"},

        // Peníze na cestě — dvě oddělené analytiky (#59 D8 / Task D):
        //   261100 cash.transit = převody peněz pokladna ↔ banka ↔ pokladna
        //     (transfer.* na pokladním dokladu i bankovní transakci). Obě
        //     strany převodu účtují sem → po zaúčtování obou nulový zůstatek
        //     (kontrola jako clearing 261200/261300).
        //   261400 card.transit = platby kartou na pokladně, než banka připíše
        //     tržbu terminálu. Zůstatek je běžně nenulový (nepřipsané tržby,
        //     stržené poplatky) — na jednom účtu s převody by kontrola nuly
        //     nefungovala. Jediná analytika, per-terminál mimo scope.
        // Migrovaný rozvrh bez 261100/261400 dá account_not_found (řádek
        // 261???), řeší se rozvrhem DS.
        {"cat": "cash.transit",       "accountMask": "261100"},
        {"cat": "card.transit",       "accountMask": "261400"},

        // DPH analytiky per kód — konvence 343{NNN}, NNN = číselná část kódu.
        // Řádek má každý kód, který může vyprodukovat nenulovou daň: nenulová
        // hodnota ve vatPercents (vč. historické 3xx řady — zpětně datované
        // a migrované doklady) nebo cíl reverseVatCode (oddaňovací páry).
        // Generováno z world.vat/config/vat-cz.jsonc; úplnost hlídá test
        // VatAnalyticsCompletenessTest. Trvale nulové kódy (cz-112, cz-122,
        // cz-123, cz-201, cz-202, cz-401) řádek nemají — nulová daň žádný
        // řádek deníku negeneruje.
        {"cat": "vat", "accountMask": "343110", "query": {"vat_code": "cz-110"}},
        {"cat": "vat", "accountMask": "343111", "query": {"vat_code": "cz-111"}},
        {"cat": "vat", "accountMask": "343301", "query": {"vat_code": "cz-301"}},
        {"cat": "vat", "accountMask": "343302", "query": {"vat_code": "cz-302"}},
        {"cat": "vat", "accountMask": "343115", "query": {"vat_code": "cz-115"}},
        {"cat": "vat", "accountMask": "343116", "query": {"vat_code": "cz-116"}},
        {"cat": "vat", "accountMask": "343340", "query": {"vat_code": "cz-340"}},
        {"cat": "vat", "accountMask": "343117", "query": {"vat_code": "cz-117"}},
        {"cat": "vat", "accountMask": "343118", "query": {"vat_code": "cz-118"}},
        {"cat": "vat", "accountMask": "343119", "query": {"vat_code": "cz-119"}},
        {"cat": "vat", "accountMask": "343341", "query": {"vat_code": "cz-341"}},
        {"cat": "vat", "accountMask": "343342", "query": {"vat_code": "cz-342"}},
        {"cat": "vat", "accountMask": "343120", "query": {"vat_code": "cz-120"}},
        {"cat": "vat", "accountMask": "343121", "query": {"vat_code": "cz-121"}},
        {"cat": "vat", "accountMask": "343310", "query": {"vat_code": "cz-310"}},
        {"cat": "vat", "accountMask": "343311", "query": {"vat_code": "cz-311"}},
        {"cat": "vat", "accountMask": "343150", "query": {"vat_code": "cz-150"}},
        {"cat": "vat", "accountMask": "343151", "query": {"vat_code": "cz-151"}},
        {"cat": "vat", "accountMask": "343350", "query": {"vat_code": "cz-350"}},
        {"cat": "vat", "accountMask": "343152", "query": {"vat_code": "cz-152"}},
        {"cat": "vat", "accountMask": "343203", "query": {"vat_code": "cz-203"}},
        {"cat": "vat", "accountMask": "343204", "query": {"vat_code": "cz-204"}},
        {"cat": "vat", "accountMask": "343370", "query": {"vat_code": "cz-370"}},
        {"cat": "vat", "accountMask": "343205", "query": {"vat_code": "cz-205"}},
        {"cat": "vat", "accountMask": "343206", "query": {"vat_code": "cz-206"}},
        {"cat": "vat", "accountMask": "343360", "query": {"vat_code": "cz-360"}},
        {"cat": "vat", "accountMask": "343361", "query": {"vat_code": "cz-361"}},
        {"cat": "vat", "accountMask": "343207", "query": {"vat_code": "cz-207"}},
        {"cat": "vat", "accountMask": "343208", "query": {"vat_code": "cz-208"}},
        {"cat": "vat", "accountMask": "343362", "query": {"vat_code": "cz-362"}},
        {"cat": "vat", "accountMask": "343363", "query": {"vat_code": "cz-363"}},
        {"cat": "vat", "accountMask": "343215", "query": {"vat_code": "cz-215"}},
        {"cat": "vat", "accountMask": "343216", "query": {"vat_code": "cz-216"}},
        {"cat": "vat", "accountMask": "343390", "query": {"vat_code": "cz-390"}},
        {"cat": "vat", "accountMask": "343391", "query": {"vat_code": "cz-391"}},
        {"cat": "vat", "accountMask": "343217", "query": {"vat_code": "cz-217"}},
        {"cat": "vat", "accountMask": "343218", "query": {"vat_code": "cz-218"}},
        {"cat": "vat", "accountMask": "343392", "query": {"vat_code": "cz-392"}},
        {"cat": "vat", "accountMask": "343393", "query": {"vat_code": "cz-393"}},
        {"cat": "vat", "accountMask": "343405", "query": {"vat_code": "cz-405"}},
        {"cat": "vat", "accountMask": "343406", "query": {"vat_code": "cz-406"}},
        {"cat": "vat", "accountMask": "343460", "query": {"vat_code": "cz-460"}},
        {"cat": "vat", "accountMask": "343461", "query": {"vat_code": "cz-461"}},
        {"cat": "vat", "accountMask": "343407", "query": {"vat_code": "cz-407"}},
        {"cat": "vat", "accountMask": "343408", "query": {"vat_code": "cz-408"}},
        {"cat": "vat", "accountMask": "343462", "query": {"vat_code": "cz-462"}},
        {"cat": "vat", "accountMask": "343463", "query": {"vat_code": "cz-463"}},
        {"cat": "vat", "accountMask": "343415", "query": {"vat_code": "cz-415"}},
        {"cat": "vat", "accountMask": "343416", "query": {"vat_code": "cz-416"}},
        {"cat": "vat", "accountMask": "343490", "query": {"vat_code": "cz-490"}},
        {"cat": "vat", "accountMask": "343491", "query": {"vat_code": "cz-491"}},
        {"cat": "vat", "accountMask": "343417", "query": {"vat_code": "cz-417"}},
        {"cat": "vat", "accountMask": "343418", "query": {"vat_code": "cz-418"}},
        {"cat": "vat", "accountMask": "343492", "query": {"vat_code": "cz-492"}},
        {"cat": "vat", "accountMask": "343493", "query": {"vat_code": "cz-493"}},

        // Fallback jen pro tuzemské kódy: neznámý cz kód spadne na syntetiku
        // 343, zahraniční kód bez mapování skončí hlasitě (account_not_found,
        // řádek 343???, is_error) — žádné tiché smíchání cizí DPH s tuzemskou.
        {"cat": "vat", "accountMask": "343", "query": {"vat_code_country": "cz"}},

        {"cat": "rounding.cost",    "accountMask": "548"},
        {"cat": "rounding.revenue", "accountMask": "648"},

        // Zaúčtování přiznání DPH (#55 D28–D31, VatReturnAccountingBuilder):
        // saldo účty odvodu / nadměrného odpočtu (partner = správce daně)
        // a náklad z neuplatnitelné části krácených kódů (koeficient ř. 52).
        {"cat": "vat.payable",       "accountMask": "343801"},
        {"cat": "vat.receivable",    "accountMask": "343802"},
        {"cat": "vat.nondeductible", "accountMask": "548"},

        // Kurzové rozdíly (vlna D, D12): analytiky per DS dohledá maska
        // (dle rozvrhu 563xxx/663xxx, resp. 563100/663100).
        {"cat": "fx.loss", "accountMask": "563"},
        {"cat": "fx.gain", "accountMask": "663"}
    ],

    "documents": [
        {"docType": "invno",
            "accounting": [
                {"cat": "revenue", "src": "rows", "side": 1,
                    "operations": ["sale.services", "sale.goods"]},
                {"accountSrc": "item", "src": "rows", "side": 1,
                    "operation": "acc.entry"},
                // Zálohy (vlna C, účet kategorií dle D10): odpočet je na
                // dokladu záporný (věrný obraz), reverseSign ho otočí na
                // kladný MD 324xxx; zdanění zálohy je kladný výnosový řádek,
                // DPH jde z rekapitulace.
                {"cat": "advances.received", "src": "rows", "side": 0, "reverseSign": 1,
                    "operation": "sale.advanceDeduction"},
                {"cat": "advances.received", "src": "rows", "side": 1,
                    "operation": "sale.advanceVat"},
                {"cat": "vat", "src": "vat", "side": 1},
                {"cat": "rounding.revenue", "src": "head", "col": "rounding",
                    "side": 1, "sign": "+", "text": "Zaokrouhlení dokladu"},
                {"cat": "rounding.cost", "src": "head", "col": "rounding",
                    "side": 0, "reverseSign": 1, "sign": "-", "text": "Zaokrouhlení dokladu"},
                // Faktura placená hotově (#59 D8): celkem jde na účet
                // pokladny místo 311 — nevzniká otevřená položka salda
                // (staré totalCash). Bez pokladny → řádek 211??? + alert.
                {"cat": "receivables", "src": "head", "col": "total", "side": 0,
                    "query": {"payment_method": {"$ne": 0}}},
                {"accountSrc": "cashDesk", "src": "head", "col": "total", "side": 0,
                    "query": {"payment_method": 0}}
            ]
        },
        {"docType": "invni",
            "accounting": [
                {"cat": "costs", "src": "rows", "side": 0,
                    "operations": ["purchase.goods", "purchase.services", "purchase.other"]},
                {"accountSrc": "item", "src": "rows", "side": 0,
                    "operation": "acc.entry"},
                // Zálohy a majetek (vlna C): odpočet je na dokladu záporný
                // (věrný obraz), reverseSign ho otočí na kladný DAL 314xxx;
                // zdanění zálohy a pořízení majetku jsou kladné MD řádky.
                // Zálohy dohledává kategorie (D10), majetek má přímý účet
                // na řádku (D9 — analytika per druh majetku).
                {"cat": "advances.given", "src": "rows", "side": 1, "reverseSign": 1,
                    "operation": "purchase.advanceDeduction"},
                {"cat": "advances.given", "src": "rows", "side": 0,
                    "operation": "purchase.advanceVat"},
                {"src": "rows", "accountSrc": "row", "side": 0,
                    "operation": "purchase.asset"},
                {"cat": "vat", "src": "vat", "side": 0},
                {"cat": "rounding.cost", "src": "head", "col": "rounding",
                    "side": 0, "sign": "+", "text": "Zaokrouhlení dokladu"},
                {"cat": "rounding.revenue", "src": "head", "col": "rounding",
                    "side": 1, "reverseSign": 1, "sign": "-", "text": "Zaokrouhlení dokladu"},
                // Hotově placená přijatá faktura → účet pokladny místo 321 (D8).
                {"cat": "payables", "src": "head", "col": "total", "side": 1,
                    "query": {"payment_method": {"$ne": 0}}},
                {"accountSrc": "cashDesk", "src": "head", "col": "total", "side": 1,
                    "query": {"payment_method": 0}}
            ]
        },
        // Pokladní doklad (#59 D7/D8): směr per doklad (cash_dir 1 příjem,
        // 2 výdej). Kroky nad řádky/rekapitulací filtruje headQuery (query
        // se u nich hodnotí nad řádkem), head kroky query. Protistrana dle
        // payment_method: 0 Hotovost → účet pokladny (accountSrc cashDesk),
        // 2 Kartou → karty na cestě (card.transit 261400). Úhrady payment.*
        // jdou na 311/321 s identitou řádku (partner, VS) — accbal je páruje
        // jako bankovní úhrady. Převody transfer.* (Task D) jdou na 261100
        // (cash.transit): příjem DAL 261100 / MD pokladna z head kroku,
        // výdej MD 261100 / DAL pokladna; protistranu nese bankovní transakce
        // transfer.* nebo pokladní doklad druhé pokladny.
        {"docType": "cash",
            "accounting": [
                // ── příjem: jako vydaná faktura
                {"headQuery": {"cash_dir": 1}, "cat": "revenue", "src": "rows", "side": 1,
                    "operations": ["sale.services", "sale.goods"]},
                {"headQuery": {"cash_dir": 1}, "cat": "receivables", "src": "rows", "side": 1,
                    "operation": "payment.receivable", "text": "Úhrada pohledávky"},
                {"headQuery": {"cash_dir": 1}, "cat": "cash.transit", "src": "rows", "side": 1,
                    "operation": "transfer.in", "text": "Převod peněz"},
                // Zálohy v hotovosti (Task E): přijatá záloha bez DPH DAL 324
                // (vat_amount 0 → maska 324, ne 3249); odpočet jako na faktuře
                // (záporný řádek s DPH, reverseSign → MD 3249), DPH z rekapitulace.
                {"headQuery": {"cash_dir": 1}, "cat": "advances.received", "src": "rows", "side": 1,
                    "operation": "advance.received", "text": "Přijatá záloha"},
                {"headQuery": {"cash_dir": 1}, "cat": "advances.received", "src": "rows", "side": 0,
                    "reverseSign": 1, "operation": "sale.advanceDeduction"},
                {"headQuery": {"cash_dir": 1}, "accountSrc": "item", "src": "rows", "side": 1,
                    "operation": "acc.entry"},
                {"headQuery": {"cash_dir": 1}, "cat": "vat", "src": "vat", "side": 1},
                {"headQuery": {"cash_dir": 1}, "cat": "rounding.revenue", "src": "head", "col": "rounding",
                    "side": 1, "sign": "+", "text": "Zaokrouhlení dokladu"},
                {"headQuery": {"cash_dir": 1}, "cat": "rounding.cost", "src": "head", "col": "rounding",
                    "side": 0, "reverseSign": 1, "sign": "-", "text": "Zaokrouhlení dokladu"},
                {"accountSrc": "cashDesk", "src": "head", "col": "total", "side": 0,
                    "query": {"cash_dir": 1, "payment_method": 0}},
                {"cat": "card.transit", "src": "head", "col": "total", "side": 0,
                    "query": {"cash_dir": 1, "payment_method": 2}},

                // ── výdej: jako přijatá faktura
                {"headQuery": {"cash_dir": 2}, "cat": "costs", "src": "rows", "side": 0,
                    "operations": ["purchase.goods", "purchase.services", "purchase.other"]},
                {"headQuery": {"cash_dir": 2}, "cat": "payables", "src": "rows", "side": 0,
                    "operation": "payment.payable", "text": "Úhrada závazku"},
                {"headQuery": {"cash_dir": 2}, "cat": "cash.transit", "src": "rows", "side": 0,
                    "operation": "transfer.out", "text": "Převod peněz"},
                {"headQuery": {"cash_dir": 2}, "cat": "advances.given", "src": "rows", "side": 0,
                    "operation": "advance.given", "text": "Poskytnutá záloha"},
                {"headQuery": {"cash_dir": 2}, "cat": "advances.given", "src": "rows", "side": 1,
                    "reverseSign": 1, "operation": "purchase.advanceDeduction"},
                {"headQuery": {"cash_dir": 2}, "accountSrc": "item", "src": "rows", "side": 0,
                    "operation": "acc.entry"},
                {"headQuery": {"cash_dir": 2}, "cat": "vat", "src": "vat", "side": 0},
                {"headQuery": {"cash_dir": 2}, "cat": "rounding.cost", "src": "head", "col": "rounding",
                    "side": 0, "sign": "+", "text": "Zaokrouhlení dokladu"},
                {"headQuery": {"cash_dir": 2}, "cat": "rounding.revenue", "src": "head", "col": "rounding",
                    "side": 1, "reverseSign": 1, "sign": "-", "text": "Zaokrouhlení dokladu"},
                {"accountSrc": "cashDesk", "src": "head", "col": "total", "side": 1,
                    "query": {"cash_dir": 2, "payment_method": 0}},
                {"cat": "card.transit", "src": "head", "col": "total", "side": 1,
                    "query": {"cash_dir": 2, "payment_method": 2}}
            ]
        },
        // Prodejka (#59 D1/D9): pevně výstup, příjmová část bez payment.*;
        // vratka = záporné řádky (záporné částky na obou stranách, vyrovnané).
        {"docType": "cashreg",
            "accounting": [
                {"cat": "revenue", "src": "rows", "side": 1,
                    "operations": ["sale.services", "sale.goods"]},
                {"accountSrc": "item", "src": "rows", "side": 1,
                    "operation": "acc.entry"},
                {"cat": "vat", "src": "vat", "side": 1},
                {"cat": "rounding.revenue", "src": "head", "col": "rounding",
                    "side": 1, "sign": "+", "text": "Zaokrouhlení dokladu"},
                {"cat": "rounding.cost", "src": "head", "col": "rounding",
                    "side": 0, "reverseSign": 1, "sign": "-", "text": "Zaokrouhlení dokladu"},
                {"accountSrc": "cashDesk", "src": "head", "col": "total", "side": 0,
                    "query": {"payment_method": 0}},
                // Prodejka „na převod“ = pohledávka (partner povinný,
                // CashRegisterDocument); identita hlavičky jako u FV.
                {"cat": "receivables", "src": "head", "col": "total", "side": 0,
                    "query": {"payment_method": 1}},
                {"cat": "card.transit", "src": "head", "col": "total", "side": 0,
                    "query": {"payment_method": 2}}
            ]
        },
        {"docType": "cmnbkp",
            "accounting": [
                {"src": "rows", "accountSrc": "row",  "sideSrc": "row", "operation": "acc.record"},
                {"src": "rows", "accountSrc": "item", "sideSrc": "row", "operation": "acc.item"},
                // Saldokontní operace bez accountSrc — účet z kategorie
                // (receivables → 311, payables → 321), strana z řádku (acc_side),
                // identita per řádek (vlajky rowPartner/rowPaymentId operace).
                {"src": "rows", "cat": "receivables", "sideSrc": "row", "operation": "acc.balanceReceivable"},
                {"src": "rows", "cat": "payables",    "sideSrc": "row", "operation": "acc.balancePayable"},
                // Kurzové rozdíly (vlna D, D12): dva kroky per operace —
                // jeden řádek generuje dva zápisy (P&L × saldo), strany fixní
                // (side na kroku), částky kladné, směr nese volba operace.
                // Identita (partner, payment_reference = staré symbol1) se
                // razítkuje z řádku na OBA zápisy (vlajky operace) — saldo
                // strana je párovatelná accbal FX fází.
                {"src": "rows", "cat": "fx.loss",     "side": 0, "operation": "acc.fxLossReceivable"},
                {"src": "rows", "cat": "receivables", "side": 1, "operation": "acc.fxLossReceivable"},
                {"src": "rows", "cat": "receivables", "side": 0, "operation": "acc.fxGainReceivable"},
                {"src": "rows", "cat": "fx.gain",     "side": 1, "operation": "acc.fxGainReceivable"},
                {"src": "rows", "cat": "fx.loss",     "side": 0, "operation": "acc.fxLossPayable"},
                {"src": "rows", "cat": "payables",    "side": 1, "operation": "acc.fxLossPayable"},
                {"src": "rows", "cat": "payables",    "side": 0, "operation": "acc.fxGainPayable"},
                {"src": "rows", "cat": "fx.gain",     "side": 1, "operation": "acc.fxGainPayable"}
            ]
        }
    ]
}
