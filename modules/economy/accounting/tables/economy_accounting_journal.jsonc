{
    "tableId": 413,
    "name": "Accounting journal",
    "name:cs": "Účetní deník",
    "name:en": "Accounting journal",

    // Deník je derivát zdroje — zapisuje výhradně účtovací engine
    // (DELETE + INSERT celého zdroje), žádná ruční editace. Proto bez
    // docStates, bez document class a bez formu. Řazení deníku = id.
    // Do navigace jde přes JournalViewer (read-only), ne jako generic
    // table item.
    //
    // Polymorfní zdroj: source_kind ('doc' | 'bankTransaction') určuje,
    // které z polí doc_head / bank_transaction (FK přidává economy.bank
    // jako extension) je vyplněné. Invariant: vyplněno právě jedno z nich
    // dle source_kind (zatím dokumentační; vynutí mikroengine ve Fázi 3).
    // doc_head je proto nullable — fresh DS ho vytvoří správně; existující
    // DS s NOT NULL doc_head se řeší přes ds-reset (deník je čistý derivát).
    //
    // Platební identita (payment_reference / specific_symbol /
    // constant_symbol / due_date): orazítkovaná ze zdroje, drží invariant
    // „saldo zná jen deník" (accbal Fáze 0). Generátor saldo pohybů je čte
    // odsud bez joinu na zdroj; navíc umožňují filtr deníku za VS. Tím se
    // částečně obrací accounting.md rozhodnutí #10 (deník schválně bez
    // saldokontních sloupců) — symboly + splatnost zpět dovnitř.

    "displayPattern": "{account_number} {text}",

    "columns": [
        {
            "id": "id",
            "name": "ID",
            "type": "int",
            "autoIncrement": true,
            "primaryKey": true
        },
        {
            "id": "source_kind",
            "name": "Source kind",
            "name:cs": "Zdroj zápisu",
            "name:en": "Source kind",
            "type": "enumString",
            "length": 20,
            "cfgItem": "economy.accounting.journalSources",
            "nullable": false,
            "default": "doc"
        },
        {
            "id": "doc_head",
            "name": "Document",
            "name:cs": "Doklad",
            "name:en": "Document",
            "type": "int",
            "nullable": true,
            "reference": "docs_core_heads"
        },
        {
            "id": "doc_type",
            "name": "Document type",
            "name:cs": "Typ dokladu",
            "name:en": "Document type",
            "type": "enumString",
            "length": 20,
            "cfgItem": "docs.core.docTypes",
            "nullable": true
        },
        {
            "id": "doc_number",
            "name": "Document number",
            "name:cs": "Číslo dokladu",
            "name:en": "Document number",
            "type": "varchar",
            "length": 40,
            "nullable": true
        },
        {
            "id": "accounting_date",
            "name": "Accounting date",
            "name:cs": "Účetní datum",
            "name:en": "Accounting date",
            "type": "date",
            "nullable": false
        },
        {
            "id": "fiscal_year",
            "name": "Fiscal year",
            "name:cs": "Fiskální rok",
            "name:en": "Fiscal year",
            "type": "int",
            "nullable": true,
            "reference": "economy_codebooks_fiscal_years"
        },
        {
            "id": "fiscal_month",
            "name": "Fiscal month",
            "name:cs": "Fiskální měsíc",
            "name:en": "Fiscal month",
            "type": "int",
            "nullable": true,
            "reference": "economy_codebooks_fiscal_months"
        },

        // --- account ---
        // account je NULL u nedohledaného účtu; account_number pak nese
        // chybovou masku doplněnou '?' na 6 znaků (např. '504???').

        {
            "id": "account",
            "name": "Account",
            "name:cs": "Účet",
            "name:en": "Account",
            "type": "int",
            "nullable": true,
            "reference": "economy_accounting_accounts"
        },
        {
            "id": "account_number",
            "name": "Account number",
            "name:cs": "Číslo účtu",
            "name:en": "Account number",
            "type": "varchar",
            "length": 12,
            "nullable": false
        },
        {
            "id": "is_error",
            "name": "Error row",
            "name:cs": "Chybový řádek",
            "name:en": "Error row",
            "type": "boolean",
            "default": 0
        },
        {
            "id": "operation",
            "name": "Operation",
            "name:cs": "Pohyb",
            "name:en": "Operation",
            "type": "enumString",
            "length": 40,
            "cfgItem": "docs.core.rowOperations",
            "nullable": true
        },

        // --- amounts ---
        // Jednostranné řádky: vyplněno právě money_dr XOR money_cr (a párový
        // _cur sloupec). U dokladu v domácí měně jsou *_cur shodné s domácími.

        {
            "id": "money_dr",
            "name": "Debit",
            "name:cs": "Má dáti",
            "name:en": "Debit",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "default": 0
        },
        {
            "id": "money_cr",
            "name": "Credit",
            "name:cs": "Dal",
            "name:en": "Credit",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "default": 0
        },
        {
            "id": "currency",
            "name": "Currency",
            "name:cs": "Měna",
            "name:en": "Currency",
            "type": "enumString",
            "length": 3,
            "cfgItem": "world.base.currencies",
            "nullable": true
        },
        {
            "id": "money_dr_cur",
            "name": "Debit (doc currency)",
            "name:cs": "Má dáti (měna dokladu)",
            "name:en": "Debit (doc currency)",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "default": 0
        },
        {
            "id": "money_cr_cur",
            "name": "Credit (doc currency)",
            "name:cs": "Dal (měna dokladu)",
            "name:en": "Credit (doc currency)",
            "type": "numeric",
            "precision": 15,
            "scale": 2,
            "default": 0
        },

        // --- context ---

        {
            "id": "partner",
            "name": "Partner",
            "name:cs": "Partner",
            "name:en": "Partner",
            "type": "int",
            "nullable": true,
            "reference": "base_persons_persons"
        },
        {
            "id": "text",
            "name": "Text",
            "name:cs": "Text",
            "name:en": "Text",
            "type": "varchar",
            "length": 200,
            "nullable": true
        },

        // --- payment identity ---
        // Párovací symboly + splatnost orazítkované ze zdroje (hlavička
        // dokladu / bankovní transakce). Drží invariant „saldo zná jen
        // deník" — generátor saldo pohybů (accbal Fáze 2) je čte odsud,
        // bez joinu na zdroj. Symboly v konvenci dokladů (payment_reference
        // varchar 35 pro RF/EndToEndId). U bankovní transakce je due_date
        // vždy NULL (transakce splatnost nemá).

        {
            "id": "payment_reference",
            "name": "Payment reference",
            "name:cs": "Variabilní symbol",
            "name:en": "Payment reference",
            "type": "varchar",
            "length": 35,
            "nullable": true
        },
        {
            "id": "specific_symbol",
            "name": "Specific symbol",
            "name:cs": "Specifický symbol",
            "name:en": "Specific symbol",
            "type": "varchar",
            "length": 20,
            "nullable": true
        },
        {
            "id": "constant_symbol",
            "name": "Constant symbol",
            "name:cs": "Konstantní symbol",
            "name:en": "Constant symbol",
            "type": "varchar",
            "length": 10,
            "nullable": true
        },
        {
            "id": "due_date",
            "name": "Due date",
            "name:cs": "Datum splatnosti",
            "name:en": "Due date",
            "type": "date",
            "nullable": true
        },

        // --- dimenze deníku (#110 D20) ---
        // Standardní dimenze jádra (journalDimensions modulu
        // economy.accounting, docs/accounting.md § Dimenze deníku): plní je
        // AccountingEngine z řádku dokladu, prázdnou z hlavičky; bankovní
        // zápisy a příspěvky contributorů je nemají (NULL). Hodnoty jsou
        // součást klíče seskupení řádků.
        //
        // cost_center — středisko zápisu (#110 D23): z řádku dokladu, prázdné
        //   z hlavičky; filtr a sloupec Středisko v deníku a v Kontaci.
        {
            "id": "cost_center",
            "name": "Cost center",
            "name:cs": "Středisko",
            "name:en": "Cost center",
            "type": "int",
            "nullable": true,
            "reference": "economy_codebooks_cost_centers"
        },

        // work_order — zakázka zápisu (#110 D23): z řádku dokladu, prázdné
        //   z hlavičky; filtr a sloupec Zakázka v deníku a v Kontaci, Deník
        //   na detailu zakázky.
        {
            "id": "work_order",
            "name": "Work order",
            "name:cs": "Zakázka",
            "name:en": "Work order",
            "type": "int",
            "nullable": true,
            "reference": "economy_work_orders_heads"
        },

        // asset — karta majetku, které se zápis týká (docs/assets.md D15,
        //   D47). Na ní stojí invariant „evidence = deník“ (docs/assets.md §1).

        {
            "id": "asset",
            "name": "Asset",
            "name:cs": "Majetek",
            "name:en": "Asset",
            "type": "int",
            "nullable": true,
            "reference": "economy_assets_assets"
        }
    ],

    "indexes": [
        {
            "id": "idx_doc_head",
            "type": "index",
            "columns": [{"column": "doc_head"}]
        },
        {
            "id": "idx_source",
            "type": "index",
            "columns": [{"column": "source_kind"}]
        },
        {
            "id": "idx_account_date",
            "type": "index",
            "columns": [
                {"column": "account_number"},
                {"column": "accounting_date"}
            ]
        },
        {
            "id": "idx_fiscal",
            "type": "index",
            "columns": [
                {"column": "fiscal_year"},
                {"column": "fiscal_month"}
            ]
        },
        {
            "id": "idx_partner",
            "type": "index",
            "columns": [{"column": "partner"}]
        },
        {
            "id": "idx_payment_reference",
            "type": "index",
            "columns": [{"column": "payment_reference"}]
        },
        // dimenze deníku (#110 D20)
        {
            "id": "idx_cost_center",
            "type": "index",
            "columns": [{"column": "cost_center"}]
        },
        {
            "id": "idx_work_order",
            "type": "index",
            "columns": [{"column": "work_order"}]
        },
        {
            "id": "idx_asset",
            "type": "index",
            "columns": [{"column": "asset"}]
        }
    ]
}
