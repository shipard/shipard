{
    "id": "economy.accounting",
    "name": "Accounting",
    "name:cs": "Účetnictví",
    "name:en": "Accounting",
    "description": "Double-entry accounting — chart of accounts",
    "description:cs": "Podvojné účetnictví — účtový rozvrh",
    "description:en": "Double-entry accounting — chart of accounts",

    "dependencies": ["core.system", "economy.items", "docs.core"],

    "tables": [
        "economy_accounting_accounts",
        "economy_accounting_journal"
    ],

    "extensions": [
        "economy_items",
        "docs_core_heads",
        "economy_codebooks_cash_desks"
    ],

    // Standardní dimenze deníku (#110 D20, docs/accounting.md § Dimenze
    // deníku). Sloupce dimenzí jsou přímo v definicích docs_core_heads,
    // docs_core_rows a economy_accounting_journal; evidence zůstává ve svém
    // modulu (karty majetku v economy.assets — každý zdroj s účetnictvím ho
    // má přes install.base). Mechanismus (engine, deník, formuláře, Kontace)
    // jede nad tímto seznamem a je otevřený dalším dimenzím.
    //
    // `forms` = pole dimenze na hlavičce a řádcích dokladů, jen se zapnutým
    // nastavením Dimenze na dokladech (`enabledBySetting`, D21) — řídí jen
    // zobrazení, uložená hodnota se do deníku propisuje vždy.
    //
    // costCenter — středisko (D23): na hlavičce jako výchozí hodnota, na
    //   řádcích skutečná; řádek bez střediska zdědí hlavičku i u pořízení
    //   majetku. Pole má i zálohová faktura vydaná — periodická fakturace
    //   z ní vystavuje zálohy a nese na nich středisko (T3).
    // asset — karta majetku: řádek bez karty zdědí kartu hlavičky (assets
    //   D60). Řádek pořízení a systémové operace majetku mají pole vždy
    //   (vlajka `rowAsset` operace) a kartu z hlavičky nedědí (`rowFlag`).
    //   Zálohová faktura se neúčtuje do nákladů — pole nemá.
    "journalDimensions": [
        {
            "id": "costCenter",
            "rowColumn": "cost_center",
            "headColumn": "cost_center",
            "journalColumn": "cost_center",
            "table": "economy_codebooks_cost_centers",
            "name": "Cost center",
            "name:cs": "Středisko",
            "name:en": "Cost center",
            "name:sk": "Stredisko",
            "name:de": "Kostenstelle",
            "forms": {
                "docTypes": ["invno", "invpo", "invni", "cash", "cmnbkp"],
                "head": true,
                "rows": true,
                "enabledBySetting": "economy.accounting.dimension.costCenter"
            }
        },
        {
            "id": "asset",
            "rowColumn": "asset",
            "headColumn": "asset",
            "journalColumn": "asset",
            "table": "economy_assets_assets",
            "rowFlag": "rowAsset",
            "name": "Asset",
            "name:cs": "Majetek",
            "name:en": "Asset",
            "name:sk": "Majetok",
            "name:de": "Anlagegut",
            "forms": {
                "docTypes": ["invni", "invno", "cash", "cmnbkp"],
                "head": true,
                "rows": true,
                "enabledBySetting": "economy.accounting.dimension.asset"
            }
        }
    ],

    "settingsItems": [
        { "page": "accountingDimensions", "section": "accounting" }
    ],

    // Dimenze na dokladech (#110 D21): jedno pole ano / ne na dimenzi, klíč
    // `economy.accounting.dimension.<id>`, prázdné = ne; pořadí polí = pořadí
    // dimenzí. Čte JournalDimensionSet::forForm přes `forms.enabledBySetting`.
    "settingsPages": [
        {
            "id": "accountingDimensions",
            "name": "Dimensions on documents",
            "name:cs": "Dimenze na dokladech",
            "name:en": "Dimensions on documents",
            "icon": "document",
            "fields": [
                {
                    "id": "economy.accounting.dimension.costCenter",
                    "type": "select",
                    "name": "Cost center on documents",
                    "name:cs": "Středisko na dokladech",
                    "name:en": "Cost center on documents",
                    "hint": "Adds the Cost center field to the header and rows of received, issued and proforma issued invoices, cash and accounting documents. Empty = no. The header value is the default for rows without their own.",
                    "hint:cs": "Přidá pole Středisko na hlavičku a řádky přijatých, vydaných a zálohových vydaných faktur, pokladních a účetních dokladů. Prázdné = ne. Středisko z hlavičky platí pro řádky bez vlastního.",
                    "hint:en": "Adds the Cost center field to the header and rows of received, issued and proforma issued invoices, cash and accounting documents. Empty = no. The header value is the default for rows without their own.",
                    "options": [
                        { "value": "yes", "label": "Yes", "label:cs": "Ano", "label:en": "Yes" },
                        { "value": "no",  "label": "No",  "label:cs": "Ne",  "label:en": "No" }
                    ]
                },
                {
                    "id": "economy.accounting.dimension.asset",
                    "type": "select",
                    "name": "Asset on documents",
                    "name:cs": "Majetek na dokladech",
                    "name:en": "Asset on documents",
                    "hint": "Adds the Asset field to the header and rows of received and issued invoices, cash and accounting documents. Empty = no. Asset acquisition rows always have the field.",
                    "hint:cs": "Přidá pole Majetek na hlavičku a řádky přijatých a vydaných faktur, pokladních a účetních dokladů. Prázdné = ne. Řádek pořízení majetku má pole vždy.",
                    "hint:en": "Adds the Asset field to the header and rows of received and issued invoices, cash and accounting documents. Empty = no. Asset acquisition rows always have the field.",
                    "options": [
                        { "value": "yes", "label": "Yes", "label:cs": "Ano", "label:en": "Yes" },
                        { "value": "no",  "label": "No",  "label:cs": "Ne",  "label:en": "No" }
                    ]
                }
            ]
        }
    ],

    "viewers": [
        {
            "id": "economy.accounting.accounts",
            "name": "Chart of accounts",
            "name:cs": "Účtový rozvrh",
            "name:en": "Chart of accounts",
            "icon": "table-list",
            "table": "economy_accounting_accounts",
            "class": "Shipard\\Module\\Economy\\Accounting\\AccountsViewer",
            "navSection": "accounting",
            "navOrder": 20
        },
        {
            "id": "economy.accounting.journal",
            "name": "Accounting journal",
            "name:cs": "Účetní deník",
            "name:en": "Accounting journal",
            "icon": "book",
            "table": "economy_accounting_journal",
            "class": "Shipard\\Module\\Economy\\Accounting\\JournalViewer",
            "navSection": "accounting",
            "navOrder": 10
        }
    ],

    "forms": [
        {
            "table": "economy_accounting_accounts",
            "id": "economy.accounting.accounts"
        }
    ],

    "documentClasses": [
        {
            "table": "economy_accounting_accounts",
            "class": "Shipard\\Module\\Economy\\Accounting\\AccountDocument"
        }
    ],

    "lookups": [
        {
            "table": "economy_accounting_accounts",
            "class": "Shipard\\Module\\Economy\\Accounting\\AccountsLookup"
        }
    ],

    "documentEventHandlers": [
        {
            "table": "docs_core_heads",
            "class": "Shipard\\Module\\Economy\\Accounting\\DocsHeadsEventHandler",
            "events": ["stateChanged", "beforeDelete"]
        }
    ],

    "alertChecks": [
        {
            "id": "economy.accounting.accounting_errors",
            "name": "Accounting errors",
            "name:cs": "Chyby účtování",
            "name:en": "Accounting errors",
            "description": "Documents in OK state that failed to post to the accounting journal.",
            "description:cs": "Doklady ve stavu V pořádku, které se nepodařilo zaúčtovat do deníku.",
            "description:en": "Documents in OK state that failed to post to the accounting journal.",
            "class": "Shipard\\Module\\Economy\\Accounting\\Checks\\AccountingErrorsCheck",
            "severity": "warning",
            "interval": "1h",
            "navSection": "accounting",
            "tags": ["accounting"]
        },
        {
            "id": "economy.accounting.undecided_account_chart",
            "name": "Account chart not chosen",
            "name:cs": "Nezvolena účtová osnova",
            "name:en": "Account chart not chosen",
            "description": "Choose the account chart variant; until decided, the chart is not seeded and documents cannot be posted.",
            "description:cs": "Vyber variantu účtové osnovy — do rozhodnutí se osnova neseeduje a doklady nejde zaúčtovat.",
            "description:en": "Choose the account chart variant; until decided, the chart is not seeded and documents cannot be posted.",
            "class": "Shipard\\Module\\Economy\\Accounting\\Checks\\UndecidedAccountChartCheck",
            "severity": "warning",
            "interval": "5m",
            "tags": ["setup"]
        }
    ],

    "config": [
        {
            "id": "economy.accounting.accountLevels",
            "file": "config/accountLevels.jsonc"
        },
        {
            "id": "economy.accounting.accountKinds",
            "file": "config/accountKinds.jsonc"
        },
        {
            "id": "economy.accounting.costsTypes",
            "file": "config/costsTypes.jsonc"
        },
        {
            "id": "economy.accounting.resultsTypes",
            "file": "config/resultsTypes.jsonc"
        },
        {
            "id": "economy.accounting.accountingStates",
            "file": "config/accountingStates.jsonc"
        },
        {
            "id": "economy.accounting.journalSources",
            "file": "config/journalSources.jsonc"
        },
        {
            "id": "economy.accounting.viewerDetailLabels",
            "file": "config/viewerDetailLabels.jsonc"
        },
        {
            "id": "economy.accounting.rules.cz",
            "file": "config/accountingRules.cz.jsonc"
        }
    ],

    "reports": [
        {
            "file": "config/reports.jsonc"
        }
    ],

    "prints": [
        { "file": "config/prints.jsonc" }
    ],

    // Panel ReportViewer — bez navSection: do navigace vstupují per-report
    // children (NavigationController, skupina Reporty), panel sám ne.
    "panels": [
        {
            "id": "reports",
            "name": "Reports",
            "name:cs": "Reporty"
        }
    ]
}
