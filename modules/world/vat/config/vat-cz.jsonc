{
    // =========================================================================
    // world.vat.cz — DPH model pro Českou republiku
    //
    // Migrace ze starého Shipardu (modules/install/country-modules/debs/eu/
    // config/vat-cz.json). Všechny kódy "EUCZ{NNN}" přejmenovány na "cz-{NNN}".
    // EUCZ000 (nedaňový řádek) a EUCZ113 (artefakt zdroje) vynechány.
    //
    // Struktura:
    //   - vatCategories  — klasifikace sazeb (sdíleno mezi kódy)
    //   - vatCodes       — konkrétní kódy DPH per kombinace
    //                      (place × direction × category)
    //   - vatPercents    — časově proměnná procenta per kód
    //   - vatNotes       — texty pro tisk dokladu
    //
    // Příznaky na kódu pro odvození kódu DPH z přijatého dokladu
    // (tasks/exchange-received-reverse-charge.md, VatCodeDerivation):
    //   - supplyKind        — "goods" | "services", jen mimo tuzemsko
    //   - reducedDeduction  — 1 = krácený odpočet; derivace ho nikdy nevybere
    // =========================================================================

    "vatCategories": {
        "standard": {
            "name": "Standard rate",
            "name:cs": "Základní",
            "name:en": "Standard rate"
        },
        "reduced": {
            "name": "Reduced rate",
            "name:cs": "Snížená",
            "name:en": "Reduced rate"
        },
        "reduced1": {
            "name": "First reduced rate",
            "name:cs": "První snížená",
            "name:en": "First reduced rate"
        },
        "reduced2": {
            "name": "Second reduced rate",
            "name:cs": "Druhá snížená",
            "name:en": "Second reduced rate"
        },
        "zero": {
            "name": "Zero rate",
            "name:cs": "Bez daně",
            "name:en": "Zero rate"
        },
        "exempt": {
            "name": "Exempt",
            "name:cs": "Osvobozeno",
            "name:en": "Exempt"
        }
    },

    "vatNotes": {
        "pdp4": {
            "text": "Daň odvede zákazník",
