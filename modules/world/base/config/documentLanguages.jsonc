{
    // =========================================================================
    // Jazyky dokumentů (#94 D3) — jazyky, ve kterých lze partnerovi vystavit
    // a poslat doklad. Klíč = ISO 639-1; pořadí = pořadí v nabídce.
    //
    // Jediný zdroj pravdy pro sloupec `base_persons_persons.language`,
    // formulář osoby, validaci a `DocumentLanguageResolver`. `en` tu musí být
    // vždy — je záložním jazykem pro země s jazykem mimo tento seznam.
    //
    // `ds-upgrade` pro každý jazyk odtud kompiluje konfiguraci (#90 D29) —
    // tisk ji čte v jazyce dokladu.
    //
    // Není to seznam jazyků tisku: tisk umí jen jazyky, pro které má katalogy
    // a popisky konfigurace (`PrintLanguageResolver::LANGUAGES`, dnes všechny
    // čtyři); jazyk přidaný jen sem se tiskne anglicky.
    // =========================================================================

    "cs": { "name": "Czech",   "name:cs": "čeština",     "name:en": "Czech" },
    "en": { "name": "English", "name:cs": "angličtina",  "name:en": "English" },
    "sk": { "name": "Slovak",  "name:cs": "slovenština", "name:en": "Slovak" },
    "de": { "name": "German",  "name:cs": "němčina",     "name:en": "German" },
}
