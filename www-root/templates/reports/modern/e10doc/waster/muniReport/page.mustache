<!DOCTYPE HTML>
<html lang="cs">
<head>
	<title>OBEC {{data.head.year}}</title>
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
	<link rel="stylesheet" href="{{dsUrl}}www-root/templates/reports/modern/style-modern.css?16" type="text/css"/>
</head>
<body>

	<table class="infoSecondary">
		<tr>
			<td class="supplier">
				<span class='hdr' id="supplier-address-hdr">{{@dict;Provozovatel}}:</span>
				{{#data.reportTexts.supplierAndContacts}}{{{data.reportTexts.supplierAndContacts}}}{{/data.reportTexts.supplierAndContacts}}
					{{^data.reportTexts.supplierAndContacts}}
					<span class='address' id="supplier-address-box">
						{{#data.reportTexts.supplier}}{{{data.reportTexts.supplier}}}<br>{{/data.reportTexts.supplier}}
						{{^data.reportTexts.supplier}}
							<span class='title'>{{data.ownerPerson.fullName}}</span>
							{{#data.ownerPerson.address.specification}}
								{{data.ownerPerson.address.specification}}<br/>
							{{/data.ownerPerson.address.specification}}
							{{data.ownerPerson.address.street}}<br/>
							{{^data.flags.foreignCountry}}
								{{data.ownerPerson.address.zipcode}} {{data.ownerPerson.address.city}}<br/>
							{{/data.flags.foreignCountry}}
							{{#data.flags.foreignCountry}}
								{{data.ownerPerson.address.zipcode}} {{data.ownerPerson.address.city}}<br/>
								{{data.ownerPerson.address.countryNameEng}}
							{{/data.flags.foreignCountry}}

							</span>
						{{/data.reportTexts.supplier}}
							{{#data.reportTexts.contacts}}{{{data.reportTexts.contacts}}}{{/data.reportTexts.contacts}}
							{{^data.reportTexts.contacts}}
								{{#data.ownerPerson_identifiers}}
									<b>{{@dict;dataItem:name}}:</b> {{value}}
								{{/data.ownerPerson_identifiers}}<br>

								<small>{{cfgItem.options.core.ownerLegalRegInfo}}</small>
							{{/data.reportTexts.contacts}}
						{{/data.reportTexts.supplierAndContacts}}
			</td>

			<td class="customer">
				<div class='hdr'>{{@dict;Obec}}:<small class='pull-right'>#{{data.muniPerson.id}}</small></div>
				<span class='title'>{{data.muniPerson.fullName}}</span>
				<span class='address'>
					{{#data.muniPerson.address.specification}}
						{{data.muniPerson.address.specification}}<br/>
					{{/data.muniPerson.address.specification}}
					{{data.muniPerson.address.street}}<br/>
					{{^data.flags.foreignCountry}}
						{{data.muniPerson.address.zipcode}} {{data.muniPerson.address.city}}<br/>
					{{/data.flags.foreignCountry}}
					{{#data.flags.foreignCountry}}
						{{data.muniPerson.address.zipcode}} {{data.muniPerson.address.city}}<br/>
						{{data.muniPerson.address.countryNameEng}}
					{{/data.flags.foreignCountry}}
				</span>

				{{#data.muniPerson_identifiers}}
					<b>{{@dict;dataItem:name}}:</b> {{value}}
				{{/data.muniPerson_identifiers}}

				{{#data.muniPerson.address.saAdmUnit11Id}}<b>IČZUJ: </b>{{data.muniPerson.address.saAdmUnit11Id}}{{/data.muniPerson.address.saAdmUnit11Id}}
			</td>
		</tr>
	</table>

	<table class="additionalAddresses">
		<tr>
			<td>
				<span class='hdr'>{{@dict;Zařízení}}:</span>
				<span class='address'>
						{{#data.ownerPerson.ownerOffice.specification}}
							{{data.ownerPerson.ownerOffice.specification}}<br/>
						{{/data.ownerPerson.ownerOffice.specification}}
						{{data.ownerPerson.ownerOffice.street}}<br/>
						{{^data.flags.foreignCountry}}
							{{data.ownerPerson.ownerOffice.zipcode}} {{data.ownerPerson.ownerOffice.city}}<br/>
						{{/data.flags.foreignCountry}}
						{{#data.flags.foreignCountry}}
							{{data.ownerPerson.ownerOffice.zipcode}} {{data.ownerPerson.ownerOffice.city}}<br/>
							{{data.ownerPerson.ownerOffice.countryNameEng}}
						{{/data.flags.foreignCountry}}
				</span>

				{{#data.ownerPerson.ownerOffice.ids}}
					<b>{{title}}:</b> {{value}}
				{{/data.ownerPerson.ownerOffice.ids}}

				<b>IČZUJ: </b>{{data.ownerPerson.ownerOffice.saAdmUnit11Id}}
			</td>

			<td>
			</td>
		</tr>
	</table>


	<h3 style="text-align: center;">Formulář pro oznámení o komunálních odpadech převzatých zařízením od fyzických osob obci, na jejímž území odpad vznikl</h3>

	<table class="default">
		<tr><td colspan="2"><b>Oznámení o komunálních odpadech převzatých zařízením od fyzických osob obci, na jejímž území odpad vznikl</b></td></tr>
		<tr><td colspan="2"><b>Určeno obci, na jejímž území odpad vznikl</b></td></tr>
		<tr><td>Identifikační číslo osoby (obce) (IČO)</td><td>{{data.muniPerson_identifier_oid}}</td></tr>
		<tr><td>Obec</td><td>{{data.muniPerson.fullName}}</td></tr>
		<tr><td>IČZUJ obce</td><td>{{data.wasteOriginAdmUnit.admUnitId}}</td></tr>
	</table>

	<table class="default" style="margin-top:.5rem;">
		<tr><td colspan="2"><b>Identifikace zařízení</b></td></tr>
		<tr><td>Název zařízení</td><td>{{data.ownerPerson.fullName}}</td></tr>
		<tr><td>Identifikační číslo osoby (IČO)</td><td>{{data.ownerPerson_identifier_oid}}</td></tr>
		<tr><td>Identifikační číslo zařízení (IČZ)</td><td>{{data.ownerPerson.office.id2}}</td></tr>
		<tr><td>Ulice č.p. / č.o.</td><td>{{data.ownerPerson.office.saStreetName}}</td></tr>
		<tr><td>Obec</td><td>{{data.ownerPerson.office.saCityName}}</td></tr>
	</table>

	<table class="default" style="margin-top:.5rem;">
		<tr><td colspan="2"><b>Převzaté komunální odpady od fyzických osob:</b></td></tr>
		<tr><td><b>Druh odpadu:</b></td><td>O</td></tr>
		{{{@renderContent;dataItem:data.wasteRows;tableClass:rows}}}
	</table>

	<table class="default" style="margin-top:.5rem;">
		<tr><td colspan="2"><b>Oznámení vyplnil:</b></td></tr>
		<tr><td>Datum</td><td>{{@date}}</td></tr>
		<tr><td>Jméno a příjmení</td><td>{{data.wasteReturn.authorFirstName}} {{data.wasteReturn.authorLastName}}</td></tr>
		<tr><td>Telefon</td><td>{{data.wasteReturn.authorPhonePrefix}} {{data.wasteReturn.authorPhone}}</td></tr>
		<tr><td>Adresa elektronické pošty</td><td>{{data.wasteReturn.authorEmail}}</td></tr>
	</table>

</body>
</html>
