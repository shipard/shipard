<style>
	table.footer{
		font-family: Arial, Helvetica, sans-serif;
		font-size: 6pt;
		width: 100%;
		margin-left: 1cm;
		margin-right: 1cm;
		border-collapse: collapse;
	}

	td.ownerInfo {text-align: left; line-height: 1.5;}
	td.author {text-align: right; vertical-align: bottom;}
	td.logo {text-align: left; width: 40%;}
	img.logo {height: 1.30em;  position: relative;}
	td.page {text-align: center; width:20%;}
	td.printInfo2 {text-align: right; width: 40%;}
</style>

<table class='footer'>
	<tr>
		<td class="ownerInfo" colspan="2">
			{{data.globalReportInfo.ownerName}}
		</td>
		<td class="author">
			{{data.globalReportInfo.printUserName}}
		</td>
	</tr>
	<tr>
		<td class='logo'>
			{{{data.globalReportInfo.logoPoweredBy}}}
		</td>
		<td class='page'>
			{{@dict;Strana}} <span class="pageNumber"></span> / <span class="totalPages"></span>
		</td>
		<td class='printInfo2'>
			<small>{{data.globalReportInfo.printTime}}</small>
		</td>
	</tr>
</table>
