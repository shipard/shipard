	"format": "shpd.eval.variant.v1",
	"name": "sonnet-5-5-effort-xhigh",
	"description": "Profil czech_general, mail.extraction i exchange.contentTags na claude-sonnet-5-5, thinking adaptive + effort xhigh výslovně",
	"profile": "czech_general",                  // kód profilu pošty
	"promptTemplateFile": null,                  // šablona promptu ze souboru (vyzkoušení bez zásahu do zdroje dat)
	"call": { "connection": null, "model": "claude-sonnet-5-5", "thinking": "adaptive", "effort": "xhigh", "maxTokens": null },
	"contentTags": { "model": "claude-sonnet-5-5", "thinking": "adaptive", "effort": "xhigh" }, // přepis funkce exchange.contentTags
}
