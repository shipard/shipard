{
    "name": "shipard/shipard",
    "require": {
        "php": ">=8.5",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "dibi/dibi": "^5.0",
        "symfony/console": "^7.0",
        "opis/json-schema": "^2.6",
        "firebase/php-jwt": "^7.1",
        "symfony/mailer": "^8.1",
        "openspout/openspout": "^5.12",
        "twig/twig": "^3",
        "chillerlan/php-qrcode": "^6.0",
        "league/commonmark": "^2",
        "ondrejnov/eet": "dev-master#cd26c32b573b0560ab8fe35ad2f3b8ff8fe096f8"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ondrejnov/eet"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Shipard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shipard\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/shpd-server", "bin/shpd-ds"]
}
