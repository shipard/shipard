#!/usr/bin/env bash
#
# pre-commit: ověří citlivé údaje ve staged souborech, soulad generovaných
# souhrnů (tasks/README.md, help/README.md) se zdroji pravdy, metadata
# stránek uživatelské dokumentace a CSS tokeny frontendu (nedefinovaný
# token použitý bez fallbacku, #129 D14).
#
# Zdroj pravdy je hlavička v task filu. Když se rozejde s indexem, commit
# se zastaví a stačí spustit generátor.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if ! command -v python3 >/dev/null 2>&1; then
    exit 0
fi

if ! python3 "$REPO_ROOT/scripts/check-sensitive.py"; then
    echo ""
    echo "==> Commit zastaven: ve staged souborech jsou citlivé údaje."
    echo "    Repozitář je veřejný — anonymizuj před commitem."
    echo ""
    exit 1
fi

if ! python3 "$REPO_ROOT/scripts/tasks-index.py" --check; then
    echo ""
    echo "==> Commit zastaven: souhrn stavů tasků není aktuální."
    echo "    Spusť:  python3 scripts/tasks-index.py"
    echo "    Pak:    git add tasks/README.md"
    echo ""
    exit 1
fi

if ! python3 "$REPO_ROOT/scripts/check-css-tokens.py"; then
    echo ""
    echo "==> Commit zastaven: frontend používá nedefinovaný CSS token."
    echo "    Nahraď ho tokenem ze styles/variables.css (nebo dev/theme.css),"
    echo "    nebo dej fallback var(--x, hodnota). Kontrola jde celým stromem:"
    echo "    python3 scripts/check-css-tokens.py"
    echo ""
    exit 1
fi

if ! python3 "$REPO_ROOT/scripts/help-index.py" --check; then
    echo ""
    echo "==> Commit zastaven: rozcestník uživatelské dokumentace není"
    echo "    aktuální, nebo chybí stránce metadata."
    echo "    Spusť:  python3 scripts/help-index.py"
    echo "    Pak:    git add help/README.md"
    echo "    Pravidla: docs/help-authoring.md"
    echo ""
    exit 1
fi
