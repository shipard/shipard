# Konfigurace video runneru pro ruční použití — zkopíruj jako `.env` a vyplň.
# `.env` je v .gitignore a nikdy se necommituje.
#
# Soubor je volitelný: proměnné už nastavené v prostředí mají přednost
# a `shpd-ds video-run` předává všechno prostředím, bez `.env`.

# Cílová instance Shipardu včetně ID datového zdroje, bez koncového lomítka.
# Scénáře adresují jen cesty uvnitř (`/app/`), takže ID datového zdroje
# nikdy nevstupuje do commitovaného scénáře.
SHPD_BASE_URL=https://demo.example.dev/a3f2-b8c1-d4e7-f9a0

# Uživatel v cílovém DS — normální přihlášení formulářem.
# Používá ho jen verb `login`; ostatní verby čtou už jen uloženou session.
SHPD_LOGIN=
SHPD_PASSWORD=

# Uložená session z verbu `login` (relativně k tools/video-runner/).
# Je stejně citlivá jako heslo — v .gitignore.
SHPD_STORAGE_STATE=.storage-state.json

# Artefakty (raw video, timeline.json, result.json) a hotová videa.
VIDEO_WORK_DIR=./.work
VIDEO_OUT_DIR=./out

# Ladění: 1 = viditelný prohlížeč, bez záznamu.
VIDEO_HEADFUL=0

# Pevný čas v prohlížeči (ISO 8601 s posunem, např. 2026-10-27T09:30:00+01:00).
# Prázdné = skutečný čas. Nastavuje `shpd-ds video-run` z kotvy sady
# a `clockTime` scénáře; ručně jen při ladění.
VIDEO_FIXED_TIME=

# Připíchnutá adresa hostitele pro Chromium (syntaxe --host-resolver-rules,
# např. `MAP demo.example.dev 127.0.0.1`). Prázdné = žádné mapování.
# Nastavuje `shpd-ds video-run`; ručně obvykle netřeba.
VIDEO_HOST_RESOLVER_RULES=
